  "afterparty": {
    "show": true,
    "eyebrow": "ODD is back",
    "premise": "We never threw the afterparty. ODDfest ended on 13 June, everyone went home, and then summer came — no last drink, no proper thank you, nothing. It has been bothering us since.",
    "point": "So we're doing it in September instead.",
    "body": "Artists, partners, friends, your parents, whoever turns up. Music and open decks, art installations, and a great bunch of odd people. If you were not at ODDfest, come anyway.",
    "practical": "We are a small non-profit with no budget, but we do have a wine cabinet. Bring your own wine, or beer, or whatever you drink. The non-alcoholic beer is on the house, thanks to Mikkeller.",
    "contribute": "Got a programme idea? Email upi@oddfest.co by Thursday 24 September.",
    "access": "Four steps at the entrance, so the space is not wheelchair accessible. Tell us in advance and we will work something out.",
    "inviteTitle": "You're invited.",
    "when": "Saturday 26 September",
    "doors": "19:00–00:00 · Free",
    "where": "ODDspace, Teollisuuskatu 9D, 00510 Helsinki",
