---
import { getEntry } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Converge from '../components/sections/Converge.astro';
import ProgramGrid from '../components/sections/ProgramGrid.astro';
import ParticipateBand from '../components/sections/ParticipateBand.astro';
import CaseGrid from '../components/sections/CaseGrid.astro';
import Aftermovie from '../components/sections/Aftermovie.astro';
import LogoStrip from '../components/sections/LogoStrip.astro';
import PartnerTiers from '../components/sections/PartnerTiers.astro';
import WarpingText from '../components/media/WarpingText.astro';
import Pill from '../components/primitives/Pill.astro';
// "More than one event" editorial pair — a dominant stage/talk photo and a
// smaller supporting gallery photo, replacing the old 11-photo scattered
// FloatingCloud (kept in src/components/media/ for reuse elsewhere, just not
// used here anymore — its arc clipped against the section's own overflow:
// hidden edge at common desktop widths, confirmed via screenshot).
import moreThanEventMain from '../assets/hero/archive-03.jpg';
import moreThanEventSupport from '../assets/hero/archive-11.jpg';

// Content file is named index.json (not home.json) so CloudCannon's
// filename-based [slug] URL placeholder resolves to "" for it, matching the
// real "/" route — see cloudcannon.config.yml's pages.url and
// docs/architecture.md#content-file-naming.
const entry = await getEntry('pages', 'index');
if (!entry || entry.data._template !== 'home')
  throw new Error('index.json content entry missing or malformed');
const page = entry.data;

const site = await getEntry('site', 'global');
if (!site) throw new Error('Missing site/global.json content entry');
const { partners, featuredIn } = site.data;

// The hero mosaic's first cell is the page's real LCP element (confirmed via
// a PerformanceObserver check against production, not assumed) — preloading
// it lets the browser start fetching before it's parsed HTML deep enough to
// discover the <img> tag itself, same file Hero.astro resolves internally.
const archiveModules = import.meta.glob<{ default: ImageMetadata }>('../assets/hero/*.jpg', {
  eager: true,
});
const firstArchiveImage = Object.values(archiveModules)[0].default;
const preloadImage = await getImage({ src: firstArchiveImage, width: 500, format: 'webp' });
---

<Layout
  title={page.seo.title}
  description={page.seo.description}
  ogImage={page.seo.ogImage}
  preloadImage={preloadImage.src}
>
  <Hero mosaicAlt={page.hero.mosaicAlt} headline={page.opening.headline} />

  <section class="mte-section">
    <div class="wrap-wide mte-grid">
      <div class="mte-media">
        <div class="mte-media-main reveal">
          <Image src={moreThanEventMain} alt="" width={800} />
        </div>
        <div class="mte-media-support reveal">
          <Image src={moreThanEventSupport} alt="" width={480} />
        </div>
      </div>
      <div class="mte-text reveal">
        <span class="eyebrow">{page.whatOddIs.eyebrow}</span>
        <WarpingText as="h2" text={page.whatOddIs.headline} class="mte-headline" color="paper" />
        <p class="mte-body">{page.whatOddIs.body}</p>
        {
          page.whatOddIs.cta && (
            <a class="mte-link" href={page.whatOddIs.cta.href}>
              {page.whatOddIs.cta.label}
            </a>
          )
        }
        {
          (page.opening.primaryCta || page.opening.secondaryCta) && (
            <div class="mte-ctas">
              {page.opening.primaryCta && (
                <Pill href={page.opening.primaryCta.href} variant="solid" magnetic>
                  {page.opening.primaryCta.label}
                </Pill>
              )}
              {page.opening.secondaryCta && (
                <Pill href={page.opening.secondaryCta.href} variant="outline" magnetic>
                  {page.opening.secondaryCta.label}
                </Pill>
              )}
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section id="business" class="converge-wrap">
    <Converge
      intro={page.twoWaysIn.intro}
      business={page.twoWaysIn.business}
      creative={page.twoWaysIn.creative}
    />
  </section>

  {
    /* "What's happening" is hidden for now — not enough confirmed content
       to justify showing it (see AGENTS.md/task notes). Component + content
       field are both kept as-is for when there's real programme to show;
       just not rendered. The hero's own "See what's on" CTA below is
       repointed to "The ODD platform" section instead of the now-hidden
       #whats-happening anchor, so it isn't a dead link. */
  }

  <ProgramGrid title="The ODD platform" cards={page.platforms} />

  <LogoStrip eyebrow="Press" title="Featured in" items={featuredIn} compact scroll />

  {
    /* "ODDfest, in numbers" is removed from the homepage — ProofGrid itself
       stays in use elsewhere (About, Media, ODDspace, oddfest.astro); only
       this page's `proof` key + guard are gone. */
  }

  <section class="work-with-odd-teaser">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{page.workWithOdd.eyebrow}</span>
        <WarpingText as="h2" text={page.workWithOdd.title} align="center" color="paper" />
      </div>
      <p class="wwo-intro reveal">{page.workWithOdd.intro}</p>
      <div class="wwo-cards reveal" style={`--cols: ${page.workWithOdd.cards.length}`}>
        {
          page.workWithOdd.cards.map((c) => (
            <a class="wwo-card" href={c.href}>
              <span class="eyebrow">{c.eyebrow}</span>
              <h3>{c.title}</h3>
              <span class="wwo-go">{c.linkLabel}</span>
            </a>
          ))
        }
      </div>
      <div class="wwo-cta">
        <a class="wwo-cta-link" href={page.workWithOdd.ctaHref}>{page.workWithOdd.ctaLabel} →</a>
      </div>
    </div>
  </section>

  {page.caseTeaser && <CaseGrid items={[page.caseTeaser]} />}

  <Aftermovie poster={page.aftermovie.poster} video={page.aftermovie.video} />

  <PartnerTiers eyebrow="Who we build with" title="Partners" items={partners} />

  <ParticipateBand items={page.participate} />
</Layout>

<style>
  /* "More than one event" — a controlled editorial pair (one dominant
     portrait photo, one smaller landscape photo tucked at its corner) next
     to a left-aligned text column, instead of the old centered text + a
     loose 11-photo scatter. Asymmetric on purpose (1.15fr/1fr, images
     overlapping their own grid cell slightly) — see mte-media-support's
     comment for how the overlap is built. */
  .mte-section {
    padding: var(--space-24) 0;
  }
  .mte-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--gutter-wide);
    align-items: center;
  }
  .mte-media {
    position: relative;
  }
  .mte-media-main {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--color-paper-12);
  }
  .mte-media-main :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keeps the lit stage/speaker (the top ~60% of the source frame) in
       frame, trimming the audience-foreground tables at the bottom rather
       than centering blindly — chosen by inspecting the actual photo, not a
       default center crop. */
    object-position: 50% 22%;
    display: block;
    filter: contrast(1.05) saturate(1.15) brightness(0.9);
  }
  .mte-media-support {
    /* Overlapping the main image's own bottom-right corner is the
       "deliberate asymmetry" — a fixed, hand-placed offset (not a random
       scatter like the old FloatingCloud), sized so it never exceeds the
       main image's own edges at this component's min supported width
       (~460px, this column's floor before the grid drops to 1 column). */
    position: absolute;
    right: -9%;
    bottom: -12%;
    width: 56%;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border: 1px solid var(--color-paper-12);
    box-shadow: 0 20px 40px -14px rgb(0 0 0 / 55%);
  }
  .mte-media-support :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keeps both people talking and the mask sculptures on the right in
       frame; the blurred foreground shape is the photo's own intentional
       shallow-depth-of-field framing, not a crop artifact. */
    object-position: 58% 42%;
    display: block;
    filter: contrast(1.05) saturate(1.15) brightness(0.92);
  }
  .mte-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
  .mte-text .eyebrow {
    color: var(--color-paper-60);
  }
  .mte-text :global(.mte-headline) {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-paper);
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1.1;
    margin: 0.9rem 0 0;
    text-wrap: balance;
  }
  .mte-body {
    max-width: 38ch;
    margin: 1.4rem 0 0;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.8;
    color: var(--color-paper-60);
  }
  .mte-link {
    display: inline-block;
    margin-top: 1.3rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.82rem;
    color: var(--color-paper-80);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-paper-20);
    transition: color var(--duration-fast) ease;
  }
  .mte-link:hover {
    color: var(--color-amber-bright);
    text-decoration-color: var(--color-amber-bright);
  }
  .mte-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.9rem;
  }
  @media (max-width: 820px) {
    .mte-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .mte-media {
      /* Mobile drops the overlap entirely rather than shrinking it — a
         floated corner image at this width would either cover the main
         photo's own subject or shrink past legibility. Two stacked,
         full-width images read as a clean vertical narrative instead. */
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .mte-media-support {
      position: static;
      width: 100%;
      aspect-ratio: 16 / 10;
    }
    .mte-text {
      align-items: center;
      text-align: center;
    }
    .mte-body {
      margin-left: auto;
      margin-right: auto;
    }
    .mte-ctas {
      justify-content: center;
    }
  }
  .work-with-odd-teaser {
    background: var(--color-bg);
  }
  .wwo-intro {
    max-width: 42rem;
    margin: -2rem auto 3rem;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--color-paper-60);
  }
  .wwo-cards {
    display: grid;
    /* --cols (set inline, per instance) — always one row instead of auto-fit
       stranding the last of the 4 cards alone at tablet width (confirmed via
       screenshot: 3-then-1 at 834px). Same fix as ProofGrid/ParticipateBand. */
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 1px;
    background: var(--color-paper-12);
  }
  @media (max-width: 700px) {
    .wwo-cards {
      grid-template-columns: 1fr;
    }
  }
  .wwo-card {
    /* min-width: 0 — without it a grid item's implicit min-width:auto
       refuses to shrink narrower than its longest unwrapped word, forcing
       this column past its 1fr share and overflowing the page horizontally
       between 701–767px (confirmed live: .wwo-card's right edge landed
       101px past the viewport at 768px). Same fix ProofGrid/ParticipateBand
       already apply for the identical reason — see their own comments. */
    min-width: 0;
    background: var(--color-backstage);
    padding: 2rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: background-color var(--duration-fast) ease;
  }
  .wwo-card:hover {
    background: color-mix(in srgb, var(--color-backstage) 85%, var(--color-paper) 15%);
  }
  .wwo-card h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    color: var(--color-paper);
    margin: 0;
  }
  .wwo-go {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-paper-60);
  }
  .wwo-cta {
    text-align: center;
    margin-top: 2.5rem;
  }
  .wwo-cta-link {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--color-paper);
    text-decoration: underline;
    text-decoration-color: var(--color-paper-40);
    text-underline-offset: 4px;
  }
  .wwo-cta-link:hover {
    text-decoration-color: var(--color-paper);
  }
</style>
