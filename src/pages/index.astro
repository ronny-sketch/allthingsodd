---
import { getEntry } from 'astro:content';
import { mosaicImage, MOSAIC_SIZES } from '../components/sections/mosaic-images';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import Converge from '../components/sections/Converge.astro';
import ProgramGrid from '../components/sections/ProgramGrid.astro';
import ProofGrid from '../components/sections/ProofGrid.astro';
import ParticipateBand from '../components/sections/ParticipateBand.astro';
import CaseGrid from '../components/sections/CaseGrid.astro';
import Aftermovie from '../components/sections/Aftermovie.astro';
import LogoStrip from '../components/sections/LogoStrip.astro';
import PartnerTiers from '../components/sections/PartnerTiers.astro';
import FloatingCloud from '../components/media/FloatingCloud.astro';
import Pill from '../components/primitives/Pill.astro';
import cloudPhoto1 from '../assets/hero/archive-03.jpg';
import cloudPhoto2 from '../assets/hero/archive-04.jpg';
import cloudPhoto3 from '../assets/hero/archive-06.jpg';
import cloudPhoto4 from '../assets/hero/archive-09.jpg';
import cloudPhoto5 from '../assets/hero/archive-11.jpg';
import cloudPhoto6 from '../assets/hero/archive-14.jpg';
import cloudPhoto7 from '../assets/hero/archive-01.jpg';
import cloudPhoto8 from '../assets/hero/archive-02.jpg';
import cloudPhoto9 from '../assets/hero/archive-07.jpg';
import cloudPhoto10 from '../assets/hero/archive-17.jpg';
import cloudPhoto11 from '../assets/hero/archive-21.jpg';

// Content file is named index.json (not home.json) so CloudCannon's
// filename-based [slug] URL placeholder resolves to "" for it, matching the
// real "/" route — see cloudcannon.config.yml's pages.url and
// docs/architecture.md#content-file-naming.
const entry = await getEntry('pages', 'index');
if (!entry || entry.data._template !== 'home')
  throw new Error('index.json content entry missing or malformed');
const page = entry.data;

const site = await getEntry('site', 'global');
if (!site) throw new Error('Missing site/global.json content entry');
const { featuredIn, logoWall } = site.data;

// Verified editorial/media coverage only (2026-08-31 final implementation
// pass) — same `pressCoverage` distinction media.astro's own "Featured in"
// already uses, rather than blindly rendering the full sitewide list (which
// also carries funders, award bodies and industry organisations with no
// editorial coverage of ODD). Capped at the 12 strongest, in the order
// they're curated in site/global.json.
const homePressLogos = featuredIn.filter((item) => item.pressCoverage).slice(0, 12);

const cloudPhotos = [
  cloudPhoto1,
  cloudPhoto2,
  cloudPhoto3,
  cloudPhoto4,
  cloudPhoto5,
  cloudPhoto6,
  cloudPhoto7,
  cloudPhoto8,
  cloudPhoto9,
  cloudPhoto10,
  cloudPhoto11,
];

// A head start on the hero mosaic's first cell — the first photograph the
// page paints. Built through the same helper Hero.astro uses, and passed to
// Layout with its full candidate set, so the preload names exactly the file
// `srcset` will pick rather than a second one alongside it.
//
// Corrected 2026-09-03: this used to be described as the page's LCP element.
// It was, but only because the real one — the <h1> — was disqualified by an
// entrance animation; measurement moved LCP back to the heading at ~0.5s.
// See Hero.astro's .hero-headline comment for the full finding.
const archiveModules = import.meta.glob<{ default: ImageMetadata }>('../assets/hero/*.jpg', {
  eager: true,
});
const firstArchiveImage = Object.values(archiveModules)[0].default;
const preloadImage = await mosaicImage(firstArchiveImage);
---

<Layout
  title={page.seo.title}
  description={page.seo.description}
  ogImage={page.seo.ogImage}
  preloadImage={preloadImage.src}
  preloadImageSrcset={preloadImage.srcset}
  preloadImageSizes={MOSAIC_SIZES}
>
  <Hero mosaicAlt={page.hero.mosaicAlt} headline={page.opening.headline} />

  <div class="whatoddis-wrap">
    <FloatingCloud images={cloudPhotos} />
    {
      /* `lead` (2026-09-11, reworked 2026-09-13): this is the page's main
         explanatory passage, not a supporting note, so it is set in brighter
         ink on a wider measure than SectionIntro's grey default — at the same
         Body size as every other paragraph on the site. The body's blank
         lines render as real paragraphs; see SectionIntro's own comment. */
    }
    <SectionIntro
      eyebrow={page.whatOddIs.eyebrow}
      headline={page.whatOddIs.headline}
      body={page.whatOddIs.body}
      lead
      warpHeadline
    />
    {
      /* One integrated action pair, not two competing CTA mechanisms — this
         used to also render SectionIntro's own text-link cta
         (page.whatOddIs.cta) directly above this row, so the section carried
         two different CTA styles doing two different things back to back.
         SectionIntro's `cta` prop is intentionally unused here; these Pills
         are the section's only calls to action. */
      (page.opening.primaryCta || page.opening.secondaryCta) && (
        <div class="whatoddis-ctas reveal">
          {page.opening.primaryCta && (
            <Pill href={page.opening.primaryCta.href} variant="solid" magnetic>
              {page.opening.primaryCta.label}
            </Pill>
          )}
          {page.opening.secondaryCta && (
            <Pill href={page.opening.secondaryCta.href} variant="outline" magnetic>
              {page.opening.secondaryCta.label}
            </Pill>
          )}
        </div>
      )
    }
  </div>

  {
    /* --- Homepage section order, set in the 2026-09-11 reorg. ---
       Hero → Why ODD → Who it's for → What we do → Work with ODD → Already in
       motion → Featured in → video → The way in is by doing.

       The reasoning, which is the part worth keeping: the page answers the
       reader's questions in the order they actually arrive. Why does this
       exist → is it for me → then what is it, concretely → how do I go
       deeper → why should I believe any of it → a last look at what it feels
       like → pick a door.

       Two of those are reversals of earlier passes, deliberately:

       * "Who ODD is for" moves back above "What we do". The 2026-09-02 pass
         put it after the proof module on the theory that "what" precedes
         "who". In review that lost the reader: ODDfest/ODDference/ODDspace
         are three names that mean nothing until you know which of them is
         aimed at you, and the audience split is what makes the grid legible
         rather than the other way round.
       * "Work with ODD" moves back to directly under "What we do". The
         2026-09-03 pass moved it away because, flush under the grid, it read
         as a fourth product card. The fix for that is the band's own styling
         and spacing (both changed here), not its position — its actual job
         is "interested in something bigger than the three above?", and that
         question only lands while the three are still on screen. This also
         restores the nav's own logic on the page: three products, then Work
         with ODD underneath them. */
  }
  <Converge
    audienceEyebrow="Who ODD is for"
    intro={page.twoWaysIn.intro}
    business={page.twoWaysIn.business}
    creative={page.twoWaysIn.creative}
    creativeFirst
  />

  <ProgramGrid title="What we do" cards={page.platforms} />

  {
    /* "Work with ODD" — a quiet organisational pathway, not a fourth equal
       product card (2026-08-31: it used to be a giant photo card inside the
       grid above, competing visually with ODDfest/ODDference/ODDspace, which
       misrepresents the site's real hierarchy — ODDagency / Work with ODD are
       deeper ways to work with ODD, not equal masterbrand programmes).

       Restyled 2026-09-11 so it can sit directly under the grid again without
       reading as a fourth card: it now carries a real eyebrow/title/body
       stack and a pill-shaped action instead of a single line of small text,
       an amber keyline that ties it to nothing else in the grid, and enough
       space above it to read as the next move rather than the last item. */
  }
  <div class="wwo-band wrap">
    <a class="wwo-band-link" href={page.workWithOdd.href}>
      <span class="wwo-band-text">
        <span class="eyebrow">{page.workWithOdd.eyebrow}</span>
        <span class="wwo-band-title">{page.workWithOdd.title}</span>
        {page.workWithOdd.body && <span class="wwo-band-body">{page.workWithOdd.body}</span>}
      </span>
      {
        /* A span, not the Pill primitive: Pill renders a <button> when it has
           no href, and the whole band is already one <a>, so a real nested
           control would be invalid. Styled from the same tokens Pill uses. */
      }
      <span class="wwo-band-go">{page.workWithOdd.linkLabel}</span>
    </a>
  </div>

  {
    /* "Already in motion" — the homepage's first hard proof, now that the
       reader has seen what ODD does and how to work with it. SectionIntro
       carries the eyebrow/headline/body/cta; the bare ProofGrid underneath
       (no eyebrow/title of its own — see content.config.ts's proofSection
       comment) renders the stat row plus the Impact Report link. Guarded on
       `proofIntro` (not `proof`) since the editorial framing is what makes
       this a real section, not just a stat grid.

       2026-09-04: the numbers are ODD's cumulative totals across its first
       two years (5,000+ / 500+ / 100+ / €400K+), not the ODDfest 2025
       snapshot this launched with — the homepage's job is to say what ODD has
       built, and a first-event-only row understated it by half. The 2025
       figures stay where they belong, on About's year-by-year impact section.
       The report link keeps its 2025 scope explicit via `reportNote` so four
       cumulative figures never read as though one year's report evidences
       them. */
  }
  {
    page.proofIntro && (
      <div class="home-proof">
        <SectionIntro
          eyebrow={page.proofIntro.eyebrow}
          headline={page.proofIntro.headline}
          body={page.proofIntro.body}
          cta={page.proofIntro.cta}
        />
        {page.proof && (
          <ProofGrid
            eyebrow={page.proof.eyebrow}
            title={page.proof.title}
            items={page.proof.items}
            reportLabel={page.proof.reportLabel}
            reportUrl={page.proof.reportUrl}
            reportNote={page.proof.reportNote}
          />
        )}
      </div>
    )
  }

  {
    /* "Featured in" — the second half of one social-proof chapter, reading
       straight on from the numbers above rather than opening a new one.
       `compact` (see LogoStrip.astro's own comment) drops the bordered
       section-head to keep that continuity. Filtered to verified press
       coverage only (see `homePressLogos` above) — the full featuredIn list
       also carries funders/award bodies/industry organisations, which aren't
       "featured in" claims. */
  }
  {
    homePressLogos.length > 0 && (
      <LogoStrip
        eyebrow="Press"
        title="Featured in"
        items={homePressLogos}
        size="large"
        scroll
        compact
      />
    )
  }

  {
    /* The grouped Partners/Media/Supported by/Collaborators logo wall stays
       fully OFF the homepage (`logoWall.visible: false` in
       site/global.json) until real organisations are confirmed for each
       category — see site/global.json's `logoWall` and docs/editing.md.
       Deliberately NOT falling back to the old flat `partners` list here:
       that list mixes funders, media and collaborators under one
       unlabeled "Partners" heading with no per-organisation confirmation
       of which group each belongs to, which is exactly what this section
       is meant to stop doing. Flipping `visible` to true (once
       `logoWall.groups` is populated) is the only thing needed to bring
       this section back. */
    logoWall?.visible && (
      <PartnerTiers eyebrow="Who we build with" title="Partners" groups={logoWall.groups} />
    )
  }

  {page.caseTeaser && <CaseGrid items={[page.caseTeaser]} />}

  {
    /* The one moving-image break on the page, and it earns its place by
       position: everything above it is argument, everything below it is the
       ask. A page that goes straight from a logo wall into four CTA cards
       gives the reader nothing to feel before deciding. Brand marquee
       (ODDfest/ODDference/ODDspace banner) is off here — those three names
       are already the "What we do" cards above; see Aftermovie.astro's
       `showBrandMarquee` comment. */
  }
  <Aftermovie
    poster={page.aftermovie.poster}
    video={page.aftermovie.video}
    showBrandMarquee={false}
  />

  {
    /* Grouped by audience (2026-09-11), creatives first — the order lives in
       index.json's `participate` array, not here. See ParticipateBand's
       `groupByAudience` comment for why the Creative/Business labels moved
       out of the cards and onto headings above them. */
  }
  <ParticipateBand title={page.participateTitle} items={page.participate} groupByAudience />
</Layout>

<style>
  .whatoddis-wrap {
    position: relative;
  }
  .whatoddis-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin: 1.8rem auto 0;
    position: relative;
  }
  /* Headline scale. This was pinned to a 4.6rem display size in the
     2026-08-31 revision, when the headline was two short sentences and
     needed the weight to read as the page's second hero moment. It is now
     one long sentence, and at 4.6rem inside SectionIntro's 42rem block that
     set as seven lines of display type — a wall, with the body it is
     supposed to introduce reduced to a footnote underneath.

     No size override here: SectionIntro's own Display role is the size, and
     the block widens instead, which buys the line count back without
     inventing a size. Still the largest headline on the page after the hero
     — just not louder than the thing it introduces. */
  .whatoddis-wrap :global(.section-intro-inner) {
    max-width: 52rem;
  }
  /* The cloud is decorative (aria-hidden, alt="") and must never paint over
     the words it frames. FloatingCloud is absolutely positioned and comes
     first in this wrapper, so by default it painted above the section, which
     is in normal flow — at the top of the arc that put a photo directly on
     the "Why ODD" eyebrow. Raising the text, rather than moving the photo,
     because the arc's apex will keep landing near the section's first line
     whenever the copy length changes. (.whatoddis-ctas below already carries
     its own position: relative for the same reason.) */
  .whatoddis-wrap :global(.section-intro) {
    position: relative;
    z-index: 1;
  }
  /* HeroCentered's eyebrow reads brighter (--color-paper-80) than
     SectionIntro's shared default (--color-paper-60) — matched here for the
     same "second hero" alignment as the headline above. */
  .whatoddis-wrap :global(.section-intro-inner .eyebrow) {
    color: var(--color-paper-80);
  }
  /* "Work with ODD" pathway band — one row, deliberately not a product card:
     no photo, no grid cell, its own full-width strip. It sits directly under
     the three platform cards again (2026-09-11), which is where its question
     — "want something bigger than one of those three?" — actually lands.
     --space-10 above it is the load-bearing number: flush (the original
     margin-top: 1px) made it read as a fourth card in the grid, and
     --space-16 (the 2026-09-03 value, from when it closed a different
     chapter) broke the connection to the grid entirely. This is a clear
     break, one step down in the same passage. */
  .wwo-band {
    margin-top: var(--space-10);
  }
  @media (max-width: 640px) {
    .wwo-band {
      margin-top: var(--space-8);
    }
  }

  /* "Already in motion" proof module — a SectionIntro (eyebrow/headline/
     body/cta) directly above a bare ProofGrid stat row. Both render as full
     default-padded <section>s on their own (see layout.css), which stacks a
     12rem gap between the closing line and the numbers backing it up —
     trimmed here so the two read as one connected passage. */
  .home-proof :global(.section-intro) {
    padding-bottom: var(--space-6);
  }
  .home-proof :global(.proof-section) {
    padding-top: 0;
  }
  @media (max-width: 640px) {
    .home-proof :global(.section-intro) {
      padding-bottom: var(--space-4);
    }
  }

  /* Four cumulative figures since 2026-09-04, not the three 2025-only ones
     this module launched with. "Directly into creative & cultural
     industries" is four times the length of "Participants", so this
     instance balances its labels and trims the column padding. The
     two-by-two tablet layout it used to set here now lives in ProofGrid
     itself, for every four-figure row. */
  .home-proof :global(.proof-label) {
    /* One long label among three short ones breaks into an unbalanced
       ragged block by default; `balance` evens the lines so the four read
       as one row of captions. */
    text-wrap: balance;
  }
  @media (min-width: 701px) {
    /* 2rem each side is generous for a one-word label and costs the long
       one a whole extra line — the divider rules still separate the
       columns. */
    .home-proof :global(.proof-item) {
      padding: 0 1.2rem;
    }
  }

  /* "Featured in" now reads straight on from "Already in motion" rather than
     from "Who ODD is for" (the 2026-09-11 reorg put the two proof modules
     together) — enough air that the logos are their own line of proof, not so
     much that they start a new chapter. */
  .home-proof + :global(.logo-strip-section.is-compact) {
    padding-top: var(--space-6);
  }

  /* The band itself, restyled 2026-09-11. The previous version was a single
     baseline-aligned row of small text — at the bottom of the page that read
     as a footnote, which was the point then. Directly under the platform
     cards it needs to read as a real next step instead, so the eyebrow/title/
     body now stack the way a card's do, the title is a Forta Heading, and the
     action is a pill rather than a line of uppercase text. What keeps it from
     becoming a fourth product card is everything it still doesn't have: no
     photo, no grid cell, full page width, and a quieter ground. */
  .wwo-band-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.4rem 2.5rem;
    padding: 2.1rem var(--gutter-wide);
    background: var(--color-backstage);
    border: 1px solid var(--color-paper-12);
    /* The one accent: a keyline in the amber the site already uses for the
       creative/organisational side, so the band is visibly a different kind
       of thing from the three cards above without shouting. */
    border-left: 2px solid var(--color-amber-bright);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }
  @media (hover: hover) {
    .wwo-band-link:hover {
      border-color: var(--color-paper-40);
      border-left-color: var(--color-amber-bright);
      background: var(--color-bg);
    }
  }
  /* Stacked, not baseline-aligned on one line — a title and a sentence of
     explanation running into each other horizontally is what made the old
     version hard to scan. */
  .wwo-band-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    min-width: 0;
  }
  .wwo-band-title {
    /* The same Heading step as ProgramGrid's card titles. What keeps it the
       step after those three rather than a fourth peer is everything around
       it — no photo, no grid cell, the quieter ground — not a smaller size. */
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    text-wrap: balance;
  }
  .wwo-band-body {
    font: var(--text-body);
    max-width: var(--measure-prose);
    color: var(--color-paper-60);
  }
  /* Pill-shaped, from the same tokens Pill.astro uses — but a <span>, since
     the whole band is one <a> and a real nested control would be invalid
     HTML. See the markup comment above. Because it isn't focusable itself,
     the band's own :focus-visible is what the keyboard shows. */
  .wwo-band-go {
    flex-shrink: 0;
    display: inline-block;
    border-radius: 999px;
    padding: 0.7rem 1.4rem;
    border: 1px solid rgb(226 223 222 / 35%);
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-paper);
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  @media (hover: hover) {
    .wwo-band-link:hover .wwo-band-go {
      border-color: var(--color-amber-bright);
      color: var(--color-amber-bright);
    }
  }
  @media (max-width: 640px) {
    .wwo-band-link {
      padding: 1.7rem var(--gutter);
      /* The action goes full-width under the text rather than sitting in a
         narrow column beside it — at this width there is no "beside". */
      align-items: stretch;
    }
    .wwo-band-go {
      text-align: center;
    }
  }
</style>
