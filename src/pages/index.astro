---
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import Converge from '../components/sections/Converge.astro';
import ProgramGrid from '../components/sections/ProgramGrid.astro';
import ProofGrid from '../components/sections/ProofGrid.astro';
import ParticipateBand from '../components/sections/ParticipateBand.astro';
import CaseGrid from '../components/sections/CaseGrid.astro';
import Aftermovie from '../components/sections/Aftermovie.astro';
import LogoStrip from '../components/sections/LogoStrip.astro';
import PartnerTiers from '../components/sections/PartnerTiers.astro';
import FloatingCloud from '../components/media/FloatingCloud.astro';
import Pill from '../components/primitives/Pill.astro';
import cloudPhoto1 from '../assets/hero/archive-03.jpg';
import cloudPhoto2 from '../assets/hero/archive-04.jpg';
import cloudPhoto3 from '../assets/hero/archive-06.jpg';
import cloudPhoto4 from '../assets/hero/archive-09.jpg';
import cloudPhoto5 from '../assets/hero/archive-11.jpg';
import cloudPhoto6 from '../assets/hero/archive-14.jpg';
import cloudPhoto7 from '../assets/hero/archive-01.jpg';
import cloudPhoto8 from '../assets/hero/archive-02.jpg';
import cloudPhoto9 from '../assets/hero/archive-07.jpg';
import cloudPhoto10 from '../assets/hero/archive-17.jpg';
import cloudPhoto11 from '../assets/hero/archive-21.jpg';

// Content file is named index.json (not home.json) so CloudCannon's
// filename-based [slug] URL placeholder resolves to "" for it, matching the
// real "/" route — see cloudcannon.config.yml's pages.url and
// docs/architecture.md#content-file-naming.
const entry = await getEntry('pages', 'index');
if (!entry || entry.data._template !== 'home')
  throw new Error('index.json content entry missing or malformed');
const page = entry.data;

const site = await getEntry('site', 'global');
if (!site) throw new Error('Missing site/global.json content entry');
const { featuredIn, logoWall } = site.data;

// Verified editorial/media coverage only (2026-08-31 final implementation
// pass) — same `pressCoverage` distinction media.astro's own "Featured in"
// already uses, rather than blindly rendering the full sitewide list (which
// also carries funders, award bodies and industry organisations with no
// editorial coverage of ODD). Capped at the 12 strongest, in the order
// they're curated in site/global.json.
const homePressLogos = featuredIn.filter((item) => item.pressCoverage).slice(0, 12);

const cloudPhotos = [
  cloudPhoto1,
  cloudPhoto2,
  cloudPhoto3,
  cloudPhoto4,
  cloudPhoto5,
  cloudPhoto6,
  cloudPhoto7,
  cloudPhoto8,
  cloudPhoto9,
  cloudPhoto10,
  cloudPhoto11,
];

// The hero mosaic's first cell is the page's real LCP element (confirmed via
// a PerformanceObserver check against production, not assumed) — preloading
// it lets the browser start fetching before it's parsed HTML deep enough to
// discover the <img> tag itself, same file Hero.astro resolves internally.
const archiveModules = import.meta.glob<{ default: ImageMetadata }>('../assets/hero/*.jpg', {
  eager: true,
});
const firstArchiveImage = Object.values(archiveModules)[0].default;
const preloadImage = await getImage({ src: firstArchiveImage, width: 500, format: 'webp' });
---

<Layout
  title={page.seo.title}
  description={page.seo.description}
  ogImage={page.seo.ogImage}
  preloadImage={preloadImage.src}
>
  <Hero mosaicAlt={page.hero.mosaicAlt} headline={page.opening.headline} />

  <div class="whatoddis-wrap">
    <FloatingCloud images={cloudPhotos} />
    <SectionIntro
      eyebrow={page.whatOddIs.eyebrow}
      headline={page.whatOddIs.headline}
      body={page.whatOddIs.body}
      warpHeadline
    />
    {
      /* One integrated action pair, not two competing CTA mechanisms — this
         used to also render SectionIntro's own text-link cta
         (page.whatOddIs.cta) directly above this row, so the section carried
         two different CTA styles doing two different things back to back.
         SectionIntro's `cta` prop is intentionally unused here; these Pills
         are the section's only calls to action. */
      (page.opening.primaryCta || page.opening.secondaryCta) && (
        <div class="whatoddis-ctas reveal">
          {page.opening.primaryCta && (
            <Pill href={page.opening.primaryCta.href} variant="solid" magnetic>
              {page.opening.primaryCta.label}
            </Pill>
          )}
          {page.opening.secondaryCta && (
            <Pill href={page.opening.secondaryCta.href} variant="outline" magnetic>
              {page.opening.secondaryCta.label}
            </Pill>
          )}
        </div>
      )
    }
  </div>

  {
    /* "What we do" (ProgramGrid, the three real platform destinations) moves
       directly under "Why ODD" (2026-09-02 copywriting pass — MOVE + REWRITE:
       once the reader understands why ODD exists, the next question is what
       it actually does, not who it's for). "Who ODD is for" (Converge) now
       follows the proof module instead of sitting glued to this grid — see
       below. */
  }
  <ProgramGrid title="What we do" cards={page.platforms} />

  {
    /* "Work with ODD" — a quiet organisational pathway, not a fourth equal
       product card (2026-08-31 final implementation pass: it used to be a
       giant photo card inside the grid above, competing visually with
       ODDfest/ODDference/ODDspace, which the brief flags as
       misrepresenting the site's real hierarchy — ODDnetwork/ODDagency/
       Work with ODD are deeper ways to work with ODD, not equal masterbrand
       programmes). A slim single-row banner immediately under the three
       primary destinations, reusing Pill for the CTA rather than inventing
       a new card component. */
  }
  <div class="wwo-band wrap">
    <a class="wwo-band-link" href={page.workWithOdd.href}>
      <span class="wwo-band-text">
        <span class="eyebrow">{page.workWithOdd.eyebrow}</span>
        <span class="wwo-band-title">{page.workWithOdd.title}</span>
        {page.workWithOdd.body && <span class="wwo-band-body">{page.workWithOdd.body}</span>}
      </span>
      <span class="wwo-band-go">{page.workWithOdd.linkLabel}</span>
    </a>
  </div>

  {
    /* "Already in motion" — NEW SECTION (2026-09-02 copywriting pass): the
       homepage's first hard proof, right after the reader has seen what ODD
       does. SectionIntro carries the eyebrow/headline/body/cta; the bare
       ProofGrid underneath (no eyebrow/title of its own — see
       content.config.ts's proofSection comment) renders the verified 2025
       stat row plus the 2025 Impact Report link. Guarded on `proofIntro`
       (not `proof`) since the editorial framing is what makes this a real
       section, not just a stat grid. */
  }
  {
    page.proofIntro && (
      <div class="home-proof">
        <SectionIntro
          eyebrow={page.proofIntro.eyebrow}
          headline={page.proofIntro.headline}
          body={page.proofIntro.body}
          cta={page.proofIntro.cta}
        />
        {page.proof && (
          <ProofGrid
            eyebrow={page.proof.eyebrow}
            title={page.proof.title}
            items={page.proof.items}
            reportLabel={page.proof.reportLabel}
            reportUrl={page.proof.reportUrl}
          />
        )}
      </div>
    )
  }

  {
    /* "Who ODD is for" (Converge, audience explanation only — the small
       per-track destination buttons were removed 2026-08-30, see
       Converge.astro's own comment) now follows the proof module rather
       than sitting glued to "What we do" — see the MOVE above. */
  }
  <Converge
    audienceEyebrow="Who ODD is for"
    intro={page.twoWaysIn.intro}
    business={page.twoWaysIn.business}
    creative={page.twoWaysIn.creative}
  />

  {
    /* "Featured in" — proof sitting after the audience/product story rather
       than competing with the hero above the fold. `compact` (see
       LogoStrip.astro's own comment) drops the bordered section-head so it
       reads as a continuation of the page, not a new chapter. Filtered to
       verified press coverage only (see `homePressLogos` above) — the full
       featuredIn list also carries funders/award bodies/industry
       organisations, which aren't "featured in" claims. */
  }
  {
    homePressLogos.length > 0 && (
      <LogoStrip
        eyebrow="Press"
        title="Featured in"
        items={homePressLogos}
        size="large"
        scroll
        compact
      />
    )
  }

  {
    /* "What's happening" is hidden for now — not enough confirmed content
       to justify showing it (see AGENTS.md/task notes). Component + content
       field are both kept as-is for when there's real programme to show;
       just not rendered. */
  }

  {
    /* The grouped Partners/Media/Supported by/Collaborators logo wall stays
       fully OFF the homepage (`logoWall.visible: false` in
       site/global.json) until real organisations are confirmed for each
       category — see site/global.json's `logoWall` and docs/editing.md.
       Deliberately NOT falling back to the old flat `partners` list here:
       that list mixes funders, media and collaborators under one
       unlabeled "Partners" heading with no per-organisation confirmation
       of which group each belongs to, which is exactly what this section
       is meant to stop doing. Flipping `visible` to true (once
       `logoWall.groups` is populated) is the only thing needed to bring
       this section back. */
    logoWall?.visible && (
      <PartnerTiers eyebrow="Who we build with" title="Partners" groups={logoWall.groups} />
    )
  }

  {page.caseTeaser && <CaseGrid items={[page.caseTeaser]} />}

  {
    /* Brand marquee (ODDfest/ODDference/ODDspace banner) is off here — those
       three names are already the "What we do" cards a few sections above;
       see Aftermovie.astro's `showBrandMarquee` comment. */
  }
  <Aftermovie
    poster={page.aftermovie.poster}
    video={page.aftermovie.video}
    showBrandMarquee={false}
  />

  <ParticipateBand title="The way in is by participation." items={page.participate} />
</Layout>

<style>
  .whatoddis-wrap {
    position: relative;
  }
  .whatoddis-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin: 1.8rem auto 0;
    position: relative;
  }
  /* 2026-08-31 revision: "What ODD is" reads as the homepage's own second
     hero moment (it's the first real statement after the mosaic), so its
     scale now matches HeroCentered's h1 — the same opening move About makes
     with its own "About ODD" hero — instead of the smaller
     --text-heading-md this used to be scoped down to (a decision from the
     2026-08-30 revision that read as undersized/secondary against the
     bigger single-paragraph intro sections on other pages). --text-display-lg
     is the closest existing token to HeroCentered's own literal
     clamp(2.2rem, 5.5vw, 4rem) h1 size — reused rather than hand-rolling a
     near-duplicate value, per the tokens-first rule. */
  .whatoddis-wrap :global(.section-intro-inner h2),
  .whatoddis-wrap :global(.section-intro-inner .section-intro-warping-headline) {
    font: var(--text-display-lg);
  }
  /* HeroCentered's eyebrow reads brighter (--color-paper-80) than
     SectionIntro's shared default (--color-paper-60) — matched here for the
     same "second hero" alignment as the headline above. */
  .whatoddis-wrap :global(.section-intro-inner .eyebrow) {
    color: var(--color-paper-80);
  }
  /* "What we do" (ProgramGrid, #four) now sits directly under the "Why ODD"
     hero moment above and directly over the quiet "Work with ODD" band below
     it (2026-09-02 copywriting pass — platforms MOVEd earlier). Trimmed
     bottom padding keeps the band tight against the grid it belongs to,
     rather than stacking a full section gap in between. */
  :global(#four) {
    padding-bottom: var(--space-12);
  }
  @media (max-width: 640px) {
    :global(#four) {
      padding-bottom: var(--space-8);
    }
  }

  /* "Work with ODD" quiet pathway band — one slim row, deliberately far
     quieter than the three photo cards above it: a plain bordered strip with
     a text pair and a link, not a card, not a photo, not its own headed
     section. */
  .wwo-band {
    margin-top: 1px;
  }

  /* "Already in motion" proof module — a SectionIntro (eyebrow/headline/
     body/cta) directly above a bare ProofGrid stat row. Both render as full
     default-padded <section>s on their own (see layout.css), which stacks a
     12rem gap between the closing line and the numbers backing it up —
     trimmed here so the two read as one connected passage. */
  .home-proof :global(.section-intro) {
    padding-bottom: var(--space-6);
  }
  .home-proof :global(.proof-section) {
    padding-top: 0;
  }
  @media (max-width: 640px) {
    .home-proof :global(.section-intro) {
      padding-bottom: var(--space-4);
    }
  }

  /* Ties "Featured in" visually to "Who ODD is for" above it without
     collapsing the gap to zero — enough air to read as its own line of
     proof, not a new chapter. */
  :global(.converge + .logo-strip-section.is-compact) {
    padding-top: var(--space-6);
  }
  .wwo-band-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 1.6rem var(--gutter-wide);
    background: var(--color-backstage);
    border: 1px solid var(--color-paper-12);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--duration-fast) ease;
  }
  .wwo-band-link:hover {
    border-color: var(--color-paper-40);
  }
  .wwo-band-text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
  }
  .wwo-band-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.15rem;
    color: var(--color-paper);
  }
  .wwo-band-body {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-paper-60);
  }
  .wwo-band-go {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-paper-80);
  }
  @media (max-width: 640px) {
    .wwo-band-link {
      padding: 1.4rem var(--gutter);
    }
  }
</style>
