---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import PricingGrid from '../components/sections/PricingGrid.astro';
import ParticipateBand from '../components/sections/ParticipateBand.astro';

const entry = await getEntry('pages', 'membership');
if (!entry || entry.data._template !== 'membership')
  throw new Error('membership.json content entry missing or malformed');
const page = entry.data;
---

<Layout title={page.seo.title} description={page.seo.description} ogImage={page.seo.ogImage}>
  <PageIntro
    eyebrow={page.eyebrow}
    title={page.title}
    intro={page.intro}
    primaryCta={{ label: page.finalCta.title, href: page.finalCta.href }}
    warpTitle
  />

  <!-- NEW SECTION (2026-09-02 copywriting pass) — "Why this exists":
       explains the need for year-round continuity without promising
       benefits that are not yet designed. -->
  <SectionIntro
    eyebrow={page.whyThisExists.eyebrow}
    headline={page.whyThisExists.headline}
    body={page.whyThisExists.body}
  />

  <!-- "What we are shaping" — SIMPLIFIED (2026-09-02 copywriting pass) from
       a "what it is" intro + a three-card audience list + a three-card
       benefit grid down to one deliberately small paragraph. The doc is
       explicit that this page should stay small until the offer, cadence,
       tiers and annual price are actually approved — see
       content.config.ts's comment on `whatWeAreShaping`. No generic
       team-photo PhotoBreak either — it wasn't actual ODDnetwork proof,
       just a stock backstage shot. -->
  <SectionIntro
    eyebrow={page.whatWeAreShaping.eyebrow}
    headline={page.whatWeAreShaping.headline}
    body={page.whatWeAreShaping.body}
    cta={page.whatWeAreShaping.cta}
  />

  {
    page.tiers && page.tiers.length > 0 && (
      <section class="mem-sub">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Options</span>
            <h2>Membership tiers</h2>
          </div>
          <PricingGrid items={page.tiers} />
        </div>
      </section>
    )
  }

  <ParticipateBand items={[page.finalCta]} noPadTop />
</Layout>

<style>
  .mem-sub {
    padding: var(--space-24) 0;
  }
</style>
