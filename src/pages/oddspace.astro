---
// Rebuilt 2026-08-30 around ODDspace's two real conversion goals — become a
// member, organise an event — instead of one section per fact. See
// content.config.ts's oddspace extend block for the full field-by-field
// reasoning behind what changed. Section numbers below match the brief's
// nine-section structure.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SubpageFrame from '../components/sections/SubpageFrame.astro';
import SpaceHero from '../components/sections/SpaceHero.astro';
import SpaceShowcase from '../components/sections/SpaceShowcase.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import ProofGrid from '../components/sections/ProofGrid.astro';
import PricingGrid from '../components/sections/PricingGrid.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import FAQList from '../components/sections/FAQList.astro';
import PhotoBreak from '../components/sections/PhotoBreak.astro';
import Pill from '../components/primitives/Pill.astro';
import oddspaceWordmark from '../assets/logos/oddspace-wordmark.svg';
import photoCommunity from '../assets/oddspace/lounge.jpg';
import photoVision from '../assets/oddspace/exterior-building.jpg';

const entry = await getEntry('pages', 'oddspace');
if (!entry || entry.data._template !== 'oddspace')
  throw new Error('oddspace.json content entry missing or malformed');
const page = entry.data;
---

<Layout
  title={page.seo.title}
  description={page.seo.description}
  ogImage={page.seo.ogImage}
  theme="light"
>
  <SubpageFrame slug={page._slug} railLeft={page.railLeft} railRight={page.railRight}>
    <!-- 1. Hero: the space itself, shown through its own photography, with
         both conversion CTAs up front. -->
    <SpaceHero
      photos={page.heroPhotos}
      title={page.title}
      meta={page.meta}
      logo={oddspaceWordmark}
      logoAlt="ODDspace"
      primaryCta={page.primaryCta}
      secondaryCta={page.secondaryCta}
    />

    <!-- 2. What is ODDspace: one concrete explainer, plus the short human/
         practical line (page.intro) directly under it. -->
    <SectionIntro
      eyebrow={page.whatItIs.eyebrow}
      headline={page.whatItIs.headline}
      body={page.whatItIs.body}
    />
    <p class="odds-intro-line reveal">{page.intro}</p>

    <!-- 3. What the space offers, and how it works — ONE coherent chapter
         (not three stacked sections): the real spaces, membership, event
         use and joining all read as internal zones of a single practical
         product section instead of four separate page chapters. -->
    <section class="odds-sub odds-offer">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">What's here</span>
          <h2>What the space offers — and how it works.</h2>
        </div>

        <div class="odds-offer-zone">
          <div class="odds-zone-head">
            <span class="eyebrow">The spaces</span>
            <h3>Four rooms, one roof.</h3>
          </div>
          <SpaceShowcase spaces={page.spaces} />
        </div>

        <div class="odds-offer-zone">
          <div class="odds-zone-head">
            <span class="eyebrow">Membership</span>
            <h3>One membership, full access.</h3>
          </div>
          <PricingGrid items={[page.membership]} />
          <div class="odds-how">
            <span class="odds-how-label">Joining</span>
            <FeatureGrid cards={page.howItWorks} />
          </div>
        </div>

        <div class="odds-offer-zone">
          <div class="odds-zone-head">
            <span class="eyebrow">Event use</span>
            <h3>Renting the space doesn't require membership.</h3>
          </div>
          <div class="odds-rates-list reveal">
            {
              page.rentalRates.map((r) => (
                <div class="odds-rate-row">
                  <span class="odds-rate-name">{r.name}</span>
                  <span class="odds-rate-price">{r.price}</span>
                  {r.note && <span class="odds-rate-note">{r.note}</span>}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- 4. ODDspace pilot in numbers. -->
    <ProofGrid eyebrow={page.proof.eyebrow} title={page.proof.title} items={page.proof.items} />

    <!-- 5. Who's it for. -->
    <SectionIntro
      eyebrow={page.community.eyebrow}
      headline={page.community.headline}
      body={page.community.body}
    />
    <PhotoBreak image={photoCommunity} alt="A co-working lounge area at ODDspace" />

    <!-- 6. Enter the space — the main conversion section: two equal
         pathways, membership and event enquiry. -->
    <section class="odds-sub odds-enter">
      <div class="wrap">
        <div class="section-head">
          <h2>Enter the space</h2>
        </div>
        <div class="odds-enter-grid reveal">
          <div class="odds-enter-card">
            <span class="eyebrow">Work here</span>
            <h3>Become a member</h3>
            <p>
              Work from ODDspace, use the shared facilities and become part of the people already
              shaping the place.
            </p>
            <div class="odds-enter-price">{page.membership.price}</div>
            <ul>
              {page.membership.benefits.slice(0, 3).map((b) => <li>{b}</li>)}
            </ul>
            <Pill href={page.membership.href} variant="solid" magnetic>
              {page.membership.ctaLabel}
            </Pill>
          </div>
          <div class="odds-enter-card">
            <span class="eyebrow">Use the space</span>
            <h3>{page.eventEnquiry.headline}</h3>
            <p>{page.eventEnquiry.body}</p>
            <Pill href={page.eventEnquiry.cta.href} variant="outline" magnetic>
              {page.eventEnquiry.cta.label}
            </Pill>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. Why ODDspace, and the grand vision — only here. -->
    <SectionIntro
      eyebrow={page.vision.eyebrow}
      headline={page.vision.headline}
      body={page.vision.body}
    />
    <PhotoBreak image={photoVision} alt="The industrial Vallila building that houses ODDspace" />

    <!-- 8. Event calendar. -->
    {
      page.calendar && (
        <section class="odds-sub">
          <div class="wrap">
            <div class="section-head">
              <span class="eyebrow">{page.calendar.eyebrow}</span>
              <h2>{page.calendar.title}</h2>
            </div>
            {page.calendar.note && <p class="odds-calendar-note reveal">{page.calendar.note}</p>}
            <div class="odds-calendar-embed reveal">
              <iframe
                src={page.calendar.embedUrl}
                title="ODDspace events calendar"
                loading="lazy"
              />
            </div>
          </div>
        </section>
      )
    }

    <!-- 9. FAQ. -->
    <section class="odds-sub">
      <div class="wrap">
        <div class="section-head">
          <h2>Practical / FAQ</h2>
        </div>
        <FAQList items={page.faq} />
      </div>
    </section>
  </SubpageFrame>
</Layout>

<style>
  .odds-sub {
    padding: var(--space-24) 0;
  }
  .odds-intro-line {
    max-width: 40rem;
    margin: -2rem auto var(--space-24);
    padding: 0 1.5rem;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.8;
    color: var(--color-paper-80);
  }
  /* One "What the space offers" chapter, three internal zones — a shared
     top section-head (h2) for the chapter, then each zone gets a smaller
     h3 sub-head instead of repeating the full section-head treatment,
     so this genuinely reads as one continuous chapter while scrolling,
     not three sections with the spacing tightened between them. */
  .odds-offer-zone + .odds-offer-zone {
    margin-top: var(--space-20);
    padding-top: var(--space-20);
    border-top: 1px solid var(--color-paper-12);
  }
  .odds-zone-head {
    text-align: center;
    margin-bottom: 2.2rem;
  }
  .odds-zone-head h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    color: var(--color-paper);
    margin: 0.5rem 0 0;
  }
  .odds-how {
    margin-top: 3rem;
  }
  .odds-how-label {
    display: block;
    text-align: center;
    font: var(--text-utility);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-paper-40);
    margin-bottom: 1.4rem;
  }
  .odds-rates-list {
    max-width: 40rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }
  .odds-rate-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.4rem 1.5rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--color-paper-12);
  }
  .odds-rates-list .odds-rate-row:last-child {
    border-bottom: 1px solid var(--color-paper-12);
  }
  .odds-rate-name {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-paper-80);
  }
  .odds-rate-price {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.2rem;
    color: var(--color-paper);
    font-variant-numeric: tabular-nums;
  }
  .odds-rate-note {
    grid-column: 1 / -1;
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--color-paper-40);
  }

  .odds-enter-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-paper-12);
  }
  .odds-enter-card {
    background: var(--color-backstage);
    padding: 2.6rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .odds-enter-card .eyebrow {
    color: var(--color-paper-60);
  }
  .odds-enter-card h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    color: var(--color-paper);
    margin: 0.7rem 0 0;
  }
  .odds-enter-card p {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-paper-60);
    margin: 1rem 0 0;
  }
  .odds-enter-price {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    color: var(--color-paper);
    margin-top: 1.2rem;
  }
  .odds-enter-card ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .odds-enter-card li {
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--color-paper-60);
    padding-left: 1rem;
    position: relative;
  }
  .odds-enter-card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-paper-40);
  }
  .odds-enter-card :global(.pill) {
    margin-top: 1.8rem;
  }
  @media (max-width: 760px) {
    .odds-enter-grid {
      grid-template-columns: 1fr;
    }
    .odds-enter-card {
      padding: 2rem 1.6rem;
    }
  }

  .odds-calendar-note {
    max-width: 42rem;
    margin: -1.5rem auto 2rem;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-paper-60);
  }
  .odds-calendar-embed {
    max-width: 56rem;
    margin: 0 auto;
    border: 1px solid var(--color-paper-12);
    /* Fixed, not var(--color-paper) — Google's calendar embed renders on a
       white surface regardless of page theme, so the frame around it should
       stay light too rather than following ODDspace's own light/dark swap. */
    background: var(--swatch-paper);
  }
  .odds-calendar-embed iframe {
    display: block;
    width: 100%;
    height: min(70vh, 620px);
    border: 0;
  }
</style>
