---
// Rebuilt 2026-08-30 around ODDspace's two real conversion goals — become a
// member, organise an event — instead of one section per fact.
//
// Cut back to seven sections on 2026-09-11 at Ronny's direct request:
//
//   1 hero · 2 what is ODDspace · 3 what's here · 4 enter the space ·
//   5 the bigger picture · 6 what's happening · 7 FAQ
//
// What went, and why it isn't "hidden for later": "Co-creative, not just
// coworking", "Who it's for" and "The network is bigger than the room" were
// three further prose sections restating what `whatItIs` and `vision`
// already say, so a reader had to get through five essays to reach a price.
// `proof` had been rendering nothing since 2026-09-02 (no verified figures).
// The Google Calendar embed is replaced by `events` — see section 6.
//
// The two things that didn't just move: every card in section 3 now carries
// its own CTA (a reader who has just decided they want the auditorium
// shouldn't have to scroll back to a generic button), and all the
// commercial detail — price, benefits, the studio carve-out, rental rates,
// joining steps, address — is consolidated into section 4 instead of being
// split between a pricing grid up in section 3 and a conversion block
// further down. See content.config.ts's oddspace extend block for the
// field-level record.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SubpageFrame from '../components/sections/SubpageFrame.astro';
import SpaceHero from '../components/sections/SpaceHero.astro';
import SpaceShowcase from '../components/sections/SpaceShowcase.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import ProgrammeList from '../components/sections/ProgrammeList.astro';
import FAQList from '../components/sections/FAQList.astro';
import InstagramGallery from '../components/sections/InstagramGallery.astro';
import { ODDSPACE_INSTAGRAM_FEED_ID } from '../scripts/oddspace-instagram-config';
import PhotoBreak from '../components/sections/PhotoBreak.astro';
import Pill from '../components/primitives/Pill.astro';
import oddspaceWordmark from '../assets/logos/oddspace-wordmark.svg';
import photoVision from '../assets/oddspace/exterior-building.jpg';

const entry = await getEntry('pages', 'oddspace');
if (!entry || entry.data._template !== 'oddspace')
  throw new Error('oddspace.json content entry missing or malformed');
const page = entry.data;
---

<Layout
  title={page.seo.title}
  description={page.seo.description}
  ogImage={page.seo.ogImage}
  theme="light"
>
  <SubpageFrame slug={page._slug} railLeft={page.railLeft} railRight={page.railRight}>
    <!-- 1. Hero: the space itself, shown through its own photography, with
         both conversion CTAs up front. -->
    <SpaceHero
      slot="hero"
      photos={page.heroPhotos}
      title={page.title}
      meta={page.meta}
      logo={oddspaceWordmark}
      logoAlt="ODDspace"
      primaryCta={page.primaryCta}
      secondaryCta={page.secondaryCta}
    />

    <!-- 2. What is ODDspace: one concrete explainer, plus the short human/
         practical line (page.intro) directly under it. -->
    <SectionIntro
      eyebrow={page.whatItIs.eyebrow}
      headline={page.whatItIs.headline}
      body={page.whatItIs.body}
    />
    <p class="odds-intro-line reveal">{page.intro}</p>

    <!-- 3. What's here — the four real rooms, each routing to the enquiry
         for that room (or, for ODDstudio, to its own page). -->
    <section class="odds-sub">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">What's here</span>
          <h2>Four rooms, one roof.</h2>
        </div>
        <SpaceShowcase spaces={page.spaces} />
      </div>
    </section>

    <!-- 4. Enter the space — the page's conversion chapter, and now the only
         place prices appear: the two ways in side by side, the one carve-out
         from the membership, what joining involves, and where to turn up. -->
    <section class="odds-sub odds-enter">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Two ways in</span>
          <h2>Enter the space</h2>
        </div>
        <div class="odds-enter-grid reveal">
          <div class="odds-enter-card">
            <span class="eyebrow">Work here</span>
            <h3>Become a member</h3>
            <p>
              Work from ODDspace, use the shared facilities and become part of the people already
              shaping the place.
            </p>
            <div class="odds-enter-price">{page.membership.price}</div>
            <span class="odds-enter-status">{page.membership.status}</span>
            <ul>
              {page.membership.benefits.map((b) => <li>{b}</li>)}
            </ul>
            <div class="odds-enter-action">
              <Pill href={page.membership.href} variant="solid" magnetic>
                {page.membership.ctaLabel}
              </Pill>
            </div>
          </div>
          <div class="odds-enter-card">
            <span class="eyebrow">Use the space</span>
            <h3>{page.eventEnquiry.headline}</h3>
            <p>{page.eventEnquiry.body}</p>
            {
              /* The rates sit in the card whose button acts on them — a
                 reader deciding whether to enquire about an event is the
                 only reader these numbers are for. */
            }
            <span class="odds-rates-label">Selected member rates</span>
            <div class="odds-rates-list">
              {
                page.rentalRates.map((r) => (
                  <div class="odds-rate-row">
                    <span class="odds-rate-name">{r.name}</span>
                    <span class="odds-rate-price">{r.price}</span>
                    {r.note && <span class="odds-rate-note">{r.note}</span>}
                  </div>
                ))
              }
            </div>
            <p class="odds-rates-nonmember">Non-member pricing: ask us about your event.</p>
            <div class="odds-enter-action">
              <Pill href={page.eventEnquiry.cta.href} variant="outline" magnetic>
                {page.eventEnquiry.cta.label}
              </Pill>
            </div>
          </div>
        </div>

        {
          /* The one carve-out from "one membership, full access" — directly
            under the price it qualifies, because a member who learns this
            later learns it from an invoice. See content.config.ts's
            `studioCallout` and tests/functional/oddstudio.spec.ts. */
        }
        <aside class="odds-studio-callout reveal">
          <span class="eyebrow">{page.studioCallout.eyebrow}</span>
          <h4>{page.studioCallout.headline}</h4>
          <p>{page.studioCallout.body}</p>
          <Pill href={page.studioCallout.cta.href} variant="outline" magnetic>
            {page.studioCallout.cta.label}
          </Pill>
        </aside>

        <div class="odds-how">
          <span class="odds-how-label">Joining</span>
          <FeatureGrid cards={page.howItWorks} />
        </div>

        <p class="odds-visit reveal">
          {page.visit.address} —{' '}
          <a href={page.visit.directionsUrl} target="_blank" rel="noreferrer"> Get directions → </a>
        </p>
      </div>
    </section>

    <!-- 5. The bigger picture — why ODDspace exists at all. Only here. -->
    <SectionIntro
      eyebrow={page.vision.eyebrow}
      headline={page.vision.headline}
      body={page.vision.body}
    />
    <PhotoBreak image={photoVision} alt="The industrial Vallila building that houses ODDspace" />

    <!-- 6. What's happening — a hand-kept list of the things a stranger can
         actually turn up to, replacing the consent-gated Google Calendar
         embed (2026-09-11). Reuses ProgrammeList, the same component
         ODDfest's programme uses. Only public, confirmed things go in;
         private bookings stay on the internal calendar. -->
    {
      page.events && page.events.items.length > 0 && (
        <section class="odds-sub">
          <div class="wrap">
            <div class="section-head">
              <span class="eyebrow">{page.events.eyebrow}</span>
              <h2>{page.events.title}</h2>
            </div>
            {page.events.note && <p class="odds-events-note reveal">{page.events.note}</p>}
            <ProgrammeList items={page.events.items} />
            {page.events.cta && (
              <div class="odds-events-cta reveal">
                <Pill href={page.events.cta.href} variant="outline" magnetic>
                  {page.events.cta.label}
                </Pill>
              </div>
            )}
          </div>
        </section>
      )
    }

    {
      /* The live @oddspace.co Instagram wall — the visual half of the same
         "what is happening here" chapter. Rendered only when a Behold feed
         is actually connected (PUBLIC_ODDSPACE_INSTAGRAM_FEED_ID): an
         unconfigured build ships no empty gallery, no skeleton and no dead
         section, which is why it is invisible in production today. See
         src/scripts/oddspace-instagram-config.ts. */
    }
    {
      page.instagram && ODDSPACE_INSTAGRAM_FEED_ID && (
        <InstagramGallery
          eyebrow={page.instagram.eyebrow}
          headline={page.instagram.headline}
          ctaLabel={page.instagram.ctaLabel}
        />
      )
    }

    <!-- 7. FAQ. -->
    <section class="odds-sub">
      <div class="wrap">
        <div class="section-head">
          <h2>Practical / FAQ</h2>
        </div>
        <FAQList items={page.faq} />
      </div>
    </section>
  </SubpageFrame>
</Layout>

<style>
  .odds-sub {
    padding: var(--space-24) 0;
  }
  /* Mobile rhythm. 6rem top+bottom is tuned for a desktop column; stacked on
     a phone it puts ~192px of empty screen between two sections (measured
     across /work-with-odd, /oddference, /oddspace, /about and /media). Halved
     to match layout.css's own `section` reduction at the same breakpoint, so
     page-level and component-level sections stay on one rhythm — see that
     file's comment, which flags exactly this class of override. */
  @media (max-width: 640px) {
    .odds-sub {
      padding: var(--space-12) 0;
    }
  }
  .odds-intro-line {
    max-width: var(--measure-prose);
    margin: -2rem auto var(--space-24);
    padding: 0 1.5rem;
    text-align: center;
    font: var(--text-body);
    color: var(--color-paper-80);
  }

  /* "Enter the space" — two equal ways in, then the carve-out, the joining
     steps and the address, in that order. */
  .odds-enter-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-paper-12);
  }
  .odds-enter-card {
    background: var(--color-backstage);
    padding: 2.6rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .odds-enter-card .eyebrow {
    color: var(--color-paper-60);
  }
  .odds-enter-card h3 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: 0.7rem 0 0;
  }
  .odds-enter-card p {
    font: var(--text-body);
    color: var(--color-paper-60);
    margin: 1rem 0 0;
  }
  /* The CTA wrapper, not the Pill itself, carries the spacing: `auto` pushes
     each card's button to the bottom so the two line up with each other
     however unevenly the copy above them falls, and the padding keeps a real
     gap above it when a card is full enough that `auto` resolves to zero. */
  .odds-enter-action {
    margin-top: auto;
    padding-top: 1.8rem;
  }
  .odds-enter-price {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin-top: 1.2rem;
  }
  .odds-enter-status {
    font: var(--text-small);
    color: var(--color-paper-40);
    margin-top: 0.3rem;
  }
  .odds-enter-card ul {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .odds-enter-card li {
    font: var(--text-body);
    color: var(--color-paper-60);
    padding-left: 1rem;
    position: relative;
  }
  .odds-enter-card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-paper-40);
  }
  @media (max-width: 760px) {
    .odds-enter-grid {
      grid-template-columns: 1fr;
    }
    .odds-enter-card {
      padding: 2rem 1.6rem;
    }
  }

  /* Rates, inside the event card (they moved there on 2026-09-11 — see the
     markup comment). Full-width of the card, so the price column still
     lines up against the right edge the way a price list should. */
  .odds-rates-label {
    display: block;
    align-self: stretch;
    margin: 1.6rem 0 0.8rem;
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-40);
  }
  .odds-rates-list {
    align-self: stretch;
    display: flex;
    flex-direction: column;
  }
  .odds-rate-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.4rem 1.5rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--color-paper-12);
  }
  .odds-rates-list .odds-rate-row:last-child {
    border-bottom: 1px solid var(--color-paper-12);
  }
  .odds-rate-name {
    font: var(--text-body);
    color: var(--color-paper-80);
  }
  /* Forta at the Body size: a figure in a price list, set against the name
     beside it — not a card title. */
  .odds-rate-price {
    font-family: var(--font-display);
    font-size: var(--font-size-body);
    color: var(--color-paper);
    font-variant-numeric: tabular-nums;
  }
  .odds-rate-note {
    grid-column: 1 / -1;
    font: var(--text-small);
    color: var(--color-paper-40);
  }
  .odds-rates-nonmember {
    font-size: var(--font-size-small) !important;
    line-height: var(--line-height-small) !important;
    color: var(--color-paper-40) !important;
    margin-top: 0.9rem !important;
  }

  /* Bordered, not a filled card: this qualifies the membership price above
     it, so it should read as an annotation attached to that block rather
     than a third competing offer. */
  .odds-studio-callout {
    max-width: 44rem;
    margin: var(--space-12) auto 0;
    padding: 1.6rem 1.8rem 1.8rem;
    border: 1px solid var(--color-paper-20);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .odds-studio-callout h4 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: 0.5rem 0 0;
  }
  .odds-studio-callout p {
    font: var(--text-body);
    color: var(--color-paper-60);
    margin: 0.8rem 0 0;
    max-width: var(--measure-prose);
  }
  .odds-studio-callout :global(.pill) {
    margin-top: 1.4rem;
  }
  @media (max-width: 640px) {
    .odds-studio-callout {
      padding: 1.3rem 1.1rem 1.5rem;
    }
  }

  .odds-how {
    margin-top: var(--space-12);
  }
  .odds-how-label {
    display: block;
    text-align: center;
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-40);
    margin-bottom: 1.4rem;
  }

  .odds-visit {
    margin: var(--space-8) 0 0;
    text-align: center;
    font: var(--text-small);
    color: var(--color-paper-60);
  }
  .odds-visit a {
    color: var(--color-paper-80);
    text-decoration: underline;
    text-decoration-color: var(--color-paper-20);
    text-underline-offset: 3px;
  }
  .odds-visit a:hover {
    color: var(--color-amber-bright);
    text-decoration-color: var(--color-amber-bright);
  }

  /* "What's happening" — the note above the list, and the one CTA under it. */
  .odds-events-note {
    max-width: var(--measure-prose);
    margin: -1.5rem auto 2.4rem;
    text-align: center;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  .odds-events-cta {
    display: flex;
    justify-content: center;
    margin-top: 2.4rem;
  }
</style>
