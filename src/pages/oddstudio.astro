---
// ODDstudio (2026-09-11) — the recording/production room inside ODDspace,
// run with TUNEMENT. See content.config.ts's oddstudio extend block for why
// this is its own route rather than a longer section on /oddspace.
//
// Section order is deliberately commercial, not descriptive: what the room
// is, what's in it, then — before any rules or terms — the one fact a
// prospective member most needs and is least likely to guess, which is that
// the studio is not covered by the €150 ODDspace membership.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SubpageFrame from '../components/sections/SubpageFrame.astro';
import SpaceHero from '../components/sections/SpaceHero.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import SpaceShowcase from '../components/sections/SpaceShowcase.astro';
import PricingGrid from '../components/sections/PricingGrid.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import FAQList from '../components/sections/FAQList.astro';
import PhotoBreak from '../components/sections/PhotoBreak.astro';
import Pill from '../components/primitives/Pill.astro';
import { Image } from 'astro:assets';

const entry = await getEntry('pages', 'oddstudio');
if (!entry || entry.data._template !== 'oddstudio')
  throw new Error('oddstudio.json content entry missing or malformed');
const page = entry.data;
---

<Layout
  title={page.seo.title}
  description={page.seo.description}
  ogImage={page.seo.ogImage}
  theme="light"
>
  <SubpageFrame slug={page._slug} railLeft={page.railLeft} railRight={page.railRight}>
    <SpaceHero
      slot="hero"
      photos={page.heroPhotos}
      title={page.title}
      meta={page.meta}
      primaryCta={page.primaryCta}
      secondaryCta={page.secondaryCta}
    />

    <!-- 1. What the room is. -->
    <SectionIntro
      eyebrow={page.whatItIs.eyebrow}
      headline={page.whatItIs.headline}
      body={page.whatItIs.body}
    />
    <p class="odst-intro-line reveal">{page.intro}</p>

    <!-- 2. What's in it — the same SpaceShowcase component /oddspace uses
         for its four rooms, here carrying the four equipment groups. -->
    <section class="odst-sub">
      <div class="wrap flow">
        <div class="section-head">
          <span class="eyebrow">What's in the room</span>
          <h2>Properly equipped, not over-equipped.</h2>
        </div>
        <SpaceShowcase spaces={page.kit} />
      </div>
    </section>

    <!-- 3. Access and pricing. The whole reason this page exists is the
         first paragraph of this section — see the route comment above. -->
    <section class="odst-sub odst-access">
      <div class="wrap flow">
        <div class="section-head">
          <span class="eyebrow">{page.access.eyebrow}</span>
          <h2>{page.access.headline}</h2>
        </div>
        <p class="odst-access-body reveal" data-studio-not-included>{page.access.body}</p>

        <div class="odst-access-zone flow">
          <div class="odst-zone-head">
            {
              /* Not "Full studio membership" — that is the pricing card's own
                name directly below, and the two stacked read as a stutter. */
            }
            <span class="eyebrow">Every month</span>
            <h3>Add the studio to your membership.</h3>
          </div>
          <PricingGrid items={[page.membership]} />
        </div>

        <div class="odst-access-zone flow">
          <div class="odst-zone-head">
            <span class="eyebrow">By the hour</span>
            <h3>Or book it when you need it.</h3>
          </div>

          <!-- Two separate tables, not one list with a qualifier column —
               see content.config.ts on why member and non-member rates are
               kept visually apart. -->
          <div class="odst-rates">
            <div class="odst-rate-table">
              <span class="odst-rates-label">ODDspace members</span>
              <div class="odst-rates-list reveal">
                {
                  page.memberRates.map((r) => (
                    <div class="odst-rate-row">
                      <span class="odst-rate-name">{r.name}</span>
                      <span class="odst-rate-price">{r.price}</span>
                      {r.note && <span class="odst-rate-note">{r.note}</span>}
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="odst-rate-table">
              <span class="odst-rates-label">Without a membership</span>
              <div class="odst-rates-list reveal">
                {
                  page.publicRates.map((r) => (
                    <div class="odst-rate-row">
                      <span class="odst-rate-name">{r.name}</span>
                      <span class="odst-rate-price">{r.price}</span>
                      {r.note && <span class="odst-rate-note">{r.note}</span>}
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
          <p class="odst-rates-note reveal">{page.ratesNote}</p>
          <div class="odst-access-cta reveal">
            <Pill href={page.primaryCta.href} variant="solid" magnetic>
              {page.primaryCta.label}
            </Pill>
          </div>
        </div>
      </div>
    </section>

    <PhotoBreak image={page.heroPhotos[0].image} alt="The ODDstudio room set up for a session" />

    <!-- 4. How a booking actually works. -->
    <section class="odst-sub">
      <div class="wrap flow">
        <div class="section-head">
          <span class="eyebrow">Booking</span>
          <h2>How it works.</h2>
        </div>
        <FeatureGrid cards={page.howItWorks} />
      </div>
    </section>

    <!-- 5. House rules — a plain list, not an accordion: these are short,
         all five matter, and nobody should have to open anything to read a
         rule they're being asked to follow. -->
    <section class="odst-sub odst-rules">
      <div class="wrap flow">
        <div class="section-head">
          <span class="eyebrow">{page.houseRules.eyebrow}</span>
          <h2>{page.houseRules.headline}</h2>
        </div>
        <ul class="odst-rules-list reveal">
          {page.houseRules.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <!-- 6. Who runs it. TUNEMENT is a real third party — this section is
         what stops the page reading as though ODD takes the bookings. -->
    <section class="odst-sub odst-operator">
      <div class="wrap">
        <div class="odst-operator-grid reveal">
          {
            page.operator.image && (
              <div class="odst-operator-photo">
                <Image
                  src={page.operator.image}
                  alt={page.operator.imageAlt ?? ''}
                  width={900}
                  densities={[1, 2]}
                />
              </div>
            )
          }
          <div class="odst-operator-copy">
            <span class="eyebrow">{page.operator.eyebrow}</span>
            <h2>{page.operator.headline}</h2>
            <p>{page.operator.body}</p>
            {
              /* No `target` — this is a mailto:, which should hand off to the
                visitor's mail client in place, not open a blank tab. */
            }
            <Pill href={page.operator.cta.href} variant="outline" magnetic>
              {page.operator.cta.label}
            </Pill>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. Individual booking terms. -->
    <section class="odst-sub">
      <div class="wrap flow">
        <div class="section-head">
          <span class="eyebrow">The small print</span>
          <h2>Individual booking terms.</h2>
        </div>
        <FAQList items={page.terms} />
        {
          page.operator.privacyPolicy && (
            <p class="odst-terms-note reveal">
              Booking data is handled by TUNEMENT —{' '}
              <a href={page.operator.privacyPolicy.href} target="_blank" rel="noreferrer noopener">
                {page.operator.privacyPolicy.label} →
              </a>
            </p>
          )
        }
        {page.photoCredit && <p class="odst-credit reveal">{page.photoCredit}</p>}
      </div>
    </section>
  </SubpageFrame>
</Layout>

<style>
  /* A stray line between two sections that belongs to the SectionIntro
     above: that section's bottom half-gap is the step down to it, and it
     contributes the half-gap below itself (layout.css, section rhythm). */
  .odst-intro-line {
    max-width: var(--measure-prose);
    margin-inline: auto;
    margin-block: 0 calc(var(--space-section) / 2);
    padding: 0 1.5rem;
    text-align: center;
    font: var(--text-body);
    color: var(--color-paper-80);
  }

  /* The "not included in the €150" paragraph. Given more presence than
     ordinary body copy on purpose — it is the one thing on this page a
     reader cannot afford to skim past — through full-strength ink rather
     than a larger size. */
  .odst-access-body {
    max-width: var(--measure-prose);
    margin-inline: auto;
    margin-block-start: var(--space-4);
    text-align: center;
    font: var(--text-body);
    color: var(--color-paper);
  }

  /* Each zone is its own group inside the section: a group step off the
     lede, and off the zone above. The second zone's rule sits at that step,
     with a content step between the rule and its head — the .section-head
     pattern turned upside down. */
  .odst-access-zone {
    margin-block-start: var(--space-group);
  }
  .odst-access-zone + .odst-access-zone {
    padding-block-start: var(--space-content);
    border-top: 1px solid var(--color-paper-12);
  }
  .odst-zone-head {
    text-align: center;
  }
  .odst-zone-head h3 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }

  /* row-gap only matters once the tables stack: each is a labelled group,
     so a group step — --space-grid would sit the next label closer to the
     table above than to its own rows. */
  .odst-rates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-10);
    row-gap: var(--space-group);
    max-width: 46rem;
    margin-inline: auto;
  }
  /* min-width:0 on the track above is load-bearing — a grid item's default
     `min-width:auto` lets the longest rate name set the column width, which
     is the same bug that made ParticipateBand and ProofGrid size by content
     instead of evenly (2026-08-21). */
  @media (max-width: 700px) {
    .odst-rates {
      grid-template-columns: 1fr;
    }
  }
  .odst-rates-label {
    display: block;
    text-align: center;
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-40);
  }
  .odst-rates-list {
    display: flex;
    flex-direction: column;
    margin-block-start: var(--space-3);
  }
  .odst-rate-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-2) 1.2rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--color-paper-12);
  }
  .odst-rates-list .odst-rate-row:last-child {
    border-bottom: 1px solid var(--color-paper-12);
  }
  .odst-rate-name {
    font: var(--text-body);
    color: var(--color-paper-80);
  }
  /* Forta at the Body size, same as ODDspace's rate list. */
  .odst-rate-price {
    font-family: var(--font-display);
    font-size: var(--font-size-body);
    color: var(--color-paper);
    font-variant-numeric: tabular-nums;
  }
  .odst-rate-note {
    grid-column: 1 / -1;
    font: var(--text-small);
    color: var(--color-paper-40);
  }
  .odst-rates-note {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
    font: var(--text-small);
    color: var(--color-paper-40);
  }
  .odst-access-cta {
    display: flex;
    justify-content: center;
  }

  /* Block-end 0 cancels the UA list margin; the top is the wrap's flow step. */
  .odst-rules-list {
    max-width: 42rem;
    margin-inline: auto;
    margin-block-end: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .odst-rules-list li {
    max-width: var(--measure-prose);
    font: var(--text-body);
    color: var(--color-paper-80);
    padding: 1.1rem 0 1.1rem 1.6rem;
    border-top: 1px solid var(--color-paper-12);
    position: relative;
  }
  .odst-rules-list li:last-child {
    border-bottom: 1px solid var(--color-paper-12);
  }
  .odst-rules-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.75em;
    width: 5px;
    height: 5px;
    border-radius: var(--radius-pill);
    background: var(--color-paper-40);
  }

  .odst-operator-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--space-12);
    row-gap: var(--space-content);
    align-items: center;
  }
  @media (max-width: 820px) {
    .odst-operator-grid {
      /* minmax(0, 1fr): the operator's email-address pill has no break
         opportunity, and a plain 1fr track would size to its full width. */
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .odst-operator-photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .odst-operator-copy h2 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }
  .odst-operator-copy p {
    font: var(--text-body);
    color: var(--color-paper-60);
    margin: var(--space-3) 0 0;
    max-width: var(--measure-prose);
  }
  .odst-operator-copy :global(.pill) {
    margin-block-start: var(--space-6);
  }

  /* Block-end 0 cancels the UA paragraph margin, which would otherwise pad
     the last section; the top is the wrap's flow step. */
  .odst-terms-note,
  .odst-credit {
    max-width: 42rem;
    margin-inline: auto;
    margin-block-end: 0;
    text-align: center;
    font: var(--text-small);
    color: var(--color-paper-40);
  }
  /* The credit reads as the note's second line, not a new block — but only
     when the note is there; on its own it takes the flow step. */
  .odst-terms-note + .odst-credit {
    margin-block-start: var(--space-4);
  }
  .odst-terms-note a {
    color: var(--color-paper-80);
    text-decoration: underline;
    text-decoration-color: var(--color-paper-20);
    text-underline-offset: 3px;
  }
  .odst-terms-note a:hover {
    color: var(--color-heat);
    text-decoration-color: var(--color-heat);
  }
</style>
