---
// The conduct document that goes with every ODDspace booking and
// membership: what we expect, the safer space principles, and the
// reporting path. Same `legal` template as the event info pack.
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/sections/PageIntro.astro';
import LegalDocument from '../../components/sections/LegalDocument.astro';

const entry = await getEntry('pages', 'oddspace-code-of-conduct');
if (!entry || entry.data._template !== 'legal')
  throw new Error('oddspace-code-of-conduct.json content entry missing or malformed');
const page = entry.data;

const sections = page.sections.map((section) => ({
  ...section,
  items: section.items?.map((item) => (typeof item === 'string' ? item : item.text)),
}));
---

<Layout title={page.seo.title} description={page.seo.description} ogImage={page.seo.ogImage}>
  <PageIntro eyebrow={page.eyebrow} title={page.title} intro={page.intro} />
  <LegalDocument
    lastUpdated={page.lastUpdated}
    contents={page.contents}
    sections={sections}
    contact={page.contact}
  />
</Layout>
