---
// ODDspace as a venue (2026-09-11) — the "organise an event here" journey.
// Written so that someone can read it and know almost everything they need
// before asking "is 27 October free?", which is exactly how the September
// planning review put it.
//
// The one rule this page is built around: it publishes what the site can
// stand behind (member rates, the rooms, what has happened here) and names
// what it cannot (capacities, AV inventory, accessibility, load-in) as
// things we answer in an enquiry. The internal rental guide has capacities
// marked "TBD — confirm before publishing externally" and three conflicting
// price lists as of 2026-09-11; none of that is on this page. A useful sales
// page with honest gaps beats a polished one with invented specifications.
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SubpageFrame from '../../components/sections/SubpageFrame.astro';
import SpaceHero from '../../components/sections/SpaceHero.astro';
import SectionIntro from '../../components/sections/SectionIntro.astro';
import ResourceList from '../../components/sections/ResourceList.astro';
import SpaceShowcase from '../../components/sections/SpaceShowcase.astro';
import VenueRateCalculator from '../../components/sections/VenueRateCalculator.astro';
import FeatureGrid from '../../components/sections/FeatureGrid.astro';
import FAQList from '../../components/sections/FAQList.astro';
import PhotoBreak from '../../components/sections/PhotoBreak.astro';
import Pill from '../../components/primitives/Pill.astro';
import BookingEnquiryForm from '../../components/sections/BookingEnquiryForm.astro';

const entry = await getEntry('pages', 'oddspace-venue');
if (!entry || entry.data._template !== 'oddspace-venue')
  throw new Error('oddspace-venue.json content entry missing or malformed');
const page = entry.data;
---

<Layout
  title={page.seo.title}
  description={page.seo.description}
  ogImage={page.seo.ogImage}
  theme="light"
>
  <SubpageFrame slug={page._slug} railLeft={page.railLeft} railRight={page.railRight}>
    <SpaceHero
      slot="hero"
      photos={page.heroPhotos}
      title={page.title}
      meta={page.meta}
      primaryCta={page.primaryCta}
      secondaryCta={page.secondaryCta}
    />

    <!-- 1. What it's good for, then the formats themselves — a plain list of
         things that have really happened here, not a promise of what could. -->
    <SectionIntro
      eyebrow={page.whatItIs.eyebrow}
      headline={page.whatItIs.headline}
      body={page.whatItIs.body}
    />
    <p class="odsv-intro-line reveal">{page.intro}</p>

    <section class="odsv-sub odsv-types">
      <div class="wrap">
        <ul class="odsv-type-list reveal">
          {page.eventTypes.map((type) => <li>{type}</li>)}
        </ul>
      </div>
    </section>

    <!-- 2. The rooms — same SpaceShowcase component /oddspace uses. -->
    <section id="spaces" class="odsv-sub">
      <div class="wrap flow">
        <div class="section-head">
          <span class="eyebrow">{page.spacesIntro.eyebrow}</span>
          <h2>{page.spacesIntro.headline}</h2>
        </div>
        <SpaceShowcase spaces={page.spaces} />
      </div>
    </section>

    <!-- 3. Price. Until 2026-09-24 this section published the member rates
         and said everything else was quoted per event — which was the honest
         thing to say while three internal price lists disagreed with each
         other. There is one list now (Ronny's, 2026-09-24), so the page
         publishes it and lets a visitor price their own event. The
         "negotiable case by case" line under the card is not a softener: it
         is the actual policy, and it is why these are starting numbers. -->
    <section class="odsv-sub odsv-pricing">
      <div class="wrap flow">
        <div class="section-head">
          <span class="eyebrow">{page.pricing.eyebrow}</span>
          <h2>{page.pricing.headline}</h2>
        </div>
        <p class="odsv-pricing-body reveal">{page.pricing.body}</p>
        <VenueRateCalculator
          vatRate={page.rateCard.vatRate}
          lanesLabel={page.rateCard.lanesLabel}
          estimateLabel={page.rateCard.estimateLabel}
          lanes={page.rateCard.lanes}
          note={page.rateCard.note}
          cta={page.rateCard.cta}
        />
        <div class="odsv-rates reveal">
          <span class="odsv-rates-label">Booked separately</span>
          {
            page.memberRates.map((r) => (
              <div class="odsv-rate-row">
                <span class="odsv-rate-name">{r.name}</span>
                <span class="odsv-rate-price">{r.price}</span>
                {r.note && <span class="odsv-rate-note">{r.note}</span>}
              </div>
            ))
          }
        </div>
        <p class="odsv-rates-note reveal">{page.ratesNote}</p>
      </div>
    </section>

    <PhotoBreak
      image={page.heroPhotos[0].image}
      alt="The ODDspace gallery floor set up for an event"
    />

    <!-- 4. More than a room. -->
    <SectionIntro
      eyebrow={page.whatWeCanDo.eyebrow}
      headline={page.whatWeCanDo.headline}
      body={page.whatWeCanDo.body}
    />

    <!-- 5. How booking works. -->
    <section class="odsv-sub">
      <div class="wrap flow">
        <div class="section-head">
          <span class="eyebrow">Booking</span>
          <h2>How it works.</h2>
        </div>
        <FeatureGrid cards={page.howItWorks} />
      </div>
    </section>

    <!-- 6. The honest half. See the route comment: these are the specs a
         real event needs that this site cannot yet verify. Naming them as
         questions we answer is more useful to a planner than silence, and
         more truthful than a number from an unconfirmed internal draft. -->
    <section class="odsv-sub odsv-ask">
      <div class="wrap">
        <div class="odsv-ask-inner">
          <span class="eyebrow">{page.askUs.eyebrow}</span>
          <h2>{page.askUs.headline}</h2>
          <p class="odsv-ask-body reveal">{page.askUs.body}</p>
          <ul class="odsv-ask-list reveal">
            {page.askUs.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- 6b. The two documents an organiser has to read (2026-09-21).
         /oddspace/event-info-pack and /oddspace/code-of-conduct were
         reachable only by typing the URL: zero inbound links from anywhere on
         the site, while both sat in the sitemap for Google to index. This is
         the page whose readers need them, right after the list of things we
         answer in an enquiry. -->
    <section class="odsv-sub">
      <div class="wrap flow">
        <SectionIntro
          eyebrow={page.beforeYourEvent.eyebrow}
          headline={page.beforeYourEvent.headline}
          body={page.beforeYourEvent.body}
        />
        <ResourceList items={page.resources} />
      </div>
    </section>

    <!-- 7. FAQ. -->
    <section class="odsv-sub">
      <div class="wrap flow">
        <div class="section-head">
          <span class="eyebrow">Practical</span>
          <h2>Questions people actually ask.</h2>
        </div>
        <FAQList items={page.faq} />
      </div>
    </section>

    <!-- 8. The ask, and since 2026-09-23 the booking enquiry form itself.
         Event organisers used to be sent on to the generic Work with ODD
         form. That form cannot ask for get-in and get-out, spaces, alcohol
         or music after 22:00, so every quote began with an email asking for
         them. The form posts to the Growth OS Worker; see
         BookingEnquiryForm.astro. Since v2 (2026-09-24) this section holds
         its "Get a quote" button, and the questions open in a dialog, from
         here, from the hero or from the sticky bar. The button sits outside
         the `reveal` block on purpose, so it never waits on an entrance
         animation. -->
    <section class="odsv-sub odsv-final">
      <div class="wrap flow">
        <div class="odsv-final-inner reveal">
          <span class="eyebrow">{page.finalCta.eyebrow}</span>
          <h2>{page.finalCta.headline}</h2>
          <p>{page.finalCta.body}</p>
          {
            page.finalCta.cta && (
              <Pill href={page.finalCta.cta.href} variant="solid" magnetic>
                {page.finalCta.cta.label}
              </Pill>
            )
          }
        </div>
        <BookingEnquiryForm />
      </div>
    </section>
  </SubpageFrame>
</Layout>

<style>
  /* .odsv-sub takes layout.css's section rhythm; no padding of its own. */

  /* Section 1 is one group spread over three siblings: SectionIntro, this
     line, and the event-type chips. SectionIntro's bottom padding is the step
     down to the line; .odsv-types' top padding is the step from the line to
     the chips. The line itself carries no block margin. */
  .odsv-intro-line {
    max-width: var(--measure-prose);
    margin-inline: auto;
    margin-block: 0;
    padding: 0 1.5rem;
    text-align: center;
    font: var(--text-body);
    color: var(--color-paper-80);
  }

  /* Event types as a wrapping row of chips rather than a bulleted column:
     this is a scan, not a read — a visitor is looking for their own format
     in it and leaving as soon as they find it. */
  .odsv-types {
    padding-block-start: var(--space-content);
  }
  .odsv-type-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .odsv-type-list li {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-paper-12);
    border-radius: var(--radius-pill);
    font: var(--text-small);
    color: var(--color-paper-80);
  }

  /* The lede under the section head: the tighter step in place of flow. */
  .odsv-pricing-body {
    max-width: var(--measure-prose);
    margin-inline: auto;
    margin-block: var(--space-4) 0;
    text-align: center;
    font: var(--text-body);
    color: var(--color-paper-80);
  }
  .odsv-rates {
    max-width: 42rem;
    margin-inline: auto;
  }
  .odsv-rates-label {
    display: block;
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-60);
  }
  .odsv-rate-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 var(--space-6);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-paper-12);
    font: var(--text-body);
  }
  .odsv-rate-row:first-of-type {
    margin-top: var(--space-4);
  }
  .odsv-rate-row:last-of-type {
    border-bottom: 1px solid var(--color-paper-12);
  }
  .odsv-rate-name {
    color: var(--color-paper-80);
  }
  .odsv-rate-price {
    text-align: right;
  }
  .odsv-rate-note {
    grid-column: 1 / -1;
    margin-top: var(--space-2);
    font: var(--text-small);
    color: var(--color-paper-60);
  }
  /* Centred and block-end only: the top is the wrap's flow step. */
  .odsv-rates-note {
    max-width: var(--measure-prose);
    margin-inline: auto;
    margin-block-end: 0;
    text-align: center;
    font: var(--text-body);
    color: var(--color-paper-60);
  }

  .odsv-ask-inner {
    max-width: 46rem;
    margin-inline: auto;
    padding: var(--space-10);
    border: 1px solid var(--color-paper-12);
  }
  .odsv-ask-inner h2 {
    margin: var(--space-3) 0 0;
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
  }
  .odsv-ask-body {
    max-width: var(--measure-prose);
    margin: var(--space-3) 0 0;
    font: var(--text-body);
    color: var(--color-paper-80);
  }
  .odsv-ask-list {
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }
  .odsv-ask-list li {
    max-width: var(--measure-prose);
    position: relative;
    padding-left: 1.4rem;
    font: var(--text-body);
    color: var(--color-paper-80);
  }
  .odsv-ask-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.5rem;
    height: 1px;
    background: var(--color-paper-40);
  }
  @media (max-width: 640px) {
    .odsv-ask-inner {
      padding: var(--space-6);
    }
  }

  .odsv-final-inner {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }
  .odsv-final-inner h2 {
    margin: var(--space-3) 0 0;
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
  }
  /* Closing-ask step, same as ODDfest's .oddf-join and ODDagency's close. */
  .odsv-final-inner p {
    margin: var(--space-4) auto 0;
    max-width: 46ch;
    font: var(--text-body);
    color: var(--color-paper-80);
  }
  .odsv-final-inner :global(.pill) {
    margin-top: var(--space-6);
  }
</style>
