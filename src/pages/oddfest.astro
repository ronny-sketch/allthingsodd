---
// ODDfest — rebuilt 2026-09-11 at Ronny's direct request, to this order:
//
//   1 hero · 2 what is ODDfest · 3 how it works · 4 how to join · 5 FAQ
//
// What changed, and why none of it is "hidden for later":
//
// The hero carries the same composition as ODDspace's and ODDference's —
// wordmark, one short h1, meta, and two CTAs — because a visitor landing
// here had no way to act without scrolling. It keeps the aftermovie rather
// than adopting ODDspace's photo grid: the ask was for the same structure,
// not the same medium, and the film is the one asset that shows what this
// actually felt like. On 2026-09-14 it also took ODDspace's proportions
// (`frame="space"`: display-sized h1, darker scrim, larger buttons) and lost
// its eyebrow and support line — exactly the change ODDference got on
// 2026-09-11, so the three product heroes now read as one family.
//
// "You make the event. ODD builds the shared layer." and "How it works" were
// two adjacent sections making one argument — who does what, then what
// actually happens — so they are now one chapter. The "shared platform"
// sub-block inside the first one is deleted outright: it promised 2027
// programme and discovery-platform features that nobody has built or
// confirmed. See content.config.ts's `ownership` block for the field-level
// record.
//
// "Register your event" became "How to join": same job, but with a second
// way in for a reader who has no event to submit yet, and a line of
// reassurance for the one who thinks their idea is too unfinished to show.
//
// "What has happened before" — the 2025/2026/2027 timeline chapter that sat
// between How to join and the FAQ — was deleted on 2026-09-14 at Ronny's
// request, field and all. The highlights and programme names below still
// show what past editions were, and the look-back buttons under "What
// ODDfest is" still link to the 2026 archive.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SubpageFrame from '../components/sections/SubpageFrame.astro';
import FullbleedVideoHero from '../components/sections/FullbleedVideoHero.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import ProgrammeList from '../components/sections/ProgrammeList.astro';
import OddfestExamples from '../components/sections/OddfestExamples.astro';
import AudienceList from '../components/sections/AudienceList.astro';
import FAQList from '../components/sections/FAQList.astro';
import Pill from '../components/primitives/Pill.astro';
import oddfestWordmark from '../assets/logos/oddfest-wordmark.svg';

const entry = await getEntry('pages', 'oddfest');
if (!entry || entry.data._template !== 'oddfest')
  throw new Error('oddfest.json content entry missing or malformed');
const page = entry.data;
if (!page.heroMedia.video || !page.heroMedia.poster || !page.heroMedia.sub) {
  throw new Error('oddfest.json is missing required fullbleed-video hero fields');
}
---

<Layout title={page.seo.title} description={page.seo.description} ogImage={page.seo.ogImage}>
  <SubpageFrame slug={page._slug} railLeft={page.railLeft} railRight={page.railRight}>
    <!-- 1. Hero: ODDfest wordmark + a short positioning line (the page's one
         h1), meta, and Submit an event idea / Look back at 2026 right in the
         hero, over the aftermovie. `frame="space"` gives it ODDspace's and
         ODDference's proportions — see FullbleedVideoHero.astro's `frame`
         prop. The Ultraviolet accent (the component default) stays: that
         wash is ODDfest's own identity, as Signal is ODDference's. -->
    {
      /* Deliberately not passed (2026-09-14), the same cut ODDference made on
         2026-09-11: `page.eyebrow` ("ODDfest · Helsinki 2027") sat between
         the ODDfest wordmark and a meta line that already says "Helsinki ·
         2027", repeating all of it. The field stays in the content — it is
         part of the shared subpageBase shape. The support paragraph is gone
         from the content altogether (see content.config.ts), and `meta` lost
         "dates to be confirmed": the FAQ's "When is ODDfest 2027?" and How to
         join both say it, where a reader is actually asking. */
    }
    <FullbleedVideoHero
      slot="hero"
      video={page.heroMedia.video}
      poster={page.heroMedia.poster}
      sub={page.heroMedia.sub}
      meta={page.meta}
      logo={oddfestWordmark}
      logoAlt="ODDfest"
      primaryCta={page.primaryCta}
      secondaryCta={page.secondaryCta}
      frame="space"
    />

    <!-- 2. What ODDfest is — the one consolidated explainer, with the two
         ways to look back at 2026 directly under it. They belong here and
         not in the hero: 2026 is context for understanding what this is,
         not the thing being offered. -->
    <SectionIntro
      eyebrow={page.whatItIs.eyebrow}
      headline={page.whatItIs.headline}
      body={page.whatItIs.body}
    />
    <div class="oddf-lookback reveal">
      <span class="oddf-lookback-label">{page.lookBack.label}</span>
      <div class="oddf-lookback-actions">
        <Pill
          href={page.lookBack.thankYou.href}
          variant="outline"
          magnetic
          target={page.lookBack.thankYou.external ? '_blank' : undefined}
        >
          {page.lookBack.thankYou.label}
        </Pill>
        <Pill
          href={page.lookBack.oldSite.href}
          variant="outline"
          magnetic
          target={page.lookBack.oldSite.external ? '_blank' : undefined}
        >
          {page.lookBack.oldSite.label}
        </Pill>
      </div>
    </div>

    <!-- 3. How it works — one chapter, two movements: who is responsible for
         what, then the four steps that follow from it. These were separate
         adjacent sections until 2026-09-11; the "shared platform" block that
         used to sit between them is deleted, not moved. -->
    <section class="oddf-sub oddf-layer">
      <div class="wrap flow">
        <div class="section-head">
          <h2>{page.ownership.headline}</h2>
        </div>
        <div class="oddf-layer-grid reveal">
          <div class="oddf-layer-col">
            <h3>{page.ownership.host.title}</h3>
            <p>{page.ownership.host.body}</p>
          </div>
          <div class="oddf-layer-col">
            <h3>{page.ownership.odd.title}</h3>
            <p>{page.ownership.odd.body}</p>
          </div>
        </div>
        <p class="oddf-layer-closing reveal">{page.ownership.closing}</p>
        <div class="oddf-steps flow">
          <span class="oddf-steps-label">{page.ownership.stepsLabel}</span>
          <FeatureGrid cards={page.howItWorks} />
        </div>
      </div>
    </section>

    <!-- 4. How to join — the page's one ask, at the highest visual weight it
         has. Two ways to act so the section has no dead end, and the
         reassurance line directly under them, where someone hesitating over
         whether their idea is "ready" will actually read it. -->
    <section id="join" class="oddf-sub oddf-join">
      <div class="wrap">
        <span class="eyebrow">{page.join.eyebrow}</span>
        <h2>{page.join.headline}</h2>
        <p>{page.join.body}</p>
        <div class="oddf-join-actions">
          <Pill href={page.join.cta.href} variant="ticket" magnetic class="oddf-join-cta">
            {page.join.cta.label}
          </Pill>
          <Pill href={page.join.altCta.href} variant="outline" magnetic>
            {page.join.altCta.label}
          </Pill>
        </div>
        <p class="oddf-join-reassurance">{page.join.reassurance}</p>
      </div>
    </section>

    {
      // Programme logic stays wired up for when the real 2027 programme goes
      // live, but renders nothing while page.programme is empty — see
      // content.config.ts's comment on this field.
      page.programme.length > 0 && (
        <section class="oddf-sub">
          <div class="wrap flow">
            <div class="section-head">
              <span class="eyebrow">Programme</span>
              <h2>Discover what's on</h2>
            </div>
            <ProgrammeList items={page.programme} />
          </div>
        </section>
      )
    }

    {
      /* No PhotoBreak here (2026-08-31 correction) — the previous image
         (assets/hero/archive-15.jpg, "Performers on stage during ODDfest")
         is legacy centrally-produced festival-stage photography, and this
         page's whole point is the new distributed, organiser-owned Creative
         Week model; keeping it visually implied the opposite of the page's
         own copy. Re-add a PhotoBreak here once real, verified Creative Week
         imagery exists — same "don't guess" rule as the examples below. */
    }

    {
      // Real, named examples — only renders while verified ones exist (see
      // content.config.ts's `creativeWeekExample` comment: no invented events
      // ship here). Filled 2026-09-14 with Creative Week and ODDfest 2026
      // events, each checked against its partner's own event page and the
      // ODDfest photo archive. The ODDfest 2025 Arthur C. Brooks keynote card
      // was removed the same day at Ronny's request, and four ODDfest 2026
      // programmes took its place (ODDgames, ODDtheatre, ODD Deep Space,
      // Smell the Art), checked against their oddfest.co lineup pages and
      // the 2026 thank-you credits. Since 2026-09-14 it follows How
      // to join directly: the "What has happened before" chapter it used to
      // sit under is gone.
      page.examples.length > 0 && (
        <section class="oddf-sub">
          <div class="wrap flow">
            <div class="section-head">
              <span class="eyebrow">{page.examplesIntro.eyebrow}</span>
              <h2>{page.examplesIntro.headline}</h2>
            </div>
            <p class="oddf-examples-lede reveal">{page.examplesIntro.body}</p>
            <OddfestExamples items={page.examples} />
            <p class="oddf-examples-closing reveal">{page.examplesIntro.closing}</p>
          </div>
        </section>
      )
    }

    {
      /* Programme highlights (2026-09-14): who was on the 2025 and 2026
         programmes, grouped, directly under the examples. The examples show
         what the formats looked like; this shows who was in them. Reuses
         AudienceList's label + line treatment rather than inventing a logo
         wall or tag cloud for what is, in the end, a list of names. */
      page.programmeHighlights.groups.length > 0 && (
        <section class="oddf-sub oddf-names">
          <div class="wrap flow">
            <div class="section-head">
              <span class="eyebrow">{page.programmeHighlights.eyebrow}</span>
              <h2>{page.programmeHighlights.headline}</h2>
            </div>
            <p class="oddf-names-lede reveal">{page.programmeHighlights.body}</p>
            <AudienceList items={page.programmeHighlights.groups} />
          </div>
        </section>
      )
    }

    <!-- "Want your event in the next one?" (2026-09-14). The proof chapter
         ends by handing the reader straight back to the page's primary
         conversion: having just seen who and what ODDfest has been, a
         would-be host is asked for theirs. Same destination as "How to join"
         but deliberately lighter (no backstage ground), so the page still has
         one loudest ask. -->
    <section class="oddf-sub oddf-bring">
      <div class="wrap">
        <div class="oddf-bring-inner reveal">
          <span class="eyebrow">{page.hostCta.eyebrow}</span>
          <h2>{page.hostCta.headline}</h2>
          <p>{page.hostCta.body}</p>
          <Pill href={page.hostCta.cta.href} variant="ticket" magnetic class="oddf-bring-cta">
            {page.hostCta.cta.label}
          </Pill>
        </div>
      </div>
    </section>

    <!-- 6. Partner route (2026-09-11). The host ask above is this page's
         primary conversion and keeps the loudest treatment; this is the
         other real audience the page has to serve — an organisation that
         wants to back the week rather than host inside it. It sits after
         the proof chapter, where "is this real?" has just been answered,
         and routes into the existing Work with ODD partnerships enquiry
         rather than introducing a second form. -->
    <section class="oddf-sub oddf-partner">
      <div class="wrap">
        <div class="oddf-partner-inner reveal">
          <span class="eyebrow">{page.partnerCta.eyebrow}</span>
          <h2>{page.partnerCta.title}</h2>
          <p>{page.partnerCta.body}</p>
          <Pill href={page.partnerCta.href} variant="outline" magnetic>
            {page.partnerCta.linkLabel}
          </Pill>
        </div>
      </div>
    </section>

    <!-- 7. FAQ -->
    <section class="oddf-sub">
      <div class="wrap flow">
        <div class="section-head">
          <h2>Practical / FAQ</h2>
        </div>
        <FAQList items={page.faq} />
      </div>
    </section>
  </SubpageFrame>
</Layout>

<style>
  /* Section rhythm and the hero→content gap are not set here: every .oddf-sub
     takes layout.css's section padding (the class stays as a hook; How to
     join, with its own ground, is the one exception — see .oddf-join), and
     SubpageFrame's .oddf-center owns the space under the hero. */

  /* Partner band. Bordered rather than filled: a solid panel here read as a
     second primary CTA competing with "How to join", which is the one thing
     this page most needs a visitor to do. */
  .oddf-partner-inner {
    max-width: 46rem;
    padding: var(--space-10);
    border: 1px solid var(--color-paper-12);
    border-radius: var(--radius-panel);
  }
  .oddf-partner-inner h2 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }
  .oddf-partner-inner p {
    margin: var(--space-4) 0 0;
    max-width: var(--measure-prose);
  }
  .oddf-partner-inner :global(.pill) {
    margin-top: var(--space-6);
  }
  @media (max-width: 640px) {
    .oddf-partner-inner {
      padding: var(--space-6);
    }
  }

  /* "Look back at 2026" — the two archive buttons under the explainer.
     Deliberately quiet (both outline, small label above) so they read as a
     footnote to "What ODDfest is" rather than a second offer competing with
     the hero's CTAs or the ask further down.

     A bare block between two sections, so it follows the section contract
     from outside: no top margin — SectionIntro's half-gap bottom padding is
     the joint that ties it to the explainer (this used to be a negative
     margin clawing that padding back) — and the other half of the gap to
     "How it works" as its bottom margin. */
  .oddf-lookback {
    max-width: 40rem;
    margin-inline: auto;
    margin-block-end: calc(var(--space-section) / 2);
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }
  .oddf-lookback-label {
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-40);
    text-align: center;
  }
  .oddf-lookback-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
  /* The default Pill is `white-space: nowrap`, and these two labels are the
     longest buttons on the page — below ~420px they would each force the
     line box wider than the screen. Only these are released from it. */
  @media (max-width: 460px) {
    .oddf-lookback-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .oddf-lookback-actions :global(.pill) {
      white-space: normal;
      text-align: center;
    }
  }

  /* "How it works" — the responsibility split, its closing line, then the
     numbered steps, all inside one section; the wrap's .flow spaces them.
     The two columns are unboxed text, not cards, so stacked on a phone they
     sit a flow step apart rather than --space-grid (a card-grid gap would
     glue the second heading to the first column's paragraph). */
  .oddf-layer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 3rem;
    row-gap: var(--space-content);
    max-width: 56rem;
    margin-inline: auto;
  }
  .oddf-layer-col h3 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: 0;
  }
  .oddf-layer-col p {
    margin: var(--space-3) 0 0;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  .oddf-layer-closing {
    max-width: var(--measure-prose);
    margin-inline: auto;
    margin-block-end: 0;
    text-align: center;
    font: var(--text-body);
    font-style: italic;
    color: var(--color-paper-40);
  }
  @media (max-width: 700px) {
    .oddf-layer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
  /* The steps, now the second half of this same section rather than their
     own. The rule above them is what keeps one section from reading as two:
     it joins the two movements instead of separating them. A second group in
     the section, so --space-group above the rule (a replacement for the flow
     step) and a flow step from the rule to the label. */
  .oddf-steps {
    margin-block-start: var(--space-group);
    padding-top: var(--space-content);
    border-top: 1px solid var(--color-paper-12);
  }
  .oddf-steps-label {
    display: block;
    text-align: center;
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-40);
  }

  /* "How to join" — the page's one ask. Backstage ground and a ticket-variant
     primary so it is unmistakably the conversion block and not another
     editorial section.

     Its own ground, so it follows layout.css's rule for one: a whole
     --space-section inside the backstage panel, and half a gap outside it
     as margin, so the neighbours' half-gap padding adds up to one full gap
     to the panel's edge. */
  .oddf-join {
    text-align: center;
    background: var(--color-backstage);
    padding-block: var(--space-section);
    margin-block: calc(var(--space-section) / 2);
  }
  .oddf-join .wrap {
    max-width: 40rem;
  }
  .oddf-join .eyebrow {
    display: block;
    color: var(--color-paper-40);
  }
  .oddf-join h2 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }
  .oddf-join p {
    font: var(--text-body);
    color: var(--color-paper-60);
    max-width: var(--measure-prose);
    margin: var(--space-4) auto 0;
  }
  .oddf-join-actions {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
  }
  /* Visibly larger than an ordinary tertiary Pill, using the `ticket`
     variant's existing shadow/lift treatment and roomier padding for extra
     weight rather than inventing a new button style (2026-09-02 UX note,
     kept). The label stays on the Small role like every other button. */
  .oddf-join-actions :global(.oddf-join-cta.pill) {
    padding: 1rem 2.4rem;
  }
  /* Scoped under .oddf-join so it outranks `.oddf-join p` by specificity
     rather than by !important. */
  .oddf-join .oddf-join-reassurance {
    font: var(--text-small);
    color: var(--color-paper-40);
    margin-top: var(--space-5);
  }
  @media (max-width: 460px) {
    .oddf-join-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .oddf-join-actions :global(.pill) {
      white-space: normal;
      text-align: center;
    }
  }

  /* "Last year, this looked like…" examples chapter — lede above the grid,
     closing line below it, spaced by the wrap's .flow. The lede belongs to
     its heading, so it replaces the flow step with the tighter one. */
  .oddf-examples-lede {
    max-width: var(--measure-prose);
    margin-block: var(--space-4) 0;
    margin-inline: auto;
    text-align: center;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  .oddf-examples-closing {
    max-width: var(--measure-prose);
    margin-inline: auto;
    margin-block-end: 0;
    text-align: center;
    font: var(--text-body);
    color: var(--color-paper-40);
  }

  /* Programme highlights — a lede above AudienceList's grouped names, tucked
     under its heading the same way as the examples lede. */
  .oddf-names-lede {
    max-width: var(--measure-prose);
    margin-block: var(--space-4) 0;
    margin-inline: auto;
    text-align: center;
    font: var(--text-body);
    color: var(--color-paper-60);
  }

  /* "Want your event in the next one?" — centered, unboxed, with the same
     roomier ticket Pill as "How to join" so the two asks read as one route. */
  .oddf-bring-inner {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }
  .oddf-bring-inner .eyebrow {
    display: block;
    color: var(--color-paper-40);
  }
  .oddf-bring-inner h2 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }
  .oddf-bring-inner p {
    font: var(--text-body);
    color: var(--color-paper-60);
    max-width: var(--measure-prose);
    margin: var(--space-4) auto 0;
  }
  .oddf-bring-inner :global(.oddf-bring-cta.pill) {
    margin-top: var(--space-6);
    padding: 1rem 2.4rem;
  }
  @media (max-width: 460px) {
    .oddf-bring-inner :global(.pill) {
      white-space: normal;
      text-align: center;
    }
  }
</style>
