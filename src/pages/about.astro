---
// Rebuilt 2026-08-30, corrected 2026-08-31 to actually follow work-with-odd
// .astro's newer layout language (HeroCentered, editorial section rhythm)
// instead of the older PageIntro/ParticipateBand shape work-with-odd.astro
// itself has since moved on from — see HeroCentered.astro's Props comment
// and docs/architecture.md#v2-about-rebuild. About stays more reflective
// than Work with ODD (no primaryCta pill, no hero photo until a real,
// verified 2026-era one exists — same "don't guess" rule as closingImage
// below), but shares its hero head layout/typography, its section rhythm,
// and a light closing set of links instead of ParticipateBand's sales-wall
// card treatment.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroCentered from '../components/sections/HeroCentered.astro';
import Timeline from '../components/sections/Timeline.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import ProofGrid from '../components/sections/ProofGrid.astro';
import PhotoBreak from '../components/sections/PhotoBreak.astro';

const entry = await getEntry('pages', 'about');
if (!entry || entry.data._template !== 'about')
  throw new Error('about.json content entry missing or malformed');
const page = entry.data;
---

<Layout title={page.seo.title} description={page.seo.description} ogImage={page.seo.ogImage}>
  <HeroCentered eyebrow={page.eyebrow} title={page.title} intro={page.intro} warpTitle />

  <section class="about-argument">
    <div class="wrap">
      {page.argument.map((paragraph) => <p class="reveal">{paragraph}</p>)}
    </div>
  </section>

  {
    /* "Why now" — NEW SECTION (2026-09-02 copywriting pass). Same plain
       section-head + stacked-paragraph treatment as the core argument above
       it, not SectionIntro (whose `body` is a single string and can't carry
       this section's two real paragraph breaks). */
  }
  <section class="about-sub">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{page.whyNow.eyebrow}</span>
        <h2>{page.whyNow.headline}</h2>
      </div>
      <div class="about-argument-inner">
        {page.whyNow.body.map((paragraph) => <p class="reveal">{paragraph}</p>)}
      </div>
    </div>
  </section>

  {
    /* "What we build" (howWeMakeItHappen's pillars only) — "Ways of working"
       (its `principles`) moved down below the timeline, per the 2026-09-02
       copywriting pass's recommended flow: What we build → What we have
       learned → Our story → Ways of working → Impact. Both still live in
       the same `howWeMakeItHappen` content field (repo mapping unchanged),
       just rendered in two places. */
  }
  <section class="about-sub">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{page.howWeMakeItHappen.eyebrow}</span>
        <h2>{page.howWeMakeItHappen.title}</h2>
      </div>
      <p class="about-lede reveal">{page.howWeMakeItHappen.intro}</p>
      <FeatureGrid cards={page.howWeMakeItHappen.pillars} />
    </div>
  </section>

  {
    /* "What we have learned" — NEW SECTION (2026-09-02 copywriting pass):
       candid, numbered lessons from 2025–2026. Reuses FeatureGrid for the
       five items, same shape ODDference's "What changes in 2027" already
       uses. [HUMAN DECISION / NEEDS FACT CHECK — see about.json's
       `whatWeLearned.items[2]` "roughly 300" ODDference attendance figure
       and item[4]'s Showcase-economics detail; both are the doc's own
       supplied copy, flagged there for confirmation against the canonical
       public figures before this goes live.] */
  }
  <section class="about-sub">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{page.whatWeLearned.eyebrow}</span>
        <h2>{page.whatWeLearned.headline}</h2>
      </div>
      <p class="about-lede reveal">{page.whatWeLearned.body}</p>
      <FeatureGrid cards={page.whatWeLearned.items} />
    </div>
  </section>

  <section class="about-sub">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{page.story.eyebrow}</span>
        <h2>{page.story.title}</h2>
      </div>
      <Timeline items={page.story.milestones} />
      <p class="about-legal-note reveal">{page.story.legalNote}</p>
    </div>
  </section>

  {
    /* "Ways of working" — now its own standalone section (moved down from
       being a sub-part of "What we build" — see the comment above). Same
       markup as before, just relocated. */
  }
  <section class="about-sub">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{page.howWeMakeItHappen.principlesEyebrow}</span>
        <h2>{page.howWeMakeItHappen.principlesTitle}</h2>
      </div>
      <ul class="about-principles-list reveal">
        {
          page.howWeMakeItHappen.principles.map((item) => (
            <li>
              <span class="about-principles-number">{item.number}</span>
              <div>
                <h4>{item.title}</h4>
                <p>{item.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    page.impact.map((snapshot) => (
      <ProofGrid
        eyebrow={snapshot.eyebrow}
        title={snapshot.title}
        items={snapshot.items}
        reportLabel={snapshot.reportLabel}
        reportUrl={snapshot.reportUrl}
        placeholder={snapshot.placeholder}
      />
    ))
  }

  <section class="about-sub about-continue">
    <div class="wrap">
      <div class="section-head">
        <h2>Keep exploring</h2>
      </div>
      <ul class="about-continue-list reveal">
        {
          page.participate.map((item) => (
            <li>
              <a href={item.href}>
                <span class="about-continue-title">{item.title}</span>
                <span class="about-continue-go">{item.linkLabel}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    page.closingImage?.image && (
      <PhotoBreak image={page.closingImage.image} alt={page.closingImage.alt} tall />
    )
  }
</Layout>

<style>
  .about-sub {
    padding: var(--space-24) 0;
  }
  /* Mobile rhythm. 6rem top+bottom is tuned for a desktop column; stacked on
     a phone it puts ~192px of empty screen between two sections (measured
     across /work-with-odd, /oddference, /oddspace, /about and /media). Halved
     to match layout.css's own `section` reduction at the same breakpoint, so
     page-level and component-level sections stay on one rhythm — see that
     file's comment, which flags exactly this class of override. */
  @media (max-width: 640px) {
    .about-sub {
      padding: var(--space-12) 0;
    }
  }
  .about-argument {
    padding: 0 0 var(--space-16);
  }
  .about-argument p {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--color-paper-60);
  }
  .about-argument p + p {
    margin-top: 1.4rem;
  }
  /* "Why now" reuses the same stacked-paragraph treatment as the core
     argument above it, scoped to its own section (not `.about-argument`,
     which also sets this section's own zero-top padding — "Why now" instead
     uses `.about-sub`'s normal section rhythm since it follows a real
     section-head, not the hero). */
  .about-argument-inner p {
    max-width: 40rem;
    margin: var(--space-8) auto 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--color-paper-60);
  }
  .about-argument-inner p + p {
    margin-top: 1.4rem;
  }
  .about-lede {
    max-width: 40rem;
    margin: -1.5rem auto 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--color-paper-60);
  }
  .about-legal-note {
    margin: var(--space-10) auto 0;
    max-width: 40rem;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--color-paper-40);
  }

  /* Ways of working — now its own standalone section (2026-09-02
     copywriting pass moved it below the timeline), still a concise list
     rather than a second FeatureGrid card row (five principles as full
     cards would be another giant grid chapter, the opposite of the simpler
     shape this rebuild is after). Its section-head is now the sitewide
     shared `.section-head` (see layout.css), same as every other
     `.about-sub` section-head on this page. */
  .about-principles-list {
    list-style: none;
    margin: var(--space-10) auto 0;
    padding: 0;
    max-width: 46rem;
    display: flex;
    flex-direction: column;
  }
  .about-principles-list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--color-paper-12);
  }
  .about-principles-list li:last-child {
    border-bottom: 1px solid var(--color-paper-12);
  }
  .about-principles-number {
    font: var(--text-caption);
    letter-spacing: 0.24em;
    color: var(--color-paper-40);
  }
  .about-principles-list h4 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-paper);
    margin: 0;
  }
  .about-principles-list p {
    margin: 0.4rem 0 0;
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-paper-60);
  }
  @media (max-width: 640px) {
    .about-principles-list li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }

  /* Get involved, replaced 2026-08-31 — ParticipateBand's card-wall
     treatment read as a sales CTA block; the brief asked for a light
     continuation instead, so this is a plain underlined-link list, the
     same weight as SectionIntro's own link treatment. */
  .about-continue-list {
    list-style: none;
    margin: var(--space-10) auto 0;
    padding: 0;
    max-width: 42rem;
    display: flex;
    flex-direction: column;
  }
  .about-continue-list li {
    border-top: 1px solid var(--color-paper-12);
  }
  .about-continue-list li:last-child {
    border-bottom: 1px solid var(--color-paper-12);
  }
  .about-continue-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.3rem 0;
    text-decoration: none;
    color: inherit;
  }
  .about-continue-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    color: var(--color-paper);
  }
  .about-continue-go {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--color-paper-60);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-paper-20);
    transition: color var(--duration-fast) ease;
  }
  .about-continue-list a:hover .about-continue-go {
    color: var(--color-amber-bright);
    text-decoration-color: var(--color-amber-bright);
  }
</style>
