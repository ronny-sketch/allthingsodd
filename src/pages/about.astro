---
// Rebuilt 2026-08-30, corrected 2026-08-31 to actually follow work-with-odd
// .astro's newer layout language (HeroCentered, editorial section rhythm)
// instead of the older PageIntro/ParticipateBand shape work-with-odd.astro
// itself has since moved on from — see HeroCentered.astro's Props comment
// and docs/architecture.md#v2-about-rebuild. About stays more reflective
// than Work with ODD (no primaryCta pill, no photo behind the hero title),
// but shares its hero head layout/typography, its section rhythm, and a
// light closing set of links instead of ParticipateBand's sales-wall card
// treatment.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroCentered from '../components/sections/HeroCentered.astro';
import Timeline from '../components/sections/Timeline.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import ProofGrid from '../components/sections/ProofGrid.astro';
import PhotoBreak from '../components/sections/PhotoBreak.astro';
import PhotoWall from '../components/sections/PhotoWall.astro';

const entry = await getEntry('pages', 'about');
if (!entry || entry.data._template !== 'about')
  throw new Error('about.json content entry missing or malformed');
const page = entry.data;
---

<Layout title={page.seo.title} description={page.seo.description} ogImage={page.seo.ogImage}>
  <HeroCentered eyebrow={page.eyebrow} title={page.title} intro={page.intro} warpTitle />

  {
    /* "Why now" is deliberately gone (2026-09-11 editorial pass). Its
       headline — "When execution gets easier, judgment matters more" — was
       strategy thinking that read well in a deck and told a visitor nothing
       about what ODD is. Its one load-bearing fact (Finland's own
       creative-economy goals already assume this expertise matters more)
       survives, inside the argument below, where it supports a point the
       page was already making instead of restating it as a section. */
  }
  <section class="about-argument">
    <div class="wrap">
      {page.argument.map((paragraph) => <p class="reveal">{paragraph}</p>)}
    </div>
  </section>

  {
    /* The ODDfest 2026 launch group photo (2026-09-14). It sits straight
       after the argument, not at the foot of the page where `closingImage`
       used to wait for it: a stage full of the people behind ODD is the
       case the argument has just made. */
    page.launchPhoto && (
      <PhotoBreak image={page.launchPhoto.image} alt={page.launchPhoto.alt} tall />
    )
  }

  {
    /* "What we build" (howWeMakeItHappen's pillars only) — "Ways of working"
       (its `principles`) moved down below the timeline, per the 2026-09-02
       copywriting pass's recommended flow: What we build → Our story → Ways
       of working → Impact. Both still live in
       the same `howWeMakeItHappen` content field (repo mapping unchanged),
       just rendered in two places. */
  }
  <section class="about-sub">
    <div class="wrap flow">
      <div class="section-head">
        <span class="eyebrow">{page.howWeMakeItHappen.eyebrow}</span>
        <h2>{page.howWeMakeItHappen.title}</h2>
      </div>
      <p class="about-lede reveal">{page.howWeMakeItHappen.intro}</p>
      <FeatureGrid cards={page.howWeMakeItHappen.pillars} />
    </div>
  </section>

  {
    /* "What we have learned" (numbered lessons from 2025–2026) was deleted
       on 2026-09-14 at Ronny's request, field and all. */
  }

  <section class="about-sub">
    <div class="wrap flow">
      <div class="section-head">
        <span class="eyebrow">{page.story.eyebrow}</span>
        <h2>{page.story.title}</h2>
      </div>
      <Timeline items={page.story.milestones} />
      <p class="about-legal-note reveal">{page.story.legalNote}</p>
    </div>
  </section>

  {
    /* "Ways of working" — now its own standalone section (moved down from
       being a sub-part of "What we build" — see the comment above). Same
       markup as before, just relocated. */
  }
  <section class="about-sub">
    <div class="wrap flow">
      <div class="section-head">
        <span class="eyebrow">{page.howWeMakeItHappen.principlesEyebrow}</span>
        <h2>{page.howWeMakeItHappen.principlesTitle}</h2>
      </div>
      <ul class="about-principles-list reveal">
        {
          page.howWeMakeItHappen.principles.map((item) => (
            <li>
              <span class="about-principles-number">{item.number}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    /* 2025–2026 in numbers: Home's cumulative figures, with the 2025 Impact
       Report and the ODDfest 2026 thank-you page as the two buttons under
       them (2026-09-14). It replaced two year snapshots — ODDfest 2025's own
       figures, and an empty 2026 one waiting on its report. */
  }
  <ProofGrid
    eyebrow={page.impact.eyebrow}
    title={page.impact.title}
    items={page.impact.items}
    ctas={page.impact.ctas}
  />

  {
    /* The photo wall under the figures (2026-09-14): ODDfest 2025 and 2026
       from their Flickr photobanks, events hosted across Helsinki, and
       ODDspace — what those numbers looked like. */
    page.gallery && page.gallery.photos.length > 0 && (
      <section class="about-sub">
        <div class="wrap flow">
          <div class="section-head">
            {page.gallery.eyebrow && <span class="eyebrow">{page.gallery.eyebrow}</span>}
            <h2>{page.gallery.title}</h2>
          </div>
          {page.gallery.note && <p class="about-lede reveal">{page.gallery.note}</p>}
          <div class="about-gallery-wall">
            <PhotoWall photos={page.gallery.photos} />
          </div>
        </div>
      </section>
    )
  }

  <section class="about-sub about-continue">
    <div class="wrap flow">
      <div class="section-head">
        <h2>Keep exploring</h2>
      </div>
      <ul class="about-continue-list reveal">
        {
          page.participate.map((item) => (
            <li>
              <a href={item.href}>
                <span class="about-continue-title">{item.title}</span>
                <span class="about-continue-go">{item.linkLabel}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  /* Section rhythm (.about-sub, .about-argument) is layout.css's — the
     hero's half below plus the argument's half above make the one full gap
     a hero → first content transition takes. Inside each .about-sub the
     `.flow` wrap spaces head, lede, grid/list and closing note. */
  .about-argument p {
    max-width: var(--measure-prose);
    margin: 0 auto;
    text-align: center;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  .about-argument p + p {
    margin-top: var(--space-4);
  }
  /* A lede belongs to the heading above it: the one sanctioned flow
     override, a tighter replacement step. */
  .about-lede {
    max-width: var(--measure-prose);
    margin-inline: auto;
    margin-block: var(--space-4) 0;
    text-align: center;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  .about-legal-note {
    margin-inline: auto;
    margin-block-end: 0;
    max-width: 40rem;
    text-align: center;
    font: var(--text-small);
    color: var(--color-paper-40);
  }

  /* Ways of working — now its own standalone section (2026-09-02
     copywriting pass moved it below the timeline), still a concise list
     rather than a second FeatureGrid card row (five principles as full
     cards would be another giant grid chapter, the opposite of the simpler
     shape this rebuild is after). Its section-head is now the sitewide
     shared `.section-head` (see layout.css), same as every other
     `.about-sub` section-head on this page. */
  .about-principles-list {
    list-style: none;
    margin-inline: auto;
    margin-block-end: 0;
    padding: 0;
    max-width: 46rem;
    display: flex;
    flex-direction: column;
  }
  /* row-gap only shows once the columns stack on phones (number over title). */
  .about-principles-list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-2) 1rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--color-paper-12);
  }
  .about-principles-list li:last-child {
    border-bottom: 1px solid var(--color-paper-12);
  }
  .about-principles-number {
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-paper-40);
  }
  /* h3, not h4: these sit directly under the section's own h2, and an
     h2 -> h4 jump is a real heading-order break for anyone navigating by
     headings. The type role below (Gabarito 600 at the Body size, a run-in
     title for the paragraph under it) is independent of the level — the
     level is semantic, the role is a design choice. Found in the 2026-09-03
     a11y sweep. */
  .about-principles-list h3 {
    max-width: var(--measure-prose);
    font: var(--text-body);
    font-weight: 600;
    color: var(--color-paper);
    margin: 0;
  }
  .about-principles-list p {
    max-width: var(--measure-prose);
    margin: var(--space-2) 0 0;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  @media (max-width: 640px) {
    .about-principles-list li {
      grid-template-columns: 1fr;
    }
    .about-continue-list a {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* Get involved, replaced 2026-08-31 — ParticipateBand's card-wall
     treatment read as a sales CTA block; the brief asked for a light
     continuation instead, so this is a plain underlined-link list, the
     same weight as SectionIntro's own link treatment. */
  .about-continue-list {
    list-style: none;
    margin-inline: auto;
    margin-block-end: 0;
    padding: 0;
    max-width: 42rem;
    display: flex;
    flex-direction: column;
  }
  .about-continue-list li {
    border-top: 1px solid var(--color-paper-12);
  }
  .about-continue-list li:last-child {
    border-bottom: 1px solid var(--color-paper-12);
  }
  .about-continue-list a {
    display: flex;
    /* Wraps, so a long title pushes the link onto its own line rather than
       past the screen edge; on phones every row stacks (below), so rows
       don't alternate between the two arrangements. */
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) 1rem;
    padding: 1.3rem 0;
    text-decoration: none;
    color: inherit;
  }
  .about-continue-title {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    text-wrap: balance;
  }
  .about-continue-go {
    flex-shrink: 0;
    font: var(--text-small);
    font-weight: 600;
    color: var(--color-paper-60);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-paper-20);
    transition: color var(--duration-fast) ease;
  }
  .about-continue-list a:hover .about-continue-go {
    color: var(--color-amber-bright);
    text-decoration-color: var(--color-amber-bright);
  }
</style>
