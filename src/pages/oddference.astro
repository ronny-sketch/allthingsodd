---
// Restructured 2026-09-11 at Ronny's direct request, to the eight sections
// he specified — the same treatment /oddspace got the same day:
//
//   1 hero · 2 the premise · 3 three reasons · 4 past speakers ·
//   5 session highlights · 6 who it's for · 7 tickets & partnership · 8 FAQ
//
// What changed, and why none of it is "hidden for later":
//
// * The hero now renders `frame="space"` (see FullbleedVideoHero.astro):
//   ODDspace's proportions, on ODDference's own video and Signal accent. The
//   h1 is a short positioning line instead of the long central question, and
//   `heroSupport` is gone — that composition has no supporting paragraph, and
//   the practical-value line it carried is now the opening sentence of
//   `concept`, where it reads as a sentence rather than as caption competing
//   with a display-sized headline. The central question moved with it, to
//   `concept`'s headline, which is where the page actually answers it.
//
// * "Who it's for" moved *below* the 2026 proof. It used to sit directly
//   under the three reasons, so a reader met a list of job titles before
//   seeing a single thing that had actually happened. Speakers and sessions
//   now carry that weight first.
//
// * `sessionHighlights` is new — real 2026 session titles from the event's
//   own run sheet. See content.config.ts for the provenance; the live 2026
//   oddfest.co page never published session-level content, only tracks.
//
// * `faq` is new, using the same FAQList as ODDfest and ODDspace.
//
// * "What changes in 2027" is removed. It was three cards of intent about an
//   event whose programme does not exist yet, sitting between the 2026 proof
//   and the ticket block — the two things the page is actually for. Its one
//   piece of real, load-bearing information (ODDference runs alongside
//   ODDfest week across Helsinki) is kept, in the FAQ. The rest is in this
//   file's git history if a future edition wants it back.
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SubpageFrame from '../components/sections/SubpageFrame.astro';
import FullbleedVideoHero from '../components/sections/FullbleedVideoHero.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import AudienceList from '../components/sections/AudienceList.astro';
import PersonGrid from '../components/sections/PersonGrid.astro';
import PricingGrid from '../components/sections/PricingGrid.astro';
import FAQList from '../components/sections/FAQList.astro';
import Pill from '../components/primitives/Pill.astro';
import oddferenceMark from '../assets/logos/oddference-mark.png';

const entry = await getEntry('pages', 'oddference');
if (!entry || entry.data._template !== 'oddference')
  throw new Error('oddference.json content entry missing or malformed');
const page = entry.data;
if (!page.heroMedia.video || !page.heroMedia.poster)
  throw new Error('oddference.json is missing required fullbleed-video hero fields');
---

<Layout title={page.seo.title} description={page.seo.description} ogImage={page.seo.ogImage}>
  <SubpageFrame slug={page._slug} railLeft={page.railLeft} railRight={page.railRight}>
    <!-- 1. Hero: ODDference mark + a short positioning line (the page's one
         h1), and Get your ticket / Partner with ODDference right in the
         hero. `frame="space"` matches ODDspace's hero proportions — see the
         file header and FullbleedVideoHero.astro's `frame` prop. -->
    {
      /* `page.eyebrow` ("ODDference · 2027") is deliberately not passed:
         ODDspace's stack is wordmark → title → meta, and here the eyebrow sat
         between the ODDference wordmark and a `meta` of "Helsinki · 2027",
         repeating both of its halves. The field stays in the content (it is
         part of the shared subpageBase shape, and other subpages render it). */
    }
    <FullbleedVideoHero
      slot="hero"
      video={page.heroMedia.video}
      poster={page.heroMedia.poster}
      sub={page.title}
      meta={page.meta}
      logo={oddferenceMark}
      logoAlt="ODDference"
      primaryCta={page.primaryCta}
      secondaryCta={page.secondaryCta}
      accent="signal"
      frame="space"
    />

    <!-- 2. The premise — the central question, and the answer to "what is
         this". Two paragraphs (SectionIntro splits on the blank line). -->
    <SectionIntro
      eyebrow={page.concept.eyebrow}
      headline={page.concept.headline}
      body={page.concept.body}
      lead
    />

    <!-- 3. The three selling points — major editorial blocks, not FeatureGrid
         cards: each gets real width and, where a real archive photo fits, its
         own image. The section head above them is new (2026-09-11); without
         it these read as a continuation of the premise rather than as the
         page's three arguments. -->
    <section class="oddc-sub">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">{page.reasonsIntro.eyebrow}</span>
          <h2>{page.reasonsIntro.headline}</h2>
        </div>
        <div class="oddc-reasons reveal">
          {
            page.reasons.map((r) => (
              <div class={`oddc-reason ${r.image ? 'has-photo' : 'text-only'}`}>
                {r.image && (
                  <div class="oddc-reason-photo">
                    <Image src={r.image} alt="" width={900} />
                  </div>
                )}
                <div class="oddc-reason-text">
                  <span class="oddc-reason-number">{r.number}</span>
                  {r.eyebrow && <span class="eyebrow">{r.eyebrow}</span>}
                  <h3>{r.title}</h3>
                  <p>{r.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {
      /* The real 2027 programme, once one exists — renders nothing while
         empty, same "don't invent it" rule as the aftermovie and partner
         blocks below. Sits here, above the 2026 proof, because that is where
         a confirmed line-up belongs: it would be the reason to come, and the
         2026 material would drop to being supporting evidence. */
      page.programme && page.programme.length > 0 && (
        <section class="oddc-sub">
          <div class="wrap">
            <div class="section-head">
              <span class="eyebrow">Schedule</span>
              <h2>Programme</h2>
            </div>
            <FeatureGrid
              cards={page.programme.map((p, i) => ({
                number: String(i + 1).padStart(2, '0'),
                title: p.title,
                body: p.description,
              }))}
            />
          </div>
        </section>
      )
    }

    <!-- 4. Past speakers — ODDference 2026's full, real roster. Renders
         nothing if it is ever emptied out (kept for a future edition's own
         roster, same convention as programme/aftermovie/partners). -->
    {
      page.speakers && page.speakers.length > 0 && (
        <section class="oddc-sub">
          <div class="wrap">
            <div class="section-head">
              <span class="eyebrow">Past speakers · ODDference 2026</span>
              <h2>People who joined us last time.</h2>
            </div>
            <PersonGrid items={page.speakers} />
          </div>
        </section>
      )
    }

    {
      /* 5. Session highlights — what was actually discussed, which is the
         half of the 2026 proof a roster of names can't carry. Page-scoped
         markup rather than ProgrammeList: these have no date, time or venue
         (the three things that component's left column exists for), and a
         real 2027 programme would use ProgrammeList properly. Same reasoning
         as the `.oddc-reason` blocks above. */
      page.sessionHighlights && page.sessionHighlights.length > 0 && (
        <section class="oddc-sub">
          <div class="wrap">
            <div class="section-head">
              <span class="eyebrow">Session highlights · ODDference 2026</span>
              <h2>What was actually on stage.</h2>
            </div>
            <ol class="oddc-sessions reveal">
              {page.sessionHighlights.map((s) => (
                <li class="oddc-session">
                  <span class="oddc-session-format">{s.format}</span>
                  <h3>{s.title}</h3>
                  <span class="oddc-session-people">{s.speakers}</span>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    {
      // No dedicated ODDference aftermovie exists yet (checked the repo and
      // the live 2026 site); this stays hidden rather than showing the
      // generic home-aftermovie.mp4 under the ODDference name. See
      // content.config.ts's comment on this field.
      page.aftermovie && (
        <section class="oddc-sub">
          <div class="wrap">
            <div class="section-head">
              <h2>See what happened last time.</h2>
            </div>
          </div>
          <div class="oddc-aftermovie">
            <Image src={page.aftermovie.poster} alt="" width={2200} />
            <video autoplay muted loop playsinline poster={page.aftermovie.poster.src}>
              <source src={page.aftermovie.video} type="video/mp4" />
            </video>
          </div>
        </section>
      )
    }

    <!-- 6. Who it's for — a lighter typographic list, not another FeatureGrid
         card chapter (see AudienceList.astro). Deliberately after the 2026
         proof: a reader should recognise themselves in the room *after*
         seeing what happens in it, not before. -->
    <section class="oddc-sub">
      <div class="wrap">
        <div class="section-head"><h2>Who it's for</h2></div>
        <AudienceList items={page.whoItsFor} />
      </div>
    </section>

    <!-- 7. Conversion: tickets + partnerships, side by side. -->
    <section class="oddc-sub" id="tickets">
      <div class="wrap">
        <div class="oddc-convert reveal">
          <div class="oddc-convert-tickets">
            <div class="section-head">
              <span class="eyebrow">ODDference 2027</span>
              <h2>Be there before you know the line-up.</h2>
            </div>
            {page.tickets && page.tickets.length > 0 && <PricingGrid items={page.tickets} />}
          </div>
          <div class="oddc-convert-partner">
            <span class="eyebrow">{page.partnershipCta.eyebrow}</span>
            <h2>{page.partnershipCta.title}</h2>
            {page.partnershipCta.body && <p>{page.partnershipCta.body}</p>}
            <Pill href={page.partnershipCta.href} variant="outline" magnetic>
              {page.partnershipCta.linkLabel}
            </Pill>
          </div>
        </div>
      </div>
    </section>

    {
      // No ODDference-specific partner/collaborator list could be verified
      // (the live 2026 page has none, and global.json's partners/press are
      // sitewide, not attributable to ODDference). Stays hidden rather than
      // presenting unrelated logos as current partners. See
      // content.config.ts's comment on this field.
      page.partners && page.partners.length > 0 && (
        <section class="oddc-sub">
          <div class="wrap">
            <div class="section-head">
              <h2>Built with</h2>
            </div>
            <div class="oddc-partners reveal">
              {page.partners.map((p) => (
                <Image src={p.logo} alt={p.name} width={200} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- 8. FAQ — same component and same position as ODDfest's and
         ODDspace's, so the three product pages end the same way. -->
    <section class="oddc-sub">
      <div class="wrap">
        <div class="section-head"><h2>Questions</h2></div>
        <FAQList items={page.faq} />
      </div>
    </section>
  </SubpageFrame>
  {
    /* Re-reads price/status/benefits/CTA for the ticket cards above from the
      ticket backend's catalog, so this marketing page cannot advertise a
      price the storefront will not honour — see
      src/scripts/oddference-tickets.ts. */
  }
  <script src="../scripts/oddference-tickets.ts"></script>
</Layout>

<style>
  /* Hero→first-content gap (2026-09-02 copywriting pass — final review
     flagged the shared SubpageFrame top padding as oversized on this page).
     Overridden here rather than in SubpageFrame.astro itself, since
     ODDagency/ODDspace weren't flagged and shouldn't change. One step down
     the spacing scale (--space-16 → --space-12 desktop, → --space-8
     mobile), not a full collapse — the hero itself is untouched. */
  :global(.oddf-center) {
    padding-top: var(--space-12);
  }
  @media (max-width: 640px) {
    :global(.oddf-center) {
      padding-top: var(--space-8);
    }
  }

  .oddc-sub {
    padding: var(--space-24) 0;
  }
  /* Mobile rhythm. 6rem top+bottom is tuned for a desktop column; stacked on
     a phone it puts ~192px of empty screen between two sections (measured
     across /work-with-odd, /oddference, /oddspace, /about and /media). Halved
     to match layout.css's own `section` reduction at the same breakpoint, so
     page-level and component-level sections stay on one rhythm — see that
     file's comment, which flags exactly this class of override. */
  @media (max-width: 640px) {
    .oddc-sub {
      padding: var(--space-12) 0;
    }
  }

  /* 3. Reasons — alternating large blocks, deliberately not a repeated
     card grid: each reason gets real width and, when it has one, a real
     photo, so the section reads as editorial rather than a features list. */
  .oddc-reasons {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .oddc-reason {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .oddc-reason.has-photo:nth-child(even) .oddc-reason-photo {
    order: 2;
  }
  .oddc-reason.text-only {
    grid-template-columns: 1fr;
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }
  .oddc-reason-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #000;
  }
  .oddc-reason-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.1);
  }
  .oddc-reason-number {
    display: block;
    font-family: var(--font-display);
    font-size: var(--font-size-small);
    color: var(--color-paper-40);
    margin-bottom: 0.6rem;
  }
  .oddc-reason-text .eyebrow {
    display: block;
    margin-bottom: 0.6rem;
  }
  .oddc-reason-text h3 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: 0;
  }
  .oddc-reason-text p {
    max-width: var(--measure-prose);
    margin: 1.1rem 0 0;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  /* The centred, text-only reason keeps its paragraph centred under the
     heading now that the paragraph is narrower than the block. */
  @media (min-width: 821px) {
    .oddc-reason.text-only .oddc-reason-text p {
      margin-inline: auto;
    }
  }
  @media (max-width: 820px) {
    .oddc-reason {
      grid-template-columns: 1fr;
      text-align: left;
      margin: 0;
      max-width: none;
      gap: 1.6rem;
    }
    .oddc-reason.has-photo:nth-child(even) .oddc-reason-photo {
      order: 0;
    }
  }

  /* 5. Session highlights (2026-09-11). An <ol> because these are a curated
     selection presented in a deliberate order, and because it gives a
     screen reader the count — "12 sessions" is itself part of the proof.

     A two-column grid rather than PersonGrid's auto-fit card wall: these
     rows are title-led and of very uneven length (one title runs to eleven
     words), so equal-width cards would either truncate or leave large
     ragged gaps. Two fixed columns keep every title on a comfortable
     measure and let the rows size to their own content. */
  .oddc-sessions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--color-paper-12);
  }
  .oddc-session {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.6rem 2rem 1.6rem 0;
    border-bottom: 1px solid var(--color-paper-12);
  }
  /* The gutter between the two columns, drawn as a border on the left-hand
     cell rather than a grid `gap`, so the horizontal rules above and below
     run unbroken across the full width — a gap would leave a notch in every
     rule and the section would read as two lists side by side. */
  .oddc-session:nth-child(odd) {
    border-right: 1px solid var(--color-paper-12);
    padding-right: 2rem;
  }
  .oddc-session:nth-child(even) {
    padding-left: 2rem;
  }
  .oddc-session-format {
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-signal);
  }
  .oddc-session h3 {
    margin: 0;
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
  }
  .oddc-session-people {
    font: var(--text-small);
    color: var(--color-paper-60);
  }
  /* One column below 820px — at two columns a phone gets ~150px of measure
     per title, which breaks these titles into four and five lines. The
     vertical gutter and its asymmetric padding go with it. */
  @media (max-width: 820px) {
    .oddc-sessions {
      grid-template-columns: 1fr;
    }
    .oddc-session,
    .oddc-session:nth-child(odd),
    .oddc-session:nth-child(even) {
      border-right: none;
      padding-left: 0;
      padding-right: 0;
    }
  }

  /* 7. Conversion — tickets, then partnerships.

     Stacked as of 2026-09-11; this was `1.4fr 1fr` side by side. The reason
     is the ticket ladder itself, not taste: side by side, the tickets column
     measured 628px at 1440px wide, and PricingGrid's `minmax(260px, 1fr)`
     auto-fit can only fit two 260px tracks in that (3 × 260 + 2 × 20 gap =
     820px), so the third tier always wrapped onto a row of its own. That was
     survivable while the three cards looked alike. It is not now that two of
     them are dimmed: a lone, greyed-out "Regular Ticket" hanging under a row
     of two reads as a rendering fault rather than as the third rung of a
     ladder.

     Full width, the same grid fits all three in one row (~385px each inside
     the 1200px wrap) and the price progression — €250 now, €350, €450 — is
     legible left to right, which is the whole point of showing the locked
     tiers at all. Narrowing PricingGrid's track floor instead was the other
     option and was rejected: at three-across inside 628px each card gets
     ~196px, ~126px of it content after padding, which wraps "Regular Ticket"
     onto two lines and would have degraded Membership's grid too. */
  .oddc-convert {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }
  /* Grid items default to min-width:auto (content-based). Below ~375px the
     actual floor turns out to be .oddc-convert-partner's own CTA — Pill's
     white-space:nowrap keeps "Talk to us about partnering →" on one line,
     and that unbreakable string's min-content is wider than the track
     .oddc-convert has to give it. Both items share that one track, so it
     floors .oddc-convert-tickets right along with it — the ticket card
     itself has nothing unbreakable that wide (confirmed via a per-child
     scrollWidth probe: every one of its children matched its own already-
     allocated width, none were fighting it for space). Real page-level
     horizontal overflow below ~375px, gone at 390px+. min-width:0 on both
     items is necessary so the grid can size the track from real available
     space instead of either item's content floor; letting the CTA wrap
     (below) is what keeps that content-width fix from just clipping the
     button text instead. Still load-bearing after the 2026-09-11 stack —
     the two items share a single track at every width now, not only narrow
     ones. */
  .oddc-convert-tickets,
  .oddc-convert-partner {
    min-width: 0;
  }
  /* Now a full-width band rather than a tall card in a side column (see
     above). Laid out as text-then-CTA on one row so the block stays the
     height of its own copy instead of stretching an empty box across the
     page, and so the partnership ask still reads as a distinct offer next to
     the ticket ladder rather than as a fourth price card. */
  .oddc-convert-partner {
    background: var(--color-backstage);
    border: 1px solid var(--color-paper-12);
    padding: 2.2rem;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'eyebrow cta'
      'title   cta'
      'body    cta';
    align-items: center;
    column-gap: 3rem;
  }
  .oddc-convert-partner .eyebrow {
    grid-area: eyebrow;
    align-self: end;
  }
  .oddc-convert-partner h2 {
    grid-area: title;
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: 0.6rem 0 0;
    max-width: 28ch;
  }
  .oddc-convert-partner p {
    grid-area: body;
    align-self: start;
    margin: 0.8rem 0 0;
    max-width: var(--measure-prose);
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  .oddc-convert-partner :global(.pill) {
    grid-area: cta;
  }
  /* Back to a single column below 760px — `1fr auto` with Pill's
     white-space:nowrap keeps "Talk to us about partnering →" on one line,
     and below this width that unbreakable string starts taking the space the
     copy beside it needs. */
  @media (max-width: 760px) {
    .oddc-convert-partner {
      grid-template-columns: 1fr;
      grid-template-areas:
        'eyebrow'
        'title'
        'body'
        'cta';
      align-items: start;
    }
    .oddc-convert-partner :global(.pill) {
      justify-self: start;
      margin-top: 1.5rem;
    }
  }
  @media (max-width: 480px) {
    .oddc-convert-partner :global(.pill) {
      white-space: normal;
      text-align: center;
    }
  }

  /* Aftermovie — plain single poster+video block, only rendered once a real
     ODDference asset exists. */
  .oddc-aftermovie {
    margin-top: 2.5rem;
    position: relative;
    background: #000;
  }
  .oddc-aftermovie :global(img),
  .oddc-aftermovie video {
    width: 100%;
    height: min(78vh, 680px);
    object-fit: cover;
    display: block;
  }
  .oddc-aftermovie video {
    display: none;
  }

  /* Partners */
  .oddc-partners {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 3rem;
  }
  .oddc-partners :global(img) {
    height: 48px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }
</style>
