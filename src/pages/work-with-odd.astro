---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroCentered from '../components/sections/HeroCentered.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import PathwayList from '../components/sections/PathwayList.astro';
import CaseGrid from '../components/sections/CaseGrid.astro';
import LogoStrip from '../components/sections/LogoStrip.astro';
import WorkEnquiryForm from '../components/sections/WorkEnquiryForm.astro';

const entry = await getEntry('pages', 'work-with-odd');
if (!entry || entry.data._template !== 'work-with-odd')
  throw new Error('work-with-odd.json content entry missing or malformed');
const page = entry.data;
---

<Layout title={page.seo.title} description={page.seo.description} ogImage={page.seo.ogImage}>
  <HeroCentered
    eyebrow={page.eyebrow}
    title={page.title}
    intro={page.intro}
    primaryCta={page.primaryCta}
    image={page.heroImage}
    warpTitle
  />

  <section class="wwo-sub">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{page.whatWeDo.eyebrow}</span>
        <h2>{page.whatWeDo.headline}</h2>
      </div>
      <p class="wwo-lede reveal">{page.whatWeDo.body}</p>
    </div>
  </section>

  <PathwayList title="Ways to work with us" cards={page.pathways} />

  {
    /* "Why ODD" moved below the pathways (was bundled into the "What we
       do" section above, ahead of them) — a visitor should reach the
       actual ways to work with ODD before the supporting reasoning for
       why. No new heading here: whyOdd has no title/eyebrow field of its
       own (see content.config.ts) and each card already carries its own
       01/02/03 number, same treatment ODDfest's "How it works" uses. */
  }
  <section class="wwo-sub wwo-why-odd">
    <div class="wrap">
      <FeatureGrid cards={page.whyOdd} />
    </div>
  </section>

  {
    page.cases.length > 0 && (
      <section class="wwo-sub">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Selected work</span>
            <h2>Things we've built together</h2>
          </div>
          <CaseGrid items={page.cases} />
        </div>
      </section>
    )
  }

  {
    page.logos.length > 0 && (
      <LogoStrip eyebrow={page.network.eyebrow} title={page.network.title} items={page.logos} />
    )
  }

  <section class="wwo-sub" id="enquiry-form">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{page.contact.eyebrow}</span>
        <h2>{page.contact.title}</h2>
      </div>
      <p class="wwo-contact-body reveal">{page.contact.body}</p>
      <WorkEnquiryForm />
    </div>
  </section>
</Layout>

<style>
  .wwo-sub {
    padding: var(--space-24) 0;
  }
  /* Mobile rhythm. 6rem top+bottom is tuned for a desktop column; stacked on
     a phone it puts ~192px of empty screen between two sections (measured
     across /work-with-odd, /oddference, /oddspace, /about and /media). Halved
     to match layout.css's own `section` reduction at the same breakpoint, so
     page-level and component-level sections stay on one rhythm — see that
     file's comment, which flags exactly this class of override. */
  @media (max-width: 640px) {
    .wwo-sub {
      padding: var(--space-12) 0;
    }
  }
  /* FeatureGrid's own margin-top:4rem (tuned for sitting directly under a
     section-head + lede paragraph) stacks with this section's own already-
     generous --space-24 top padding when it's the section's only child —
     a real double-gap, same failure mode this codebase's other pages
     already fix at the source rather than override (see
     docs/architecture.md). Zeroed here since .wwo-sub's own padding is
     already the section's rhythm. */
  .wwo-why-odd :global(.oddf-grid) {
    margin-top: 0;
  }
  .wwo-lede {
    max-width: 40rem;
    margin: -1.5rem auto 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--color-paper-60);
  }
  .wwo-contact-body {
    max-width: 40rem;
    margin: -1.5rem auto var(--space-10);
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--color-paper-60);
  }
</style>
