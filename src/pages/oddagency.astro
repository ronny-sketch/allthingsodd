---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroCentered from '../components/sections/HeroCentered.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import CaseGrid from '../components/sections/CaseGrid.astro';
import PhotoBreak from '../components/sections/PhotoBreak.astro';
import Pill from '../components/primitives/Pill.astro';
import photoCraft from '../assets/hero/archive-09.jpg';

const entry = await getEntry('pages', 'oddagency');
if (!entry || entry.data._template !== 'oddagency')
  throw new Error('oddagency.json content entry missing or malformed');
const page = entry.data;
---

<Layout title={page.seo.title} description={page.seo.description} ogImage={page.seo.ogImage}>
  <!-- 2026-08-31 final implementation pass: dropped SubpageFrame's side-rail
       ticker + SplitHero in favour of Work with ODD's own HeroCentered —
       ODDagency is a deeper way to work with ODD, not a fourth core
       masterbrand product beside ODDfest/ODDference/ODDspace, so it
       shouldn't carry their same product-page chrome (the decorative rails
       + video/photo split hero). This brings it into the Work with ODD
       editorial family instead — same hero, same section rhythm. -->
  <HeroCentered
    eyebrow={page.eyebrow}
    title={page.title}
    intro={page.intro}
    image={page.heroMedia.image}
    primaryCta={page.primaryCta}
    warpTitle
  />

  <!-- "When ODDagency makes sense" — NEW SECTION (2026-09-02 copywriting
       pass), right after the hero: says when to buy ODDagency, which the
       old capabilities list didn't. Four concise panels via FeatureGrid
       (reused, not forked — same shape as capabilities/howItWorks below). -->
  <section class="odda-sub">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{page.whenThisWorks.eyebrow}</span>
        <h2>{page.whenThisWorks.headline}</h2>
      </div>
      <FeatureGrid cards={page.whenThisWorks.items} />
    </div>
  </section>

  <!-- Concise capabilities + kinds of questions — one chapter, not two
         (2026-08-31 final implementation pass: dropped the separate
         `features` grid, which repeated this same "what ODDagency can do"
         idea, and the old `whyOdd` grid). -->
  <section class="odda-sub">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Capabilities</span>
        <h2>What ODDagency contributes</h2>
      </div>
      <FeatureGrid cards={page.capabilities} />
      <div class="odda-type-list reveal">
        {page.projectTypes.map((t) => <span class="odda-type-tag">{t}</span>)}
      </div>
    </div>
  </section>

  <PhotoBreak image={photoCraft} alt="Musicians performing together at an ODD event" />

  <!-- Real cases when available — stays hidden while empty. -->
  {
    page.cases.length > 0 && (
      <section class="odda-sub">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Selected work</span>
            <h2>The work is easier to understand through the work.</h2>
          </div>
          <CaseGrid items={page.cases} />
        </div>
      </section>
    )
  }

  <!-- Compact how-we-work process. -->
  <section class="odda-sub">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Process</span>
        <h2>How a project works</h2>
      </div>
      <FeatureGrid cards={page.howItWorks} />
    </div>
  </section>

  <!-- Closing CTA — SIMPLIFIED (2026-09-02 copywriting pass) from a
       two-card ParticipateBand ("Bring us a brief" / "Talk to us first") to
       one clear exit. Plain headline + body + single Pill, not a card grid. -->
  <section class="odda-sub odda-closing">
    <div class="wrap">
      <h2>{page.closingCta.title}</h2>
      <p>{page.closingCta.body}</p>
      <Pill href={page.closingCta.href} variant="solid" magnetic>
        {page.closingCta.linkLabel}
      </Pill>
    </div>
  </section>
</Layout>

<style>
  .odda-sub {
    padding: var(--space-24) 0;
  }
  /* Mobile rhythm. 6rem top+bottom is tuned for a desktop column; stacked on
     a phone it puts ~192px of empty screen between two sections (measured
     across /work-with-odd, /oddference, /oddspace, /about and /media). Halved
     to match layout.css's own `section` reduction at the same breakpoint, so
     page-level and component-level sections stay on one rhythm — see that
     file's comment, which flags exactly this class of override. */
  @media (max-width: 640px) {
    .odda-sub {
      padding: var(--space-12) 0;
    }
  }
  .odda-type-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: var(--space-10);
  }
  .odda-type-tag {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-paper-80);
    background: var(--color-backstage);
    border: 1px solid var(--color-paper-12);
    border-radius: 999px;
    padding: 0.55rem 1.2rem;
  }

  /* Closing CTA — one clear exit, plain and centered rather than a card
     grid (see the comment above this section). */
  .odda-closing .wrap {
    max-width: 34rem;
    text-align: center;
  }
  .odda-closing h2 {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-paper);
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    margin: 0;
  }
  .odda-closing p {
    margin: 1.1rem 0 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-paper-60);
  }
  .odda-closing :global(.pill) {
    margin-top: 1.8rem;
  }
</style>
