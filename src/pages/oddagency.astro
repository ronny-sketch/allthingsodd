---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroCentered from '../components/sections/HeroCentered.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import CaseGrid from '../components/sections/CaseGrid.astro';
import ParticipateBand from '../components/sections/ParticipateBand.astro';
import PhotoBreak from '../components/sections/PhotoBreak.astro';
import photoCraft from '../assets/hero/archive-09.jpg';

const entry = await getEntry('pages', 'oddagency');
if (!entry || entry.data._template !== 'oddagency')
  throw new Error('oddagency.json content entry missing or malformed');
const page = entry.data;
---

<Layout title={page.seo.title} description={page.seo.description} ogImage={page.seo.ogImage}>
  <!-- 2026-08-31 final implementation pass: dropped SubpageFrame's side-rail
       ticker + SplitHero in favour of Work with ODD's own HeroCentered —
       ODDagency is a deeper way to work with ODD, not a fourth core
       masterbrand product beside ODDfest/ODDference/ODDspace, so it
       shouldn't carry their same product-page chrome (the decorative rails
       + video/photo split hero). This brings it into the Work with ODD
       editorial family instead — same hero, same section rhythm. -->
  <HeroCentered
    eyebrow={page.eyebrow}
    title={page.title}
    intro={page.intro}
    image={page.heroMedia.image}
    primaryCta={page.primaryCta}
    warpTitle
  />

  <!-- What the work is. -->
  <SectionIntro
    eyebrow={page.whatItIs.eyebrow}
    headline={page.whatItIs.headline}
    body={page.whatItIs.body}
  />

  <!-- Concise capabilities + kinds of questions — one chapter, not two
         (2026-08-31 final implementation pass: dropped the separate
         `features` grid, which repeated this same "what ODDagency can do"
         idea, and the `whyOdd` grid, whose "Network model"/"Real
         communities & platforms" copy was the internal/consultancy
         language the brief asks to remove). -->
  <section class="odda-sub">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Capabilities</span>
        <h2>What ODDagency can do</h2>
      </div>
      <FeatureGrid cards={page.capabilities} />
      <div class="odda-type-list reveal">
        {page.projectTypes.map((t) => <span class="odda-type-tag">{t}</span>)}
      </div>
    </div>
  </section>

  <PhotoBreak image={photoCraft} alt="Musicians performing together at an ODD event" />

  <!-- Real cases when available — stays hidden while empty. -->
  {
    page.cases.length > 0 && (
      <section class="odda-sub">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Selected work</span>
            <h2>Cases</h2>
          </div>
          <CaseGrid items={page.cases} />
        </div>
      </section>
    )
  }

  <!-- Compact how-we-work process. -->
  <section class="odda-sub">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Process</span>
        <h2>How a project works</h2>
      </div>
      <FeatureGrid cards={page.howItWorks} />
    </div>
  </section>

  <ParticipateBand items={page.participate} noPadTop />
</Layout>

<style>
  .odda-sub {
    padding: var(--space-24) 0;
  }
  .odda-type-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: var(--space-10);
  }
  .odda-type-tag {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-paper-80);
    background: var(--color-backstage);
    border: 1px solid var(--color-paper-12);
    border-radius: 999px;
    padding: 0.55rem 1.2rem;
  }
</style>
