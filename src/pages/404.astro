---
import Layout from '../layouts/Layout.astro';
import Pill from '../components/primitives/Pill.astro';
---

<Layout
  title="Page not found — ODD"
  description="This page doesn't exist. Find your way back to ODD's home page."
  noindex
>
  <section class="not-found">
    <div class="wrap">
      <div class="eyebrow">404</div>
      <h1>This page took a wrong turn.</h1>
      <p>Whatever you were looking for isn't here — but the rest of ODD is.</p>
      <Pill href="/" variant="solid" magnetic>Back to home</Pill>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    /* PageIntro's rhythm: one section gap under the nav, half a gap
       below. The min-height still centres the message in what's left. */
    padding-block: var(--space-section) calc(var(--space-section) / 2);
  }
  .not-found h1 {
    font: var(--text-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }
  .not-found p {
    font: var(--text-body);
    color: var(--color-paper-60);
    max-width: 40ch;
    margin: var(--space-5) auto 0;
  }
  .not-found :global(.pill) {
    margin-top: var(--space-6);
  }
</style>
