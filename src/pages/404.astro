---
import Layout from '../layouts/Layout.astro';
import Pill from '../components/primitives/Pill.astro';
---

<Layout
  title="Page not found — ODD"
  description="This page doesn't exist. Find your way back to ODD's home page."
>
  <section class="not-found">
    <div class="wrap">
      <div class="eyebrow">404</div>
      <h1>This page took a wrong turn.</h1>
      <p>Whatever you were looking for isn't here — but the rest of ODD is.</p>
      <Pill href="/" variant="solid" magnetic>Back to home</Pill>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-24) 0;
  }
  .not-found h1 {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-paper);
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    line-height: 1.08;
    margin: 0.9rem 0 0;
  }
  .not-found p {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-paper-60);
    max-width: 40ch;
    margin: 1.4rem auto 2rem;
  }
</style>
