---
// How suppliers invoice New Nordic Way rf: e-invoice, PDF and paper
// addresses, from the association's supplier notice (toimittajailmoitus).
// Linked from the footer's legal row. Same `legal` template as /privacy.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import LegalDocument from '../components/sections/LegalDocument.astro';

const entry = await getEntry('pages', 'invoicing');
if (!entry || entry.data._template !== 'legal')
  throw new Error('invoicing.json content entry missing or malformed');
const page = entry.data;

const sections = page.sections.map((section) => ({
  ...section,
  items: section.items?.map((item) => (typeof item === 'string' ? item : item.text)),
}));
---

<Layout title={page.seo.title} description={page.seo.description} ogImage={page.seo.ogImage}>
  <PageIntro eyebrow={page.eyebrow} title={page.title} intro={page.intro} />
  <LegalDocument lastUpdated={page.lastUpdated} sections={sections} contact={page.contact} />
</Layout>
