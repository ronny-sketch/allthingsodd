---
// ODDference ticket storefront. Deliberately not CloudCannon content —
// ticket types/prices/availability are dynamic, backend-owned data (see
// ../../../../odd-growth-os/ops/TICKETING_IMPLEMENTATION_PLAN.md), not
// editorial copy. This is a new, isolated commerce domain: it does not
// reuse PricingGrid.astro (shared with other pages' generic pricing
// display) or extend any existing content schema.
import Layout from '../../layouts/Layout.astro';
import Pill from '../../components/primitives/Pill.astro';
import { STRIPE_PUBLISHABLE_KEY } from '../../scripts/tickets/config';

// Whether this BUILD could ever open a sale. The full rule needs the hostname
// and so can only run in the browser (salesEnabled(), in config.ts), but its
// first clause is decidable here: without a live key the sale is closed on
// every public host, which is the only place a real visitor ever sees.
//
// That is what lets the not-yet-on-sale panel below be rendered VISIBLE
// rather than revealed by script — see its own comment for the 365px layout
// shift that cost when it was the other way round.
const saleCouldOpen = STRIPE_PUBLISHABLE_KEY?.startsWith('pk_live_') ?? false;
---

<Layout
  title="Tickets — ODDference 2027"
  description="ODDference 2027 tickets: the three tiers, their real prices, and how to get one."
>
  <section class="tix-page flow">
    {
      /* State-neutral heading and intro. They read true whether or not card
         payment is open, so neither has to be kept in sync with the sale
         state — see salesEnabled() in scripts/tickets/config.ts. */
    }
    <div class="wrap tix-head reveal">
      <span class="eyebrow">ODDference · 2027</span>
      <h1>Tickets</h1>
      <p>The three tiers, their real prices, and how to get one.</p>
    </div>

    {
      /* Shown when card payment is not open — see salesEnabled(). Rendered
         VISIBLE and hidden by storefront.ts where sales are open, which is
         the opposite of how this started (2026-09-21) and the opposite of
         what it looks like it should be.

         It started hidden and was revealed, so that an open sale would never
         flash a closed notice. But `salesEnabled()` reads the hostname, so
         the closed state is the only state a public host ever has: on
         allthingsodd.co the notice was revealed every single time, ~350px
         tall, and only once the catalogue fetch had resolved. Measured on
         production 2026-09-22: one shift of 0.153 at 557ms, CLS over the
         0.1 budget on the one route that takes money — while the same page
         measured 0.000 locally, because localhost is where sales are open
         and the notice never appears at all.

         Inverted, the flash lands where it is harmless. A public host paints
         the honest state and never moves. A dev host may show the notice for
         one frame before storefront.ts hides it, which no visitor sees and
         no budget measures. The no-JS reader now gets the closed notice too
         — true on production, and better than the nothing they saw before;
         the <noscript> below still explains the missing store. */
    }
    <div class="wrap tix-closed" id="tixClosed">
      <span class="eyebrow">Not yet on sale</span>
      <h2>Card payment isn't open yet.</h2>
      <p>
        The prices below are the real ones, and they are what we will charge. The card checkout is
        not finished, so we are not going to pretend it is. If you want a ticket now, ask us for an
        invoice — that route works today.
      </p>
      <div class="tix-closed-actions">
        <Pill
          href="mailto:hello@oddfest.co?subject=ODDference%202027%20%E2%80%94%20invoice%20request"
          variant="solid">Request an invoice</Pill
        >
        <Pill href="/contact/?topic=partnering" variant="outline">Ask about tickets</Pill>
      </div>
    </div>

    <div class="wrap tix-layout">
      <div class="tix-list" id="tixList" aria-busy="true">
        {
          /* Skeleton rows, and they exist for one measured reason: this list
             is rendered from the ticket catalogue after the page has painted,
             and it grew from 32px to 902px on desktop and 25px to 982px on a
             phone. Everything below it — the whole footer — dropped by that
             much about 600ms in. Measured CLS on /tickets was 0.26 against a
             0.1 budget, the only route on the site that failed it.

             Three rows, with three benefit lines on the first and one on the
             others, because that is the shape of the current ODDference
             catalogue. Deliberately NOT a `min-height`: rows are taller on a
             phone than on a desktop and the first tier is taller than the
             other two, so one reserved number would be wrong at most widths.
             Real markup laid out by the real CSS is right at every width by
             construction.

             The placeholder text is never read: `aria-hidden`, and
             `color: transparent` so it reserves a line box without showing a
             fake price. It says nothing about what a ticket costs — the
             numbers come from the catalogue, and inventing one here is
             exactly what this page must not do. storefront.ts replaces the
             whole list on render, so these never survive a successful load. */
        }
        <p class="sr-only" role="status">Loading tickets…</p>
        {
          [3, 1, 1].map((benefitLines) => (
            <div class="tix-row tix-row-skeleton" aria-hidden="true">
              <div class="tix-row-main">
                <div class="tix-row-info">
                  <span class="tix-row-name">Ticket tier</span>
                  <p class="tix-row-desc">
                    A description of about the length the ticket descriptions on this page run to.
                  </p>
                  <ul class="tix-row-benefits">
                    {Array.from({ length: benefitLines }).map(() => (
                      <li>Included with this tier</li>
                    ))}
                  </ul>
                </div>
                <div class="tix-row-price">
                  &euro;000<span class="tix-row-price-vat">+ VAT</span>
                </div>
              </div>
              <div class="tix-row-action">
                <span class="tix-status-badge">Loading</span>
              </div>
            </div>
          ))
        }
      </div>
      <aside class="tix-summary" id="tixSummary" aria-label="Your order"></aside>
    </div>
    <p id="tixCartStatus" class="sr-only" role="status" aria-live="polite"></p>

    {
      /* The whole store is client-rendered from the ticket catalogue, so
         without JavaScript this page would otherwise sit on "Loading
         tickets…" for ever. Say so, and point at the two places that work
         without it: the prices on /oddference, and a human. */
    }
    <noscript>
      <div class="wrap tix-noscript">
        <p>
          The ticket store needs JavaScript to show live prices and availability. The tiers and
          their prices are also listed on the <a href="/oddference/#tickets">ODDference page</a>,
          and you can always <a href="/contact/?topic=partnering">ask us about a ticket</a> or email
          <a href="mailto:hello@oddfest.co">hello@oddfest.co</a>.
        </p>
      </div>
    </noscript>
  </section>

  <button type="button" class="tix-mobile-bar" id="tixMobileBar" hidden>
    <span id="tixMobileBarSummary"></span>
    <span class="tix-mobile-bar-cta">View order</span>
  </button>
  <div class="tix-sheet-backdrop" id="tixSheetBackdrop" hidden></div>
  <div
    class="tix-sheet"
    id="tixSheet"
    hidden
    role="dialog"
    aria-modal="true"
    aria-label="Your order"
  >
    <div class="tix-sheet-handle" aria-hidden="true"></div>
    <button
      type="button"
      class="tix-sheet-close"
      id="tixSheetClose"
      aria-label="Close order summary">&times;</button
    >
    <div id="tixSheetContent"></div>
  </div>

  <script src="../../scripts/tickets/storefront.ts"></script>
</Layout>

<style>
  /* PageIntro's rhythm: one section gap under the nav, half a gap
     below (layout.css, section rhythm). */
  .tix-page {
    padding-block: var(--space-section) calc(var(--space-section) / 2);
  }
  .tix-head {
    max-width: 40rem;
    text-align: center;
  }
  .tix-head h1 {
    font: var(--text-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }
  .tix-head p {
    margin: var(--space-5) 0 0;
    font: var(--text-body);
    color: var(--color-paper-60);
  }

  /* The not-yet-on-sale panel and the no-JS notice. Both hold content, so
     both are square (design-system rule 6), and both take the same surface
     as .tix-row so the page reads as one system. No outer block margin —
     the section's .flow owns the gap above them (rule 7). */
  .tix-closed,
  .tix-noscript {
    max-width: 44rem;
    margin-inline: auto;
  }
  .tix-closed > *,
  .tix-noscript > * {
    margin: 0;
  }
  .tix-closed {
    padding: var(--space-8);
    background: var(--color-backstage);
    border: 1px solid var(--color-paper-12);
    text-align: center;
  }
  /* [hidden]'s UA display:none loses to the author rules above at equal
     specificity in some engines once a display is set, so state it — the
     same tie already documented on .tix-mobile-bar[hidden] below. */
  .tix-closed[hidden] {
    display: none;
  }
  .tix-closed h2 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin-block-start: var(--space-3);
    text-wrap: balance;
  }
  .tix-closed p {
    margin-block-start: var(--space-5);
    font: var(--text-body);
    color: var(--color-paper-80);
  }
  .tix-closed-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }
  .tix-noscript p {
    font: var(--text-body);
    color: var(--color-paper-80);
  }

  /* The page title is a group of its own, not a section-head: the store
     below it starts one group step down (a replacement for the flow step). */
  .tix-layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-block-start: var(--space-group);
  }
  @media (max-width: 900px) {
    .tix-layout {
      grid-template-columns: 1fr;
    }
  }

  .tix-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-grid);
    min-width: 0;
  }
  /* The skeleton holds space and nothing else: no text visible, no border
     that would read as a real card that failed to fill in. */
  .tix-row-skeleton {
    color: transparent;
    border-color: var(--color-paper-06);
    background: var(--color-paper-06);
  }
  .tix-row-skeleton :global(.tix-row-benefits li::before) {
    background: var(--color-paper-12);
  }
  .tix-loading,
  .tix-error,
  .tix-empty {
    margin: 0;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  :global(.tix-cart-notice) {
    margin: 0;
    padding: 0.8rem 1rem;
    background: var(--color-backstage);
    border: 1px solid var(--color-paper-12);
    font: var(--text-body);
    color: var(--color-paper-80);
  }

  :global(.tix-row) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: 1.5rem;
    background: var(--color-backstage);
    border: 1px solid var(--color-paper-12);
  }
  :global(.tix-row.is-inactive) {
    opacity: 0.55;
  }
  :global(.tix-row-main) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
  }
  /* Phones: the Heading-size price beside the name left the name,
     description and benefits a 130-200px column. They stack instead. */
  @media (max-width: 480px) {
    :global(.tix-row-main) {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
  :global(.tix-row-info) {
    min-width: 0;
  }
  :global(.tix-row-name) {
    display: block;
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    text-wrap: balance;
  }
  :global(.tix-row-desc) {
    margin: var(--space-3) 0 0;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  :global(.tix-row-benefits) {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  :global(.tix-row-benefits li) {
    font: var(--text-body);
    color: var(--color-paper-80);
    padding-left: 1rem;
    position: relative;
  }
  :global(.tix-row-benefits li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 4px;
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--color-signal-deep);
  }
  :global(.tix-row-price) {
    flex-shrink: 0;
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    white-space: nowrap;
  }
  /* "+ VAT 13.5%" under an ex-VAT price. */
  :global(.tix-row-price-vat) {
    display: block;
    text-align: right;
    font: var(--text-small);
    letter-spacing: normal;
    color: var(--color-paper-60);
  }
  :global(.tix-row-action) {
    display: flex;
    justify-content: flex-end;
  }
  :global(.tix-status-badge) {
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-paper-40);
  }

  /* Quantity stepper — 44px minimum touch target on every device, not just mobile. */
  :global(.tix-stepper) {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  :global(.tix-stepper-btn) {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-paper-20);
    background: transparent;
    color: var(--color-paper);
    /* A +/− glyph centred in a 44px circle: the Body size, on a line box
       exactly one glyph tall. */
    font-family: var(--font-body);
    font-size: var(--font-size-body);
    line-height: 1;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) ease,
      opacity var(--duration-fast) ease;
  }
  :global(.tix-stepper-btn:hover:not(:disabled)) {
    border-color: var(--color-paper);
  }
  :global(.tix-stepper-btn:disabled) {
    opacity: 0.3;
    cursor: not-allowed;
  }
  :global(.tix-stepper-qty) {
    min-width: 1.6rem;
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--font-size-body);
    color: var(--color-paper);
  }

  /* Desktop sticky summary */
  .tix-summary {
    position: sticky;
    top: calc(var(--nav-h) + var(--space-6));
    background: var(--color-backstage);
    border: 1px solid var(--color-paper-12);
    padding: 1.75rem;
  }
  @media (max-width: 900px) {
    .tix-summary {
      display: none;
    }
  }
  .tix-summary :global(.eyebrow) {
    display: block;
    margin-bottom: var(--space-4);
  }
  .tix-summary :global(.tix-summary-empty) {
    margin: 0;
    font: var(--text-small);
    color: var(--color-paper-40);
  }
  .tix-summary :global(.tix-summary-lines) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .tix-summary :global(.tix-summary-line) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font: var(--text-small);
    color: var(--color-paper-80);
  }
  /* Forta at the Body size — the order total in a compact summary panel. */
  .tix-summary :global(.tix-summary-total-row) {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-paper-12);
    font-family: var(--font-display);
    font-size: var(--font-size-body);
    color: var(--color-paper);
  }
  /* Subtotal + VAT rows between the ticket lines and the total, only when
     VAT is added on top of an ex-VAT price. */
  .tix-summary :global(.tix-summary-vat),
  .tix-sheet :global(.tix-summary-vat) {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-paper-12);
  }
  .tix-summary :global(.tix-summary-vat-note) {
    margin: var(--space-2) 0 0;
    font: var(--text-small);
    color: var(--color-paper-40);
  }
  .tix-summary :global(.tix-checkout-btn) {
    display: block;
    width: 100%;
    text-align: center;
    margin-top: var(--space-6);
  }
  .tix-summary :global(.tix-checkout-btn:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* Mobile fixed bottom bar — appears once cart > 0, opens the bottom sheet.
     A real <button> (not a clickable div) so it's keyboard-operable and
     gets a real accessible name for free — see CLAUDE.md's "no custom
     controls that only work with pointer devices" rule. */
  .tix-mobile-bar {
    display: none;
  }
  @media (max-width: 900px) {
    .tix-mobile-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 1rem 1.25rem;
      padding-bottom: max(1rem, env(safe-area-inset-bottom));
      background: var(--color-ink);
      border: none;
      border-top: 1px solid var(--color-paper-20);
      font: var(--text-small);
      color: var(--color-paper);
      cursor: pointer;
      min-height: 44px;
      text-align: left;
    }
    /* The [hidden] attribute's UA-stylesheet display:none is lower
       specificity than the class rule above, which would otherwise win at
       this breakpoint and show the bar even with an empty cart — verified
       live (a real bug, not theoretical) via Chrome DevTools before this
       fix. */
    .tix-mobile-bar[hidden] {
      display: none;
    }
  }
  .tix-mobile-bar-cta {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tix-sheet-backdrop {
    position: fixed;
    inset: 0;
    z-index: 49;
    background: rgb(14 9 11 / 55%);
  }
  .tix-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    max-height: 80vh;
    overflow-y: auto;
    background: var(--color-backstage);
    border-top: 1px solid var(--color-paper-20);
    border-radius: var(--radius-panel) var(--radius-panel) 0 0;
    padding: 1rem 1.5rem calc(1.5rem + env(safe-area-inset-bottom));
  }
  .tix-sheet-handle {
    width: 40px;
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--color-paper-20);
    margin: 0 auto var(--space-4);
  }
  .tix-sheet-close {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    color: var(--color-paper-60);
    /* The × is an icon glyph, sized on the Heading step. */
    font-size: var(--font-size-heading);
    cursor: pointer;
  }
  .tix-sheet :global(.eyebrow) {
    display: block;
    margin-bottom: var(--space-4);
  }
  .tix-sheet :global(.tix-summary-lines) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .tix-sheet :global(.tix-summary-line) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font: var(--text-small);
    color: var(--color-paper-80);
  }
  .tix-sheet :global(.tix-summary-total-row) {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-paper-12);
    font-family: var(--font-display);
    font-size: var(--font-size-body);
    color: var(--color-paper);
  }
  .tix-sheet :global(.tix-summary-vat-note) {
    margin: var(--space-2) 0 0;
    font: var(--text-small);
    color: var(--color-paper-40);
  }
  .tix-sheet :global(.tix-checkout-btn) {
    display: block;
    width: 100%;
    text-align: center;
    margin-top: var(--space-6);
  }
</style>
