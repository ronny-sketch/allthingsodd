---
// Buyer details + secure Stripe payment. Minimal fields before payment by
// design (see ../../../../odd-growth-os/ops/TICKETING_IMPLEMENTATION_PLAN.md
// and CLAUDE.md's low-friction-checkout instruction) — no account creation,
// attendee assignment happens after payment on /tickets/confirmation.
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Checkout — ODDference 2027"
  description="Complete your ODDference 2027 ticket purchase securely."
  noindex
>
  <section class="tixc-page">
    <div class="wrap flow">
      <div class="tixc-head reveal">
        <span class="eyebrow">ODDference · 2027</span>
        <h1>Checkout</h1>
      </div>

      <p id="tixcEmptyNotice" class="tixc-empty" hidden>
        Your cart is empty. <a href="/tickets">Choose your tickets</a>.
      </p>

      {
        /* Card payment not open — see salesEnabled() in
           scripts/tickets/config.ts. Reachable by a direct link or a stale
           cart, so this page has to answer for itself rather than assume
           nobody arrives here. */
      }
      <p id="tixcClosed" class="tixc-empty" hidden>
        Card payment isn't open yet, so there is nothing to check out. The tiers and their real
        prices are on the <a href="/tickets">ticket page</a>, and you can
        <a href="mailto:hello@oddfest.co?subject=ODDference%202027%20%E2%80%94%20invoice%20request"
          >request an invoice</a
        > or <a href="/contact/?topic=partnering">ask us about a ticket</a> today.
      </p>

      <div class="tixc-layout" id="tixcLayout">
        <div class="tixc-main">
          <form id="tixcBuyerForm" novalidate>
            <h2>Your details</h2>
            <div class="field">
              <label for="tixc-email">Email</label>
              <input id="tixc-email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="tixc-name">Full name</label>
              <input id="tixc-name" name="name" type="text" required autocomplete="name" />
            </div>
            <label class="tixc-checkbox">
              <input type="checkbox" id="tixc-company-toggle" />
              Buying as a company
            </label>
            <div class="tixc-company-fields" id="tixcCompanyFields" hidden>
              <div class="field">
                <label for="tixc-company">Company name</label>
                <input
                  id="tixc-company"
                  name="companyName"
                  type="text"
                  autocomplete="organization"
                />
              </div>
              <div class="field">
                <label for="tixc-vat">VAT ID</label>
                <input id="tixc-vat" name="vatId" type="text" />
              </div>
            </div>
            <p class="tixc-status" id="tixcStatus" role="status" aria-live="polite"></p>
            <p class="tixc-not-connected" id="tixcNotConnected" hidden>
              Payment isn't connected yet — email
              <a href="mailto:hello@oddfest.co">hello@oddfest.co</a> to reserve your ticket in the meantime.
            </p>
            <button type="submit" class="pill pill-solid tixc-continue-btn" id="tixcContinueBtn">
              Continue to payment
            </button>
          </form>

          <div id="tixcPaymentSection" class="tixc-payment" hidden>
            <h2>Payment</h2>
            <div id="tixcCheckoutMount"></div>
            <p class="tixc-payment-error" id="tixcPaymentError" role="alert" hidden></p>
          </div>

          <div class="tixc-invoice-toggle-wrap">
            <button
              type="button"
              class="tixc-invoice-toggle-btn"
              id="tixcInvoiceToggle"
              aria-expanded="false"
              aria-controls="tixcInvoiceForm"
            >
              Prefer an invoice? Request one →
            </button>
          </div>

          <form id="tixcInvoiceForm" class="tixc-invoice-form" hidden novalidate>
            <h2>Request an invoice</h2>
            <p class="tixc-invoice-intro">
              Choose the ticket type and quantity, then send the request from your email app. We
              will reply with the invoice and next steps.
            </p>
            <div class="field">
              <label for="tixc-inv-ticket">Ticket type</label>
              <select id="tixc-inv-ticket" name="ticketTypeId" required></select>
            </div>
            <div class="field">
              <label for="tixc-inv-qty">Number of tickets</label>
              <input
                id="tixc-inv-qty"
                name="quantity"
                type="number"
                inputmode="numeric"
                min="1"
                step="1"
                value="1"
                required
              />
            </div>
            <div class="field">
              <label for="tixc-inv-name">Full name</label>
              <input id="tixc-inv-name" name="name" type="text" required autocomplete="name" />
            </div>
            <div class="field">
              <label for="tixc-inv-email">Email</label>
              <input id="tixc-inv-email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="tixc-inv-company">Company (optional)</label>
              <input id="tixc-inv-company" name="company" type="text" autocomplete="organization" />
            </div>
            <a
              id="tixcInvoiceSubmit"
              class="pill pill-outline tixc-invoice-submit-btn"
              href="#"
              aria-disabled="true"
            >
              Send invoice request
            </a>
          </form>
        </div>

        <aside class="tixc-summary" id="tixcSummary" aria-label="Order summary"></aside>
      </div>
    </div>
  </section>

  <script src="../../scripts/tickets/checkout.ts"></script>
</Layout>

<style>
  /* PageIntro's rhythm: one section gap under the nav, half a gap
     below (layout.css, section rhythm). */
  .tixc-page {
    padding-block: var(--space-section) calc(var(--space-section) / 2);
  }
  .tixc-head h1 {
    font: var(--text-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }
  /* The empty-cart line takes the wrap's flow step; only its UA bottom
     margin needs clearing. */
  .tixc-empty {
    margin-block-end: 0;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  .tixc-empty a {
    color: var(--color-paper);
  }

  /* The page title is a group of its own, not a section-head: the form
     starts one group step below it (a replacement for the flow step). Row
     gap: the cart notice above, and the summary once stacked (≤860px). */
  .tixc-layout {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-group) 2.5rem;
    align-items: start;
    margin-block-start: var(--space-group);
  }
  /* [hidden] (UA stylesheet, display:none) and .tixc-layout (this file,
     display:grid) tie on specificity — author CSS wins the tie, so the
     `hidden` attribute checkout.ts sets for an empty cart was silently
     losing to this rule and rendering the (empty) layout anyway. Same bug
     class the PR #9 commit already fixed once for the mobile cart bar's
     [hidden]; this instance was missed. */
  .tixc-layout[hidden] {
    display: none;
  }
  @media (max-width: 860px) {
    .tixc-layout {
      grid-template-columns: 1fr;
    }
  }

  :global(.tixc-cart-notice) {
    grid-column: 1 / -1;
    margin: 0;
    padding: 0.8rem 1rem;
    background: var(--color-backstage);
    border: 1px solid var(--color-paper-12);
    font: var(--text-body);
    color: var(--color-paper-80);
  }

  /* No margin of its own: in both forms the flex gap already sits under the
     heading (it used to stack on top of it), and the payment block spaces
     its mount the same step below. */
  .tixc-main h2 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: 0;
  }

  #tixcBuyerForm {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .field label {
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-40);
  }
  .field input {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-paper-20);
    padding: 0.6rem 0;
    /* Body — whose 1rem floor is also the iOS no-zoom guarantee. */
    font: var(--text-body);
    color: var(--color-paper);
    outline: none;
    transition: border-color var(--duration-fast) ease;
  }
  .field input:focus {
    border-color: var(--color-paper);
  }
  .field input:disabled {
    opacity: 0.5;
  }
  .tixc-checkbox {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font: var(--text-body);
    color: var(--color-paper-80);
    cursor: pointer;
  }
  .tixc-checkbox input {
    width: 18px;
    height: 18px;
  }
  .tixc-company-fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-paper-12);
  }
  .tixc-status {
    margin: 0;
    font: var(--text-small);
    color: var(--color-paper-60);
    min-height: 1.2em;
  }
  .tixc-not-connected {
    margin: 0;
    padding: 0.9rem 1rem;
    background: var(--color-backstage);
    border: 1px solid var(--color-paper-12);
    font: var(--text-body);
    color: var(--color-paper-80);
  }
  .tixc-not-connected a {
    color: var(--color-paper);
  }
  .tixc-continue-btn {
    align-self: flex-start;
  }
  .tixc-continue-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* The three ruled groups below each open one group step either side of
     their rule — the rule is the joint, not a reason to double it. */
  .tixc-payment {
    margin-top: var(--space-group);
    padding-top: var(--space-group);
    border-top: 1px solid var(--color-paper-12);
  }
  #tixcCheckoutMount {
    min-height: 320px;
    margin-top: var(--space-6);
  }
  .tixc-payment-error {
    margin: var(--space-4) 0 0;
    padding: 0.9rem 1rem;
    background: rgb(154 67 43 / 12%);
    border: 1px solid rgb(154 67 43 / 40%);
    font: var(--text-body);
    color: var(--color-paper);
  }

  .tixc-invoice-toggle-wrap {
    margin-top: var(--space-group);
    padding-top: var(--space-group);
    border-top: 1px solid var(--color-paper-12);
  }
  .tixc-invoice-toggle-btn {
    background: none;
    border: none;
    padding: 0;
    font: var(--text-small);
    color: var(--color-paper-60);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .tixc-invoice-toggle-btn:hover {
    color: var(--color-paper);
  }

  .tixc-invoice-form {
    margin-top: var(--space-group);
    padding-top: var(--space-group);
    border-top: 1px solid var(--color-paper-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  /* Same [hidden]-vs-author-CSS specificity tie as .tixc-layout[hidden]
     above — author `display: flex` wins the tie over the UA stylesheet's
     `display: none`, so the `hidden` attribute alone doesn't hide this. */
  .tixc-invoice-form[hidden] {
    display: none;
  }
  .tixc-invoice-intro {
    max-width: var(--measure-prose);
    margin: 0;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  .tixc-invoice-form select {
    background: var(--color-ink);
    border: none;
    border-bottom: 1px solid var(--color-paper-20);
    padding: 0.6rem 0;
    font: var(--text-body);
    color: var(--color-paper);
    outline: none;
  }
  .tixc-invoice-submit-btn {
    align-self: flex-start;
  }
  .tixc-invoice-submit-btn[aria-disabled='true'] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .tixc-summary {
    position: sticky;
    top: calc(var(--nav-h) + var(--space-6));
    background: var(--color-backstage);
    border: 1px solid var(--color-paper-12);
    padding: 1.75rem;
  }
  .tixc-summary :global(.eyebrow) {
    display: block;
    margin-bottom: var(--space-4);
  }
  .tixc-summary :global(.tixc-summary-lines) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .tixc-summary :global(.tixc-summary-line) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font: var(--text-small);
    color: var(--color-paper-80);
  }
  /* Forta at the Body size — the order total in a compact summary panel. */
  .tixc-summary :global(.tixc-summary-total-row) {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-paper-12);
    font-family: var(--font-display);
    font-size: var(--font-size-body);
    color: var(--color-paper);
  }
  /* Subtotal + VAT rows between the ticket lines and the total, only when
     VAT is added on top of an ex-VAT price. */
  .tixc-summary :global(.tixc-summary-vat) {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-paper-12);
  }
  .tixc-summary :global(.tixc-summary-vat-note) {
    margin: var(--space-2) 0 0;
    font: var(--text-small);
    color: var(--color-paper-40);
  }
</style>
