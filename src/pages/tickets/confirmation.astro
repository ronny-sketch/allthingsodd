---
// Order confirmation. Never shows "paid" from the
// Stripe redirect alone — see ../../scripts/tickets/confirmation.ts,
// which polls the backend order status (only the webhook handler ever
// sets it to 'paid'). See
// ../../../../odd-growth-os/ops/TICKETING_IMPLEMENTATION_PLAN.md.
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Pill from '../../components/primitives/Pill.astro';

const site = await getEntry('site', 'global');
if (!site) throw new Error('Missing site/global.json content entry');
const { social } = site.data;
---

<Layout
  title="Order confirmation — ODDference 2027"
  description="Your ODDference 2027 order confirmation."
  noindex
>
  <section class="tixf-page">
    <div class="wrap">
      <!-- One real, shared h1 for the whole page — confirmation.ts sets its
           text per state instead of each state carrying its own hidden h1.
           Five parallel <h1>s (only one ever unhidden) would still pass a
           screen reader's "hidden content is inert" check, but it fails the
           sitewide "exactly one h1 per page" assertion
           (tests/visual/pages.spec.ts) the same way a real duplicate would —
           and there's only ever one real heading role on this page regardless
           of state, so one element is the more accurate markup anyway. -->
      <span class="eyebrow">ODDference · 2027</span>
      {
        /* Not empty. This h1 shipped with no content at all, so a reader
           whose JavaScript failed — or a screen reader arriving before
           confirmation.ts ran — got a page whose only heading was blank.
           "Checking your order…" is the state the page really is in on
           arrival (#tixfProcessing is what confirmation.ts shows first), and
           its HEADINGS map overwrites this the moment a state resolves. */
      }
      <h1 id="tixfHeading">Checking your order…</h1>

      <div id="tixfProcessing" class="tixf-state" hidden>
        <p>This usually takes a few seconds. Do not close this page.</p>
        <div class="tixf-spinner" aria-hidden="true"></div>
      </div>

      <!-- Ronny's wording (2026-10-08). The same email goes out from the
           Worker's webhook (odd-growth-os worker/src/tickets/
           confirmation-email.ts) — keep the two saying the same thing. No
           tickets or QR codes here: the official ticket follows by email. -->
      <div id="tixfSuccess" class="tixf-state" hidden>
        <p>
          Your order is confirmed<span id="tixfCodeLine" hidden
            >, confirmation code <strong id="tixfCode"></strong></span
          >. We've emailed you a confirmation.
        </p>
        <p>
          Your official event ticket and event info will arrive by email no later than one month
          before the event, by 22 March 2027.
        </p>
        <p>
          In the meantime, <a href="#newsletter">sign up to our newsletter</a> and follow us on {
            social.map((s, i) => (
              <>
                {i > 0 && (i === social.length - 1 ? ' and ' : ', ')}
                <a href={s.href} rel="noopener">
                  {s.platform}
                </a>
              </>
            ))
          } to stay up to date.
        </p>
      </div>

      <div id="tixfFailed" class="tixf-state" hidden>
        <p id="tixfFailedMessage"></p>
        <Pill href="/tickets">Back to tickets</Pill>
      </div>

      <div id="tixfTimeout" class="tixf-state" hidden>
        <p>
          This is taking longer than expected. Refresh this page in a minute. If you were charged,
          your order is safe.
        </p>
      </div>

      <div id="tixfNotFound" class="tixf-state" hidden>
        <p>
          We could not find this order. If you just completed a purchase, your confirmation is in
          your email. Not there? <a href="mailto:hello@oddfest.co">Contact us</a>.
        </p>
        <Pill href="/tickets">Back to tickets</Pill>
      </div>
    </div>
  </section>

  <script src="../../scripts/tickets/confirmation.ts"></script>
</Layout>

<style>
  /* PageIntro's rhythm: one section gap under the nav, half a gap
     below (layout.css, section rhythm). The eyebrow/h1/state stack is one
     intro's internals, so it keeps its own small steps rather than .flow. */
  .tixf-page {
    padding-block: var(--space-section) calc(var(--space-section) / 2);
  }
  .tixf-state {
    max-width: 40rem;
  }
  #tixfHeading {
    font: var(--text-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }
  .tixf-state p {
    margin: var(--space-5) 0 0;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  .tixf-state strong {
    color: var(--color-paper);
  }
  .tixf-state a:not(.pill) {
    color: var(--color-paper);
  }
  /* "Back to tickets" sat flush under its paragraph. inline-block so the
     top margin applies to the bare link. */
  /* :global — Pill renders in its own scope, not this page's. */
  .tixf-state :global(.pill) {
    display: inline-block;
    margin-top: var(--space-6);
  }
  .tixf-spinner {
    margin-top: var(--space-6);
    width: 28px;
    height: 28px;
    border-radius: var(--radius-pill);
    border: 3px solid var(--color-paper-20);
    border-top-color: var(--color-paper);
  }
  @media (prefers-reduced-motion: no-preference) {
    .tixf-spinner {
      animation: tixf-spin 0.8s linear infinite;
    }
  }
  @keyframes tixf-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
