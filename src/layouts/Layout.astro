---
import '../styles/global.css';
import Nav from '../components/navigation/Nav.astro';
import Footer from '../components/navigation/Footer.astro';
import MobileMenu from '../components/navigation/MobileMenu.astro';
import Cursor from '../components/media/Cursor.astro';
import SteamFilters from '../components/media/SteamFilters.astro';
import StructuredData from '../components/media/StructuredData.astro';
import NewsletterPopup from '../components/media/NewsletterPopup.astro';
import ConsentBanner from '../components/navigation/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** URL of the first image a page paints, if it has an image-heavy hero
   * worth a head start — see index.astro for how the home page computes it.
   * (Home's real LCP element is its <h1>, not this image; see Hero.astro's
   * .hero-headline comment. This preload is about the hero's first
   * photograph appearing promptly, not about the metric.) */
  preloadImage?: string;
  /** The same image's responsive candidate set. Required whenever the
   * preloaded <img> itself uses srcset: without them the preload names one
   * fixed file while the img picks another, so the browser downloads both.
   * See src/components/sections/mosaic-images.ts. */
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
  /** 'light' flips the whole page — Nav/Footer/MobileMenu included, via the
   * `.theme-light` token scope in tokens.css — to ODDspace's inverse
   * identity. Every other page omits this and stays the sitewide dark
   * ground. See tokens.css's own comment on `.theme-light` for why this is
   * a single class on <body> rather than a per-component light variant. */
  theme?: 'light';
  /** Transient/private pages (checkout, order confirmation) — keeps them
   * out of search results without affecting any of the site's ten real
   * content pages, which never set this. */
  noindex?: boolean;
}
const {
  title,
  description,
  ogImage,
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,
  theme,
  noindex,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Path-preserving redirect from the retired production host
// (odd-field-guide.surge.sh) to the canonical one (allthingsodd.co).
//
// Why this is JavaScript and not a real 301: Surge serves redirects from a
// ROUTER file, and ROUTER files are a paid-plan feature (verified against
// surge.sh/docs/platform/redirects and .../plans; this account is on Free —
// custom domains and managed SSL are free, per-request server features are
// not). A genuine 301 on the old hostname is not available without
// upgrading the plan, so this is the lowest-risk free equivalent: keep
// publishing the identical build to the old host (nothing 404s, no existing
// link on the internet dies) and hand visitors forward to the same path on
// the new one.
//
// Search-engine consolidation does NOT depend on this script — every page's
// <link rel="canonical"> and og:url below already point at allthingsodd.co
// (from `site` in astro.config.mjs), which is the signal Google actually
// uses to fold duplicate hosts together. This is for humans following old
// links.
//
// Off by default. `PUBLIC_LEGACY_REDIRECT` is set to '1' in the deploy job
// (.github/workflows/ci.yml) only once allthingsodd.co is confirmed
// resolving over HTTPS — enabling it before DNS lands would bounce every
// visitor on the old host to a domain that doesn't answer, i.e. take
// production down for exactly the audience it exists to protect.
// See docs/deployment.md#domain-migration.
const legacyRedirect = import.meta.env.PUBLIC_LEGACY_REDIRECT === '1';

/** See the <script is:inline> in <head> below for what this is and why. */
const revealOptIn = `(function(){var d=document.documentElement;try{if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches&&'IntersectionObserver' in window){d.classList.add('reveal-js');setTimeout(function(){if(!d.hasAttribute('data-reveal-ready'))d.classList.remove('reveal-js');},4000);}}catch(e){d.classList.remove('reveal-js');}})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {
      /* First script in <head>, is:inline and synchronous, so an old-host
         visitor is forwarded before any of this page paints. Only the
         retired production host redirects — the preview deployment
         (allthingsodd-preview.surge.sh) deliberately does not, since its
         whole job is showing a build that is NOT production. `replace`, not
         `assign`: the old URL must not sit in the back-stack, or Back from
         the new site bounces the visitor straight forward again. */
      legacyRedirect && (
        <script
          is:inline
          set:html="if(location.hostname==='odd-field-guide.surge.sh')location.replace('https://allthingsodd.co'+location.pathname+location.search+location.hash)"
        />
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          imagesrcset={preloadImageSrcset}
          imagesizes={preloadImageSizes}
          fetchpriority="high"
        />
      )
    }

    <meta property="og:type" content="website" />
    {
      /* The website's own name, distinct from each page's og:title. "All
         Things ODD" is the umbrella site/project (2026-09-04); ODD remains
         the masterbrand and ODDfest/ODDference/ODDspace/ODDagency remain its
         products, which is why this is the one place the phrase belongs and
         product page titles stay product-first. */
    }
    <meta property="og:site_name" content="All Things ODD" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={new URL(ogImage, Astro.site)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <StructuredData />
    <!--
      Reveal-animation opt-in, inline and render-blocking on purpose.
      `.reveal`'s hidden state is scoped to `html.reveal-js` (see
      styles/motion.css) so that content is visible by default and the
      animation only exists when the script able to undo it is running. That
      scope has to be on <html> before the first paint — adding it from the
      deferred src/scripts/reveal.ts module instead would paint every section
      visible, then blank it, then fade it back in.

      The timer is the failure backstop: src/scripts/reveal.ts sets
      data-reveal-ready as soon as it runs, so this only ever fires when that
      module didn't (a bundle that 404s, a script error, an engine that chokes
      on it) — in which case the scope is dropped and the page renders as
      plain, visible, un-animated content rather than staying at opacity 0
      forever.

      Built as a string handed to set:html rather than written as literal
      script body: prettier's Astro plugin cannot parse an inline <script>
      here and fails `npm run format:check` outright.
    -->
    <script is:inline set:html={revealOptIn} />
  </head>
  <body class={theme === 'light' ? 'theme-light' : undefined}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>
    <SteamFilters />
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <MobileMenu />
    <NewsletterPopup />
    <ConsentBanner />
    <Cursor />
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/magnetic.ts"></script>
    <script src="../scripts/nav-height.ts"></script>
  </body>
</html>
