---
import '../styles/global.css';
import Nav from '../components/navigation/Nav.astro';
import Footer from '../components/navigation/Footer.astro';
import MobileMenu from '../components/navigation/MobileMenu.astro';
import Cursor from '../components/media/Cursor.astro';
import SteamFilters from '../components/media/SteamFilters.astro';
import StructuredData from '../components/media/StructuredData.astro';
import ConsentBanner from '../components/navigation/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** URL of this page's real LCP candidate, if it has an image-heavy hero
   * worth preloading — see index.astro for how the home page computes it. */
  preloadImage?: string;
}
const { title, description, ogImage, preloadImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={new URL(ogImage, Astro.site)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <StructuredData />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <SteamFilters />
    <Nav />
    <slot />
    <Footer />
    <MobileMenu />
    <ConsentBanner />
    <Cursor />
    <script src="../scripts/reduced-motion-video.ts"></script>
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/magnetic.ts"></script>
    <script src="../scripts/nav-height.ts"></script>
  </body>
</html>
