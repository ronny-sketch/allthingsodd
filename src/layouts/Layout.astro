---
import '../styles/global.css';
import Nav from '../components/navigation/Nav.astro';
import Footer from '../components/navigation/Footer.astro';
import MobileMenu from '../components/navigation/MobileMenu.astro';
import Cursor from '../components/media/Cursor.astro';
import SteamFilters from '../components/media/SteamFilters.astro';
import StructuredData from '../components/media/StructuredData.astro';
import NewsletterPopup from '../components/media/NewsletterPopup.astro';
import ConsentBanner from '../components/navigation/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** URL of this page's real LCP candidate, if it has an image-heavy hero
   * worth preloading — see index.astro for how the home page computes it. */
  preloadImage?: string;
  /** 'light' flips the whole page — Nav/Footer/MobileMenu included, via the
   * `.theme-light` token scope in tokens.css — to ODDspace's inverse
   * identity. Every other page omits this and stays the sitewide dark
   * ground. See tokens.css's own comment on `.theme-light` for why this is
   * a single class on <body> rather than a per-component light variant. */
  theme?: 'light';
  /** Transient/private pages (checkout, order confirmation) — keeps them
   * out of search results without affecting any of the site's ten real
   * content pages, which never set this. */
  noindex?: boolean;
}
const { title, description, ogImage, preloadImage, theme, noindex } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={new URL(ogImage, Astro.site)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <StructuredData />
  </head>
  <body class={theme === 'light' ? 'theme-light' : undefined}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>
    <SteamFilters />
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <MobileMenu />
    <NewsletterPopup />
    <ConsentBanner />
    <Cursor />
    <script src="../scripts/reduced-motion-video.ts"></script>
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/magnetic.ts"></script>
    <script src="../scripts/nav-height.ts"></script>
  </body>
</html>
