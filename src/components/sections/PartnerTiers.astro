---
// Home's dedicated Partners section — grouped by sponsorship tier (Partner /
// Supporter / Media, or whatever real tiers apply), one continuous divider
// line under the tier labels, logos static and centered under their own
// tier. Structure matches a reference screenshot Ronny supplied directly.
//
// Real tier assignment (which named company is Partner vs. Supporter vs.
// Media) isn't something to guess at — it's a real business fact, not a
// design choice. Until `tier` is set per logo in site/global.json (via
// CloudCannon), every logo falls into one unlabeled group, which still
// renders the same static, divider-lined structure, just as one column
// instead of several.
import type { ImageMetadata } from 'astro';

interface LogoItem {
  name: string;
  logo: ImageMetadata;
  tier?: string;
}
interface Props {
  eyebrow: string;
  title: string;
  // Legacy/current mode: one flat logo list, optionally grouped by each
  // item's own `tier` field (see the file comment above).
  items?: LogoItem[];
  // Explicit-groups mode — used by the future grouped logo wall (Partners /
  // Media / Supported by / Collaborators, see site/global.json's `logoWall`
  // and docs/editing.md). Takes precedence over `items`/tier-inference when
  // provided, so a caller doesn't need to flatten pre-grouped CMS data back
  // into a single tagged array just to reuse this component.
  groups?: { label: string; items: LogoItem[] }[];
}
const { eyebrow, title, items, groups: explicitGroups } = Astro.props;

const hasTiers = !explicitGroups && (items ?? []).some((item) => item.tier);
const groups: { label: string; items: LogoItem[] }[] =
  explicitGroups ??
  (hasTiers
    ? Array.from(
        (items ?? []).reduce((map, item) => {
          const key = item.tier || 'Partners';
          if (!map.has(key)) map.set(key, []);
          map.get(key)!.push(item);
          return map;
        }, new Map<string, LogoItem[]>()),
      ).map(([label, groupItems]) => ({ label, items: groupItems }))
    : [{ label: '', items: items ?? [] }]);
// A --cols custom property, not an inline grid-template-columns directly —
// an inline style always outranks a stylesheet media query, which is what
// forced the mobile breakpoint below into using !important. Same fix as
// ProofGrid.astro/ParticipateBand.astro's identical --cols pattern.
const columnStyle = `--cols: ${groups.length}`;
---

<section class="partner-tiers-section flow">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
    </div>
  </div>
  <div class="wrap-wide flow">
    {
      (hasTiers || explicitGroups) && (
        <div class="tier-labels" style={columnStyle}>
          {groups.map((g) => (
            <span class="tier-label">{g.label}</span>
          ))}
        </div>
      )
    }
    <div class="tier-divider"></div>
    <div class="tier-columns reveal" style={columnStyle}>
      {
        groups.map((g) => (
          <div class="tier-column">
            {g.items.map((item) => (
              <img src={item.logo.src} alt={item.name} loading="lazy" />
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Section rhythm from layout.css. Both the section (head → logo wall) and
     .wrap-wide (labels → divider → logos) are flow containers. */
  .partner-tiers-section {
    border-top: 1px solid var(--color-paper-12);
  }
  .tier-labels {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    column-gap: 1.5rem;
    row-gap: var(--space-grid);
  }
  .tier-label {
    text-align: center;
    font: var(--text-small);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-80);
  }
  /* The divider belongs to the labels above it — the .section-head step
     (--space-4) rather than the full flow step. Without labels it is the
     first child, and this margin collapses into .wrap-wide's own flow step. */
  .tier-divider {
    border-top: 1px solid var(--color-paper-20);
    margin-block-start: var(--space-4);
  }
  .tier-columns {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    column-gap: 2.5rem;
    row-gap: var(--space-grid);
  }
  .tier-column {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-grid) 3.5rem;
  }
  /* Fixed height + object-fit:contain (not a fixed width) is what actually
     gives "optical" rather than "CSS" equality here — a wide wordmark and a
     compact symbol mark both read as the same visual weight at a shared
     height, each keeping its own real aspect ratio, rather than being
     force-stretched or letterboxed into equal boxes. Sized up from 40px so
     these read as legitimate participants, not footer-sponsor afterthoughts
     — see the task's "Way Out West" reference for the target scale. */
  .tier-column img {
    height: 3.25rem;
    width: auto;
    max-width: 13.75rem;
    object-fit: contain;
    display: block;
    opacity: 0.75;
    filter: brightness(0) invert(1);
    transition: opacity var(--duration-fast) ease;
  }
  .tier-column img:hover {
    opacity: 1;
  }
  @media (max-width: 820px) {
    .tier-labels,
    .tier-columns {
      grid-template-columns: 1fr;
    }
    .tier-column {
      padding-bottom: var(--space-grid);
      border-bottom: 1px solid var(--color-paper-12);
    }
    .tier-column:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
  }
</style>
