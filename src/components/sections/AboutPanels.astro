---
// About's opening panels (What is ODD / Why we exist / How it works / One
// platform) — a plain stacked sequence, one panel per section. This used to
// be a pinned, horizontal-scroll-hijacking version of the same content
// (see git history for AboutParallax.astro); dropped at Ronny's request
// (2026-08-21) in favor of a simpler, direct page — the real content below
// is unchanged, only the scroll-jacking presentation is gone.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Logo from '../primitives/Logo.astro';
import Pill from '../primitives/Pill.astro';
import WarpingText from '../media/WarpingText.astro';

type Panel =
  | {
      _kind: 'media';
      image: ImageMetadata;
      alt: string;
      eyebrow: string;
      title: string;
      body: string;
    }
  | {
      _kind: 'model';
      eyebrow: string;
      title: string;
      items: { label: string; meta: string; href: string }[];
    }
  | {
      _kind: 'text';
      eyebrow: string;
      title: string;
      body: string;
      cta?: { label: string; href: string };
    };

interface Props {
  panels: Panel[];
  marqueeItems: string[];
  pageTitle: string;
}
const { panels, marqueeItems, pageTitle } = Astro.props;
const marqueeLoop = [...marqueeItems, ...marqueeItems];
---

{
  /* Every panel below is an h2 — the page as a whole still needs exactly one
   h1 for a correct heading hierarchy, even though the design has no visible
   "page title" moment (it opens straight into the first panel). */
}
<h1 class="sr-only">{pageTitle}</h1>

<div class="about-panels">
  {
    panels.map((panel, i) => {
      if (panel._kind === 'media') {
        return (
          <div class="about-panel about-panel--media reveal">
            <div class="about-media">
              <Image src={panel.image} alt={panel.alt} width={1200} />
            </div>
            <div class="about-copy">
              <div class="eyebrow">{panel.eyebrow}</div>
              {/* Only the very first panel — the page's opening line ("This
                  is ODD.") — gets the living-warping treatment; the rest of
                  the panels stay plain, same "opt-in per real heading, not
                  blanket" rule as PageIntro/SplitHero's warpTitle prop. */}
              {i === 0 ? (
                <WarpingText as="h2" text={panel.title} class="about-warping-title" color="paper" />
              ) : (
                <h2>{panel.title}</h2>
              )}
              <p>{panel.body}</p>
            </div>
          </div>
        );
      }
      if (panel._kind === 'model') {
        return (
          <div class="about-panel about-panel--text reveal">
            <div class="about-mark">
              <Logo ariaHidden />
            </div>
            <div class="eyebrow">{panel.eyebrow}</div>
            <h2>{panel.title}</h2>
            <div class="about-model-list">
              {panel.items.map((item) => (
                <a class="about-model-row" href={item.href}>
                  <b>{item.label}</b>
                  <span>{item.meta}</span>
                </a>
              ))}
            </div>
          </div>
        );
      }
      return (
        <div class="about-panel about-panel--text reveal">
          <div class="eyebrow">{panel.eyebrow}</div>
          <h2>
            {panel.title.split('\n').map((line, i) =>
              i === 0 ? (
                line
              ) : (
                <>
                  <br />
                  {line}
                </>
              ),
            )}
          </h2>
          <p>{panel.body}</p>
          {panel.cta && (
            <div style="margin-top:1.8rem;">
              <Pill href={panel.cta.href} variant="solid" magnetic>
                {panel.cta.label}
              </Pill>
            </div>
          )}
        </div>
      );
    })
  }

  <div class="about-marquee" aria-hidden="true">
    <div class="about-marquee-track">
      {
        marqueeLoop.map((item, i) => (
          <span class="about-marquee-item">
            {i % 2 === 0 && <Logo ariaHidden />}
            {item}
          </span>
        ))
      }
    </div>
  </div>
</div>

<style>
  .about-panel {
    width: 100%;
    display: grid;
    overflow: hidden;
  }
  .about-panel--media {
    grid-template-columns: 1fr 1fr;
    min-height: 70vh;
  }
  .about-panel--text {
    grid-template-columns: 1fr;
    align-content: center;
    justify-items: center;
    text-align: center;
    padding: var(--space-24) 8vw;
  }
  .about-media {
    position: relative;
    overflow: hidden;
    background: var(--color-backstage);
  }
  .about-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.1) brightness(0.88);
  }
  .about-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4vw 6vw;
    max-width: 34rem;
  }
  .about-copy .eyebrow {
    margin-bottom: 1.2rem;
  }
  /* :global() on the warping variant — WarpingText renders its heading
     inside its own component file, so this file's scoped-CSS attribute
     doesn't carry over to it (same pattern as PageIntro/SplitHero). */
  .about-copy h2,
  .about-copy :global(.about-warping-title),
  .about-panel--text h2 {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-paper);
    font-size: clamp(2.2rem, 4.6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.01em;
    margin: 0 0 1.4rem;
    text-wrap: balance;
  }
  .about-panel--text h2 {
    max-width: 20ch;
  }
  .about-copy p,
  .about-panel--text p {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.75;
    color: var(--color-paper-60);
    max-width: 42ch;
  }
  .about-panel--text .eyebrow {
    margin-bottom: 1.2rem;
  }
  .about-mark {
    width: min(160px, 22vw);
    height: auto;
    color: var(--color-paper-40);
    margin: 0 auto 2rem;
  }
  .about-model-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 1.6rem;
    max-width: 30rem;
    width: 100%;
  }
  .about-model-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--color-paper-12);
    text-align: left;
    text-decoration: none;
    color: inherit;
    transition: color var(--duration-fast) ease;
  }
  .about-model-row:first-child {
    border-top: none;
  }
  .about-model-row b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.2rem;
    color: var(--color-paper);
  }
  .about-model-row span {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-paper-40);
    white-space: nowrap;
  }
  .about-model-row:hover b {
    color: var(--color-amber);
  }

  .about-marquee {
    height: 60px;
    border-top: 1px solid var(--color-paper-12);
    border-bottom: 1px solid var(--color-paper-12);
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .about-marquee-track {
    display: flex;
    align-items: center;
    gap: 2.75rem;
    width: max-content;
  }
  @media (prefers-reduced-motion: no-preference) {
    .about-marquee-track {
      animation: marquee-right 26s linear infinite;
    }
  }
  .about-marquee-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.15rem;
    text-transform: uppercase;
    color: var(--color-paper-60);
    white-space: nowrap;
  }
  .about-marquee-item :global(svg) {
    width: 20px;
    height: auto;
    color: var(--color-paper-40);
    flex-shrink: 0;
  }

  @media (max-width: 820px) {
    .about-panel--media {
      grid-template-columns: 1fr;
      grid-template-rows: 38vh auto;
      min-height: 0;
    }
    .about-copy {
      padding: 6vw;
      max-width: none;
    }
  }
</style>
