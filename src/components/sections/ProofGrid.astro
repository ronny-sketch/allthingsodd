---
// The site's proof/traction module — Section 6 in docs/architecture.md#v2.
// Deliberately optional at the page-schema level (see content.config.ts's
// `proofSection`), so a page can omit this component entirely rather than
// render fabricated numbers.
interface ProofItem {
  value: string;
  label: string;
  context?: string;
}
interface Props {
  eyebrow: string;
  title?: string;
  items: ProofItem[];
  // A link to the underlying report (e.g. "Read the 2025 Impact Report") —
  // rendered under the grid when both are set. Omit entirely rather than
  // link to a report that doesn't exist yet.
  reportLabel?: string;
  reportUrl?: string;
  // Shown instead of the grid when `items` is empty — About's 2026 impact
  // snapshot, whose real numbers aren't verified yet, uses this rather than
  // fabricating figures or silently omitting the section. A deliberate,
  // narrow exception to this component's usual "omit rather than render
  // fabricated numbers" rule (see the header comment above) — the data is
  // pending, not nonexistent.
  placeholder?: string;
}
const { eyebrow, title, items, reportLabel, reportUrl, placeholder } = Astro.props;
const showReport = Boolean(reportLabel && reportUrl);
---

<section class="proof-section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{eyebrow}</span>
      {title && <h2>{title}</h2>}
    </div>
    {
      items.length > 0 ? (
        <>
          {
            /* --cols capped at 4 — forcing every item into one row
               (items.length directly) was fine for the 2-3 item case this
               was designed around, but Media's 8-stat highlights grid
               squeezed each column so narrow that overflow-wrap:anywhere on
               .proof-value fractured numbers mid-character ("2,600" → "2," /
               "600", confirmed via screenshot). Capping at 4 wraps to a
               second row instead — every real usage today (1/2/3/8 items)
               divides cleanly with no orphaned row. */
          }
          <div class="proof-grid reveal" style={`--cols: ${Math.min(items.length, 4)}`}>
            {items.map((item) => (
              <div class="proof-item">
                <div class="proof-value">{item.value}</div>
                <div class="proof-label">{item.label}</div>
                {item.context && <div class="proof-context">{item.context}</div>}
              </div>
            ))}
          </div>
          {showReport && (
            <a class="proof-report-link" href={reportUrl}>
              {reportLabel} →
            </a>
          )}
        </>
      ) : (
        placeholder && <p class="proof-placeholder">{placeholder}</p>
      )
    }
  </div>
</section>

<style>
  .proof-grid {
    display: grid;
    /* --cols (set inline, per instance) — always exactly one row instead of
       auto-fit stranding a lone item on its own row when the count (2 or 3
       across pages) doesn't fill a full row at a given width. See
       ParticipateBand's identical comment/fix; same failure mode, found here
       too via a real screenshot (3 stats, 2-then-1 at tablet width). */
    grid-template-columns: repeat(var(--cols), 1fr);
    row-gap: 2.5rem;
  }
  .proof-item {
    min-width: 0;
    padding: 0 2rem;
    border-left: 1px solid var(--color-paper-12);
    text-align: center;
  }
  .proof-item:first-child {
    border-left: none;
  }
  /* Every row-start item needs its left border dropped, not just the very
     first item overall — with --cols capped at 4, that's every 4th item
     starting the count over. */
  .proof-item:nth-child(4n + 1) {
    border-left: none;
  }
  .proof-value {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1;
    color: var(--color-paper);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .proof-label {
    margin-top: 0.7rem;
    font: var(--text-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-paper-60);
  }
  .proof-context {
    margin-top: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--color-paper-40);
  }
  .proof-report-link {
    display: block;
    width: fit-content;
    margin: 2.4rem auto 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.82rem;
    color: var(--color-paper-80);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-paper-20);
    transition: color var(--duration-fast) ease;
  }
  .proof-report-link:hover {
    color: var(--color-amber-bright);
    text-decoration-color: var(--color-amber-bright);
  }
  .proof-placeholder {
    max-width: 32rem;
    margin: 0 auto;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-paper-40);
    padding: 2.4rem 2rem;
    border: 1px dashed var(--color-paper-12);
  }
  @media (max-width: 700px) {
    .proof-grid {
      grid-template-columns: 1fr;
      gap: 2rem 0;
    }
    .proof-item {
      border-left: none;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .proof-grid .proof-item {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.55s ease,
        transform 0.55s ease;
    }
    .proof-grid.in .proof-item {
      opacity: 1;
      transform: none;
    }
  }
</style>
