---
// The site's proof/traction module — Section 6 in docs/architecture.md#v2.
// Deliberately optional at the page-schema level (see content.config.ts's
// `proofSection`), so a page can omit this component entirely rather than
// render fabricated numbers.
import Pill from '../primitives/Pill.astro';

interface LinkCta {
  label: string;
  href: string;
  external?: boolean;
}
interface ProofItem {
  value: string;
  label: string;
  context?: string;
  // An unabbreviated spoken form of `value`, for screen readers only
  // (2026-09-04). Home's cumulative proof row shows "€400K+", which a
  // screen reader renders as something between "euro four hundred K plus"
  // and a spelled-out "K" — so the full meaning ("More than €400,000") is
  // carried here instead of being lost to the abbreviation the design
  // needs. Set it and the visible glyphs are hidden from the a11y tree in
  // favour of this string; omit it and nothing changes.
  srValue?: string;
}
interface Props {
  // Optional (2026-09-02 copywriting pass) — Home's "Already in motion"
  // module pairs a SectionIntro (which already carries its own eyebrow)
  // directly above a bare stat row, so that instance omits both eyebrow and
  // title and this component renders no section-head at all. Every other
  // caller keeps passing both as before.
  eyebrow?: string;
  title?: string;
  items: ProofItem[];
  // The row's one next step, under the grid — About's "2025 Impact Report",
  // Home's ODDfest 2026 thank-you page. An outline Pill since 2026-09-14, not
  // an underlined text link. Omit entirely rather than point at something
  // that doesn't exist yet.
  cta?: LinkCta;
  // One short line set above that button (Home: "ODDfest 2026 was a
  // co-created effort."). Replaced `reportNote`, a scope caveat that existed
  // only because Home linked a 2025-only report under cumulative figures.
  ctaLead?: string;
  // Shown instead of the grid when `items` is empty — About's 2026 impact
  // snapshot, whose real numbers aren't verified yet, uses this rather than
  // fabricating figures or silently omitting the section. A deliberate,
  // narrow exception to this component's usual "omit rather than render
  // fabricated numbers" rule (see the header comment above) — the data is
  // pending, not nonexistent.
  placeholder?: string;
}
const { eyebrow, title, items, cta, ctaLead, placeholder } = Astro.props;
const hasItems = items.length > 0;
---

<section class={`proof-section ${!hasItems ? 'is-pending' : ''}`}>
  <div class="wrap">
    {
      hasItems ? (
        <>
          {(eyebrow || title) && (
            <div class="section-head">
              {eyebrow && <span class="eyebrow">{eyebrow}</span>}
              {title && <h2>{title}</h2>}
            </div>
          )}
          {/* --cols capped at 4 — forcing every item into one row
               (items.length directly) was fine for the 2-3 item case this
               was designed around, but Media's 8-stat highlights grid
               squeezed each column so narrow that overflow-wrap:anywhere on
               .proof-value fractured numbers mid-character ("2,600" → "2," /
               "600", confirmed via screenshot). Capping at 4 wraps to a
               second row instead. (Today's callers, Home and About, both
               pass four.) */}
          <div
            class={`proof-grid reveal ${items.length >= 4 ? 'is-four' : ''}`}
            style={`--cols: ${Math.min(items.length, 4)}`}
          >
            {items.map((item) => (
              <div class="proof-item">
                <div class="proof-value">
                  {item.srValue ? (
                    <>
                      <span aria-hidden="true">{item.value}</span>
                      <span class="sr-only">{item.srValue}</span>
                    </>
                  ) : (
                    item.value
                  )}
                </div>
                <div class="proof-label">{item.label}</div>
                {item.context && <div class="proof-context">{item.context}</div>}
              </div>
            ))}
          </div>
          {cta && (
            <div class="proof-follow">
              {ctaLead && <p class="proof-follow-lead">{ctaLead}</p>}
              <Pill
                href={cta.href}
                variant="outline"
                magnetic
                target={cta.external ? '_blank' : undefined}
              >
                {cta.label} →
              </Pill>
            </div>
          )}
        </>
      ) : (
        // No verified numbers yet — a quiet, subordinate note, not the full
        // bordered section-head/h2 "new chapter" treatment above or a large
        // dashed placeholder box (missing data shouldn't carry the same
        // visual weight as real evidence). Automatically upgrades to the
        // normal ProofGrid treatment the moment `items` is populated —
        // nothing else to wire up.
        placeholder && (
          <p class="proof-pending">
            <span class="eyebrow">{eyebrow}</span> — {placeholder}
          </p>
        )
      )
    }
  </div>
</section>

<style>
  .proof-grid {
    display: grid;
    /* --cols (set inline, per instance) — always exactly one row instead of
       auto-fit stranding a lone item on its own row when the count (2 or 3
       across pages) doesn't fill a full row at a given width. See
       ParticipateBand's identical comment/fix; same failure mode, found here
       too via a real screenshot (3 stats, 2-then-1 at tablet width). */
    grid-template-columns: repeat(var(--cols), 1fr);
    row-gap: 2.5rem;
  }
  .proof-item {
    min-width: 0;
    padding: 0 2rem;
    border-left: 1px solid var(--color-paper-12);
    text-align: center;
  }
  .proof-item:first-child {
    border-left: none;
  }
  /* Every row-start item needs its left border dropped, not just the very
     first item overall — with --cols capped at 4, that's every 4th item
     starting the count over. */
  .proof-item:nth-child(4n + 1) {
    border-left: none;
  }
  /* A four-across row goes two-by-two on tablet. Between 701 and 1024px a
     quarter of the column is roughly 160-240px, which cannot reliably hold a
     Display figure and a Small-capitals label ("Contributors") unbroken.
     This lived as a Home-only override until About's impact row grew to
     four figures as well. */
  @media (min-width: 701px) and (max-width: 1024px) {
    .proof-grid.is-four {
      grid-template-columns: repeat(2, 1fr);
    }
    .proof-grid.is-four .proof-item:nth-child(2n + 1) {
      border-left: none;
    }
  }
  .proof-value {
    font: var(--text-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-paper);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .proof-label {
    margin-top: 0.7rem;
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-60);
  }
  .proof-context {
    margin-top: 0.5rem;
    font: var(--text-small);
    color: var(--color-paper-40);
  }
  .proof-follow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2.4rem;
    text-align: center;
  }
  /* A lead-in to the button, not a caption under the figures — one step
     brighter than the stat labels' quietest ink so it reads as the sentence
     the button finishes. */
  .proof-follow-lead {
    max-width: 34rem;
    margin: 0;
    font: var(--text-small);
    color: var(--color-paper-60);
  }
  /* Quiet, subordinate — this section's own padding shrinks too (see
     .proof-section.is-pending below) so missing 2026 data reads as a small
     aside under real 2025 evidence, not a section of equal visual weight. */
  .proof-section.is-pending {
    padding: var(--space-8) 0;
  }
  .proof-pending {
    max-width: 32rem;
    margin: 0 auto;
    text-align: center;
    font: var(--text-small);
    color: var(--color-paper-40);
  }
  .proof-pending .eyebrow {
    color: var(--color-paper-40);
  }
  @media (max-width: 700px) {
    .proof-grid {
      grid-template-columns: 1fr;
      gap: 2rem 0;
    }
    .proof-item {
      border-left: none;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .proof-grid .proof-item {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.55s ease,
        transform 0.55s ease;
    }
    :global(html.reveal-js) .proof-grid.in .proof-item {
      opacity: 1;
      transform: none;
    }
  }
</style>
