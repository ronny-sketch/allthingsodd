---
// The ODDspace membership form (2026-10-21), the last section of
// /oddspace/membership at #join. It replaces the detour to the Work with ODD
// form: membership was being asked "What would you like to explore with ODD?"
// on a page about partnerships.
//
// Five questions and the details to reply to, in the order a visitor thinks
// about it: how they'd like to see the place first, when, how they'd use it,
// then who they are. The visit comes first because it is the step that
// converts: a person picks one to three times that suit them, and a teammate
// claims one in Slack (../odd-growth-os D34). Everything else (why now, what
// they'd bring, billing) is asked at the visit, by a person.
//
// membership-form.ts builds the time choices in the browser, from the rules
// in membership-schema.ts, because they depend on today's date and this page
// is static. Their styles are therefore global, scoped under .msf.
//
// method="post" and a disabled button until the script is ready, as on the
// other forms: with no script, a native submit would put answers in the URL.
import ChoiceChips from '../primitives/ChoiceChips.astro';
import Pill from '../primitives/Pill.astro';
import { VISITS, USES, STARTS, HEARD, MAX_TEAM } from '../../scripts/membership-schema';

interface Props {
  eyebrow: string;
  headline: string;
  body: string;
}
const { eyebrow, headline, body } = Astro.props;
---

<section class="msf" id="join" aria-labelledby="msf-heading">
  <div class="wrap msf-inner">
    <div class="msf-head reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h2 id="msf-heading">{headline}</h2>
      <p>{body}</p>
    </div>

    <form class="msf-form" id="membershipForm" method="post" novalidate>
      <fieldset class="msf-q" data-field="visit">
        <legend>How would you like to see it first?</legend>
        <ChoiceChips name="visit" options={VISITS} required idPrefix="msf-visit" />
        <p class="msf-error" id="msf-err-visit" hidden></p>
      </fieldset>

      <fieldset class="msf-q msf-times" data-field="times" hidden>
        <legend id="msf-times-legend">Pick up to three times that suit you</legend>
        <p class="msf-hint" id="msf-times-hint">
          Someone from the team takes one of them and confirms it by email.
        </p>
        <div class="msf-days" id="msf-days" role="group" aria-label="Days"></div>
        <div class="msf-slots" id="msf-slots" role="group" aria-labelledby="msf-times-legend"></div>
        <p class="msf-picks" id="msf-picks" aria-live="polite"></p>
        <p class="msf-error" id="msf-err-times" hidden></p>
      </fieldset>

      <fieldset class="msf-q" data-field="start">
        <legend>When would you like to start?</legend>
        <ChoiceChips name="start" options={STARTS} required idPrefix="msf-start" />
        <p class="msf-error" id="msf-err-start" hidden></p>
      </fieldset>

      <fieldset class="msf-q" data-field="use">
        <legend>How would you use ODDspace?</legend>
        <ChoiceChips name="use" options={USES} required idPrefix="msf-use" />
        <p class="msf-error" id="msf-err-use" hidden></p>
        <div class="msf-ticks">
          <label class="msf-tick" for="msf-team">
            <input type="checkbox" id="msf-team" name="team" value="true" />
            <span>We're a team</span>
          </label>
          <label class="msf-tick" for="msf-studio">
            <input type="checkbox" id="msf-studio" name="studio" value="true" />
            <span>I'd want ODDstudio too</span>
          </label>
        </div>
        <div class="field msf-team-size" data-field="team_size" hidden>
          <label for="msf-team-size">How many of you?</label>
          <input
            id="msf-team-size"
            name="team_size"
            type="number"
            min="2"
            max={MAX_TEAM}
            inputmode="numeric"
          />
          <p class="msf-error" id="msf-err-team_size" hidden></p>
        </div>
      </fieldset>

      <div class="msf-grid">
        <div class="field" data-field="name">
          <label for="msf-name">Your name</label>
          <input id="msf-name" name="name" type="text" required autocomplete="name" />
          <p class="msf-error" id="msf-err-name" hidden></p>
        </div>
        <div class="field" data-field="email">
          <label for="msf-email">Email</label>
          <input id="msf-email" name="email" type="email" required autocomplete="email" />
          <p class="msf-error" id="msf-err-email" hidden></p>
        </div>
        <div class="field msf-wide" data-field="works_on">
          <label for="msf-works">What do you work on?</label>
          <input
            id="msf-works"
            name="works_on"
            type="text"
            required
            maxlength="200"
            placeholder="In a line: ceramics, a game studio, film sound…"
          />
          <p class="msf-error" id="msf-err-works_on" hidden></p>
        </div>
        <div class="field" data-field="link">
          <label for="msf-link">A link to your work <span class="optional">(optional)</span></label>
          <input
            id="msf-link"
            name="link"
            type="text"
            inputmode="url"
            autocomplete="url"
            placeholder="Site, portfolio or Instagram"
          />
          <p class="msf-error" id="msf-err-link" hidden></p>
        </div>
        <div class="field" data-field="phone">
          <label for="msf-phone">Phone <span class="optional">(optional)</span></label>
          <input id="msf-phone" name="phone" type="tel" autocomplete="tel" />
          <p class="msf-error" id="msf-err-phone" hidden></p>
        </div>
        <div class="field" data-field="heard">
          <label for="msf-heard"
            >How did you hear about ODDspace? <span class="optional">(optional)</span></label
          >
          <select id="msf-heard" name="heard">
            <option value="">Choose one</option>
            {HEARD.map((h) => <option value={h.value}>{h.label}</option>)}
          </select>
        </div>
        <div class="field msf-wide" data-field="notes">
          <label for="msf-notes">Anything else? <span class="optional">(optional)</span></label>
          <textarea id="msf-notes" name="notes" rows="3" maxlength="2000"></textarea>
        </div>
      </div>

      <input
        type="text"
        name="hp_field"
        class="botcheck"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <div class="msf-ticks msf-consent">
        <label class="msf-tick" for="msf-consent" data-field="consent_privacy">
          <input type="checkbox" id="msf-consent" name="consent_privacy" value="true" required />
          <span>
            Keep my answers so the team can reply. See the <a href="/privacy/">privacy notice</a>.
          </span>
        </label>
        <p class="msf-error" id="msf-err-consent_privacy" hidden></p>
        <label class="msf-tick" for="msf-newsletter">
          <input type="checkbox" id="msf-newsletter" name="newsletter" value="true" />
          <span>Also send me ODD's newsletter</span>
        </label>
      </div>

      <div class="field-submit">
        <Pill type="submit" variant="solid" disabled>Send</Pill>
        <p class="form-status" id="msf-status" role="status" aria-live="polite"></p>
      </div>
      <p class="form-fallback">
        If the button stays greyed out, the form can't load here. Email hello@oddfest.co instead.
      </p>
    </form>

    <div class="msf-done" id="msf-done" tabindex="-1" hidden>
      <span class="eyebrow">Got it</span>
      <h2 id="msf-done-title"></h2>
      <p id="msf-done-body"></p>
      <p class="msf-ref" id="msf-done-ref"></p>
    </div>
  </div>
</section>

<script src="../../scripts/membership-form.ts"></script>

<style>
  /* .msf takes layout.css's section rhythm; nothing here redeclares it. */
  .msf-inner {
    display: grid;
    gap: var(--space-group);
    max-width: 44rem;
    margin-inline: auto;
  }
  .msf-head {
    display: grid;
    gap: var(--space-3);
    text-align: center;
  }
  .msf-head p {
    color: var(--color-paper-80);
  }

  .msf-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-content);
  }
  .msf-q {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }
  .msf-q legend,
  .field label {
    padding: 0;
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-60);
  }
  .optional {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
  }
  .msf-hint,
  .msf-picks {
    margin: 0;
    font: var(--text-small);
    color: var(--color-paper-60);
  }

  .msf-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6) var(--space-8);
  }
  .msf-wide {
    grid-column: 1 / -1;
  }
  @media (max-width: 640px) {
    .msf-grid {
      grid-template-columns: 1fr;
    }
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-width: 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-paper-20);
    padding: 0.6rem 0;
    font: var(--text-body);
    color: var(--color-paper);
    outline: none;
    resize: vertical;
    transition: border-color var(--duration-fast) ease;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--color-paper-40);
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--color-paper);
  }
  .msf-team-size {
    max-width: 10rem;
  }

  .msf-ticks {
    display: grid;
    gap: var(--space-3);
  }
  .msf-tick {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    cursor: pointer;
    font: var(--text-body);
    color: var(--color-paper-80);
  }
  .msf-tick input {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.2rem;
    flex: none;
    accent-color: var(--color-paper);
  }

  .msf-error {
    margin: 0;
    font: var(--text-small);
    color: var(--color-heat);
  }
  .botcheck {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .field-submit {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.2rem;
  }
  .form-status {
    margin: 0;
    font: var(--text-small);
    color: var(--color-paper-60);
  }
  .form-status[data-error] {
    color: var(--color-heat);
  }
  .form-fallback {
    margin: 0;
    font: var(--text-small);
    color: var(--color-paper-60);
  }
  .msf-form[data-ready] .form-fallback {
    display: none;
  }

  .msf-done {
    display: grid;
    gap: var(--space-3);
    text-align: center;
    outline: none;
  }
  .msf-done p {
    color: var(--color-paper-80);
  }
  .msf-ref {
    font: var(--text-small);
    color: var(--color-paper-60);
  }
  /* Scoped `display` rules beat the browser's own [hidden] style, so every
     element this form hides says so explicitly (as CreativeWeekForm does). */
  .msf-q[hidden],
  .msf-form[hidden],
  .msf-done[hidden],
  .field[hidden],
  .msf-error[hidden] {
    display: none;
  }

  /* Built by membership-form.ts after load, so these styles cannot be
     scoped to this component's markup: global, under .msf only. Same look
     as ChoiceChips. */
  :global(.msf .msf-days),
  :global(.msf .msf-slots) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  :global(.msf .msf-slot) {
    min-height: 2.75rem;
    padding: 0.5rem 1.05rem;
    border: 1px solid var(--color-paper-35);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-paper);
    font: var(--text-body);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }
  :global(.msf .msf-slot:hover) {
    border-color: var(--color-paper);
  }
  :global(.msf .msf-slot[aria-pressed='true']),
  :global(.msf .msf-slot[aria-current='true']) {
    background: var(--color-paper);
    color: var(--color-bg);
    border-color: var(--color-paper);
  }
  :global(.msf .msf-slot:disabled) {
    opacity: 0.35;
    cursor: not-allowed;
  }
  :global(.msf .msf-slot:focus-visible) {
    outline: 2px solid var(--color-paper);
    outline-offset: 2px;
  }
  :global(.msf .msf-day) {
    border-color: var(--color-paper-20);
  }
</style>
