---
// A centred hero with a real supporting photo — Work with ODD's own hero,
// also About's (2026-08-31 — see about.astro for why About shares this
// component instead of PageIntro's plainer shape now that Work with ODD has
// moved on from it). Borrows SplitHero's display-type treatment (warped
// title, meta-less centred stack) and PhotoBreak's scrim idea, but isn't a
// 50/50 split panel and isn't PageIntro either: PageIntro stays untouched for
// Contact/Media/Membership, SplitHero stays untouched for ODDference/
// ODDagency. This is its own component specifically so a change here can't
// regress either of those. "Much simpler than an event hero" per the brief —
// one photo, one scrim, no video, no rail.
//
// `image` and `primaryCta` are both optional — a caller with a verified,
// on-brand photo and a real primary action (Work with ODD) gets the full
// photographic treatment; a more reflective page with neither (About, whose
// ODDfest 2026 launch photo sits under its argument instead) still gets the
// same head layout and
// widths, just without the media panel and CTA pill — and its title takes
// Display rather than Hero (see the styles).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Pill from '../primitives/Pill.astro';
import WarpingText from '../media/WarpingText.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  primaryCta?: { label: string; href: string };
  image?: ImageMetadata;
  // Several photos side by side instead of one (Work with ODD, 2026-09-24:
  // the partner-built things from ODDfest 2025 in one frame). One photo in
  // this list renders exactly like `image`.
  images?: ImageMetadata[];
  warpTitle?: boolean;
}
const { eyebrow, title, intro, primaryCta, image, images, warpTitle = true } = Astro.props;
const photos = images ?? (image ? [image] : []);
---

<section class={`hero-centered ${photos.length ? '' : 'is-plain'}`}>
  {
    photos.length > 0 && (
      <div class={`hero-centered-media ${photos.length > 1 ? 'is-collage' : ''}`}>
        {photos.map((p) => (
          <Image
            src={p}
            alt=""
            width={photos.length > 1 ? 900 : 2200}
            loading="eager"
            fetchpriority="high"
          />
        ))}
        <div class="hero-centered-scrim" />
      </div>
    )
  }
  <div class="wrap">
    <div class="hero-centered-head reveal">
      <span class="eyebrow">{eyebrow}</span>
      {
        warpTitle ? (
          <WarpingText
            as="h1"
            text={title}
            class="hero-centered-warping-title"
            color="paper"
            align="center"
          />
        ) : (
          <h1>{title}</h1>
        )
      }
      <p>{intro}</p>
      {
        primaryCta && (
          <div class="hero-centered-cta">
            <Pill href={primaryCta.href} variant="solid" magnetic>
              {primaryCta.label}
            </Pill>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero-centered {
    position: relative;
    overflow: hidden;
    min-height: min(78vh, 640px);
    display: flex;
    align-items: center;
    background: var(--swatch-ink);
    /* A photograph is an edge, not padding: the hero owns its own height
       (min-height + the head's padding) and contributes its half of the
       section gap outside itself — layout.css, section rhythm. */
    padding-block: 0;
    margin-block-end: calc(var(--space-section) / 2);
  }
  /* No photo — About, until a verified one exists (see the Props comment
     above). Same head layout/typography as the photographic variant, but
     laid out like a plain top-of-page section (nav-offset padding, page
     background) instead of a full-viewport dark overlay hero, since there's
     no scrim to sit on. */
  .hero-centered.is-plain {
    min-height: 0;
    background: transparent;
    margin-block-end: 0;
    /* One section gap under the nav, half a gap below — PageIntro's rhythm
       exactly. --space-section is fluid, so no mobile override. */
    padding-block: var(--space-section) calc(var(--space-section) / 2);
  }
  /* The head's own padding is the photo variant's height; without a photo it
     would stack on the section padding above. */
  .hero-centered.is-plain .hero-centered-head {
    padding-block: 0;
  }
  .hero-centered-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-centered-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.15) brightness(0.85);
  }
  /* Columns of equal width, one per photo; a phone gets two columns and
     shows the first four, and an odd last photo takes the whole row. */
  .hero-centered-media.is-collage {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    gap: 2px;
  }
  @media (max-width: 700px) {
    .hero-centered-media.is-collage {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      grid-auto-rows: minmax(0, 1fr);
    }
    .hero-centered-media.is-collage > :global(img:nth-of-type(n + 5)) {
      display: none;
    }
    .hero-centered-media.is-collage > :global(img:last-of-type:nth-of-type(odd)) {
      grid-column: span 2;
    }
  }
  .hero-centered-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(14 9 11 / 78%) 0%,
      rgb(14 9 11 / 42%) 55%,
      rgb(14 9 11 / 20%) 100%
    );
  }
  .hero-centered-head {
    position: relative;
    z-index: 1;
    max-width: 40rem;
    margin-inline: auto;
    padding-block: var(--space-16);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-centered-head .eyebrow {
    color: var(--color-paper-80);
  }
  /* :global() on the warping variant's class — WarpingText renders its <h1>
     inside its own component file, so this file's scoped-CSS attribute
     doesn't carry over to it. */
  /* Hero, not Display: with a photograph behind it and nothing else in the
     frame, this title is the whole first screen — the one composition on the
     site that earns the rarest step of the ladder (Work with ODD). The plain
     variant has no photograph and lays out exactly like PageIntro, so it
     takes PageIntro's Display step instead (About). */
  .hero-centered-head h1,
  .hero-centered-head :global(.hero-centered-warping-title) {
    font: var(--text-hero);
    letter-spacing: var(--tracking-hero);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }
  .hero-centered.is-plain .hero-centered-head h1,
  .hero-centered.is-plain .hero-centered-head :global(.hero-centered-warping-title) {
    font: var(--text-display);
    letter-spacing: var(--tracking-display);
  }
  /* The Hero step needs a wider line than the plain 40rem head: at 84px that
     measure holds about twelve characters, which stacked ODDagency's title
     into four lines of one or two words. The intro keeps its own 38ch. */
  .hero-centered:not(.is-plain) .hero-centered-head {
    max-width: 52rem;
  }
  /* Phones: Hero's 3.25rem floor is wider than a phone column for one long
     word ("something" is ~350px at 52px, against 264px of column at 320px),
     so the title steps to Display — the next role down, the same kind of
     step the mobile menu takes on short screens. */
  @media (max-width: 640px) {
    .hero-centered-head h1,
    .hero-centered-head :global(.hero-centered-warping-title) {
      font: var(--text-display);
      letter-spacing: var(--tracking-display);
    }
  }
  .hero-centered-head p {
    max-width: 38ch;
    margin: var(--space-5) 0 0;
    font: var(--text-body);
    color: var(--color-paper-80);
  }
  .hero-centered-cta {
    margin-top: var(--space-6);
  }
  @media (max-width: 640px) {
    .hero-centered {
      min-height: min(64vh, 520px);
    }
  }
</style>
