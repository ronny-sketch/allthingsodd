---
// A centred hero with a real supporting photo — Work with ODD's own hero.
// Borrows SplitHero's display-type treatment (warped title, meta-less
// centred stack) and PhotoBreak's scrim idea, but isn't a 50/50 split panel
// and isn't PageIntro either: PageIntro stays untouched for Contact/Media/
// Membership, SplitHero stays untouched for ODDference/ODDagency. This is
// its own component specifically so a change here can't regress either of
// those. "Much simpler than an event hero" per the brief — one photo, one
// scrim, no video, no rail.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Pill from '../primitives/Pill.astro';
import WarpingText from '../media/WarpingText.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  primaryCta: { label: string; href: string };
  image: ImageMetadata;
  warpTitle?: boolean;
}
const { eyebrow, title, intro, primaryCta, image, warpTitle = true } = Astro.props;
---

<section class="hero-centered">
  <div class="hero-centered-media">
    <Image src={image} alt="" width={2200} />
    <div class="hero-centered-scrim"></div>
  </div>
  <div class="wrap">
    <div class="hero-centered-head reveal">
      <span class="eyebrow">{eyebrow}</span>
      {
        warpTitle ? (
          <WarpingText
            as="h1"
            text={title}
            class="hero-centered-warping-title"
            color="paper"
            align="center"
          />
        ) : (
          <h1>{title}</h1>
        )
      }
      <p>{intro}</p>
      <div class="hero-centered-cta">
        <Pill href={primaryCta.href} variant="solid" magnetic>
          {primaryCta.label}
        </Pill>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-centered {
    position: relative;
    overflow: hidden;
    min-height: min(78vh, 640px);
    display: flex;
    align-items: center;
    background: #000;
  }
  .hero-centered-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-centered-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.15) brightness(0.7);
  }
  .hero-centered-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 78%) 0%,
      rgb(0 0 0 / 42%) 55%,
      rgb(0 0 0 / 20%) 100%
    );
  }
  .hero-centered-head {
    position: relative;
    z-index: 1;
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--space-16) 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-centered-head .eyebrow {
    color: var(--color-paper-80);
  }
  /* :global() on the warping variant's class — WarpingText renders its <h1>
     inside its own component file, so this file's scoped-CSS attribute
     doesn't carry over to it. */
  .hero-centered-head h1,
  .hero-centered-head :global(.hero-centered-warping-title) {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-paper);
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    line-height: 1.08;
    margin: 0.9rem 0 0;
  }
  .hero-centered-head p {
    max-width: 38ch;
    margin: 1.6rem 0 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--color-paper-80);
  }
  .hero-centered-cta {
    margin-top: 1.8rem;
  }
  @media (max-width: 640px) {
    .hero-centered {
      min-height: min(64vh, 520px);
    }
  }
</style>
