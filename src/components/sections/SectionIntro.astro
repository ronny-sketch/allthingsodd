---
// A single-column editorial intro block — eyebrow/headline/body/optional
// link. The shape of "What ODD is", ODDference's "Big question", ODDagency's
// "What it is", Membership's "What it is", and several other single-idea
// sections across V2 — one component, many pages. See content.config.ts's
// `sectionIntro` fragment.
import WarpingText from '../media/WarpingText.astro';

interface LinkCta {
  label: string;
  href: string;
  external?: boolean;
}
interface Props {
  eyebrow: string;
  headline: string;
  body: string;
  cta?: LinkCta;
  // Opt-in per caller (default off) — SectionIntro is reused across most
  // pages on the site; the living-warping treatment is meant for a couple
  // of real headings for variation, not applied blanket to every section
  // that happens to reuse this shape. Same convention as PageIntro/
  // SplitHero's warpTitle prop.
  warpHeadline?: boolean;
  // Opt-in larger body setting (default off) — for the one or two places
  // where this component is carrying the page's main explanatory passage
  // rather than a short supporting note. Home's "Why ODD" uses it: it is the
  // first thing a reader actually reads after the hero, and at the shared
  // 0.98rem it set as a small grey block under a very large headline.
  bodySize?: 'default' | 'large';
}
const { eyebrow, headline, body, cta, warpHeadline = false, bodySize = 'default' } = Astro.props;

// Blank lines in `body` become real paragraphs (2026-09-11): several of these
// sections carry three distinct points, and as one unbroken block a reader has
// no way to see where one ends and the next starts. A body with no blank line
// in it — which is every other caller — still renders as exactly one <p>, so
// this is additive for existing content. \r\n tolerated because CloudCannon's
// textarea is what editors type these into.
const paragraphs = body
  .split(/\r?\n\s*\r?\n/)
  .map((part) => part.trim())
  .filter(Boolean);
---

<section class="section-intro">
  <div class="wrap">
    <div class={`section-intro-inner reveal ${bodySize === 'large' ? 'is-body-large' : ''}`}>
      <span class="eyebrow">{eyebrow}</span>
      {
        warpHeadline ? (
          <WarpingText
            as="h2"
            text={headline}
            class="section-intro-warping-headline"
            color="paper"
            align="center"
          />
        ) : (
          <h2>{headline}</h2>
        )
      }
      {paragraphs.map((para) => <p>{para}</p>)}
      {
        cta && (
          <a
            class="section-intro-link"
            href={cta.href}
            target={cta.external ? '_blank' : undefined}
            rel={cta.external ? 'noreferrer' : undefined}
          >
            {cta.label}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .section-intro-inner {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .section-intro-inner .eyebrow {
    color: var(--color-paper-60);
  }
  /* :global() on the warping variant — WarpingText renders its heading
     inside its own component file, so this file's scoped-CSS attribute
     doesn't carry over to it (same pattern as PageIntro/SplitHero). */
  .section-intro-inner h2,
  .section-intro-inner :global(.section-intro-warping-headline) {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-paper);
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    line-height: 1.1;
    margin: 0.9rem 0 0;
    text-wrap: balance;
  }
  .section-intro-inner p {
    max-width: 44ch;
    margin: 1.4rem 0 0;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.8;
    color: var(--color-paper-60);
  }
  /* Between two paragraphs the 1.4rem above is measuring from the headline,
     not from another block of the same text — a slightly tighter step keeps
     a multi-point body reading as one passage with visible joints rather
     than three separate notes. */
  .section-intro-inner p + p {
    margin-top: 1.1rem;
  }
  /* `bodySize="large"` — bigger type, brighter ink and a wider measure, for
     the one or two sections carrying a page's main explanatory passage. The
     measure has to grow with the type or the larger size just buys more
     lines at the same ~44 characters. */
  .section-intro-inner.is-body-large p {
    max-width: 52ch;
    font-size: 1.12rem;
    line-height: 1.75;
    color: var(--color-paper-80);
  }
  .section-intro-link {
    display: inline-block;
    margin-top: 1.4rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.82rem;
    color: var(--color-paper-80);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-paper-20);
    transition: color var(--duration-fast) ease;
  }
  .section-intro-link:hover {
    color: var(--color-amber-bright);
    text-decoration-color: var(--color-amber-bright);
  }
  /* Mobile typography (2026-09-02 mobile experience pass). The eyebrow and
     headline stay centered — that centered editorial opening is the shape of
     this component and reads correctly at any width. The body paragraph does
     not: at 390px the measure is ~28 characters, and several of these
     sections run 9-11 lines, so centered setting leaves every line starting
     and ending in a different place with no left edge for the eye to return
     to. Ragged-right at this measure is simply easier to read, and the block
     itself stays centered in the column, so the composition is unchanged.

     Line-height comes down with it: 1.8 is generous for a wide desktop
     measure and turns into a very loose, sprawling column once the same
     paragraph is three times as tall. */
  @media (max-width: 640px) {
    .section-intro-inner p {
      text-align: left;
      line-height: 1.65;
    }
    /* 1.12rem is a desktop size against a desktop measure; at ~28 characters
       per line it turns the same passage into a very tall column. Still a
       step above the default body, just a smaller one. */
    .section-intro-inner.is-body-large p {
      font-size: 1.04rem;
      line-height: 1.6;
    }
  }
  @media (max-width: 760px) {
    /* This single-line link's own text box measures ~20px tall — under the
       WCAG 2.5.8 AA touch-target guidance. Padding grows the tappable area;
       the equal-and-opposite negative margin keeps the visible underlined
       text sitting exactly where it did, so this is hit-slop only, not a
       layout change (the block stays centered — both are symmetric). */
    .section-intro-link {
      padding: 10px 14px;
      margin-top: calc(1.4rem - 10px);
      margin-right: -14px;
      margin-bottom: -10px;
      margin-left: -14px;
    }
  }
</style>
