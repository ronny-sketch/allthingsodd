---
// A single-column editorial intro block — eyebrow/headline/body/optional
// link. The shape of "What ODD is", ODDference's "Big question", ODDagency's
// "What it is", Membership's "What it is", and several other single-idea
// sections across V2 — one component, many pages. See content.config.ts's
// `sectionIntro` fragment.
import WarpingText from '../media/WarpingText.astro';
import Pill from '../primitives/Pill.astro';

interface LinkCta {
  label: string;
  href: string;
  external?: boolean;
}
interface Props {
  eyebrow: string;
  headline: string;
  body: string;
  cta?: LinkCta;
  // Opt-in per caller (default off) — SectionIntro is reused across most
  // pages on the site; the living-warping treatment is meant for a couple
  // of real headings for variation, not applied blanket to every section
  // that happens to reuse this shape. Same convention as PageIntro/
  // SplitHero's warpTitle prop.
  warpHeadline?: boolean;
  // Opt-in lead treatment (default off) — for the rare place where this
  // component carries the page's main explanatory passage rather than a short
  // supporting note (ODDference's premise; Home's "Why ODD" used it until it
  // moved to BuiltAround on 2026-09-14). It
  // was a larger body size until the 2026-09-13 typography pass; the ladder
  // has exactly one Body size, so the passage now gains its presence from
  // brighter ink and a wider measure instead. See typography.css.
  lead?: boolean;
  // How `cta` renders (2026-09-14). The underlined text link stays the
  // default — most intros end on a quiet "read more". Where the link is the
  // section's real next step (Home's "Already in motion"), `button` renders
  // the site's outline Pill instead.
  ctaAs?: 'link' | 'button';
}
const {
  eyebrow,
  headline,
  body,
  cta,
  warpHeadline = false,
  lead = false,
  ctaAs = 'link',
} = Astro.props;

// Blank lines in `body` become real paragraphs (2026-09-11): several of these
// sections carry three distinct points, and as one unbroken block a reader has
// no way to see where one ends and the next starts. A body with no blank line
// in it — which is every other caller — still renders as exactly one <p>, so
// this is additive for existing content. \r\n tolerated because CloudCannon's
// textarea is what editors type these into.
const paragraphs = body
  .split(/\r?\n\s*\r?\n/)
  .map((part) => part.trim())
  .filter(Boolean);
---

<section class="section-intro">
  <div class="wrap">
    <div class={`section-intro-inner reveal ${lead ? 'is-lead' : ''}`}>
      <span class="eyebrow">{eyebrow}</span>
      {
        warpHeadline ? (
          <WarpingText
            as="h2"
            text={headline}
            class="section-intro-warping-headline"
            color="paper"
            align="center"
          />
        ) : (
          <h2>{headline}</h2>
        )
      }
      {paragraphs.map((para) => <p>{para}</p>)}
      {
        cta &&
          (ctaAs === 'button' ? (
            <div class="section-intro-cta">
              <Pill
                href={cta.href}
                variant="outline"
                magnetic
                target={cta.external ? '_blank' : undefined}
              >
                {cta.label}
              </Pill>
            </div>
          ) : (
            <a
              class="section-intro-link"
              href={cta.href}
              target={cta.external ? '_blank' : undefined}
              rel={cta.external ? 'noreferrer' : undefined}
            >
              {cta.label}
            </a>
          ))
      }
    </div>
  </div>
</section>

<style>
  .section-intro-inner {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .section-intro-inner .eyebrow {
    color: var(--color-paper-60);
  }
  /* :global() on the warping variant — WarpingText renders its heading
     inside its own component file, so this file's scoped-CSS attribute
     doesn't carry over to it (same pattern as PageIntro/SplitHero). */
  .section-intro-inner h2,
  .section-intro-inner :global(.section-intro-warping-headline) {
    font: var(--text-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }
  .section-intro-inner p {
    max-width: 44ch;
    margin: var(--space-5) 0 0;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  /* Between two paragraphs the step above is measuring from the headline,
     not from another block of the same text — a slightly tighter step keeps
     a multi-point body reading as one passage with visible joints rather
     than three separate notes. */
  .section-intro-inner p + p {
    margin-top: var(--space-4);
  }
  /* `lead` — the same Body size in brighter ink on a wider measure, for the
     one or two sections carrying a page's main explanatory passage. */
  .section-intro-inner.is-lead p {
    max-width: var(--measure-prose);
    color: var(--color-paper-80);
  }
  .section-intro-link {
    display: inline-block;
    margin-top: var(--space-5);
    font: var(--text-small);
    font-weight: 600;
    color: var(--color-paper-80);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-paper-20);
    transition: color var(--duration-fast) ease;
  }
  .section-intro-link:hover {
    color: var(--color-amber-bright);
    text-decoration-color: var(--color-amber-bright);
  }
  /* A button sits further off the body than the text link does — the same
     step Home's other intro-plus-Pills rows use. Pill carries its own
     44px touch height, so the link's mobile hit-slop below doesn't apply. */
  .section-intro-cta {
    margin-top: var(--space-6);
  }
  /* Mobile (2026-09-02 mobile experience pass). The eyebrow and headline stay
     centered — that centered editorial opening is the shape of this component
     and reads correctly at any width. The body paragraph does not: on a phone
     the measure is short and several of these sections run nine lines or
     more, so centered setting leaves every line starting and ending in a
     different place with no left edge for the eye to return to. Ragged-right
     is simply easier to read there, and the block itself stays centered in
     the column, so the composition is unchanged. Size and line-height stay on
     the shared Body role at every width. */
  @media (max-width: 640px) {
    .section-intro-inner p {
      text-align: left;
    }
  }
  @media (max-width: 760px) {
    /* This single-line link's own text box measures ~20px tall — under the
       WCAG 2.5.8 AA touch-target guidance. Padding grows the tappable area;
       the equal-and-opposite negative margin keeps the visible underlined
       text sitting exactly where it did, so this is hit-slop only, not a
       layout change (the block stays centered — both are symmetric). */
    .section-intro-link {
      padding: 10px 14px;
      margin-top: calc(var(--space-5) - 10px);
      margin-right: -14px;
      margin-bottom: -10px;
      margin-left: -14px;
    }
  }
</style>
