---
// "What's happening" — V2 reworks this from two hand-authored, manually
// balanced columns into one flat, category-tagged collection (see
// content.config.ts's `activityItem`), so it can actually hold ODDfest,
// ODDference, ODDspace, member events, open calls, etc. side by side without
// an editor having to decide which fixed column a new item goes in. The
// paper-band identity and underlined-title link treatment are unchanged.
import Pill from '../primitives/Pill.astro';

interface Item {
  date: string;
  category: string;
  title: string;
  description: string;
  href: string;
}
interface Props {
  items: Item[];
  note: string;
}
const { items, note } = Astro.props;
---

<div class="whats-on" id="whats-happening">
  <div class="wrap">
    <div class="whats-on-eyebrow">What&rsquo;s happening</div>
    <div class="whats-on-grid reveal">
      {
        items.map((item) => (
          <div class="whats-on-row">
            <div class="whats-on-when">
              <span class="whats-on-category">{item.category}</span>
              <span class="whats-on-date">{item.date}</span>
            </div>
            <div class="whats-on-body">
              <a
                class="whats-on-title"
                href={item.href}
                target={item.href.startsWith('http') ? '_blank' : undefined}
                rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
              >
                {item.title}
              </a>
              <p class="whats-on-desc">{item.description}</p>
              <Pill href={item.href} variant="ticket" magnetic>
                Find out more →
              </Pill>
            </div>
          </div>
        ))
      }
    </div>
    <p class="whats-on-note">{note}</p>
  </div>
</div>

<style>
  .whats-on {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 3rem 0 3.5rem;
    /* The nav is position:sticky — without this, an in-page anchor jump
       (e.g. the homepage hero's "See what's on" CTA) lands with the section
       head hidden under it. */
    scroll-margin-top: var(--nav-h);
  }
  .whats-on-eyebrow {
    font: var(--text-caption);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgb(36 34 32 / 50%);
    margin-bottom: 1.6rem;
  }
  .whats-on-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0 3rem;
  }
  .whats-on-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding: 1.1rem 0;
    border-top: 1px solid rgb(36 34 32 / 14%);
  }
  .whats-on-when {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .whats-on-category {
    font: var(--text-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(36 34 32 / 55%);
  }
  .whats-on-date {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .whats-on-title {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.2;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-decoration-color: rgb(36 34 32 / 35%);
    transition: text-decoration-color var(--duration-fast) ease;
  }
  @media (hover: hover) {
    .whats-on-title:hover {
      color: var(--color-ticket-blue);
      text-decoration-color: var(--color-ticket-blue);
    }
  }
  /* Touch press state. `(hover: hover)` above keeps the pointer-only
     enhancements off touchscreens, where iOS leaves :hover stuck on the
     last-tapped element; this is what replaces them — an immediate, physical
     acknowledgement at the moment of the tap. The tap-highlight reset is
     paired with it deliberately: the platform's grey flash is only removed
     because there is a real state taking its place. */
  @media (hover: none) {
    .whats-on-title {
      -webkit-tap-highlight-color: transparent;
    }
    .whats-on-title:active {
      color: var(--color-ticket-blue);
      text-decoration-color: var(--color-ticket-blue);
    }
  }

  .whats-on-desc {
    margin: 0.4rem 0 0;
    font-family: var(--font-body);
    font-size: 0.85rem;
    /* Archive value (65%) measured 4.43:1 on the light band background —
       just under WCAG AA. Lightened to 68% (4.83:1), same reasoning as
       --color-paper-40 in tokens.css. */
    color: rgb(36 34 32 / 68%);
    line-height: 1.5;
  }
  .whats-on-body :global(.pill) {
    display: inline-block;
    margin-top: 1.1rem;
  }
  .whats-on-note {
    margin: 1.8rem 0 0;
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: rgb(36 34 32 / 45%);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .whats-on-grid .whats-on-row {
      opacity: 0;
      transform: translateY(10px);
      transition:
        opacity 0.5s ease,
        transform 0.5s ease;
    }
    :global(html.reveal-js) .whats-on-grid.in .whats-on-row {
      opacity: 1;
      transform: none;
    }
  }
</style>
