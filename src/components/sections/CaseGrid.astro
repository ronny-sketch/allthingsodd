---
// Reusable case/story card grid — Work with ODD "Selected work", ODDagency
// "Selected cases", and Home's single-case teaser (via CaseGrid with one
// item) all use this. Typographic by default: ODDagency and Home still have
// no real case photography, so their cards stay strong editorial cards
// instead of forcing a stock/placeholder image — see content.config.ts's
// `caseStudy`.
//
// 2026-09-14: Work with ODD's references are real ODDfest work with real
// photos (BajaMyArt, the 2025 aftermovie, the two Flickr archives), so a
// card can now carry an optional photo, its own link label, and `external`.
// Every one of those references points off-site, where a same-tab
// "Read more →" was wrong on all counts. A card that sets none of the three
// renders exactly as before. See content.config.ts's `referenceCase`.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Metric {
  value: string;
  label: string;
}
interface CaseItem {
  category: string;
  title: string;
  partner?: string;
  summary: string;
  metrics?: Metric[];
  href: string;
  image?: ImageMetadata;
  linkLabel?: string;
  external?: boolean;
}
interface Props {
  items: CaseItem[];
  // Caps how many cards share a row. Work with ODD passes 2 so its four
  // references read as a 2×2 block instead of three plus a stranded fourth.
  // Layout, not content — which is why it's a prop and not a CMS field.
  maxColumns?: number;
}
const { items, maxColumns } = Astro.props;
---

<div
  class="case-grid reveal"
  style={maxColumns ? `--case-grid-max-cols: ${maxColumns}` : undefined}
>
  {
    items.map((c) => (
      <a
        class="case-card"
        href={c.href}
        target={c.external ? '_blank' : undefined}
        rel={c.external ? 'noreferrer' : undefined}
      >
        {c.image && (
          <div class="case-media">
            <Image class="case-media-img" src={c.image} alt="" width={800} />
          </div>
        )}
        <span class="case-category">
          {c.category}
          {c.partner && ` · ${c.partner}`}
        </span>
        <h3>{c.title}</h3>
        <p>{c.summary}</p>
        {c.metrics && c.metrics.length > 0 && (
          <div class="case-metrics">
            {c.metrics.map((m) => (
              <div class="case-metric">
                <b>{m.value}</b>
                <span>{m.label}</span>
              </div>
            ))}
          </div>
        )}
        <span class="case-go">{c.linkLabel ?? 'Read more →'}</span>
      </a>
    ))
  }
</div>

<style>
  /* Capped max track width, no container background (2026-08-31 final
     implementation pass, same fix as FeatureGrid/PersonGrid's identical
     bug) — an uncapped 1fr track lets a lone last-row card stretch to fill
     the whole row once real cases exist in a count that doesn't divide
     evenly per row; `justify-content: center` centers a short final row
     instead of leaving it flush left; dropping the background stops CSS
     Grid's uniform-column-count-per-row from painting an incomplete last
     row's genuinely empty cells as a bare solid-color box (each card's own
     background below plus `gap` is what reads as a hairline grid). */
  .case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17.5rem, 20rem));
    justify-content: center;
    gap: 1px;
  }
  /* `maxColumns` — narrows the container to exactly N 20rem tracks plus
     their 1px gaps, so auto-fit can't open an (N+1)th column. Unset, nothing
     here applies and the grid is as wide as its parent. */
  .case-grid[style*='--case-grid-max-cols'] {
    max-width: calc(var(--case-grid-max-cols) * 20rem + (var(--case-grid-max-cols) - 1) * 1px);
    margin-inline: auto;
  }
  .case-card {
    background: var(--color-backstage);
    padding: 2.4rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: background-color var(--duration-fast) ease;
  }
  @media (hover: hover) {
    .case-card:hover {
      background: color-mix(in srgb, var(--color-backstage) 85%, var(--color-paper) 15%);
    }
  }
  /* Optional photo (2026-09-14). It bleeds to the card's edges by cancelling
     the card's own padding, so a photo card and a typographic card keep one
     grid rhythm. 4:3 with the same grade as OddfestExamples' media. The
     alt is empty on purpose: the photo illustrates the card's own title,
     which is the link's accessible name. */
  .case-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin: -2.4rem -2.4rem var(--space-6);
    background: var(--color-backstage);
  }
  .case-media :global(.case-media-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.15) brightness(0.92);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .case-media :global(.case-media-img) {
      transition: transform 0.6s ease;
    }
    .case-card:hover .case-media :global(.case-media-img) {
      transform: scale(1.05);
    }
  }
  .case-category {
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-40);
  }
  .case-card h3 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }
  .case-card p {
    font: var(--text-body);
    color: var(--color-paper-60);
    margin: var(--space-3) 0 0;
    flex: 1;
  }
  .case-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin: var(--space-5) 0 0;
  }
  .case-metric {
    display: flex;
    flex-direction: column;
  }
  .case-metric b {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    font-variant-numeric: tabular-nums;
  }
  .case-metric span {
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-40);
  }
  .case-go {
    display: inline-block;
    width: fit-content;
    margin-top: var(--space-5);
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-paper);
    border-bottom: 1px solid var(--color-paper-40);
    padding-bottom: 0.15rem;
    transition: border-color var(--duration-fast) ease;
  }
  @media (hover: hover) {
    .case-card:hover .case-go {
      border-color: var(--color-paper);
    }
  }
  /* Touch press state. `(hover: hover)` above keeps the pointer-only
     enhancements off touchscreens, where iOS leaves :hover stuck on the
     last-tapped element; this is what replaces them — an immediate, physical
     acknowledgement at the moment of the tap. The tap-highlight reset is
     paired with it deliberately: the platform's grey flash is only removed
     because there is a real state taking its place. */
  @media (hover: none) {
    .case-card {
      -webkit-tap-highlight-color: transparent;
      transition:
        transform 0.12s ease,
        background 0.12s ease;
    }
    .case-card:active {
      transform: scale(0.985);
      background: color-mix(in srgb, var(--color-backstage) 85%, var(--color-paper) 15%);
    }
    .case-card:active .case-go {
      border-color: var(--color-paper);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .case-grid .case-card {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.55s ease,
        transform 0.55s ease;
    }
    :global(html.reveal-js) .case-grid.in .case-card {
      opacity: 1;
      transform: none;
    }
  }
</style>
