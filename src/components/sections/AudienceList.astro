---
// A lighter typographic treatment for "who it's for" lists — audiences
// aren't parallel features or steps, so FeatureGrid's bordered card grid
// overstates them as another chapter of cards. This scans as a plain list:
// a bold label, a short description, nothing else. See content.config.ts's
// `audienceItem` fragment (oddference.json/membership.json both use this
// shape) and docs/design-system.md's FeatureGrid usage rule.
interface Item {
  label: string;
  description: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ul class="audience-list reveal">
  {
    items.map((item) => (
      <li>
        <span class="audience-label">{item.label}</span>
        <span class="audience-description">{item.description}</span>
      </li>
    ))
  }
</ul>

<style>
  /* No block margin of its own: the caller places the list with `.flow`,
     whose margin-block-start replaces the <ul>'s default one. Only the
     default bottom margin is reset. */
  .audience-list {
    list-style: none;
    margin-block-end: 0;
    margin-inline: auto;
    padding: 0;
    max-width: 46rem;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-paper-12);
  }
  .audience-list li {
    display: grid;
    /* An 18rem label column — wide enough for the longest single word a label
       carries ("Organisational") at the Heading role's 2rem cap. */
    grid-template-columns: minmax(0, 18rem) 1fr;
    gap: var(--space-3) 2rem;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-paper-12);
  }
  .audience-label {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    text-wrap: balance;
  }
  .audience-description {
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  @media (max-width: 640px) {
    .audience-list li {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .audience-list {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.55s ease,
        transform 0.55s ease;
    }
    :global(html.reveal-js) .audience-list.in {
      opacity: 1;
      transform: none;
    }
  }
</style>
