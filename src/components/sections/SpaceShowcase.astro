---
// The four real, distinct spaces inside ODDspace (co-working / event-gallery
// / auditorium / studio) — a photo-led editorial grid, not another
// text-only FeatureGrid, since the brief asks the visitor to see the rooms
// before reading much copy about them.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Pill from '../primitives/Pill.astro';

interface Space {
  name: string;
  body: string;
  bullets?: string[];
  image?: ImageMetadata;
  // The card's own CTA (2026-09-11). Added for ODDstudio, which has a real
  // page of its own, and extended the same day to every ODDspace card so a
  // reader who has just decided they want *this* room can act on it there
  // and then. A caller that sets neither (ODDstudio's own `kit` cards)
  // renders exactly as before. Both are required together — a label with
  // no href would be a dead control.
  href?: string;
  goLabel?: string;
}
interface Props {
  spaces: Space[];
}
const { spaces } = Astro.props;
---

<div class="space-showcase reveal">
  {
    spaces.map((s) => (
      <div class="space-card">
        {s.image && (
          <div class="space-card-photo">
            <Image src={s.image} alt="" width={700} />
          </div>
        )}
        <div class="space-card-body">
          <h3>{s.name}</h3>
          <p>{s.body}</p>
          {s.bullets && (
            <ul>
              {s.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          )}
          {s.href && s.goLabel && (
            <div class="space-card-go">
              <Pill href={s.href} variant="outline" magnetic>
                {s.goLabel}
              </Pill>
            </div>
          )}
        </div>
      </div>
    ))
  }
</div>

<style>
  .space-showcase {
    display: grid;
    /* minmax(0, 1fr): with 1fr, a card's one-line CTA label set the column's
       minimum and pushed the grid past its wrap at tablet widths. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-paper-12);
  }
  .space-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
  }
  .space-card-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .space-card-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.1);
  }
  .space-card-body {
    padding: 1.8rem 2rem 2.2rem;
    /* Grows to fill the card (the photo above it is fixed-ratio) and lays
       its own children out in a column, so .space-card-go's `margin-top:
       auto` has something to push against. */
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .space-card-body h3 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: 0;
  }
  .space-card-body p {
    font: var(--text-body);
    color: var(--color-paper-60);
    margin: 0.7rem 0 0;
  }
  .space-card-body ul {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .space-card-body li {
    font: var(--text-body);
    color: var(--color-paper-60);
    padding-left: 1rem;
    position: relative;
  }
  .space-card-body li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-paper-40);
  }
  /* Per-card CTA. A real Pill rather than the underlined text link this was
     until 2026-09-11: these are now the page's primary routing controls for
     each room, not a footnote, and Pill already carries the site's focus,
     touch-target and long-label-wrapping behaviour (see Pill.astro) instead
     of this component re-deriving them. `auto` bottoms it out so the CTAs in
     a row of cards line up with each other whatever length the copy above
     them runs to. */
  .space-card-go {
    margin-top: auto;
    padding-top: 1.5rem;
  }
  .space-card-go :global(.pill) {
    white-space: normal;
    max-width: 100%;
    text-align: center;
  }
  @media (max-width: 700px) {
    .space-showcase {
      grid-template-columns: 1fr;
    }
    /* A modest mobile gutter (2026-08-31 final implementation pass) — the
       previous near-zero 0.2rem horizontal padding ran the body text right
       up against the viewport edge on a single-column mobile card, which
       read as unfinished rather than intentional. */
    .space-card-body {
      padding: 1.4rem 1.1rem 1.8rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .space-showcase .space-card {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.55s ease,
        transform 0.55s ease;
    }
    :global(html.reveal-js) .space-showcase.in .space-card {
      opacity: 1;
      transform: none;
    }
  }
</style>
