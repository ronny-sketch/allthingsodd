---
// Shared top-of-page header — eyebrow/title/intro(+optional CTAs) — for
// pages that don't use SplitHero/FullbleedVideoHero's media-panel layout
// (Contact, Media, Privacy). See
// docs/architecture.md#hero-variants for why those two are separate.
import Pill from '../primitives/Pill.astro';

interface LinkCta {
  label: string;
  href: string;
  external?: boolean;
}
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  primaryCta?: LinkCta;
  secondaryCta?: LinkCta;
}
const { eyebrow, title, intro, primaryCta, secondaryCta } = Astro.props;
---

<section class="page-intro">
  <div class="wrap">
    <div class="page-intro-head reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p>{intro}</p>
      {
        (primaryCta || secondaryCta) && (
          <div class="page-intro-ctas">
            {primaryCta && (
              <Pill
                href={primaryCta.href}
                variant="solid"
                magnetic
                target={primaryCta.external ? '_blank' : undefined}
              >
                {primaryCta.label}
              </Pill>
            )}
            {secondaryCta && (
              <Pill
                href={secondaryCta.href}
                variant="outline"
                magnetic
                target={secondaryCta.external ? '_blank' : undefined}
              >
                {secondaryCta.label}
              </Pill>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  /* One section gap under the nav; half a gap below, like any other section
     (layout.css, section rhythm). The nav is `position: sticky`, so it
     already takes its own height in the flow — don't add --nav-h here. */
  .page-intro {
    padding-block: var(--space-section) calc(var(--space-section) / 2);
  }
  .page-intro-head {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .page-intro-head .eyebrow {
    color: var(--color-paper-60);
  }
  .page-intro-head h1 {
    font: var(--text-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }
  .page-intro-head p {
    max-width: 38ch;
    margin: var(--space-5) 0 0;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  .page-intro-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
