---
// Shared top-of-page header — eyebrow/title/intro(+optional CTAs) — for
// pages that don't use SplitHero/FullbleedVideoHero's media-panel layout
// (Contact, Media, and V2's Work with ODD / Membership gateway pages). See
// docs/architecture.md#hero-variants for why those two are separate.
import Pill from '../primitives/Pill.astro';
import WarpingText from '../media/WarpingText.astro';

interface LinkCta {
  label: string;
  href: string;
  external?: boolean;
}
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  primaryCta?: LinkCta;
  secondaryCta?: LinkCta;
  // Opt-in per caller (default off) — Contact, Media, Work with ODD and
  // Membership all share this component; the living-warping treatment is
  // meant for a couple of real headings for variation, not every page that
  // happens to reuse this shape (a utility page like Contact doesn't want it).
  warpTitle?: boolean;
}
const { eyebrow, title, intro, primaryCta, secondaryCta, warpTitle = false } = Astro.props;
---

<section class="page-intro">
  <div class="wrap">
    <div class="page-intro-head reveal">
      <span class="eyebrow">{eyebrow}</span>
      {
        warpTitle ? (
          <WarpingText
            as="h1"
            text={title}
            class="page-intro-warping-title"
            color="paper"
            align="center"
          />
        ) : (
          <h1>{title}</h1>
        )
      }
      <p>{intro}</p>
      {
        (primaryCta || secondaryCta) && (
          <div class="page-intro-ctas">
            {primaryCta && (
              <Pill
                href={primaryCta.href}
                variant="solid"
                magnetic
                target={primaryCta.external ? '_blank' : undefined}
              >
                {primaryCta.label}
              </Pill>
            )}
            {secondaryCta && (
              <Pill
                href={secondaryCta.href}
                variant="outline"
                magnetic
                target={secondaryCta.external ? '_blank' : undefined}
              >
                {secondaryCta.label}
              </Pill>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .page-intro {
    padding: calc(var(--nav-h) + var(--space-20)) 0 var(--space-12);
  }
  .page-intro-head {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .page-intro-head .eyebrow {
    color: var(--color-paper-60);
  }
  /* :global() on the warping variant's class — WarpingText renders its <h1>
     inside its own component file, so this file's scoped-CSS attribute
     doesn't carry over to it; the bare `h1` selector still covers the
     non-warped (default) case. */
  .page-intro-head h1,
  .page-intro-head :global(.page-intro-warping-title) {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-paper);
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    line-height: 1.08;
    margin: 0.9rem 0 0;
  }
  .page-intro-head p {
    max-width: 38ch;
    margin: 1.6rem 0 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--color-paper-60);
  }
  .page-intro-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 1.8rem;
  }
</style>
