---
// Renders a legal page: prose sections, then the cookie declaration table,
// then a contact block. Shared rather than page-specific because a second
// legal document (terms of sale, a code of conduct) should be a JSON file
// and a two-line route, not another component — see the `legal` variant's
// comment in src/content.config.ts.
//
// The cookie table is built from src/scripts/consent-config.ts, which is
// the same array ConsentBanner.astro gates on. That shared import is the
// whole point: a tracker can't be added to the site without appearing here,
// and a category can't be documented here without being enforceable there.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { GA_MEASUREMENT_ID } from '../../scripts/analytics-config';
import { buildDeclaration } from '../../scripts/consent-config';

interface Section {
  title: string;
  body: string[];
  items?: string[];
  /** A photograph of what the section describes — used by the ODDspace event
   *  info pack to show each room. Privacy has nothing to photograph. */
  image?: { src: ImageMetadata; alt: string; caption?: string };
}
interface Props {
  lastUpdated: string;
  sections: Section[];
  /** Heading for the contents list. Present = render one, linking to each
   *  section. A document long enough to need one says so in its content;
   *  /privacy is nine sections and does not. */
  contents?: string;
  /** Omitted by legal-template documents that are not the privacy policy
   *  (the ODDspace event info pack and code of conduct): there is no cookie
   *  declaration to make on a page that sets nothing the others don't. */
  cookieSection?: { title: string; body: string[]; settingsLabel: string };
  contact: { title: string; body: string[]; name: string; email: string; address: string };
}
const { lastUpdated, sections, contents, cookieSection, contact } = Astro.props;

/** Section ids are derived from the title, so the contents list and any
 *  link someone shares ("see #house-rules") stay in sync with the copy. */
const slug = (title: string) =>
  title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const declaration = buildDeclaration(GA_MEASUREMENT_ID);

const KIND_LABEL: Record<string, string> = {
  cookie: 'Cookie',
  localStorage: 'Local storage',
  sessionStorage: 'Session storage',
};
---

<section class="legal">
  <div class="wrap flow">
    <p class="legal-updated reveal">Last updated: {lastUpdated}</p>

    {
      contents && (
        <nav class="legal-contents reveal" aria-labelledby="legal-contents-heading">
          <h2 id="legal-contents-heading">{contents}</h2>
          <ol>
            {sections.map((section) => (
              <li>
                <a href={`#${slug(section.title)}`}>{section.title}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {
      sections.map((section) => (
        <article class="legal-section reveal" id={slug(section.title)}>
          <h2>{section.title}</h2>
          {section.image && (
            <figure class="legal-figure">
              <Image
                src={section.image.src}
                alt={section.image.alt}
                widths={[480, 760, 1100]}
                sizes="(max-width: 46rem) 100vw, 46rem"
                loading="lazy"
              />
              {section.image.caption && <figcaption>{section.image.caption}</figcaption>}
            </figure>
          )}
          {section.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {section.items && (
            <ul>
              {section.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </article>
      ))
    }

    {
      cookieSection && (
        <article class="legal-section reveal" id="cookies">
          <h2>{cookieSection.title}</h2>
          {cookieSection.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}

          {declaration.map((category) => (
            <div class="legal-category">
              <h3>
                {category.label}
                {category.alwaysOn && <span class="legal-tag">Always on</span>}
              </h3>
              <p class="legal-category-summary">{category.summary}</p>
              {category.entries.length === 0 ? (
                /* An empty category is stated outright rather than omitted.
                   "We don't do this" is information a reader can act on;
                   silence is indistinguishable from an oversight. */
                <p class="legal-empty">Nothing in this category. We set none of these.</p>
              ) : (
                /* Wrapped, not styled to fit: a five-column table cannot
                   shrink to a 320px viewport without becoming unreadable, so
                   it scrolls inside its own box while the page itself never
                   scrolls sideways. tabindex makes that box keyboard-
                   reachable, which a scrollable region otherwise isn't. */
                <div
                  class="legal-table-scroll"
                  tabindex="0"
                  role="region"
                  aria-label={`${category.label} cookies`}
                >
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Type</th>
                        <th scope="col">Set by</th>
                        <th scope="col">Purpose</th>
                        <th scope="col">Kept for</th>
                      </tr>
                    </thead>
                    <tbody>
                      {category.entries.map((entry) => (
                        <tr>
                          <th scope="row">
                            <code>{entry.name}</code>
                            {entry.scope && <span class="legal-scope">{entry.scope}</span>}
                          </th>
                          <td>{KIND_LABEL[entry.kind] ?? entry.kind}</td>
                          <td>{entry.provider}</td>
                          <td>{entry.purpose}</td>
                          <td>{entry.retention}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          ))}

          <button type="button" class="legal-settings-btn" id="privacyConsentSettings">
            {cookieSection.settingsLabel}
          </button>
        </article>
      )
    }

    <article class="legal-section reveal">
      <h2>{contact.title}</h2>
      {contact.body.map((paragraph) => <p>{paragraph}</p>)}
      <address>
        {contact.name}<br />
        <a href={`mailto:${contact.email}`}>{contact.email}</a><br />
        {contact.address}
      </address>
    </article>
  </div>
</section>

<script>
  import { openConsentSettings } from '../../scripts/consent';

  document
    .getElementById('privacyConsentSettings')
    ?.addEventListener('click', () => openConsentSettings());
</script>

<style>
  .legal .wrap {
    /* Narrower than the site's default wrap — this is the one page on the
       site that is genuinely read top to bottom, and a comfortable measure
       is the difference between a policy someone reads and one they scroll
       past. The paragraphs themselves hold to --measure-prose. */
    max-width: 46rem;
  }
  .legal-updated {
    font: var(--text-small);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-paper-40);
    margin: 0;
  }
  /* Contents list — only rendered for documents that ask for one. Two
     columns where there is room, so a long pack's contents stay one glance
     rather than one scroll. */
  .legal-contents h2 {
    font: var(--text-body);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-paper-40);
    margin: 0 0 var(--space-3);
  }
  .legal-contents ol {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2;
    column-gap: var(--space-5);
    counter-reset: legal-contents;
  }
  .legal-contents li {
    break-inside: avoid;
    counter-increment: legal-contents;
    margin: 0 0 var(--space-2);
  }
  .legal-contents a {
    font: var(--text-body);
    color: var(--color-paper-80);
    text-decoration: none;
    display: grid;
    grid-template-columns: 2ch 1fr;
    gap: var(--space-2);
  }
  .legal-contents a::before {
    content: counter(legal-contents, decimal-leading-zero);
    color: var(--color-paper-40);
    font-variant-numeric: tabular-nums;
  }
  .legal-contents a:hover,
  .legal-contents a:focus-visible {
    color: var(--color-paper);
    text-decoration: underline;
  }
  @media (max-width: 40rem) {
    .legal-contents ol {
      columns: 1;
    }
  }

  /* A room, photographed. Sits above the copy that describes it. */
  .legal-figure {
    margin: 0 0 var(--space-4);
  }
  .legal-figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .legal-figure figcaption {
    font: var(--text-small);
    color: var(--color-paper-40);
    margin-block-start: var(--space-2);
  }

  /* .legal takes layout.css's section rhythm; the `.flow` wrap puts the
     first section a content step under the date, and each later section is
     a new group. Paragraph margins inside a section collapse into that
     step rather than adding to it. */
  .legal-section + .legal-section {
    margin-block-start: var(--space-group);
  }
  .legal-section h2 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: 0 0 var(--space-3);
  }
  /* A subsection label inside running legal text: Forta for continuity with
     the h2 above, at the Body size so it stays in the reading flow instead of
     competing with the section title. */
  .legal-section h3 {
    font-family: var(--font-display);
    font-size: var(--font-size-body);
    /* Forta ships a single 400 face. Without this the h3 takes the browser's
       default bold, which the browser then synthesises. */
    font-weight: 400;
    color: var(--color-paper);
    margin: 0 0 var(--space-2);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .legal-section p,
  .legal-section li {
    max-width: var(--measure-prose);
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  .legal-section p {
    margin: 0 0 var(--space-4);
  }
  .legal-section ul {
    margin: 0 0 var(--space-4);
    padding-left: 1.1rem;
  }
  .legal-section li {
    margin-bottom: var(--space-3);
  }
  .legal-category {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-paper-12);
  }
  .legal-category-summary {
    margin-bottom: var(--space-4);
  }
  .legal-tag {
    font: var(--text-small);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-paper-40);
    border: 1px solid var(--color-paper-20);
    border-radius: var(--radius-pill);
    padding: 0.15rem 0.55rem;
  }
  /* Scoped under .legal-section so it outranks `.legal-section p` — whose
     `font` shorthand would otherwise reset the italic. */
  .legal-section .legal-empty {
    font-style: italic;
    margin: 0;
  }
  .legal-table-scroll {
    overflow-x: auto;
    border: 1px solid var(--color-paper-12);
  }
  .legal-table-scroll table {
    border-collapse: collapse;
    width: 100%;
    /* Sized to fit inside the 46rem reading column at desktop (minus the
       wrap's own padding) so the table does NOT scroll on the viewports
       most people read this on — below that the five columns would wrap
       into unreadable slivers, and the scroll container above takes over
       instead. */
    min-width: 42rem;
  }
  .legal-table-scroll th,
  .legal-table-scroll td {
    font: var(--text-small);
    text-align: left;
    vertical-align: top;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-paper-12);
    color: var(--color-paper-60);
  }
  .legal-table-scroll thead th {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-paper-80);
    white-space: nowrap;
  }
  .legal-table-scroll tbody tr:last-child th,
  .legal-table-scroll tbody tr:last-child td {
    border-bottom: 0;
  }
  .legal-table-scroll tbody th {
    font-weight: 400;
    color: var(--color-paper-80);
  }
  .legal-table-scroll code {
    /* The platform monospace for storage keys, at the Small size like the
       rest of the table — the one place the site sets a third family. */
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--font-size-small);
    color: var(--color-paper);
    display: block;
  }
  .legal-scope {
    display: block;
    margin-top: var(--space-2);
    font: var(--text-small);
    color: var(--color-paper-40);
  }
  .legal-settings-btn {
    margin-top: var(--space-6);
    font: var(--text-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    padding: 0.7rem 1.4rem;
    border-radius: var(--radius-pill);
    /* Signal-deep for the same 3.3:1 → 4.7:1 reason as ConsentBanner's
       solid button, which this one reopens. */
    background: var(--color-signal-deep);
    border: 1px solid var(--color-signal-deep);
    color: var(--color-paper);
    cursor: pointer;
    transition: opacity var(--duration-fast) ease;
  }
  .legal-settings-btn:hover {
    opacity: 0.85;
  }
  .legal-section address {
    font: var(--text-body);
    font-style: normal;
    color: var(--color-paper-60);
  }
  .legal-section address a {
    color: var(--color-paper);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
