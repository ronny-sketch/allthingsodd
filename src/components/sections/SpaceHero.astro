---
// ODDspace's hero — same family as FullbleedVideoHero.astro (fullbleed,
// dark scrim, centered wordmark/h1/meta/CTAs) but built for a *grid* of real
// photos of the actual space instead of one video, since ODDspace's brief
// asks for the space itself to be the protagonist, shown through a lot of
// real photography rather than one clip. Static CSS grid, no client script —
// unlike Hero.astro's interactive Ken-Burns mosaic, this doesn't need
// pointer-driven motion to make its point, and staying static keeps this
// fully reduced-motion-safe by construction (see CLAUDE.md's motion rule).
//
// The scrim/text below use fixed --swatch-* values, not the themeable
// --color-paper/--color-ink roles — ODDspace's page is theme="light"
// (Layout.astro), and --color-paper is the token that inverts under
// .theme-light (see tokens.css and ParticipateBand.astro's identical note),
// which would put dark text on this hero's dark photo scrim. The scrim
// needs to read the same regardless of the page's own theme.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Pill from '../primitives/Pill.astro';

interface Photo {
  image: ImageMetadata;
  alt: string;
}
interface LinkCta {
  label: string;
  href: string;
}
interface Props {
  photos: Photo[];
  title: string;
  // The quiet first sentence of a two-ink h1 (2026-09-19, the ODDfest 2026
  // thank-you): set at Heading and dimmed above `title`, which stays the
  // loud line at Display. Without it the h1 is `title` alone, as before.
  premise?: string;
  // Opt-in opening (same page): the photographs collide into the frame
  // around cell-1 and the text arrives in beats, ODDfest's register (see
  // Hero.astro's cell-fly) rather than ODDspace's still one. Off by default
  // so every ODDspace hero keeps its approved static composition.
  opening?: boolean;
  meta?: string;
  logo?: ImageMetadata;
  logoAlt?: string;
  primaryCta?: LinkCta;
  secondaryCta?: LinkCta;
}
const {
  photos,
  title,
  premise,
  opening = false,
  meta,
  logo,
  logoAlt = '',
  primaryCta,
  secondaryCta,
} = Astro.props;
---

{
  /* No `.reveal` (removed 2026-09-02) — same reasoning as
     FullbleedVideoHero.astro: this is the page's first paint and LCP
     candidate, so it must not start at opacity 0 waiting on an
     IntersectionObserver. Its entrance is a CSS animation instead. */
}
<header class:list={['space-hero', opening && 'has-opening']}>
  <div class="space-hero-grid" aria-hidden="true">
    {
      photos.map((p, i) => (
        <div class={`space-hero-cell cell-${i + 1}`}>
          <Image
            src={p.image}
            alt=""
            width={i === 0 ? 1400 : 800}
            loading="eager"
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </div>
      ))
    }
  </div>
  <p class="sr-only">
    {photos.map((p) => p.alt).join('. ')}
  </p>
  <div class="space-hero-scrim"></div>
  <div class="space-hero-overlay">
    {
      logo && (
        <div class="space-hero-logo">
          <Image src={logo} alt={logoAlt} width={420} />
        </div>
      )
    }
    <h1 class="space-hero-title">
      {
        premise ? (
          <>
            <span class="space-hero-premise">{premise}</span>{' '}
            <span class="space-hero-point">{title}</span>
          </>
        ) : (
          title
        )
      }
    </h1>
    {meta && <p class="space-hero-meta">{meta}</p>}
    {
      (primaryCta || secondaryCta) && (
        <div class="space-hero-ctas">
          {primaryCta && (
            <Pill href={primaryCta.href} variant="solid" magnetic class="space-hero-pill-solid">
              {primaryCta.label}
            </Pill>
          )}
          {secondaryCta && (
            <Pill
              href={secondaryCta.href}
              variant="outline"
              magnetic
              class="space-hero-pill-outline"
            >
              {secondaryCta.label}
            </Pill>
          )}
        </div>
      )
    }
  </div>
</header>

<style>
  /* Full-frame height (2026-08-31, requirement 23) — same reasoning as
     FullbleedVideoHero.astro's identical change: nav + hero should read as
     one first viewport, svh avoids the mobile-Safari toolbar jump, the
     fixed min-height floor protects the logo/title/meta/CTA stack on short
     viewports, and there's no more margin-bottom here — the hero's half of
     the hero→content gap is SubpageFrame's `.oddf-center` top padding (the
     first section pads the other half). */
  .space-hero {
    position: relative;
    height: calc(100vh - var(--nav-h));
    height: calc(100svh - var(--nav-h));
    min-height: 560px;
    overflow: hidden;
    background: var(--swatch-ink);
  }
  .space-hero-grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 3px;
  }
  .space-hero-cell {
    position: relative;
    overflow: hidden;
    background: rgb(255 255 255 / 6%);
  }
  .space-hero-cell :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* 0.95, not 0.82 (2026-09-25): measured on screen, the hero photos sat
       at 7-34% luminance with up to 80% of the frame near-black. Same lift
       FullbleedVideoHero got the day before; the scrim below carries the
       text contrast. */
    filter: contrast(1.05) saturate(1.1) brightness(0.95);
  }
  /* An asymmetric 8-cell layout — cell-1 (the first of heroPhotos) anchors
     the grid as the largest cell, the rest fill in around it. Deliberately
     not a plain N-up grid: the brief asks the space to read as "entered",
     not tiled. */
  .cell-1 {
    grid-column: 1 / 4;
    grid-row: 1 / 4;
  }
  .cell-2 {
    grid-column: 4 / 6;
    grid-row: 1 / 3;
  }
  .cell-3 {
    grid-column: 6 / 7;
    grid-row: 1 / 2;
  }
  .cell-4 {
    grid-column: 6 / 7;
    grid-row: 2 / 3;
  }
  .cell-5 {
    grid-column: 4 / 5;
    grid-row: 3 / 5;
  }
  .cell-6 {
    grid-column: 5 / 7;
    grid-row: 3 / 5;
  }
  .cell-7 {
    grid-column: 1 / 2;
    grid-row: 4 / 5;
  }
  .cell-8 {
    grid-column: 2 / 4;
    grid-row: 4 / 5;
  }
  /* Mobile: a 2x2 frame where all eight photographs live in four slots.
     Rewritten 2026-09-02 — this used to lay the eight cells out in a flat 2x4
     grid and then `display: none` the last four, so a phone got a static
     half-crop of the composition and none of the ambience the desktop grid
     has. The four photos were still being downloaded (every cell ships
     `loading="eager"`), so hiding them cost their bytes and returned nothing.

     Now cells 5-8 are stacked onto slots 1-4 and slowly crossfade past them
     on a long, phase-offset cycle: the space is always changing but never in
     a hurry, which is ODDspace's own register — atmosphere and architecture,
     not the festival's collision energy (see Hero.astro/mosaic.ts for the
     deliberately faster ODDfest language). Pure CSS on four elements, no
     script, no extra requests, no per-frame work. */
  @media (max-width: 820px) {
    .space-hero-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(2, 1fr);
    }
    .cell-1,
    .cell-5 {
      grid-area: 1 / 1;
    }
    .cell-2,
    .cell-6 {
      grid-area: 1 / 2;
    }
    .cell-3,
    .cell-7 {
      grid-area: 2 / 1;
    }
    .cell-4,
    .cell-8 {
      grid-area: 2 / 2;
    }
  }
  /* Reduced motion keeps the original static four-photo frame — the second
     layer is removed entirely rather than parked at opacity 0, so there's no
     stacked-image decode to settle. */
  @media (max-width: 820px) and (prefers-reduced-motion: reduce) {
    .cell-5,
    .cell-6,
    .cell-7,
    .cell-8 {
      display: none;
    }
  }
  @media (max-width: 820px) and (prefers-reduced-motion: no-preference) {
    .cell-5,
    .cell-6,
    .cell-7,
    .cell-8 {
      opacity: 0;
      animation: odds-crossfade 32s ease-in-out infinite;
    }
    /* Negative delays start each slot part-way through the same cycle, so the
       four never turn over together — one corner of the frame is always
       mid-change and the others are settled. */
    .cell-6 {
      animation-delay: -8s;
    }
    .cell-7 {
      animation-delay: -16s;
    }
    .cell-8 {
      animation-delay: -24s;
    }
  }
  @keyframes odds-crossfade {
    0%,
    38% {
      opacity: 0;
    }
    50%,
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  .space-hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 55% 60% at 50% 55%, rgb(14 9 11 / 30%) 0%, rgb(14 9 11 / 52%) 100%),
      linear-gradient(
        to top,
        rgb(14 9 11 / 72%) 0%,
        rgb(14 9 11 / 10%) 40%,
        rgb(14 9 11 / 30%) 100%
      );
  }
  .space-hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-5);
    padding: 2rem;
  }
  /* Short viewports — same reasoning and same fix as
     FullbleedVideoHero.astro's identical block: the 560px portrait floor
     otherwise makes this hero taller than a landscape phone's whole screen,
     pushing its CTAs below the fold. Content-sized here, viewport height as a
     minimum rather than a target; the photo grid stays absolutely positioned
     behind, so the full-frame composition is unchanged. */
  @media (max-height: 620px) {
    .space-hero {
      height: auto;
      min-height: calc(100vh - var(--nav-h));
      min-height: calc(100svh - var(--nav-h));
      display: flex;
    }
    .space-hero-overlay {
      position: relative;
      inset: auto;
      flex: 1;
      padding: 2rem 1.5rem;
      gap: var(--space-3);
    }
    .space-hero-logo {
      width: min(15rem, 44vw);
    }
  }
  .space-hero-logo {
    width: min(18.75rem, 56vw);
    filter: drop-shadow(0 4px 30px rgb(14 9 11 / 50%));
  }
  .space-hero-logo :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Above 820px SubpageFrame's fixed 68px rails paint over both edges of this
     full-bleed frame, so the text column keeps clear of them — at the Display
     step the title otherwise ran to within 2px of the rails at 1024-1280px.
     Declared after the short-viewport block so a wide landscape screen gets
     the clearance too. */
  @media (min-width: 821px) {
    .space-hero-overlay {
      padding-inline: calc(68px + var(--space-8));
    }
  }
  /* The narrowest phones: 1rem each side instead of 2rem gives the Display
     title back enough measure to avoid one-word first and last lines. */
  @media (max-width: 400px) {
    .space-hero-overlay {
      padding-inline: 1rem;
    }
  }
  .space-hero-title {
    margin: 0;
    max-width: 32ch;
    font: var(--text-display);
    letter-spacing: var(--tracking-display);
    color: var(--swatch-paper);
    text-shadow:
      0 1px 3px rgb(14 9 11 / 75%),
      0 8px 32px rgb(14 9 11 / 50%);
  }
  /* The two-ink h1: premise at Heading in the meta line's 70% swatch, point
     at the title's own Display size, one flow step apart. */
  .space-hero-premise {
    display: block;
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: rgb(226 223 222 / 70%);
  }
  .space-hero-point {
    display: block;
    margin-top: var(--space-3);
  }
  .space-hero-meta {
    margin: 0;
    font: var(--text-small);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: rgb(226 223 222 / 70%);
  }
  .space-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    /* On top of the overlay's --space-5 gap: together the hero's body →
       actions step, --space-6. */
    margin-top: var(--space-1);
  }
  /* Bigger than the site's default Pill, here only (2026-09-11, at Ronny's
     request). Pill is sized for buttons sitting inside a text column; these
     two sit alone under a wordmark on a full-viewport photograph, where the
     default padding reads as a caption rather than the one thing the hero is
     asking you to do. Padding only; the label stays on the Small role like
     every other button (2026-09-13). Scoped to this hero — the primitive's
     own proportions, and every other caller, are untouched. The mobile
     touch-target floor in Pill.astro still applies on top of this: it sets
     vertical padding to 0.85rem under `(hover: none)`, which is larger than
     the value here, so the 44px minimum is unaffected. */
  .space-hero-ctas :global(.pill) {
    padding: 0.8rem 1.9rem;
  }
  @media (max-width: 480px) {
    .space-hero-ctas :global(.pill) {
      padding: 0.75rem 1.5rem;
    }
  }
  /* Entrance, replacing the `.reveal` class this header used to carry (see
     the markup comment above) — a CSS animation with `both` fill always ends
     visible, so the first screen can never depend on a script. */
  @media (prefers-reduced-motion: no-preference) {
    .space-hero-logo,
    .space-hero-title,
    .space-hero-meta,
    .space-hero-ctas {
      animation: space-hero-in 0.9s var(--ease-out-expo) both;
    }
    .space-hero-title {
      animation-delay: 0.1s;
    }
    .space-hero-meta {
      animation-delay: 0.18s;
    }
    .space-hero-ctas {
      animation-delay: 0.26s;
    }
  }
  /* A very slow, barely-there push into the photography — the "calm depth"
     half of ODDspace's motion register, and the mobile counterpart to the
     eight-cell composition desktop gets from its grid alone. Runs on the
     image, not the cell, so it composites on the GPU and never interacts
     with the crossfade above.

     Scoped to the same 820px breakpoint as the crossfade: desktop's hero is
     an approved static composition and this pass must not change it (an
     earlier revision of this rule was unscoped and moved the desktop
     photography, which the visual-regression baselines caught). */
  @media (max-width: 820px) and (prefers-reduced-motion: no-preference) {
    .space-hero-cell :global(img) {
      animation: space-hero-drift 46s ease-in-out infinite alternate;
    }
    .cell-2 :global(img),
    .cell-6 :global(img) {
      animation-delay: -11s;
    }
    .cell-3 :global(img),
    .cell-7 :global(img) {
      animation-delay: -23s;
    }
    .cell-4 :global(img),
    .cell-8 :global(img) {
      animation-delay: -34s;
    }
  }
  @keyframes space-hero-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* The opening (`opening` prop, 2026-09-19). Cell-1 is the LCP photograph
     and is never animated on opacity: it settles from a 1.06 scale while
     the other cells fly in around it, each from its own fixed offset (the
     same range Hero.astro's mosaic draws at random), 0.06 s apart. Then the
     point line, the meta and the pills arrive after the last photograph has
     landed. The offsets live in the keyframes' `from`, not in a base state,
     so a cell whose animation is something else (the phone's crossfade
     layer, cells 5-8) never inherits them; cells 5-8 only fly on desktop,
     where they are the visible grid rather than a second layer. Everything
     uses `both` fill, so the settled frame is also the reduced-motion and
     the no-JS frame. */
  .has-opening .cell-1 {
    --i: 0;
  }
  .has-opening .cell-2 {
    --i: 1;
    --ex: 40px;
    --ey: -24px;
    --er: 2.5deg;
  }
  .has-opening .cell-3 {
    --i: 2;
    --ex: -28px;
    --ey: -36px;
    --er: 2deg;
  }
  .has-opening .cell-4 {
    --i: 3;
    --ex: 32px;
    --ey: 30px;
    --er: -2deg;
  }
  .has-opening .cell-5 {
    --i: 4;
    --ex: -40px;
    --ey: 20px;
    --er: 3deg;
  }
  .has-opening .cell-6 {
    --i: 5;
    --ex: 24px;
    --ey: -32px;
    --er: -2.5deg;
  }
  .has-opening .cell-7 {
    --i: 6;
    --ex: -30px;
    --ey: -20px;
    --er: -2deg;
  }
  .has-opening .cell-8 {
    --i: 7;
    --ex: 36px;
    --ey: 26px;
    --er: 2.5deg;
  }
  @media (prefers-reduced-motion: no-preference) {
    .has-opening .space-hero-cell:where(.cell-2, .cell-3, .cell-4) {
      animation: space-hero-fly 0.95s var(--ease-out-expo) both;
      animation-delay: calc(var(--i) * 0.06s);
    }
    .has-opening .cell-1 {
      animation: space-hero-settle 1.6s var(--ease-out-expo) both;
    }
    .has-opening .space-hero-point {
      animation: space-hero-in 0.9s 0.9s var(--ease-out-expo) both;
    }
    .has-opening .space-hero-meta {
      animation-delay: 1.3s;
    }
    .has-opening .space-hero-ctas {
      animation-delay: 1.45s;
    }
  }
  @media (min-width: 821px) and (prefers-reduced-motion: no-preference) {
    .has-opening .space-hero-cell:where(.cell-5, .cell-6, .cell-7, .cell-8) {
      animation: space-hero-fly 0.95s var(--ease-out-expo) both;
      animation-delay: calc(var(--i) * 0.06s);
    }
  }
  /* On the phone cells 5-8 are the crossfade layer over slots 1-4, and the
     default phase offsets (-8/-16/-24 s) put two of them mid-cycle, fully
     visible, at load — which would cover the bottom row's fly-in. With an
     opening they all start in the hidden 38% of the cycle and turn over one
     after another from ~3 s, once the frame has assembled. */
  @media (max-width: 820px) and (prefers-reduced-motion: no-preference) {
    .has-opening .cell-6 {
      animation-delay: -3s;
    }
    .has-opening .cell-7 {
      animation-delay: -6s;
    }
    .has-opening .cell-8 {
      animation-delay: -9s;
    }
  }
  @keyframes space-hero-fly {
    from {
      opacity: 0;
      transform: translate(var(--ex, 0), var(--ey, 0)) rotate(var(--er, 0deg)) scale(0.82);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes space-hero-settle {
    from {
      transform: scale(1.06);
    }
    to {
      transform: none;
    }
  }
  @keyframes space-hero-drift {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.07);
    }
  }
  /* Pill's outline variant is styled for use on the site's normal (dark)
     background — here it sits directly on a photo, so it needs its own
     always-light border/text regardless of page theme, same reasoning as
     the rest of this component's fixed --swatch-* values. Scoped under
     .space-hero-overlay (a scoped selector, so Astro adds this component's
     own attribute selector to it) specifically to outrank Pill.astro's own
     `:global(.theme-light) .pill-outline` rule outright rather than tie
     with it at equal specificity, where source order (not intent) would
     decide the winner. */
  .space-hero-overlay :global(.space-hero-pill-outline.pill-outline) {
    border-color: var(--swatch-paper);
    color: var(--swatch-paper);
  }
  /* Same fix, same reasoning, for the solid variant (found 2026-08-31 during
     the hero-frame QA pass — a real pre-existing defect, not introduced by
     that work): Pill's `.pill-solid` is `background: var(--color-paper);
     color: var(--color-ink)`, which is correct against the site's normal
     dark ground but silently flips under `.theme-light` (ODDspace's own
     page theme) to a dark pill with light text — nearly invisible against
     this hero's own dark photo scrim, exactly the class of bug this
     component's header comment already describes for its plain text. Fixed
     swatch colors here restore the intended light-pill/dark-text solid
     button regardless of the page's theme. */
  .space-hero-overlay :global(.space-hero-pill-solid.pill-solid) {
    background: var(--swatch-paper);
    color: var(--swatch-ink);
    border-color: var(--swatch-paper);
  }
</style>
