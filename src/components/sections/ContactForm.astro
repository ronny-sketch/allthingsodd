---
// Real submission via Web3Forms (web3forms.com) — a free access key, no
// backend of ours needed. Until a key is set in src/content/pages/contact.json
// the form still renders (so layout/copy stay reviewable) but tells the
// visitor it isn't connected yet instead of silently discarding input. See
// docs/editing.md#contact-form.
//
// Topic routing (2026-09-11): a Web3Forms key is bound to one recipient
// address, so the visitor's chosen topic picks the key, and each key points
// at a Google Group rather than at a list of people — see content.config.ts's
// `formAccessKeys` note for why the fan-out deliberately lives in Workspace
// admin and not in this repo.
import { getEntry } from 'astro:content';
import Pill from '../primitives/Pill.astro';
import SocialIcon from '../primitives/SocialIcon.astro';
import { socialLinkLabel } from '../primitives/social-handle';
import { CONTACT_TOPICS } from '../../scripts/contact-topics';

const site = await getEntry('site', 'global');
if (!site) throw new Error('Missing site/global.json content entry');
const { contact, social, formAccessKeys } = site.data;

// "Connected" means at least the General key exists: every topic falls back
// to it, so one key is enough for the form to genuinely send. Checking each
// topic separately would show the not-connected note to a visitor whose
// message would in fact arrive.
const connected = Boolean(formAccessKeys?.general?.trim());
---

<section class="contact-section">
  <div class="wrap contact-grid reveal">
    <form
      class="contact-form"
      id="contactForm"
      data-access-keys={JSON.stringify(formAccessKeys ?? {})}
    >
      {
        /* The subject line the message arrives with in ODD's inbox — the
          site it came from, not the address it goes to. Updated 2026-09-03
          with the domain cutover: hello@oddfest.co stays the canonical
          address (a separate, unapproved migration), but the old oddfest.co
          site still exists and still has its own forms, so a subject naming
          it made messages from this site indistinguishable from that one's. */
      }
      <input
        type="hidden"
        name="subject"
        id="cf-subject"
        value="New message from the allthingsodd.co contact form"
      />
      <p class="contact-topic-note" id="cf-topic-note" hidden></p>
      {
        /* The routing control. It is a real, visible field rather than a
          hidden one inferred from the referring page: a visitor arriving on
          /contact directly has no referring page to infer from, and the
          person who knows which team should read this is the one writing it.
          Default is "general" — never guess a topic on the visitor's behalf,
          since guessing wrong sends their message to three people it isn't
          for. Deep links (?topic=) preselect it, and the visitor can still
          change it. */
      }
      <div class="field">
        <label for="cf-topic">What's this about?</label>
        <select id="cf-topic" name="topic" required>
          {
            CONTACT_TOPICS.map((t) => (
              <option value={t.value} selected={t.value === 'general'}>
                {t.label}
              </option>
            ))
          }
        </select>
      </div>
      <div class="field">
        <label for="cf-name">Name</label>
        <input id="cf-name" name="name" type="text" required autocomplete="name" />
      </div>
      <div class="field">
        <label for="cf-email">Email</label>
        <input id="cf-email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="cf-message">Message</label>
        <textarea id="cf-message" name="message" rows="5" required></textarea>
      </div>
      <input
        type="text"
        name="botcheck"
        class="botcheck"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />
      <div class="field-submit">
        <Pill type="submit" variant="solid">Send message</Pill>
        <p class="form-status" role="status" aria-live="polite"></p>
      </div>
      {
        !connected && (
          <p class="form-note">
            This form isn't connected yet — email us directly using the addresses alongside it.
          </p>
        )
      }
    </form>

    <div class="contact-direct">
      <h2>Reach us directly</h2>
      <ul class="contact-emails">
        {
          contact.map((c) => (
            <li>
              <span class="contact-label">{c.label}</span>
              <a href={`mailto:${c.email}`}>{c.email}</a>
            </li>
          ))
        }
      </ul>
      <div class="contact-social">
        {
          social.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noreferrer"
              aria-label={socialLinkLabel(s.platform, s.href)}
            >
              <SocialIcon platform={s.platform} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script src="../../scripts/contact-form.ts"></script>

<style>
  .contact-section {
    padding-top: 0;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 4rem;
    align-items: start;
    max-width: 56rem;
  }
  @media (max-width: 760px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .field label {
    font: var(--text-caption);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-paper-40);
  }
  .field input,
  .field select,
  .field textarea {
    /* width/min-width: a <select> sizes to its longest option's intrinsic
       width, and default min-width:auto on a flex item lets it escape the
       column instead of shrinking — same fix, same reason, as
       WorkEnquiryForm.astro's select. */
    width: 100%;
    min-width: 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-paper-20);
    padding: 0.6rem 0;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-paper);
    outline: none;
    resize: vertical;
    transition: border-color var(--duration-fast) ease;
  }
  .field select {
    color-scheme: dark;
  }
  /* iOS Safari auto-zooms the viewport on focus for any input under 16px —
     same fix as Footer.astro's newsletter field, see that comment. */
  @media (max-width: 640px) {
    .field input,
    .field select,
    .field textarea {
      font-size: 16px;
    }
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--color-paper);
  }
  .botcheck {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .field-submit {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 0.4rem;
  }
  .form-status {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--color-paper-60);
  }
  .form-note {
    margin: -0.6rem 0 0;
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--color-paper-40);
  }
  .contact-topic-note {
    margin: -0.8rem 0 0;
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--color-paper-60);
  }

  .contact-direct {
    border-left: 1px solid var(--color-paper-12);
    padding-left: 2.5rem;
  }
  @media (max-width: 760px) {
    .contact-direct {
      border-left: none;
      border-top: 1px solid var(--color-paper-12);
      padding-left: 0;
      padding-top: 2rem;
    }
  }
  .contact-direct h2 {
    font: var(--text-heading-sm);
    color: var(--color-paper);
    margin: 0 0 1.4rem;
  }
  .contact-emails {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .contact-label {
    display: block;
    font: var(--text-caption);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-paper-40);
    margin-bottom: 0.2rem;
  }
  .contact-emails a {
    color: var(--color-paper-60);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.95rem;
    transition: color var(--duration-fast) ease;
  }
  .contact-emails a:hover {
    color: var(--color-paper);
  }
  .contact-social {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 2rem;
  }
  .contact-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin: -11px;
    color: var(--color-paper-40);
    text-decoration: none;
    transition:
      color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }
  .contact-social a:hover {
    color: var(--color-paper);
    transform: translateY(-2px);
  }
  .contact-social a :global(svg) {
    width: 22px;
    height: 22px;
    display: block;
  }
</style>
