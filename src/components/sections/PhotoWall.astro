---
// A wall of photographs of a place in use — added 2026-09-14 for ODDspace,
// when the page's photography was replaced with pictures of people actually
// using the space (the opening, talks, sets, ordinary working days). The
// rooms themselves stay in SpaceHero and SpaceShowcase; this is the section
// that shows what happens in them.
//
// Static, no script: every tile's size is fixed by the grid before its image
// decodes, so the wall costs no layout shift. The layout is packed at build
// time from each photo's own orientation (astro:assets knows its width and
// height), not from fixed positions, so an editor can add, remove or reorder
// photos in CloudCannon without opening a hole in the wall. Rows:
//
//   feature     one large landscape + two tall portraits (mirrored on every
//               other feature row) — tried first on even rows
//   strip       four small landscapes — tried first on odd rows
//   tall strip  four portraits
//   last band   whatever is left over (never more than four) shares one band
//
// Every row fills all 12 desktop columns, and every row breaks into whole
// pairs on the two-column phone grid (a `wide` tile takes a whole phone row),
// so the wall tiles exactly at any count. Photos keep their relative order
// within each orientation. Same "a deliberate rhythm, not a masonry reflow"
// reasoning as InstagramGallery.astro's 2x2 lead tile.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo {
  image: ImageMetadata;
  alt: string;
}
interface Props {
  photos: Photo[];
}
const { photos } = Astro.props;

type Shape = 'big' | 'tall' | 'small' | 'fill';
interface Tile {
  photo: Photo;
  shape: Shape;
  // How many photos share a `fill` band (1-4).
  of?: number;
  wide: boolean;
}

const portraits = photos.filter((p) => p.image.height > p.image.width);
const landscapes = photos.filter((p) => p.image.height <= p.image.width);
const tiles: Tile[] = [];
let row = 0;
let features = 0;

while (portraits.length + landscapes.length > 0) {
  const canFeature = landscapes.length >= 1 && portraits.length >= 2;
  const canStrip = landscapes.length >= 4;
  const canTallStrip = portraits.length >= 4;
  if (canFeature && (row % 2 === 0 || (!canStrip && !canTallStrip))) {
    const big: Tile[] = landscapes
      .splice(0, 1)
      .map((photo) => ({ photo, shape: 'big', wide: true }));
    const pair: Tile[] = portraits
      .splice(0, 2)
      .map((photo) => ({ photo, shape: 'tall', wide: false }));
    tiles.push(...(features++ % 2 === 0 ? [...big, ...pair] : [...pair, ...big]));
  } else if (canStrip || canTallStrip) {
    const queue = canStrip ? landscapes : portraits;
    const shape: Shape = canStrip ? 'small' : 'tall';
    tiles.push(...queue.splice(0, 4).map((photo) => ({ photo, shape, wide: false })));
  } else {
    // No full row fits, which leaves at most three of one orientation plus
    // one of the other. Landscapes first, so a three-photo band's full-width
    // phone tile is a landscape whenever there is one.
    const rest = [...landscapes.splice(0), ...portraits.splice(0)];
    tiles.push(
      ...rest.map((photo, i) => ({
        photo,
        shape: 'fill' as const,
        of: rest.length,
        wide: rest.length === 1 || (rest.length === 3 && i === 0),
      })),
    );
  }
  row++;
}

// Roughly the tile's widest rendered size (a 6-column tile on a wide
// desktop, a full-width tile on a phone) at 2x, capped at the source so
// nothing is upscaled.
const renderWidth = (t: Tile) => {
  const target =
    t.shape === 'big' || (t.shape === 'fill' && (t.of ?? 4) <= 2)
      ? t.of === 1
        ? 1800
        : 1600
      : 900;
  return Math.min(target, t.photo.image.width);
};
---

<div class="photo-wall reveal">
  <ul class="photo-wall-grid" role="list">
    {
      tiles.map((t) => (
        <li
          class:list={['pw-tile', `pw-${t.shape}`, t.of && `pw-of-${t.of}`, { 'pw-wide': t.wide }]}
        >
          <Image src={t.photo.image} alt={t.photo.alt} width={renderWidth(t)} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* The wrapper is the size container so the grid's row height can be
     derived from its own width (an element can't query itself). */
  .photo-wall {
    container-type: inline-size;
  }
  /* Twelve columns so every leftover band (1-4 photos) divides the row
     evenly. One row is the height of a three-column tile at 4:3, so a
     three-column tile is 4:3, a six-column two-row tile is 4:3 too, and a
     three-column two-row tile is a 2:3 portrait. */
  .photo-wall-grid {
    --pw-gap: var(--space-2);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: calc((100cqi - 3 * var(--pw-gap)) / 4 * 0.75);
    gap: var(--pw-gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pw-tile {
    position: relative;
    overflow: hidden;
    margin: 0;
    background: var(--color-paper-06);
  }
  .pw-tile :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.05) saturate(1.1);
  }
  .pw-big {
    grid-column: span 6;
    grid-row: span 2;
  }
  .pw-tall {
    grid-column: span 3;
    grid-row: span 2;
  }
  .pw-small {
    grid-column: span 3;
  }
  .pw-fill {
    grid-row: span 2;
  }
  .pw-of-1 {
    grid-column: span 12;
  }
  .pw-of-2 {
    grid-column: span 6;
  }
  .pw-of-3 {
    grid-column: span 4;
  }
  .pw-of-4 {
    grid-column: span 3;
  }
  /* Phones: two columns, rows sized by each tile's own aspect ratio. Every
     desktop row breaks into whole pairs here (see the header comment), so
     two tiles side by side always share a shape. */
  @media (max-width: 700px) {
    .photo-wall-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
    }
    .pw-tile {
      grid-column: span 1;
      grid-row: auto;
      aspect-ratio: 3 / 4;
    }
    .pw-small {
      aspect-ratio: 1 / 1;
    }
    .pw-wide {
      grid-column: span 2;
      aspect-ratio: 4 / 3;
    }
  }
</style>
