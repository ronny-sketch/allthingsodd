---
// Speaker/team grid — ODDference's Speakers section and About's People
// section. `image` is optional: About's team has no photos yet and keeps
// the clean typographic card; ODDference's 2026 speaker roster has real,
// verified photos, which render as a photo-led card instead.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Person {
  name: string;
  role: string;
  organisation?: string;
  bio?: string;
  href?: string;
  image?: ImageMetadata;
}
interface Props {
  items: Person[];
}
const { items } = Astro.props;
---

<div class="person-grid reveal">
  {
    items.map((p) => {
      const Tag = p.href ? 'a' : 'div';
      return (
        <Tag class={`person-card ${p.image ? 'has-photo' : ''}`} href={p.href}>
          {p.image && (
            <div class="person-photo">
              <Image src={p.image} alt="" width={480} />
            </div>
          )}
          <span class="person-name">{p.name}</span>
          <span class="person-role">
            {p.role}
            {p.organisation && ` — ${p.organisation}`}
          </span>
          {p.bio && <p class="person-bio">{p.bio}</p>}
        </Tag>
      );
    })
  }
</div>

<style>
  .person-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px;
    background: var(--color-paper-12);
  }
  .person-card {
    background: var(--color-backstage);
    padding: 1.8rem;
    display: block;
    text-decoration: none;
    color: inherit;
  }
  /* Photo-led card (ODDference's speaker roster): the photo takes the top
     of the card edge-to-edge, name/role sit in the same padded footer as
     the plain typographic card below. */
  .person-card.has-photo {
    padding: 0 0 1.5rem;
  }
  .person-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #000;
    margin-bottom: 1.4rem;
  }
  .person-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.1) grayscale(0.15);
    transition: filter var(--duration-fast) ease;
  }
  .person-card.has-photo:hover .person-photo :global(img) {
    filter: contrast(1.05) saturate(1.25) grayscale(0);
  }
  .person-card.has-photo .person-name,
  .person-card.has-photo .person-role,
  .person-card.has-photo .person-bio {
    padding-left: 1.8rem;
    padding-right: 1.8rem;
  }
  .person-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.25rem;
    color: var(--color-paper);
  }
  .person-role {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--color-paper-40);
  }
  .person-bio {
    margin: 0.9rem 0 0;
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-paper-60);
  }

  @media (prefers-reduced-motion: no-preference) {
    .person-grid .person-card {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.5s ease,
        transform 0.5s ease;
    }
    .person-grid.in .person-card {
      opacity: 1;
      transform: none;
    }
  }
</style>
