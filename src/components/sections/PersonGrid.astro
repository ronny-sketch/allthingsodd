---
// Speaker grid — ODDference's past speakers, its only caller since About
// dropped its People section. `image` is optional: a card without one keeps
// the plain typographic treatment; ODDference's speakers have real, verified
// photos, which render as a photo-led card instead.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Person {
  name: string;
  role: string;
  organisation?: string;
  bio?: string;
  href?: string;
  image?: ImageMetadata;
}
interface Props {
  items: Person[];
}
const { items } = Astro.props;
---

<div class="person-grid reveal">
  {
    items.map((p) => {
      const Tag = p.href ? 'a' : 'div';
      return (
        <Tag class={`person-card ${p.image ? 'has-photo' : ''}`} href={p.href}>
          {p.image && (
            <div class="person-photo">
              <Image src={p.image} alt="" width={480} />
            </div>
          )}
          <span class="person-name">{p.name}</span>
          <span class="person-role">
            {p.role}
            {p.organisation && ` — ${p.organisation}`}
          </span>
          {p.bio && <p class="person-bio">{p.bio}</p>}
        </Tag>
      );
    })
  }
</div>

<style>
  /* Ten speakers as 5 × 2, and 2 × 5 on phones (2026-09-17 — this was an
     auto-fit wall of 13.75rem cards that ran to five rows). Fixed columns
     only divide evenly at ten, which is why the CMS asks editors to keep it
     there. 720px, not the site's usual 640px, because 5 columns between
     641px and 720px leave a card too narrow for "Jääskeläinen" at any role.
     No container background: the cards' own backgrounds plus the 1px gap
     read as a hairline grid. */
  .person-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
  }
  @media (max-width: 720px) {
    .person-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .person-card {
    background: var(--color-backstage);
    padding: 1.8rem;
    display: block;
    text-decoration: none;
    color: inherit;
  }
  /* Photo-led card (ODDference's speaker roster): the photo takes the top
     of the card edge-to-edge, and name/role sit under it with narrower
     inline padding than the plain card's 1.8rem (see below). */
  .person-card.has-photo {
    padding: 0 0 var(--space-4);
  }
  .person-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--swatch-ink);
    margin-bottom: var(--space-3);
  }

  .person-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.1) grayscale(0.15);
    transition: filter var(--duration-fast) ease;
  }
  @media (hover: hover) {
    .person-card.has-photo:hover .person-photo :global(img) {
      filter: contrast(1.05) saturate(1.25) grayscale(0);
    }
  }
  .person-card.has-photo .person-name,
  .person-card.has-photo .person-role,
  .person-card.has-photo .person-bio {
    padding-inline: 0.9rem;
  }
  /* A fifth of a column is a narrow card, so the photo card's name is Forta
     at Body rather than Heading, and at Small below 1024px, where a card is
     117–157px wide (design-system.md, documented exception 7). The inline
     padding gives way in the same range, back to 0.6rem once two columns
     leave room. `break-word` catches a word that still does not fit — phones
     narrower than 357px, or a larger browser default font size — so it
     wraps inside its card instead of running under the next one. */
  .person-card.has-photo .person-name {
    font-size: var(--font-size-body);
  }
  .person-card.has-photo .person-role {
    margin-top: 0.25rem;
  }
  .person-name,
  .person-role {
    overflow-wrap: break-word;
  }
  @media (max-width: 1023px) {
    .person-card.has-photo .person-name {
      font-size: var(--font-size-small);
    }
    .person-card.has-photo .person-name,
    .person-card.has-photo .person-role,
    .person-card.has-photo .person-bio {
      padding-inline: 0.4rem;
    }
  }
  @media (max-width: 720px) {
    .person-card.has-photo .person-name,
    .person-card.has-photo .person-role,
    .person-card.has-photo .person-bio {
      padding-inline: 0.6rem;
    }
  }
  .person-name {
    display: block;
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    text-wrap: balance;
  }
  .person-role {
    display: block;
    margin-top: var(--space-2);
    font: var(--text-small);
    color: var(--color-paper-40);
  }
  .person-bio {
    margin: var(--space-3) 0 0;
    font: var(--text-body);
    color: var(--color-paper-60);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .person-grid .person-card {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.5s ease,
        transform 0.5s ease;
    }
    :global(html.reveal-js) .person-grid.in .person-card {
      opacity: 1;
      transform: none;
    }
  }
</style>
