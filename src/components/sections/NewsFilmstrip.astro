---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface NewsItem {
  image: ImageMetadata;
  caption: string;
  href: string;
}
interface Props {
  items: NewsItem[];
}
const { items } = Astro.props;
// The strip holds the real photos twice back to back, so wrapping past the first
// set is seamless — see src/scripts/filmstrip.ts.
const looped = [...items, ...items];
---

<section>
  <div class="wrap">
    <div class="news-head">
      <div>
        <div class="eyebrow">Now</div>
        <h2 class="news-head-title">What's happening</h2>
      </div>
    </div>
  </div>
  <div class="news-duo" id="newsDuo">
    <span class="news-corner-tag">News</span>
    <div class="news-arrows">
      <button type="button" id="newsPrev" aria-label="Previous">&#8592;</button>
      <button type="button" id="newsNext" aria-label="Next">&#8594;</button>
    </div>
    <div class="news-strip" id="newsStrip">
      {
        looped.map((item) => (
          <a class="news-panel" href={item.href}>
            <Image src={item.image} alt={item.caption} width={900} />
            <div class="news-panel-scrim" />
            <span class="news-panel-caption">{item.caption}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script src="../../scripts/filmstrip.ts"></script>

<style>
  .news-head-title {
    font: var(--text-heading-md);
    margin: 0.5rem 0 0;
    color: var(--color-paper);
  }
  .news-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.6rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-paper-12);
  }
  .news-duo {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
  }
  .news-corner-tag {
    position: absolute;
    top: 1.4rem;
    left: 1.75rem;
    z-index: 3;
    font: var(--text-caption);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-paper);
  }
  .news-arrows {
    position: absolute;
    top: 1.1rem;
    right: 1.75rem;
    z-index: 3;
    display: flex;
    gap: 0.6rem;
  }
  .news-arrows button {
    height: 2.5rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--color-paper-40);
    background: rgb(14 9 11 / 50%);
    color: var(--color-paper);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  .news-arrows button:hover {
    background: var(--color-paper);
    color: var(--color-ink);
    border-color: var(--color-paper);
  }
  .news-strip {
    display: flex;
    width: max-content;
  }
  .news-strip.is-snapping {
    transition: transform 0.6s var(--ease-out-expo);
  }
  .news-panel {
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
    flex-shrink: 0;
    width: 50vw;
    height: min(62vh, 620px);
    min-height: 360px;
  }
  .news-panel :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.06) saturate(1.2) brightness(0.92);
  }
  .news-panel-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 70%) 0%, rgb(0 0 0 / 5%) 38%, transparent 60%);
  }
  .news-panel-caption {
    position: absolute;
    left: 1.75rem;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 2;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 3.2vw, 2.3rem);
    line-height: 1.12;
    color: var(--color-paper);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    text-decoration-color: var(--color-paper-60);
    transition:
      color var(--duration-fast) ease,
      text-decoration-color var(--duration-fast) ease;
  }
  .news-panel:hover .news-panel-caption {
    color: var(--color-amber-bright);
    text-decoration-color: var(--color-amber-bright);
  }
  @media (max-width: 820px) {
    .news-panel {
      width: 100vw;
      height: 42vh;
      min-height: 300px;
    }
  }
</style>
