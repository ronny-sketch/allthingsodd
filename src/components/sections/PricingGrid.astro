---
// Shared by ODDference's Tickets and Membership's Tiers — same real shape
// (name/price/benefits/CTA), no invented prices (see content.config.ts's
// `pricingTier` and each page's JSON for the explicit placeholder text).
import Pill from '../primitives/Pill.astro';

interface Tier {
  name: string;
  audience?: string;
  description?: string;
  price: string;
  // Small text beside the price — ODDference's "+ VAT 13.5%" (2026-09-14).
  // Kept out of `price` so the price stays a bare amount the catalog sync
  // and the drift test can compare. Re-derived from the catalog at runtime
  // like the price itself.
  priceNote?: string;
  status?: string;
  benefits: string[];
  ctaLabel: string;
  href: string;
  recommended?: boolean;
  // The badge text on the emphasised card. Replaces the hardcoded
  // "Recommended" (2026-09-11, at Ronny's request): on a ticket ladder where
  // exactly one tier is purchasable, "Recommended" is meaningless — it reads
  // as a sales opinion about a choice the reader does not actually have. The
  // deadline ("Available until 1 Nov 2026") is the real information. Falls
  // back to "Recommended" so Membership's tiers — a genuine choice between
  // three live options — are unchanged.
  badgeLabel?: string;
  // "The price is real, but you cannot buy this one yet." Renders the card
  // dimmed with an inert CTA, so the whole ladder is visible (a reader can
  // see what waiting costs them) without offering a checkout that would fail.
  // Build-time fallback only: oddference-tickets.ts re-derives it from the
  // catalog's own status at runtime and can unlock a tier the moment the
  // backend says it is on sale. Membership omits it entirely.
  locked?: boolean;
  // Ticket-catalog slug, ODDference only. Present means "this card's price,
  // status, benefits and CTA are owned by the ticket backend, not by this
  // JSON" — src/scripts/oddference-tickets.ts re-reads them from
  // /api/tickets/catalog at runtime and the build-time values are only the
  // no-JS/offline fallback. Membership's tiers have no catalog behind them
  // and deliberately omit it.
  syncSlug?: string;
  note?: string;
  // Optional low-friction secondary link under the note (e.g. "Want to know
  // more before buying? Email hello@oddfest.co") — a different shape from
  // `note` (plain text) since this one needs a real href.
  noteLink?: { label: string; href: string };
}
interface Props {
  items: Tier[];
}
const { items } = Astro.props;
---

<div class="pricing-grid reveal">
  {
    items.map((t) => (
      <div
        class={`pricing-card ${t.recommended ? 'is-recommended' : ''} ${t.locked ? 'is-locked' : ''}`}
        data-ticket-slug={t.syncSlug}
      >
        <span class="pricing-badge" hidden={!t.recommended}>
          {t.badgeLabel ?? 'Recommended'}
        </span>
        <span class="pricing-name">{t.name}</span>
        {t.audience && <span class="pricing-audience">{t.audience}</span>}
        <div class="pricing-price-row">
          <div class="pricing-price">{t.price}</div>
          <span class="pricing-price-note" hidden={!t.priceNote}>
            {t.priceNote}
          </span>
        </div>
        <span class="pricing-status" hidden={!t.status}>
          {t.status}
        </span>
        {t.description && <p class="pricing-desc">{t.description}</p>}
        <ul class="pricing-benefits">
          {t.benefits.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
        <Pill
          href={t.href}
          variant={t.recommended ? 'solid' : 'outline'}
          magnetic
          ariaDisabled={t.locked}
        >
          {t.ctaLabel}
        </Pill>
        {t.note && <p class="pricing-note">{t.note}</p>}
        {t.noteLink && (
          <a class="pricing-note-link" href={t.noteLink.href}>
            {t.noteLink.label}
          </a>
        )}
      </div>
    ))
  }
</div>

<style>
  /* No outer margin: the caller's flow places the grid. column-gap stays
     1.25rem — ODDference's three-across ladder math depends on it (see
     .oddc-convert in oddference.astro). */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16.25rem, 1fr));
    column-gap: 1.25rem;
    row-gap: var(--space-grid);
    align-items: stretch;
  }
  /* A showing badge straddles its card's top border, 0.9rem outside the
     card's box, and oddference-tickets.ts can move it to any tier — so on a
     wrapped or stacked grid it can land on a card in the second row. The
     grid makes room for it above the first row, so the caller's flow step
     measures to the badge, not to the card edge it overhangs. Only a badge
     on a later card can land in a row gap, so only then does the gap grow. */
  .pricing-grid:has(.pricing-badge:not([hidden])) {
    padding-block-start: 0.9rem;
  }
  .pricing-grid:has(> .pricing-card:not(:first-child) > .pricing-badge:not([hidden])) {
    row-gap: calc(var(--space-grid) + 0.9rem);
  }
  /* minmax(16.25rem, …)'s 16.25rem (260px at the default root, which is what
     applies at these widths) is a hard floor, not content-based — auto-fit
     still won't size a track below it even when the real available space is
     narrower, which forces this grid (and .oddc-convert/.wrap above it)
     wider than the viewport (confirmed: real page-level horizontal overflow
     on both ODDference's ticket grid and Membership's tier grid below
     ~375px, gone at 390px+, and unaffected by min-width:0 anywhere in the
     ancestor chain — that only helps content-based sizing, not an explicit
     minmax minimum). Dropping the floor for a plain 1-column track below
     480px — where a single card easily has room regardless of viewport
     width — is what actually removes it; auto-fit still runs (2+ columns
     once there's room for two 16.25rem cards) at every wider width, tablet
     included. */
  @media (max-width: 480px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
  .pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-backstage);
    border: 1px solid var(--color-paper-12);
    padding: 2.2rem;
  }
  .pricing-card.is-recommended {
    border-color: var(--color-paper-40);
  }
  /* A tier whose price is real but not yet purchasable (2026-09-11). Dimmed
     as one block rather than by re-coloring each child: the whole card is
     one "later" object, and a per-element grey would have to be re-tuned
     every time a child's own color changes.

     0.55, not lower: the point of showing these at all is that a reader can
     read what the next two tiers will cost, so the price has to stay
     legible against --color-backstage rather than merely present.

     Set as a variable, not as `opacity` directly, because the reveal rule at
     the bottom of this file animates the very same property from a much
     higher-specificity selector (`html.reveal-js .pricing-grid.in
     .pricing-card`) — a plain `.pricing-card.is-locked { opacity }` would
     lose to it the moment the section scrolled into view, and the dimming
     would silently do nothing. Routing both through one custom property
     means the reveal animates *to* whatever this card's resting opacity is,
     and neither rule has to know about the other. */
  .pricing-card {
    --pricing-card-opacity: 1;

    opacity: var(--pricing-card-opacity);
    /* So a runtime unlock (see oddference-tickets.ts) fades up rather than
       popping. The reveal's own transition overrides this while revealing. */
    transition: opacity var(--duration-slow) ease;
  }
  .pricing-card.is-locked {
    --pricing-card-opacity: 0.55;
  }
  /* A locked tier shows no button at all. `.pricing-status` already says
     "Not on sale yet" two lines above, so an inert button repeating it is
     pure noise — and a visible-but-dead control is worse than no control,
     because a reader will try it before believing it.

     `display: none`, not removal from the markup: the anchor has to survive
     so oddference-tickets.ts can hand it back the moment the catalog opens
     that tier (it drops `.is-locked`, and the button returns with the right
     label and variant already set). Same reason the element stays an <a>
     rather than a <span> — see Pill.astro's `ariaDisabled` prop. */
  .pricing-card.is-locked :global(.pill) {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .pricing-card {
      transition: none;
    }
  }
  .pricing-badge {
    position: absolute;
    /* Half the badge's own height, so it still sits centred on the card's
       top border now that its label is on the Small role. */
    top: -0.9rem;
    left: 2.2rem;
    background: var(--color-paper);
    color: var(--color-ink);
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }
  .pricing-name {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    text-wrap: balance;
  }
  .pricing-audience {
    display: block;
    margin-top: var(--space-2);
    text-wrap: balance;
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-40);
  }
  /* Same Heading step as the tier name above — the price is set apart by its
     own line and the space above it, not by a size in between. */
  .pricing-price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5rem;
    margin-top: var(--space-5);
  }
  .pricing-price {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
  }
  .pricing-price-note {
    font: var(--text-small);
    color: var(--color-paper-60);
  }
  /* .pricing-badge and .pricing-status are always in the DOM and toggled
     with the `hidden` attribute (rather than conditionally rendered) so
     oddference-tickets.ts can reveal either one when the live catalog says
     a different tier is the active/recommended one. `.pricing-status` sets
     its own `display`, which outranks the UA sheet's `[hidden]` rule — hence
     the explicit override; without it, hiding it would silently do nothing. */
  .pricing-badge[hidden],
  .pricing-price-note[hidden],
  .pricing-status[hidden] {
    display: none;
  }
  .pricing-status {
    display: inline-block;
    margin-top: var(--space-2);
    font: var(--text-small);
    color: var(--color-paper-60);
  }
  .pricing-desc {
    margin: var(--space-3) 0 0;
    font: var(--text-body);
    color: var(--color-paper-60);
  }
  .pricing-benefits {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }
  .pricing-benefits li {
    font: var(--text-body);
    color: var(--color-paper-80);
    padding-left: 1.1rem;
    position: relative;
  }
  .pricing-benefits li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-paper-40);
  }
  /* Benefits → button is one step owned here (it used to be the list's
     bottom margin plus this one, stacked). */
  .pricing-card :global(.pill) {
    align-self: flex-start;
    margin-top: var(--space-6);
  }
  .pricing-note {
    margin: var(--space-3) 0 0;
    font: var(--text-small);
    color: var(--color-paper-40);
  }
  .pricing-note-link {
    display: inline-block;
    margin: var(--space-3) 0 0;
    font: var(--text-small);
    font-weight: 600;
    color: var(--color-paper-60);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-paper-20);
    transition: color var(--duration-fast) ease;
  }
  .pricing-note-link:hover {
    color: var(--color-amber-bright);
    text-decoration-color: var(--color-amber-bright);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .pricing-grid .pricing-card {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.5s ease,
        transform 0.5s ease;
    }
    /* `var(--pricing-card-opacity)`, not a literal 1 — a locked tier reveals
       to its own dimmed resting state instead of being animated back to full
       opacity. See the `.is-locked` comment above. */
    :global(html.reveal-js) .pricing-grid.in .pricing-card {
      opacity: var(--pricing-card-opacity);
      transform: none;
    }
  }
</style>
