---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import oddfestWordmark from '../../assets/logos/oddfest-wordmark.svg';
import oddferenceMark from '../../assets/logos/oddference-mark.png';
import oddspaceWordmark from '../../assets/logos/oddspace-wordmark.svg';

interface Props {
  poster: ImageMetadata;
  video: string;
}
const { poster, video } = Astro.props;
const logos = [
  { src: oddfestWordmark.src, alt: 'ODDFEST', class: '' },
  { src: oddferenceMark.src, alt: 'ODDference', class: 'is-oddference' },
  { src: oddspaceWordmark.src, alt: 'ODDspace', class: '' },
];
// The old static centered row clipped the outer marks against its own edges
// the moment it scrolled — fixed here not by going back to static, but by
// repeating the 3-mark sequence enough times that the track is always full:
// nothing to clip, because there's no gap between one lap and the next. See
// LogoStrip.astro's `scroll` mode / motion.css for the same doubled-track
// convention this reuses.
const reps = 6;
const track = Array.from({ length: reps }, () => logos).flat();
---

<section class="logo-train">
  <div class="brand-marquee">
    <div class="brand-marquee-track" aria-hidden="true">
      {track.map((l) => <img src={l.src} alt="" class={l.class} loading="lazy" />)}
    </div>
    <p class="sr-only">ODDfest, ODDference, ODDspace</p>
  </div>
  <div class="aftermovie-full">
    {
      /* width 2200 — .aftermovie-full is full-bleed (100vw), which was
         upscaling a 1600px source on any wide monitor. See PhotoBreak.astro
         for the identical reasoning. */
    }
    <Image src={poster} alt="" width={2200} data-video-poster />
    <video autoplay muted loop playsinline poster={poster.src} preload="none">
      <source src={video} type="video/mp4" />
    </video>
  </div>
</section>

<script>
  // Swap the static poster <img> (used for LCP / no-JS) for the real <video> once
  // the browser can actually play it — avoids shipping/decoding the video for
  // crawlers and no-JS visitors, who only ever see the poster frame. Skipped
  // entirely under prefers-reduced-motion: those visitors keep the static
  // poster rather than an autoplaying video, same as src/scripts/reduced-motion-video.ts.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.aftermovie-full').forEach((wrap) => {
      const poster = wrap.querySelector('img[data-video-poster]');
      const video = wrap.querySelector('video');
      if (poster && video instanceof HTMLVideoElement) {
        poster.remove();
        video.style.display = 'block';
        video.load();
      }
    });
  }
</script>

<style>
  .logo-train {
    border-top: 1px solid var(--color-paper-12);
    border-bottom: 1px solid var(--color-paper-12);
    padding: 2.75rem 0;
    overflow: hidden;
  }
  .brand-marquee {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
  }
  .brand-marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: 5.5rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .brand-marquee-track {
      /* reverse — same empirically-verified convention as LogoStrip.astro's
         scroll mode: plain marquee-right on a repeated track reads
         right-to-left, reversing it is what actually moves left → right. */
      animation: marquee-right 42s linear infinite reverse;
      will-change: transform;
    }
  }
  .brand-marquee img {
    height: 56px;
    width: auto;
    display: block;
    flex-shrink: 0;
    opacity: 0.85;
    /* Same monochrome normalization as LogoStrip/PartnerTiers — a graphic,
       architectural field of marks reads more like brand signage than a
       colored logo carousel. */
    filter: brightness(0) invert(1);
  }
  /* oddference-mark.png's "OOO" glyph sits noticeably taller within its own
     canvas than the other two marks' equivalent glyph does within theirs, so
     equal img height doesn't read as equal mark size (confirmed via
     screenshot, side by side). A source-asset proportion difference, not
     fixable via height alone — scaled down slightly as the practical fix
     without new export files. */
  .brand-marquee img.is-oddference {
    height: 47px;
  }
  @media (max-width: 700px) {
    .logo-train {
      padding: 2rem 0;
    }
    .brand-marquee-track {
      gap: 3.25rem;
    }
    .brand-marquee img {
      height: 38px;
    }
    .brand-marquee img.is-oddference {
      height: 32px;
    }
  }

  .aftermovie-full {
    margin-top: 3rem;
    position: relative;
    background: #000;
  }
  .aftermovie-full :global(img[data-video-poster]) {
    width: 100%;
    height: min(78vh, 680px);
    object-fit: cover;
    display: block;
  }
  .aftermovie-full video {
    width: 100%;
    height: min(78vh, 680px);
    display: none;
    object-fit: cover;
  }
  .aftermovie-full::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgb(0 0 0 / 35%) 0%, transparent 18%);
  }
</style>
