---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import oddfestWordmark from '../../assets/logos/oddfest-wordmark.svg';
import oddferenceMark from '../../assets/logos/oddference-mark.png';
import oddspaceWordmark from '../../assets/logos/oddspace-wordmark.svg';

interface Props {
  poster: ImageMetadata;
  video: string;
  // The scrolling ODDfest/ODDference/ODDspace brand-mark banner above the
  // video — on by default (this component's original shape), off on Home as
  // of the 2026-08-30 homepage revision: those three names are already the
  // "What we do" cards a few sections above, so the banner repeated the same
  // information again immediately before the aftermovie. Kept configurable,
  // not deleted, in case another page wants the banner treatment without the
  // aftermovie repetition problem Home had.
  showBrandMarquee?: boolean;
}
const { poster, video, showBrandMarquee = true } = Astro.props;
const logos = [
  { src: oddfestWordmark.src, alt: 'ODDFEST', class: '' },
  { src: oddferenceMark.src, alt: 'ODDference', class: 'is-oddference' },
  { src: oddspaceWordmark.src, alt: 'ODDspace', class: '' },
];
// The old static centered row clipped the outer marks against its own edges
// the moment it scrolled — fixed here not by going back to static, but by
// repeating the 3-mark sequence enough times that the track is always full:
// nothing to clip, because there's no gap between one lap and the next. See
// LogoStrip.astro's `scroll` mode / motion.css for the same doubled-track
// convention this reuses.
const reps = 6;
const track = Array.from({ length: reps }, () => logos).flat();
---

{
  showBrandMarquee && (
    <section class="logo-train">
      <div class="brand-marquee">
        <div class="brand-marquee-track" aria-hidden="true">
          {track.map((l) => (
            <img src={l.src} alt="" class={l.class} loading="lazy" />
          ))}
        </div>
        <p class="sr-only">ODDfest, ODDference, ODDspace</p>
      </div>
    </section>
  )
}
<section class={`aftermovie-section ${showBrandMarquee ? '' : 'is-standalone'}`}>
  {
    /* The poster <img> stays in the document flow permanently — it defines
       the band's height (so there is no CLS when the video arrives) and it is
       the only thing crawlers, no-JS visitors and reduced-motion visitors
       ever see. The <video> is layered over it and only fades in once
       src/scripts/autoplay-video.ts has confirmed real playback; if playback
       is refused or the file fails, the poster simply stays. This used to
       remove the poster up front and hope, which left a black rectangle on
       every mobile viewport in both engines — see autoplay-video.ts. */
  }
  <div class="aftermovie-full" data-video-stage>
    {
      /* width 2200 — .aftermovie-full is full-bleed (100vw), which was
         upscaling a 1600px source on any wide monitor. See PhotoBreak.astro
         for the identical reasoning. */
    }
    <Image src={poster} alt="" width={2200} data-video-poster />
    <video data-autoplay-video muted loop playsinline preload="none" data-src={video}></video>
  </div>
</section>

<script src="../../scripts/autoplay-video.ts"></script>

<style>
  .logo-train {
    border-top: 1px solid var(--color-paper-12);
    padding: 2.75rem 0;
    overflow: hidden;
  }
  .brand-marquee {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
  }
  .brand-marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: 5.5rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .brand-marquee-track {
      /* reverse — same empirically-verified convention as LogoStrip.astro's
         scroll mode: plain marquee-right on a repeated track reads
         right-to-left, reversing it is what actually moves left → right. */
      animation: marquee-right 42s linear infinite reverse;
      will-change: transform;
    }
  }
  .brand-marquee img {
    height: 56px;
    width: auto;
    display: block;
    flex-shrink: 0;
    opacity: 0.85;
    /* Same monochrome normalization as LogoStrip/PartnerTiers — a graphic,
       architectural field of marks reads more like brand signage than a
       colored logo carousel. */
    filter: brightness(0) invert(1);
  }
  /* oddference-mark.png's "OOO" glyph sits noticeably taller within its own
     canvas than the other two marks' equivalent glyph does within theirs, so
     equal img height doesn't read as equal mark size (confirmed via
     screenshot, side by side). A source-asset proportion difference, not
     fixable via height alone — scaled down slightly as the practical fix
     without new export files. */
  .brand-marquee img.is-oddference {
    height: 47px;
  }
  @media (max-width: 700px) {
    .logo-train {
      padding: 2rem 0;
    }
    .brand-marquee-track {
      gap: 3.25rem;
    }
    .brand-marquee img {
      height: 38px;
    }
    .brand-marquee img.is-oddference {
      height: 32px;
    }
  }

  .aftermovie-section {
    /* Base rhythm assumes the marquee sits directly above it (which already
       carries its own top border/padding) — `.is-standalone` (no marquee,
       Home as of 2026-08-30) gets its own top border + a smaller top padding
       instead, so the video doesn't inherit a large gap or a doubled border
       meant for a banner that isn't there. */
    padding: var(--space-16) 0;
  }
  .aftermovie-section.is-standalone {
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-paper-12);
  }
  .aftermovie-full {
    position: relative;
    background: #000;
  }
  .aftermovie-full :global(img[data-video-poster]) {
    width: 100%;
    height: min(78vh, 680px);
    object-fit: cover;
    display: block;
  }
  /* Layered over the poster, not swapped for it — identical box, identical
     object-fit, so the crossfade can't shift anything. `visibility` rides
     along with opacity so a never-playing video is fully out of the
     compositor rather than an invisible full-bleed layer. */
  .aftermovie-full video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-slow) ease;
  }
  .aftermovie-full[data-video-state='playing'] video {
    opacity: 1;
    visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .aftermovie-full video {
      transition: none;
    }
  }
  .aftermovie-full::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgb(0 0 0 / 35%) 0%, transparent 18%);
  }
  /* The poster/video frame has "BE THE ODD ONE" baked into the footage
     itself. Desktop's fixed min(78vh, 680px) band comfortably fits a 2:1
     source at wide viewports, but on a narrow phone that same tall, narrow
     box forces object-fit:cover to crop nearly the entire width away,
     leaving only the two center dots of the logo mark visible — the actual
     words disappear (confirmed via elementFromPoint against the rendered
     poster, not assumed). Switching to the source's own 2:1 aspect ratio
     below 700px shows the full frame with no side-cropping instead. */
  Only the poster needs the rule: it is the element in flow that sizes the
     band, and the video is absolutely stretched to whatever box the poster
     ends up defining. */
  @media (max-width: 700px) {
    .aftermovie-full :global(img[data-video-poster]) {
      height: auto;
      aspect-ratio: 2 / 1;
    }
  }
</style>
