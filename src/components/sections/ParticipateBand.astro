---
interface Item {
  eyebrow: string;
  title: string;
  linkLabel: string;
  href: string;
  // Optional small in-card classification (e.g. "Business" / "Creative" /
  // "Stay in touch") — shown inside the card itself, same slot as `eyebrow`
  // (whichever is set). See content.config.ts's `cta` fragment and Home's
  // "The way in is by participation" band. 2026-08-31: this used to group
  // cards into separate stacked rows with the label sitting *above* each
  // row instead of inside the cards — replaced with one flat row (matching
  // every other page that reuses this component) since the classification
  // reads better as part of each card, not as a row heading.
  audience?: string;
}
interface Props {
  title?: string;
  items: Item[];
  inverted?: boolean;
  noPadTop?: boolean;
  // Opt-in (2026-09-11 homepage reorg): render each `audience` as a heading
  // *above* its own run of cards instead of as a small label inside each
  // card. The label inside a card answers "what is this one?"; a heading over
  // a group answers "which of these are for me?", which is the actual job of
  // the page's closing band — a reader scanning it is picking a side, not
  // reading four cards.
  //
  // Desktop keeps the single equal-width row this component is built around:
  // the headings sit on their own grid row, each spanning its group's
  // columns, so grouping costs no extra height and every card stays the same
  // width. Below 1024px the groups simply stack (see the media queries).
  //
  // Group order follows the order the audiences first appear in `items` — so
  // "creatives before business" is a content decision in index.json, not one
  // hard-coded here. Items with no `audience` are ignored by the grouping and
  // it falls back to the flat row, so every other caller is unaffected.
  groupByAudience?: boolean;
}
const {
  title = 'Ways to participate',
  items,
  inverted = false,
  noPadTop = false,
  groupByAudience = false,
} = Astro.props;

// [audience, items] in first-appearance order. Empty unless every item
// actually declares an audience — a half-labelled array would render some
// cards under a heading and orphan the rest, so the flat row is the safer
// answer there.
const groups: { audience: string; items: Item[]; start: number }[] = [];
if (groupByAudience && items.length > 0 && items.every((item) => item.audience)) {
  let start = 0;
  for (const item of items) {
    const audience = item.audience as string;
    const existing = groups.find((group) => group.audience === audience);
    if (existing) existing.items.push(item);
    else groups.push({ audience, items: [item], start: 0 });
  }
  // Columns are assigned after grouping, not during: a group's cards are
  // contiguous on the rendered row even if the source array interleaved them.
  for (const group of groups) {
    group.start = start;
    start += group.items.length;
  }
}
const isGrouped = groups.length > 1;
---

<section
  class={`participate-band ${inverted ? 'is-inverted' : ''}`}
  style={noPadTop ? 'padding-top:0' : undefined}
>
  <div class="wrap">
    <div class="section-head"><h2>{title}</h2></div>
    <div
      class={`participate reveal ${isGrouped ? 'is-grouped' : ''}`}
      style={`--cols: ${items.length}`}
    >
      {
        isGrouped
          ? groups.map((group) => (
              <>
                {/* --gc/--gs as custom properties, not a literal inline
                    `grid-column` — an inline style beats every stylesheet
                    rule regardless of media query, so the narrow-width
                    reset below could never undo it. Same trap --cols
                    documents above. */}
                <span
                  class="participate-group-head"
                  style={`--gc: ${group.start + 1}; --gs: ${group.items.length};`}
                >
                  {group.audience}
                </span>
                {group.items.map((item) => (
                  <a class="p-cta" href={item.href}>
                    {item.eyebrow && <span class="eyebrow">{item.eyebrow}</span>}
                    <h3>{item.title}</h3>
                    <span class="go">{item.linkLabel}</span>
                  </a>
                ))}
              </>
            ))
          : items.map((item) => (
              <a class="p-cta" href={item.href}>
                {(item.eyebrow || item.audience) && (
                  <span class="eyebrow">{item.eyebrow || item.audience}</span>
                )}
                <h3>{item.title}</h3>
                <span class="go">{item.linkLabel}</span>
              </a>
            ))
      }
    </div>
  </div>
</section>

<style>
  .participate-band {
    background: var(--color-bg);
    padding: 5.5rem 0;
    margin: 0;
  }
  .participate-band .section-head {
    border-bottom-color: var(--color-paper-12);
  }
  .participate-band .section-head h2 {
    color: var(--color-paper);
  }

  .participate {
    display: grid;
    /* --cols (set inline, per instance) drives the column count — always
       exactly one row on desktop (2-5 CTAs in practice) instead of auto-fit
       occasionally stranding one item alone on its own row when N × 240px
       doesn't divide evenly into the container width. A custom property, not
       an inline grid-template-columns directly — the mobile media query
       below still needs to be able to override it, and a real inline style
       would beat any stylesheet rule regardless of media query. Real bug,
       not hypothetical: Home's 5-item band did exactly this. See
       docs/architecture.md#v2. */
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 1.5rem;
    background: transparent;
  }

  /* Grouped variant (`groupByAudience`) — two rows, not two stacked grids:
     row 1 holds one heading per group, each spanning that group's columns;
     row 2 holds every card. Because all the cards share one row of one grid,
     they stay exactly as equal-width as they are ungrouped, and the headings
     cost one short row of height rather than splitting the band into
     separate blocks. */
  .participate.is-grouped {
    row-gap: 0.9rem;
  }
  .participate-group-head {
    grid-row: 1;
    grid-column: var(--gc) / span var(--gs);
    align-self: end;
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-60);
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--color-paper-12);
  }
  /* Every card on row 2, columns auto-assigned in DOM order — which the
     grouping above already made contiguous per group. */
  .participate.is-grouped .p-cta {
    grid-row: 2;
  }
  .p-cta {
    /* min-width: 0 — a grid item's implicit min-width:auto refuses to shrink
       narrower than its own content, which left 1fr tracks sized by each
       card's own text length instead of equally (confirmed via
       getComputedStyle: 297/270/253/174/211px for 5 supposedly-equal
       columns). Same fix as ProofGrid's identical bug earlier this session. */
    min-width: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    /* 1.4rem horizontal, not 2.2rem — at 5 equal columns (real instances run
       2-5 items) there wasn't enough width left for a single long word like
       "ODDference" to fit without breaking mid-word even after the h3
       font-size below was already reduced once; freeing up padding was the
       other half of the fix (see h3's own comment). */
    padding: 3rem 1.4rem;
    border: 1px solid transparent;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* flex-start + .go's margin-top:auto below, not justify-content:center —
       centering each card's content independently meant cards with a
       longer, more-wrapped title pushed their eyebrow/link to a different
       vertical position than shorter cards in the same row (confirmed via
       screenshot: eyebrows didn't line up across the row). Anchoring the
       top and pinning the link to the bottom keeps every card's eyebrow and
       link aligned regardless of how many lines its title wraps to. */
    justify-content: flex-start;
    gap: 0.4rem;
    min-height: 220px;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease,
      border-color 0.25s ease;
  }
  .p-cta .eyebrow {
    /* Assumes .p-cta's own light --color-paper card background (true in the
       default dark theme). Under .theme-light (ODDspace), --color-paper
       swaps to the dark role, so the card itself goes dark — this literal
       dark-tinted label would nearly disappear against it. */
    color: rgb(36 34 32 / 55%);
  }
  :global(.theme-light) .p-cta .eyebrow {
    color: rgb(226 223 222 / 55%);
  }
  .p-cta h3 {
    /* Heading, like every other card title. What keeps the longest single
       word ("ODDference") inside a card at this size is the card's width and
       padding — see the grid rules — not a smaller type size. */
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    margin: 1rem 0 0;
    overflow-wrap: break-word;
    max-width: 100%;
  }
  .p-cta .go {
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    margin-top: auto;
    padding-top: 1.5rem;
  }
  .p-cta:hover {
    background: var(--color-bg);
    color: var(--color-paper);
    border-color: var(--color-paper);
    transform: translateY(-3px);
  }
  .p-cta:hover .eyebrow {
    color: var(--color-paper-60);
  }
  /* One full row (--cols, up to 5 in practice) only down to 1023px — below
     that, a fixed column count stops fitting comfortably (confirmed via a
     real screenshot at 768px: "ODDference"/"something" broke mid-word, not
     just wrapped, at ~130px per column). auto-fit + minmax lets the row
     wrap to however many columns actually fit at ≥210px each instead of
     forcing all of them into one line. */
  @media (max-width: 1023px) and (min-width: 761px) {
    .participate {
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    }
  }
  /* Below 1024px the column count is no longer the item count (auto-fit
     above, one column below), so a heading pinned to specific columns would
     land over the wrong cards or off the end of the row entirely. The groups
     stack instead: full-width heading, then that group's cards, then the next
     heading — which is the DOM order already, so only the explicit placement
     has to be undone. */
  @media (max-width: 1023px) {
    .participate.is-grouped {
      row-gap: 1.5rem;
      /* Two, not the auto-fit count above. Auto-fit sizes the track count
         from the container, which is right when every card is in one row —
         but once the groups stack, a 4-column track leaves each 2-card group
         filling half a row and trailing two empty columns. Two columns makes
         a pair of cards a full row, and a group of three wrap to 2 + 1
         rather than stranding one. */
      grid-template-columns: repeat(2, 1fr);
    }
    .participate-group-head {
      grid-row: auto;
      grid-column: 1 / -1;
      margin-top: 1rem;
    }
    .participate-group-head:first-child {
      margin-top: 0;
    }
    .participate.is-grouped .p-cta {
      grid-row: auto;
    }
  }
  @media (max-width: 760px) {
    .participate-band {
      padding: 3.25rem 0;
    }
    .participate {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    /* Needs restating for the grouped variant: `.participate.is-grouped`'s
       two-column rule above is one class more specific than `.participate`,
       so it would otherwise keep two columns all the way down to 320px. */
    .participate.is-grouped {
      grid-template-columns: 1fr;
      row-gap: 1rem;
    }
    .p-cta {
      padding: 2.2rem 1.8rem;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .participate .p-cta,
    :global(html.reveal-js) .participate .participate-group-head {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.55s ease,
        transform 0.55s ease;
    }
    :global(html.reveal-js) .participate.in .p-cta,
    :global(html.reveal-js) .participate.in .participate-group-head {
      opacity: 1;
      transform: none;
    }
    .participate.in .p-cta:last-child {
      transition-delay: 0.1s;
    }
  }
</style>
