---
interface Item {
  eyebrow: string;
  title: string;
  linkLabel: string;
  href: string;
  // Optional — groups this CTA under an audience label (e.g. "Business" /
  // "Creative" / "Stay in touch") instead of one flat row. See
  // content.config.ts's `cta` fragment and Home's "The way in is by
  // participation" band (2026-08-30 homepage revision). Any page whose items
  // don't set this renders exactly as before — one flat, ungrouped row.
  audience?: string;
}
interface Props {
  title?: string;
  items: Item[];
  inverted?: boolean;
  noPadTop?: boolean;
}
const { title = 'Ways to participate', items, inverted = false, noPadTop = false } = Astro.props;

// Group by first-appearance order of `audience`, preserving each group's own
// item order — content-driven grouping, not nth-child CSS or a hardcoded
// array-position assumption. A "Stay in touch" (or any single-item) group
// renders visually smaller/secondary via `.is-secondary` below, since it's a
// different kind of action (mailing list) from the audience-facing CTAs.
const hasAudience = items.some((i) => i.audience);
const groups: { label: string; items: Item[] }[] = hasAudience
  ? Array.from(
      items.reduce((map, item) => {
        const key = item.audience || '';
        if (!map.has(key)) map.set(key, []);
        map.get(key)!.push(item);
        return map;
      }, new Map<string, Item[]>()),
    ).map(([label, groupItems]) => ({ label, items: groupItems }))
  : [{ label: '', items }];
---

<section
  class={`participate-band ${inverted ? 'is-inverted' : ''}`}
  style={noPadTop ? 'padding-top:0' : undefined}
>
  <div class="wrap">
    <div class="section-head"><h2>{title}</h2></div>
    {
      hasAudience ? (
        <div class="participate-groups">
          {groups.map((g) => (
            <div class={`participate-group ${g.items.length === 1 ? 'is-secondary' : ''}`}>
              {g.label && <span class="participate-group-label">{g.label}</span>}
              <div class="participate reveal" style={`--cols: ${g.items.length}`}>
                {g.items.map((item) => (
                  <a class="p-cta" href={item.href}>
                    {item.eyebrow && <span class="eyebrow">{item.eyebrow}</span>}
                    <h3>{item.title}</h3>
                    <span class="go">{item.linkLabel}</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="participate reveal" style={`--cols: ${items.length}`}>
          {items.map((item) => (
            <a class="p-cta" href={item.href}>
              <span class="eyebrow">{item.eyebrow}</span>
              <h3>{item.title}</h3>
              <span class="go">{item.linkLabel}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .participate-band {
    background: var(--color-bg);
    padding: 5.5rem 0;
    margin: 0;
  }
  .participate-band .section-head {
    border-bottom-color: var(--color-paper-12);
  }
  .participate-band .section-head h2 {
    color: var(--color-paper);
  }

  .participate-groups {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }
  .participate-group-label {
    display: block;
    font: var(--text-utility);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-paper-60);
    margin-bottom: 1rem;
  }
  /* "Stay in touch" (or any single-CTA group) reads as a smaller, secondary
     action rather than a third audience-sized card row — same visual
     language, deliberately quieter. */
  .participate-group.is-secondary .participate {
    max-width: 22rem;
  }
  .participate-group.is-secondary .p-cta {
    min-height: 0;
    padding: 1.6rem 1.4rem;
  }
  .participate-group.is-secondary .participate-group-label {
    color: var(--color-paper-40);
  }
  .participate {
    display: grid;
    /* --cols (set inline, per instance) drives the column count — always
       exactly one row on desktop (2-5 CTAs in practice) instead of auto-fit
       occasionally stranding one item alone on its own row when N × 240px
       doesn't divide evenly into the container width. A custom property, not
       an inline grid-template-columns directly — the mobile media query
       below still needs to be able to override it, and a real inline style
       would beat any stylesheet rule regardless of media query. Real bug,
       not hypothetical: Home's 5-item band did exactly this. See
       docs/architecture.md#v2. */
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 1.5rem;
    background: transparent;
  }
  .p-cta {
    /* min-width: 0 — a grid item's implicit min-width:auto refuses to shrink
       narrower than its own content, which left 1fr tracks sized by each
       card's own text length instead of equally (confirmed via
       getComputedStyle: 297/270/253/174/211px for 5 supposedly-equal
       columns). Same fix as ProofGrid's identical bug earlier this session. */
    min-width: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    /* 1.4rem horizontal, not 2.2rem — at 5 equal columns (real instances run
       2-5 items) there wasn't enough width left for a single long word like
       "ODDference" to fit without breaking mid-word even after the h3
       font-size below was already reduced once; freeing up padding was the
       other half of the fix (see h3's own comment). */
    padding: 3rem 1.4rem;
    border: 1px solid transparent;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* flex-start + .go's margin-top:auto below, not justify-content:center —
       centering each card's content independently meant cards with a
       longer, more-wrapped title pushed their eyebrow/link to a different
       vertical position than shorter cards in the same row (confirmed via
       screenshot: eyebrows didn't line up across the row). Anchoring the
       top and pinning the link to the bottom keeps every card's eyebrow and
       link aligned regardless of how many lines its title wraps to. */
    justify-content: flex-start;
    gap: 0.4rem;
    min-height: 220px;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease,
      border-color 0.25s ease;
  }
  .p-cta .eyebrow {
    /* Assumes .p-cta's own light --color-paper card background (true in the
       default dark theme). Under .theme-light (ODDspace), --color-paper
       swaps to the dark role, so the card itself goes dark — this literal
       dark-tinted label would nearly disappear against it. */
    color: rgb(36 34 32 / 55%);
  }
  :global(.theme-light) .p-cta .eyebrow {
    color: rgb(226 223 222 / 55%);
  }
  .p-cta h3 {
    font-family: var(--font-display);
    font-weight: 400;
    /* Small enough that the longest realistic single word ("ODDference",
       "something") fits the available card width without needing to wrap —
       confirmed via getComputedStyle at 1440px: 133px available at the old
       1.75rem cap wasn't enough for a 10-character word in this display
       font, so it broke mid-word instead of wrapping at a space. */
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    margin: 1rem 0 0;
    overflow-wrap: break-word;
    max-width: 100%;
  }
  .p-cta .go {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: auto;
    padding-top: 1.5rem;
  }
  .p-cta:hover {
    background: var(--color-bg);
    color: var(--color-paper);
    border-color: var(--color-paper);
    transform: translateY(-3px);
  }
  .p-cta:hover .eyebrow {
    color: var(--color-paper-60);
  }
  @media (max-width: 760px) {
    .participate-band {
      padding: 3.25rem 0;
    }
    .participate {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .p-cta {
      padding: 2.2rem 1.8rem;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .participate .p-cta {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.55s ease,
        transform 0.55s ease;
    }
    .participate.in .p-cta {
      opacity: 1;
      transform: none;
    }
    .participate.in .p-cta:last-child {
      transition-delay: 0.1s;
    }
  }
</style>
