---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Logo from '../primitives/Logo.astro';
import Pill from '../primitives/Pill.astro';

interface Props {
  video: string;
  poster: ImageMetadata;
  // The one visible line of copy over the video — rendered as the page's
  // real <h1>. Shared by ODDfest and ODDference (both full-bleed-video
  // subpages; see docs/architecture.md#hero-variants) — rendered into
  // SubpageFrame's named `hero` slot by each page, not as a plain first
  // child (see SubpageFrame.astro's 2026-08-31 hero-frame comment).
  sub: string;
  // Optional small secondary line under the h1 (e.g. "Helsinki · 2027").
  meta?: string;
  // A real page-specific wordmark (e.g. src/assets/logos/oddfest-wordmark.svg)
  // takes priority over the generic ODD mark below — pass it whenever one
  // exists rather than showing the brand's generic mark on a page that has
  // its own real logo asset.
  logo?: ImageMetadata;
  logoAlt?: string;
  // Optional in-hero CTA pair — ODDfest's hero (the only other caller) has
  // none; ODDference's does (Reserve Blind Bird / Partner with ODDference), so
  // these stay optional additions rather than forcing every caller to pass
  // both.
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  // Which archive accent tints the hero scrim — 'ultraviolet' (default) is
  // the ODDfest/festival wash, --color-ultraviolet (tokens.css: "the study's
  // own rarest color... ODDfest page only"); 'signal' is ODDference's own
  // business-facing accent, --color-signal ("business / ODDference" per
  // tokens.css). Added 2026-08-31 (final implementation pass) so the two
  // subpages that share this hero read as distinct product identities
  // without duplicating the whole component — see docs/design-system.md.
  accent?: 'ultraviolet' | 'signal';
}
const {
  video,
  poster,
  sub,
  meta,
  logo,
  logoAlt = '',
  primaryCta,
  secondaryCta,
  accent = 'ultraviolet',
} = Astro.props;
---

<header class={`oddfest-hero oddfest-hero--${accent} reveal`}>
  <video autoplay muted loop playsinline poster={poster.src}>
    <source src={video} type="video/mp4" />
  </video>
  <div class="oddfest-hero-scrim"></div>
  <div class="oddfest-hero-overlay">
    <div class="oddfest-hero-logo">
      {logo ? <Image src={logo} alt={logoAlt} width={720} /> : <Logo ariaHidden />}
    </div>
    <h1 class="oddfest-hero-sub">{sub}</h1>
    {meta && <p class="oddfest-hero-meta">{meta}</p>}
    {
      (primaryCta || secondaryCta) && (
        <div class="oddfest-hero-cta">
          {primaryCta && (
            <Pill href={primaryCta.href} variant="ticket" magnetic>
              {primaryCta.label}
            </Pill>
          )}
          {secondaryCta && (
            <Pill href={secondaryCta.href} variant="outline">
              {secondaryCta.label}
            </Pill>
          )}
        </div>
      )
    }
  </div>
</header>

<style>
  /* Full-frame height (2026-08-31, requirement 23): nav + hero should read
     as one first viewport, not nav-height-plus-92vh (previously always
     taller than one screen). calc(100vh - var(--nav-h)) is the fallback for
     browsers without svh support; the second declaration overrides it where
     svh is understood — svh (not the bare dynamic 100vh) is what actually
     avoids the classic mobile-Safari jump as the address bar/toolbar shows
     and hides. `min-height` stays a fixed px floor (not 100vh-based) so a
     very short viewport still protects the logo/headline/meta/CTA stack
     instead of collapsing with it. No `margin-bottom` any more — the
     hero→content gap is now owned once, by SubpageFrame's `.oddf-center`
     top padding, instead of this margin plus that padding stacking into an
     accidental double gap. */
  .oddfest-hero {
    position: relative;
    height: calc(100vh - var(--nav-h));
    height: calc(100svh - var(--nav-h));
    min-height: 540px;
    overflow: hidden;
    background: #000;
  }
  .oddfest-hero video,
  .oddfest-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.15) brightness(0.8);
  }
  .oddfest-hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 45% 55% at 84% 14%, var(--hero-accent-wash) 0%, transparent 60%),
      linear-gradient(
        to top,
        rgb(14 9 11 / 78%) 0%,
        rgb(14 9 11 / 10%) 42%,
        rgb(14 9 11 / 50%) 100%
      );
  }
  /* ODDfest's wash — the archive's rarest color, used "always a wash, never
     fill" per tokens.css. */
  .oddfest-hero--ultraviolet {
    --hero-accent-wash: color-mix(in srgb, var(--color-ultraviolet) 16%, transparent);
  }
  /* ODDference's wash — Signal Blue, the business-facing accent, at the same
     16% wash strength so the two heroes read as siblings, not a different
     design language. */
  .oddfest-hero--signal {
    --hero-accent-wash: color-mix(in srgb, var(--color-signal) 22%, transparent);
  }
  .oddfest-hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1.1rem;
    padding: 2rem;
  }
  .oddfest-hero-logo {
    /* min(440px, 62vw) sized the old ~3:1 generic mark; a real wordmark
       asset (oddfest-wordmark.svg) is closer to 5:1, so it needs a wider
       box at the same visual weight — width is the only constraint,
       height stays auto so either asset's own aspect ratio is respected. */
    width: min(520px, 78vw);
    filter: drop-shadow(0 4px 30px rgb(0 0 0 / 50%));
    color: var(--color-paper);
  }
  .oddfest-hero-logo :global(img),
  .oddfest-hero-logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  /* h1 reset — this line carries the page's only h1 (see Props comment
     above), so it needs the same visual weight the old plain <p> had, not
     default browser h1 sizing. */
  .oddfest-hero-sub {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.15rem, 2.4vw, 1.7rem);
    color: var(--color-paper);
    letter-spacing: 0.01em;
  }
  .oddfest-hero-meta {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-paper-60);
  }
  .oddfest-hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 0.8rem;
  }
</style>
