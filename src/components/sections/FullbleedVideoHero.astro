---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Logo from '../primitives/Logo.astro';
import Pill from '../primitives/Pill.astro';

interface Props {
  video: string;
  poster: ImageMetadata;
  // Optional small caption above the logo/h1 (e.g. "ODDference · 2027") —
  // added 2026-09-02 for ODDference's hero, which the copywriting master
  // doc asks to carry a visible eyebrow; ODDfest's hero (the only other
  // caller) omits it and renders exactly as before.
  eyebrow?: string;
  // The one visible line of copy over the video — rendered as the page's
  // real <h1>. Shared by ODDfest and ODDference (both full-bleed-video
  // subpages; see docs/architecture.md#hero-variants) — rendered into
  // SubpageFrame's named `hero` slot by each page, not as a plain first
  // child (see SubpageFrame.astro's 2026-08-31 hero-frame comment).
  sub: string;
  // Optional supporting paragraph under the h1 (2026-09-02 copywriting
  // pass) — ODDference's hero needs a short practical-value line under its
  // question-headline h1 that meta's single small caption can't carry.
  // ODDfest omits it and renders exactly as before.
  support?: string;
  // Optional small secondary line under the h1/support (e.g. "Helsinki · 2027").
  meta?: string;
  // A real page-specific wordmark (e.g. src/assets/logos/oddfest-wordmark.svg)
  // takes priority over the generic ODD mark below — pass it whenever one
  // exists rather than showing the brand's generic mark on a page that has
  // its own real logo asset.
  logo?: ImageMetadata;
  logoAlt?: string;
  // Optional in-hero CTA pair — ODDfest's hero (the only other caller) has
  // none; ODDference's does (Get your ticket / Partner with ODDference), so
  // these stay optional additions rather than forcing every caller to pass
  // both.
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  // Which archive accent tints the hero scrim — 'ultraviolet' (default) is
  // the ODDfest/festival wash, --color-ultraviolet (tokens.css: "the study's
  // own rarest color... ODDfest page only"); 'signal' is ODDference's own
  // business-facing accent, --color-signal ("business / ODDference" per
  // tokens.css). Added 2026-08-31 (final implementation pass) so the two
  // subpages that share this hero read as distinct product identities
  // without duplicating the whole component — see docs/design-system.md.
  accent?: 'ultraviolet' | 'signal';
}
const {
  video,
  poster,
  eyebrow,
  sub,
  support,
  meta,
  logo,
  logoAlt = '',
  primaryCta,
  secondaryCta,
  accent = 'ultraviolet',
} = Astro.props;
---

{
  /* No `.reveal` on the hero itself (removed 2026-09-02): this is the page's
     first paint and its LCP candidate, and gating it on an
     IntersectionObserver meant the whole first screen started at opacity 0
     and depended on JS to become visible at all. Its own entrance is a CSS
     animation instead — see .oddfest-hero-overlay below — which can't fail
     open. */
}
<header class={`oddfest-hero oddfest-hero--${accent}`} data-video-stage>
  {
    /* Real <img>, not the <video poster> attribute. The poster attribute is
       only shown while a video element has no frame of its own, which makes
       it invisible to LCP, unavailable without JS, and impossible to fade
       between — the whole hero is either the still or the film with a hard
       cut. As a sibling layer it is the guaranteed rendering, and the video
       crossfades over it only once autoplay-video.ts has confirmed real
       playback (mobile Safari refuses inline autoplay in more cases than
       Chromium; a refusal now leaves a photograph, never a black frame). */
  }
  <Image
    src={poster}
    alt=""
    width={poster.width}
    data-video-poster
    loading="eager"
    fetchpriority="high"
  />
  <video data-autoplay-video muted loop playsinline preload="none" data-src={video}></video>
  <div class="oddfest-hero-scrim"></div>
  <div class="oddfest-hero-overlay">
    <div class="oddfest-hero-logo">
      {logo ? <Image src={logo} alt={logoAlt} width={720} /> : <Logo ariaHidden />}
    </div>
    {eyebrow && <span class="oddfest-hero-eyebrow eyebrow">{eyebrow}</span>}
    <h1 class="oddfest-hero-sub">{sub}</h1>
    {support && <p class="oddfest-hero-support">{support}</p>}
    {meta && <p class="oddfest-hero-meta">{meta}</p>}
    {
      (primaryCta || secondaryCta) && (
        <div class="oddfest-hero-cta">
          {primaryCta && (
            <Pill href={primaryCta.href} variant="ticket" magnetic>
              {primaryCta.label}
            </Pill>
          )}
          {secondaryCta && (
            <Pill href={secondaryCta.href} variant="outline">
              {secondaryCta.label}
            </Pill>
          )}
        </div>
      )
    }
  </div>
</header>

<script src="../../scripts/autoplay-video.ts"></script>

<style>
  /* Full-frame height (2026-08-31, requirement 23): nav + hero should read
     as one first viewport, not nav-height-plus-92vh (previously always
     taller than one screen). calc(100vh - var(--nav-h)) is the fallback for
     browsers without svh support; the second declaration overrides it where
     svh is understood — svh (not the bare dynamic 100vh) is what actually
     avoids the classic mobile-Safari jump as the address bar/toolbar shows
     and hides. `min-height` stays a fixed px floor (not 100vh-based) so a
     very short viewport still protects the logo/headline/meta/CTA stack
     instead of collapsing with it. No `margin-bottom` any more — the
     hero→content gap is now owned once, by SubpageFrame's `.oddf-center`
     top padding, instead of this margin plus that padding stacking into an
     accidental double gap. */
  .oddfest-hero {
    position: relative;
    height: calc(100vh - var(--nav-h));
    height: calc(100svh - var(--nav-h));
    min-height: 540px;
    overflow: hidden;
    background: #000;
  }
  /* Poster and video occupy the identical box so the crossfade between them
     can't move a pixel. */
  .oddfest-hero video,
  .oddfest-hero :global(img[data-video-poster]) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.15) brightness(0.8);
  }
  .oddfest-hero video {
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-slow) ease;
  }
  .oddfest-hero[data-video-state='playing'] video {
    opacity: 1;
    visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .oddfest-hero video {
      transition: none;
    }
  }
  .oddfest-hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 45% 55% at 84% 14%, var(--hero-accent-wash) 0%, transparent 60%),
      linear-gradient(
        to top,
        rgb(14 9 11 / 78%) 0%,
        rgb(14 9 11 / 10%) 42%,
        rgb(14 9 11 / 50%) 100%
      );
  }
  /* ODDfest's wash — the archive's rarest color, used "always a wash, never
     fill" per tokens.css. */
  .oddfest-hero--ultraviolet {
    --hero-accent-wash: color-mix(in srgb, var(--color-ultraviolet) 16%, transparent);
  }
  /* ODDference's wash — Signal Blue, the business-facing accent, at the same
     16% wash strength so the two heroes read as siblings, not a different
     design language. */
  .oddfest-hero--signal {
    --hero-accent-wash: color-mix(in srgb, var(--color-signal) 22%, transparent);
  }
  .oddfest-hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1.1rem;
    padding: 2rem;
  }
  /* Short viewports — landscape phones above all, but also a small laptop
     window or a zoomed-in page.

     The `min-height: 540px` floor above protects the logo/headline/meta/CTA
     stack in portrait, but on a 375px-tall landscape phone it forces the hero
     to 1.4x the viewport height: the CTAs end up below the fold of a hero
     that is supposed to *be* the first screen, and the reader has to scroll a
     full-bleed video to find the button.

     Here the floor is dropped and the composition sized by its own content
     instead: the overlay returns to normal flow so the header is exactly as
     tall as the stack inside it needs, with the viewport height as a
     *minimum* rather than a fixed target. The media stays absolutely
     positioned behind it, so the full-frame effect is unchanged — the frame
     just stops being taller than the screen. Portrait is untouched. */
  @media (max-height: 620px) {
    .oddfest-hero {
      height: auto;
      min-height: calc(100vh - var(--nav-h));
      min-height: calc(100svh - var(--nav-h));
      display: flex;
    }
    .oddfest-hero-overlay {
      position: relative;
      inset: auto;
      flex: 1;
      padding: 2rem 1.5rem;
      gap: 0.8rem;
    }
    .oddfest-hero-logo {
      width: min(380px, 58vw);
    }
  }
  .oddfest-hero-logo {
    /* min(440px, 62vw) sized the old ~3:1 generic mark; a real wordmark
       asset (oddfest-wordmark.svg) is closer to 5:1, so it needs a wider
       box at the same visual weight — width is the only constraint,
       height stays auto so either asset's own aspect ratio is respected. */
    width: min(520px, 78vw);
    filter: drop-shadow(0 4px 30px rgb(0 0 0 / 50%));
    color: var(--color-paper);
  }
  .oddfest-hero-logo :global(img),
  .oddfest-hero-logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Optional caption above the logo/h1 (ODDference only — see Props
     comment). Reuses the sitewide `.eyebrow` utility class for color/
     tracking, this rule only trims the spacing the flex-column gap already
     handles for every other child. */
  .oddfest-hero-eyebrow {
    margin: 0;
  }
  /* h1 reset — this line carries the page's only h1 (see Props comment
     above), so it needs the same visual weight the old plain <p> had, not
     default browser h1 sizing. */
  .oddfest-hero-sub {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.15rem, 2.4vw, 1.7rem);
    color: var(--color-paper);
    letter-spacing: 0.01em;
  }
  /* Optional supporting paragraph under the h1 (ODDference only) — a real
     sentence, not another caption, so it gets body-font sizing/line-height
     rather than the meta line's small-caps treatment. */
  .oddfest-hero-support {
    margin: 0;
    max-width: 34rem;
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-paper-80);
  }
  .oddfest-hero-meta {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-paper-60);
  }
  .oddfest-hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 0.8rem;
  }
  /* The hero's entrance, replacing the `.reveal` class this header used to
     carry (see the markup comment above). A plain CSS animation with `both`
     fill runs unconditionally at load and always finishes at the visible
     state — there is no observer, no class toggle and no script that could
     fail and leave the first screen blank. The staggered children are what
     gives the frame the same "assembling" feel the shared reveal had. */
  @media (prefers-reduced-motion: no-preference) {
    .oddfest-hero-logo,
    .oddfest-hero-sub,
    .oddfest-hero-meta,
    .oddfest-hero-cta {
      animation: hero-frame-in 0.9s var(--ease-out-expo) both;
    }
    .oddfest-hero-sub {
      animation-delay: 0.1s;
    }
    .oddfest-hero-meta {
      animation-delay: 0.18s;
    }
    .oddfest-hero-cta {
      animation-delay: 0.26s;
    }
  }
  @keyframes hero-frame-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
