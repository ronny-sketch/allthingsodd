---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Logo from '../primitives/Logo.astro';
import Pill from '../primitives/Pill.astro';
import VideoToggle from '../primitives/VideoToggle.astro';

interface Props {
  video: string;
  poster: ImageMetadata;
  // Optional small caption between the wordmark and the h1 (e.g.
  // "ODDference · 2027") — added 2026-09-02 for ODDference's hero. Neither
  // caller passes one any more: ODDference dropped it on 2026-09-11 and
  // ODDfest on 2026-09-14, because in the `space` frame it sits between a
  // wordmark and a meta line that already say the same thing.
  eyebrow?: string;
  // The one visible line of copy over the video — rendered as the page's
  // real <h1>. Shared by ODDfest and ODDference (both full-bleed-video
  // subpages; see docs/architecture.md#hero-variants) — rendered into
  // SubpageFrame's named `hero` slot by each page, not as a plain first
  // child (see SubpageFrame.astro's 2026-08-31 hero-frame comment).
  sub: string;
  // Optional supporting paragraph under the h1 (2026-09-02 copywriting
  // pass). Neither caller passes one any more — ODDference's line moved into
  // its premise section on 2026-09-11 and ODDfest's was cut on 2026-09-14 —
  // because the `space` frame's composition has no paragraph.
  support?: string;
  // Optional small secondary line under the h1/support (e.g. "Helsinki · 2027").
  meta?: string;
  // A real page-specific wordmark (e.g. src/assets/logos/oddfest-wordmark.svg)
  // takes priority over the generic ODD mark below — pass it whenever one
  // exists rather than showing the brand's generic mark on a page that has
  // its own real logo asset.
  logo?: ImageMetadata;
  logoAlt?: string;
  // Optional in-hero CTA pair. Both callers pass both (Get your ticket /
  // Partner with ODDference; Submit an event idea / Look back at 2026), but
  // they stay optional rather than forcing every future caller to.
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  // Which archive accent tints the hero scrim — 'ultraviolet' (default) is
  // the ODDfest/festival wash, --color-ultraviolet (tokens.css: "the study's
  // own rarest color... ODDfest page only"); 'signal' is ODDference's own
  // business-facing accent, --color-signal ("business / ODDference" per
  // tokens.css). Added 2026-08-31 (final implementation pass) so the two
  // subpages that share this hero read as distinct product identities
  // without duplicating the whole component — see docs/design-system.md.
  accent?: 'ultraviolet' | 'signal';
  // Which of the two hero *proportions* this renders. 'default' is the
  // original frame (small h1 under a very wide wordmark, light scrim,
  // standard Pill sizing). 'space' matches SpaceHero.astro — ODDspace's hero
  // — instead: a display-sized h1, a darker centred scrim so centered text
  // reads over any frame of the film, and the same larger CTA pills ODDspace
  // got on 2026-09-11. Added 2026-09-11 at Ronny's request so /oddference and
  // /oddspace read as one family; /oddfest joined them on 2026-09-14, so no
  // page currently renders 'default'. Both keep their own video and accent
  // rather than adopting ODDspace's photo grid. Deliberately a separate knob
  // from `accent` — color identity and frame proportions are two different
  // decisions, and conflating them would mean a future page could not have
  // one without the other.
  frame?: 'default' | 'space';
}
const {
  video,
  poster,
  eyebrow,
  sub,
  support,
  meta,
  logo,
  logoAlt = '',
  primaryCta,
  secondaryCta,
  accent = 'ultraviolet',
  frame = 'default',
} = Astro.props;

// The `space` frame sizes the wordmark to one rendered *height*, not one
// width. Its width values (see .oddfest-hero--frame-space .oddfest-hero-logo)
// were tuned on the ODDference mark, 1080×167 (the PNG it shipped as until
// 2026-09-18 — the canonical SVG is 6.51:1, so its own scale is now ~1.01);
// any other wordmark scales them by its own aspect ratio relative to that one. ODDfest's wordmark is 709×141
// — squarer, 5.03:1 against 6.47:1 — so at ODDference's widths it rendered
// ~72px tall beside ODDference's ~56px and ODDspace's ~55px. ODDference's own
// scale is exactly 1, so its hero is unchanged.
const SPACE_FRAME_LOGO_RATIO = 1080 / 167;
const logoScale = logo ? logo.width / logo.height / SPACE_FRAME_LOGO_RATIO : 1;
---

{
  /* No `.reveal` on the hero itself (removed 2026-09-02): this is the page's
     first paint and its LCP candidate, and gating it on an
     IntersectionObserver meant the whole first screen started at opacity 0
     and depended on JS to become visible at all. Its own entrance is a CSS
     animation instead — see .oddfest-hero-overlay below — which can't fail
     open. */
}
<header
  class={`oddfest-hero oddfest-hero--${accent} oddfest-hero--frame-${frame}`}
  style={`--logo-scale: ${logoScale}`}
  data-video-stage
>
  {
    /* Real <img>, not the <video poster> attribute. The poster attribute is
       only shown while a video element has no frame of its own, which makes
       it invisible to LCP, unavailable without JS, and impossible to fade
       between — the whole hero is either the still or the film with a hard
       cut. As a sibling layer it is the guaranteed rendering, and the video
       crossfades over it only once autoplay-video.ts has confirmed real
       playback (mobile Safari refuses inline autoplay in more cases than
       Chromium; a refusal now leaves a photograph, never a black frame).
       The 2026 posters are 1920px wide (2026-10-04), so a phone gets a
       smaller one from the srcset rather than the full-size file. */
  }
  <Image
    src={poster}
    alt=""
    widths={[800, 1200, poster.width]}
    sizes="100vw"
    data-video-poster
    loading="eager"
    fetchpriority="high"
  />
  <video data-autoplay-video muted loop playsinline preload="none" data-src={video}></video>
  <div class="oddfest-hero-scrim"></div>
  <div class="oddfest-hero-overlay">
    <div class="oddfest-hero-logo">
      {logo ? <Image src={logo} alt={logoAlt} width={960} /> : <Logo ariaHidden />}
    </div>
    {eyebrow && <span class="oddfest-hero-eyebrow eyebrow">{eyebrow}</span>}
    <h1 class="oddfest-hero-sub">{sub}</h1>
    {support && <p class="oddfest-hero-support">{support}</p>}
    {meta && <p class="oddfest-hero-meta">{meta}</p>}
    {
      (primaryCta || secondaryCta) && (
        <div class="oddfest-hero-cta">
          {primaryCta && (
            <Pill href={primaryCta.href} variant="ticket" magnetic>
              {primaryCta.label}
            </Pill>
          )}
          {secondaryCta && (
            <Pill href={secondaryCta.href} variant="outline">
              {secondaryCta.label}
            </Pill>
          )}
        </div>
      )
    }
  </div>
  <VideoToggle name={logoAlt ? `${logoAlt} background video` : 'background video'} />
</header>

<script src="../../scripts/autoplay-video.ts"></script>

<style>
  /* Full-frame height (2026-08-31, requirement 23): nav + hero should read
     as one first viewport, not nav-height-plus-92vh (previously always
     taller than one screen). calc(100vh - var(--nav-h)) is the fallback for
     browsers without svh support; the second declaration overrides it where
     svh is understood — svh (not the bare dynamic 100vh) is what actually
     avoids the classic mobile-Safari jump as the address bar/toolbar shows
     and hides. `min-height` stays a fixed px floor (not 100vh-based) so a
     very short viewport still protects the logo/headline/meta/CTA stack
     instead of collapsing with it. No `margin-bottom` any more — the
     hero's half of the hero→content gap is SubpageFrame's `.oddf-center`
     top padding (the first section pads the other half), instead of this
     margin plus that padding stacking into an accidental double gap. */
  .oddfest-hero {
    position: relative;
    height: calc(100vh - var(--nav-h));
    height: calc(100svh - var(--nav-h));
    min-height: 540px;
    overflow: hidden;
    background: var(--swatch-ink);
  }
  /* Poster and video occupy the identical box so the crossfade between them
     can't move a pixel. */
  .oddfest-hero video,
  .oddfest-hero :global(img[data-video-poster]) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.15) brightness(0.95);
  }
  .oddfest-hero video {
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-slow) ease;
  }
  .oddfest-hero[data-video-state='playing'] video {
    opacity: 1;
    visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .oddfest-hero video {
      transition: none;
    }
  }
  .oddfest-hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 45% 55% at 84% 14%, var(--hero-accent-wash) 0%, transparent 60%),
      linear-gradient(
        to top,
        rgb(14 9 11 / 78%) 0%,
        rgb(14 9 11 / 10%) 42%,
        rgb(14 9 11 / 50%) 100%
      );
  }
  /* ODDfest's wash — the archive's rarest color, used "always a wash, never
     fill" per tokens.css. */
  .oddfest-hero--ultraviolet {
    --hero-accent-wash: color-mix(in srgb, var(--color-ultraviolet) 16%, transparent);
  }
  /* ODDference's wash — Signal Blue, the business-facing accent, at the same
     16% wash strength so the two heroes read as siblings, not a different
     design language. */
  .oddfest-hero--signal {
    --hero-accent-wash: color-mix(in srgb, var(--color-signal) 22%, transparent);
  }
  .oddfest-hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-5);
    padding: 2rem;
  }
  @media (max-height: 620px) {
    .oddfest-hero {
      height: auto;
      min-height: calc(100vh - var(--nav-h));
      min-height: calc(100svh - var(--nav-h));
      display: flex;
    }
    .oddfest-hero-overlay {
      position: relative;
      inset: auto;
      flex: 1;
      padding: 1rem 1.5rem;
      gap: 0.35rem;
    }
    .oddfest-hero-logo {
      width: min(14.375rem, 30vw);
    }
    .oddfest-hero-support {
      max-width: 46ch;
    }
  }
  @media (min-width: 821px) {
    .oddfest-hero-overlay {
      padding-inline: calc(68px + var(--space-8));
    }
    .oddfest-hero {
      --video-toggle-right: calc(68px + var(--space-4));
    }
  }
  .oddfest-hero-logo {
    width: min(32.5rem, 78vw);
    filter: drop-shadow(0 4px 30px rgb(14 9 11 / 50%));
    color: var(--color-paper);
  }
  .oddfest-hero-logo :global(img),
  .oddfest-hero-logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .oddfest-hero-eyebrow {
    margin: 0;
  }
  .oddfest-hero-sub {
    margin: 0;
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
  }
  .oddfest-hero-support {
    margin: 0;
    max-width: 34rem;
    font: var(--text-body);
    color: var(--color-paper-80);
  }
  .oddfest-hero-meta {
    margin: 0;
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: rgb(226 223 222 / 88%);
    text-shadow: 0 1px 8px rgb(14 9 11 / 70%);
  }
  .oddfest-hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .oddfest-hero-logo,
    .oddfest-hero-sub,
    .oddfest-hero-meta,
    .oddfest-hero-cta {
      animation: hero-frame-in 0.9s var(--ease-out-expo) both;
    }
    .oddfest-hero-sub {
      animation-delay: 0.1s;
    }
    .oddfest-hero-meta {
      animation-delay: 0.18s;
    }
    .oddfest-hero-cta {
      animation-delay: 0.26s;
    }
  }
  @keyframes hero-frame-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .oddfest-hero--frame-space .oddfest-hero-scrim {
    background:
      radial-gradient(ellipse 45% 55% at 84% 14%, var(--hero-accent-wash) 0%, transparent 60%),
      radial-gradient(ellipse 55% 60% at 50% 55%, rgb(14 9 11 / 30%) 0%, rgb(14 9 11 / 52%) 100%),
      linear-gradient(
        to top,
        rgb(14 9 11 / 72%) 0%,
        rgb(14 9 11 / 10%) 40%,
        rgb(14 9 11 / 30%) 100%
      );
  }
  .oddfest-hero--frame-space .oddfest-hero-logo {
    width: calc(min(22.5rem, 64vw) * var(--logo-scale, 1));
  }
  .oddfest-hero--frame-space .oddfest-hero-sub {
    max-width: 32ch;
    font: var(--text-display);
    letter-spacing: var(--tracking-display);
    text-shadow:
      0 1px 3px rgb(14 9 11 / 75%),
      0 8px 32px rgb(14 9 11 / 50%);
  }
  .oddfest-hero--frame-space .oddfest-hero-support {
    max-width: 42rem;
  }
  .oddfest-hero--frame-space .oddfest-hero-cta :global(.pill) {
    padding: 0.8rem 1.9rem;
  }
  @media (max-width: 480px) {
    .oddfest-hero--frame-space .oddfest-hero-cta :global(.pill) {
      padding: 0.75rem 1.5rem;
    }
  }
  @media (max-width: 400px) {
    .oddfest-hero--frame-space .oddfest-hero-overlay {
      padding-inline: 1rem;
    }
  }
  @media (max-height: 620px) {
    .oddfest-hero--frame-space .oddfest-hero-logo {
      width: calc(min(15rem, 44vw) * var(--logo-scale, 1));
    }
    .oddfest-hero--frame-space .oddfest-hero-sub {
      font: var(--text-heading);
      letter-spacing: var(--tracking-heading);
    }
    .oddfest-hero--frame-space .oddfest-hero-overlay {
      gap: 0.6rem;
    }
  }
</style>
