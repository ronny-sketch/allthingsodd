---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import VideoToggle from '../primitives/VideoToggle.astro';
import { photographers } from './photo-credits';

// "ODDfest 2026 in video and pictures" (2026-10-04): the ODDfest and
// ODDference 2026 aftermovies and the 2026 photo bank, as three equal cards
// (stacked on a phone). It replaced Aftermovie.astro, one full-bleed loop of
// older footage under a brand-mark marquee that no page still showed.
//
// A film card shows its short muted preview through autoplay-video.ts (the
// same lifecycle as the /oddfest and /oddference heroes, which use the same
// preview files) and links to the full film, which film-player.ts opens with
// sound in the dialog below. The whole card is the link; the pause button
// sits above it.
interface Props {
  title: string;
  films: { label: string; poster: ImageMetadata; preview: string; film: string }[];
  photoBank: { label: string; href: string; image: ImageMetadata; alt: string };
}
const { title, films, photoBank } = Astro.props;
// The footer credits it too (photo-credits.ts reads every image in the
// page's content); on the card it says whose picture is advertising the bank.
const [photographer] = photographers(photoBank.image);
// One column on a phone, a third of the container from 761px.
const sizes = '(min-width: 761px) 33vw, 100vw';
---

<section class="video-and-pictures">
  <div class="wrap flow">
    <div class="section-head"><h2>{title}</h2></div>
    <div class="vp-grid reveal">
      {
        films.map((f) => (
          <article class="vp-card">
            <div class="vp-media" data-video-stage>
              <Image
                src={f.poster}
                alt=""
                widths={[480, 800, 1200]}
                sizes={sizes}
                data-video-poster
              />
              <video
                data-autoplay-video
                muted
                loop
                playsinline
                preload="none"
                data-src={f.preview}
              />
              <VideoToggle name={`preview of ${f.label.replace(/^Watch /, '')}`} />
            </div>
            <a class="vp-go" href={f.film} data-film>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M4.5 2.8v10.4a.8.8 0 0 0 1.2.7l8.4-5.2a.8.8 0 0 0 0-1.4L5.7 2.1a.8.8 0 0 0-1.2.7Z" />
              </svg>
              {f.label}
            </a>
          </article>
        ))
      }
      <article class="vp-card">
        <div class="vp-media">
          <Image
            src={photoBank.image}
            alt={photoBank.alt}
            widths={[480, 800, 1200]}
            sizes={sizes}
          />
        </div>
        <a class="vp-go" href={photoBank.href} target="_blank" rel="noreferrer">
          {photoBank.label}<span aria-hidden="true"> ↗</span>
          <span class="sr-only"> (opens Flickr in a new tab)</span>
        </a>
        {photographer && <p class="vp-credit">Photo: {photographer}</p>}
      </article>
    </div>
  </div>

  {
    /* `data-suppress-newsletter-popup`: the popup never lands on top of a
       film someone chose to watch. No captions track yet: none were
       supplied with the films. */
  }
  <dialog class="film-dialog" id="film-dialog" data-suppress-newsletter-popup>
    <button type="button" class="film-close" aria-label="Close">
      <span aria-hidden="true">×</span>
    </button>
    <video controls playsinline preload="none"></video>
  </dialog>
</section>

<script src="../../scripts/autoplay-video.ts"></script>
<script src="../../scripts/film-player.ts"></script>

<style>
  .vp-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-grid);
  }
  @media (max-width: 760px) {
    .vp-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .vp-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .vp-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--swatch-ink);
  }
  /* Poster and preview share one box, so the crossfade cannot move a pixel
     (the same rule as the heroes). */
  .vp-media :global(img),
  .vp-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .vp-media video {
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-slow) ease;
  }
  .vp-media[data-video-state='playing'] video {
    opacity: 1;
    visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .vp-media video {
      transition: none;
    }
  }
  /* The label is the link; its ::after stretches over the whole card, so the
     picture is clickable too without nesting the pause button in a link. */
  .vp-go {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-paper);
    text-decoration: none;
  }
  .vp-go::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .vp-go svg {
    flex: none;
    width: 0.85em;
    height: 0.85em;
    fill: currentColor;
  }
  @media (hover: hover) {
    .vp-card:hover .vp-go {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
  }
  .vp-credit {
    margin: 0;
    font: var(--text-small);
    color: var(--color-paper-60);
  }

  .film-dialog {
    --film-close: 2.75rem;
    /* The films are 2:1: as wide as the screen allows, and never so tall that
       the film and the close button above it stop fitting on the screen. */
    width: min(
      100vw - 2 * var(--space-4),
      (100dvh - 2 * var(--space-4) - var(--film-close) - var(--space-2)) * 2
    );
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    overflow: visible;
    background: transparent;
    color: var(--color-paper);
  }
  .film-dialog::backdrop {
    background: rgb(14 9 11 / 88%);
  }
  .film-dialog video {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    background: var(--swatch-ink);
  }
  /* Above the film, not on it: the browsers draw their own controls in the
     video's corners (Safari's volume slider is in the top right). */
  .film-close {
    display: grid;
    place-items: center;
    width: var(--film-close);
    height: var(--film-close);
    margin: 0 0 var(--space-2) auto;
    padding: 0;
    border: 1px solid var(--color-paper-35);
    border-radius: var(--radius-pill);
    background: rgb(14 9 11 / 55%);
    color: var(--color-paper);
    font: var(--text-heading);
    line-height: 1;
    cursor: pointer;
  }
  @media (hover: hover) {
    .film-close:hover {
      background: rgb(14 9 11 / 80%);
      border-color: var(--color-paper-60);
    }
  }
</style>
