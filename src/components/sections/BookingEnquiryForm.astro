---
// The ODDspace booking enquiry form, on /oddspace/venue. First built
// 2026-09-23; reworked 2026-09-24 for brand, order and error handling.
//
// It asks for what a quote depends on (the date and hours, the room, the
// headcount, how much help, alcohol, music after 22:00, smoke and flame), so
// nobody has to write back with twenty questions. The order follows the
// visitor's own question, which is the section's headline: "Is your date
// free?". So the date comes first, then the people and the room, then the
// event, then the practical details, and contact details come last.
//
// It posts JSON to POST /api/booking-enquiry on the Growth OS Worker
// (../odd-growth-os). The Worker writes the Notion Events Pipeline record and
// hands the submission to Make. This file holds no keys and imports no
// Growth OS code (AGENTS.md, "Growth OS integration").
//
// A few questions are asked differently from the payload they fill, and the
// submit script converts them. The Worker contract is unchanged.
// - Date, from and until become `get_in` and `get_out`. An end time earlier
//   than the start means the next day.
// - "How many people?" is a number, and `headcount_band` is derived from it.
// - "Who can come?" fills both `event_visibility` and `event_access`.
// - In a space with fixed seating (the Auditorium) the layout is not asked
//   and is sent as `theatre`.
//
// Every option list comes from booking-enquiry-schema.ts, the same module
// the submit script validates against. Labels are UI copy and stay in code,
// following WorkEnquiryForm.astro, and are not exposed in CloudCannon.
//
// Conditional fields carry `data-show-when="<name>=<value>[|<value>]"`,
// `<name>!=<value>` or `<name>=*` (any answer). booking-enquiry-form.ts hides
// them until they apply and disables their inputs while hidden, so a hidden
// field is never sent or validated. Without JavaScript every field shows, and
// the <noscript> note gives the email route, because the form cannot send
// without JavaScript.
import Pill from '../primitives/Pill.astro';
import ChoiceChips from '../primitives/ChoiceChips.astro';
import {
  ORG_TYPES,
  MEMBERSHIP_TIERS,
  EVENT_TYPES,
  AUDIENCE,
  SPACES,
  SPACE_INFO,
  FIXED_SEATING_SPACES,
  LAYOUTS,
  SUPPORT_LEVELS,
  TECH_OFFERED,
  CATERING,
  ALCOHOL,
  MUSIC,
  YES_NO_NOT_SURE,
  MEDIA,
  CLEANING,
  BUDGET_BANDS,
  LIMITS,
} from '../../scripts/booking-enquiry-schema';

const FIXED = FIXED_SEATING_SPACES.join('|');
const YES_NO = [
  { value: 'true', label: 'Yes' },
  { value: 'false', label: 'No' },
];
---

<div class="booking" id="booking-form">
  <noscript>
    <p class="booking-noscript">
      This form needs JavaScript to send. You can email the same details to{' '}
      <a href="mailto:hello@oddfest.co">hello@oddfest.co</a> instead.
    </p>
  </noscript>

  <form class="booking-form" id="bookingEnquiryForm" novalidate>
    <p class="booking-key">
      Questions marked <span class="req" aria-hidden="true">*</span><span class="sr-only"
        >with an asterisk</span
      > are required. The rest help us quote, but can wait.
    </p>

    <!-- Honeypot. A person never sees it. A non-empty value means a bot. -->
    <div class="botcheck" aria-hidden="true">
      <label for="bk-hp">Leave this empty</label>
      <input id="bk-hp" name="hp_field" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <!-- 01 When ------------------------------------------------------------ -->
    <div class="bk-step" role="group" aria-labelledby="bk-step-1">
      <h3 class="bk-step-head" id="bk-step-1">
        <span class="bk-step-num" aria-hidden="true">01</span>
        <span>When</span>
      </h3>

      <fieldset class="field" id="bk-when" data-label="Date and time">
        <legend>Date and time <span class="req" aria-hidden="true">*</span></legend>
        <div class="bk-when-grid">
          <div class="bk-sub bk-sub-date">
            <label for="bk-date">Date</label>
            <input
              id="bk-date"
              name="event_date"
              type="date"
              required
              aria-describedby="bk-when-hint"
            />
          </div>
          <div class="bk-sub">
            <label for="bk-from">From</label>
            <input
              id="bk-from"
              name="time_from"
              type="time"
              step="900"
              required
              aria-describedby="bk-when-hint"
            />
          </div>
          <div class="bk-sub">
            <label for="bk-until">Until</label>
            <input
              id="bk-until"
              name="time_until"
              type="time"
              step="900"
              required
              aria-describedby="bk-when-hint"
            />
          </div>
        </div>
        <label class="check">
          <input type="checkbox" name="multi_day" value="true" />
          <span>It runs over more than one day</span>
        </label>
        <div class="bk-sub bk-sub-date" data-show-when="multi_day=true">
          <label for="bk-enddate">Last day</label>
          <input id="bk-enddate" name="end_date" type="date" required />
        </div>
        <p class="field-hint" id="bk-when-hint">
          Helsinki time. Start from when your first person arrives to set up, and end when the last
          person leaves after clearing up. The hire covers everything in between.
        </p>
        <p class="bk-derived" id="bk-when-summary" aria-live="polite" hidden></p>
        <input type="hidden" name="get_in" />
        <input type="hidden" name="get_out" />
        <p class="field-error" id="bk-when-err" hidden></p>
      </fieldset>

      <p class="booking-warning" id="bk-notice" role="status" aria-live="polite" hidden></p>

      <div class="field-row">
        <div class="field" data-label="Another date">
          <label for="bk-alt1">Another date that would work</label>
          <input id="bk-alt1" name="alt_date_1" type="date" />
          <p class="field-error" id="bk-alt1-err" hidden></p>
        </div>
        <div class="field" data-label="A third date" data-show-when="alt_date_1=*">
          <label for="bk-alt2">And another</label>
          <input id="bk-alt2" name="alt_date_2" type="date" />
          <p class="field-error" id="bk-alt2-err" hidden></p>
        </div>
      </div>

      <div class="field">
        <label class="check">
          <input type="checkbox" name="is_series" value="true" />
          <span>It is one of a series of events</span>
        </label>
      </div>
      <div
        class="field bk-narrow"
        data-label="Events in the series"
        data-show-when="is_series=true"
      >
        <label for="bk-series">How many events? <span class="req" aria-hidden="true">*</span></label
        >
        <input
          id="bk-series"
          name="series_count"
          type="number"
          inputmode="numeric"
          min="2"
          max={LIMITS.maxSeries}
          step="1"
          required
        />
        <p class="field-error" id="bk-series-err" hidden></p>
      </div>
    </div>

    <!-- 02 People and space ------------------------------------------------- -->
    <div class="bk-step" role="group" aria-labelledby="bk-step-2">
      <h3 class="bk-step-head" id="bk-step-2">
        <span class="bk-step-num" aria-hidden="true">02</span>
        <span>People and space</span>
      </h3>

      <div class="field bk-narrow" data-label="Number of people">
        <label for="bk-estimate"
          >How many people? <span class="req" aria-hidden="true">*</span></label
        >
        <input
          id="bk-estimate"
          name="headcount_estimate"
          type="number"
          inputmode="numeric"
          min="1"
          max={LIMITS.maxHeadcount}
          step="1"
          required
          aria-describedby="bk-estimate-hint"
        />
        <p class="field-hint" id="bk-estimate-hint">
          The most people inside at once, counting guests, crew and performers. A rough number is
          fine.
        </p>
        <p class="field-hint" id="bk-steward" hidden>
          Over 100 people needs a licensed security steward on site, which is not part of the hire.
        </p>
        <input type="hidden" name="headcount_band" />
        <p class="field-error" id="bk-estimate-err" hidden></p>
      </div>

      <fieldset class="field" id="bk-space" data-label="Space">
        <legend>Which space? <span class="req" aria-hidden="true">*</span></legend>
        <div class="bk-spaces">
          {
            SPACES.map((o, i) => {
              const info = SPACE_INFO[o.value];
              return (
                <label class="bk-space" for={`bk-space-${o.value}`}>
                  <input
                    class="bk-space-input"
                    id={`bk-space-${o.value}`}
                    type="radio"
                    name="space"
                    value={o.value}
                    required={i === 0}
                  />
                  <span class="bk-space-face">
                    <span class="bk-space-name">{o.label}</span>
                    <span class="bk-space-meta">{info.meta}</span>
                    <span class="bk-space-blurb">{info.blurb}</span>
                  </span>
                </label>
              );
            })
          }
        </div>
        <p class="field-hint">
          The <a href="/oddspace/event-info-pack/">event info pack</a> has more about each room.
        </p>
        <p class="booking-warning" id="bk-capacity" role="status" aria-live="polite" hidden></p>
        <p class="field-error" id="bk-space-err" hidden></p>
      </fieldset>

      <fieldset class="field" id="bk-layout" data-label="Layout" data-show-when={`space!=${FIXED}`}>
        <legend>How should the room be set up? <span class="req" aria-hidden="true">*</span></legend
        >
        <ChoiceChips name="layout" options={LAYOUTS} required idPrefix="bk-layout" />
        <p class="field-hint" data-show-when="space=full_triangle">
          This is for the Gallery and the Aula. The Auditorium's seats are fixed.
        </p>
        <p class="field-error" id="bk-layout-err" hidden></p>
      </fieldset>
      <div class="field" data-show-when={`space=${FIXED}`}>
        <p class="bk-fixed">
          The Auditorium has fixed tiered seating, so there is no layout to choose.
        </p>
        <input type="hidden" name="layout" value="theatre" />
      </div>
      <div class="field" data-label="Layout details" data-show-when="layout=custom">
        <label for="bk-layout-detail"
          >Describe the layout <span class="req" aria-hidden="true">*</span></label
        >
        <input
          id="bk-layout-detail"
          name="layout_custom"
          type="text"
          maxlength={LIMITS.short}
          required
        />
        <p class="field-error" id="bk-layout-detail-err" hidden></p>
      </div>
    </div>

    <!-- 03 The event --------------------------------------------------------- -->
    <div class="bk-step" role="group" aria-labelledby="bk-step-3">
      <h3 class="bk-step-head" id="bk-step-3">
        <span class="bk-step-num" aria-hidden="true">03</span>
        <span>The event</span>
      </h3>

      <div class="field" data-label="Name of the event">
        <label for="bk-title">Name of the event <span class="req" aria-hidden="true">*</span></label
        >
        <input
          id="bk-title"
          name="event_title"
          type="text"
          required
          maxlength={LIMITS.short}
          aria-describedby="bk-title-hint"
        />
        <p class="field-hint" id="bk-title-hint">A working title is fine.</p>
        <p class="field-error" id="bk-title-err" hidden></p>
      </div>

      <fieldset class="field" id="bk-type" data-label="Kind of event">
        <legend>What kind of event? <span class="req" aria-hidden="true">*</span></legend>
        <ChoiceChips name="event_type" options={EVENT_TYPES} required idPrefix="bk-type" />
        <p class="field-error" id="bk-type-err" hidden></p>
      </fieldset>

      <fieldset class="field" id="bk-audience" data-label="Who can come">
        <legend>Who can come? <span class="req" aria-hidden="true">*</span></legend>
        <ChoiceChips name="audience" options={AUDIENCE} required idPrefix="bk-audience" />
        <input type="hidden" name="event_visibility" />
        <input type="hidden" name="event_access" />
        <p class="field-error" id="bk-audience-err" hidden></p>
      </fieldset>

      <div class="field" data-label="About the event">
        <label for="bk-desc">Tell us about it <span class="req" aria-hidden="true">*</span></label>
        <textarea
          id="bk-desc"
          name="event_description"
          rows="4"
          required
          maxlength={LIMITS.long}
          aria-describedby="bk-desc-hint"></textarea>
        <p class="field-hint" id="bk-desc-hint">
          What happens, for whom, and what the room needs to do.
        </p>
        <p class="field-error" id="bk-desc-err" hidden></p>
      </div>
    </div>

    <!-- 04 Help, food and sound ------------------------------------------------ -->
    <div class="bk-step" role="group" aria-labelledby="bk-step-4">
      <h3 class="bk-step-head" id="bk-step-4">
        <span class="bk-step-num" aria-hidden="true">04</span>
        <span>Help, food and sound</span>
      </h3>

      <fieldset class="field" id="bk-support" data-label="Help from us">
        <legend
          >How much help do you want from us? <span class="req" aria-hidden="true">*</span></legend
        >
        <ChoiceChips name="support_level" options={SUPPORT_LEVELS} required idPrefix="bk-support" />
        <p class="field-hint">
          From Raw, just the room, to Turnkey, where we run it with you. Your quote spells out what
          the level you pick includes.
        </p>
        <p class="field-error" id="bk-support-err" hidden></p>
      </fieldset>

      <fieldset class="field" id="bk-tech" data-label="Kit from us">
        <legend>Kit you would like from us</legend>
        <ChoiceChips name="tech" options={TECH_OFFERED} type="checkbox" idPrefix="bk-tech" />
        <p class="field-hint">Every booking already includes the PA system and one microphone.</p>
      </fieldset>
      <div class="field bk-narrow" data-label="Microphones" data-show-when="tech=mics">
        <label for="bk-mics"
          >Microphones in total <span class="req" aria-hidden="true">*</span></label
        >
        <input
          id="bk-mics"
          name="mic_count"
          type="number"
          inputmode="numeric"
          min="1"
          max={LIMITS.maxMics}
          step="1"
          required
        />
        <p class="field-error" id="bk-mics-err" hidden></p>
      </div>

      <div class="field">
        <label class="check">
          <input
            type="checkbox"
            name="own_equipment"
            value="true"
            aria-describedby="bk-equip-hint"
          />
          <span>We are bringing our own equipment</span>
        </label>
        <p class="field-hint" id="bk-equip-hint">
          Staging, rigging, lighting, or anything that needs more than a normal socket.
        </p>
      </div>
      <div class="field" data-label="Your equipment" data-show-when="own_equipment=true">
        <label for="bk-equip"
          >What are you bringing? <span class="req" aria-hidden="true">*</span></label
        >
        <textarea
          id="bk-equip"
          name="own_equipment_detail"
          rows="3"
          maxlength={LIMITS.long}
          required></textarea>
        <p class="field-error" id="bk-equip-err" hidden></p>
      </div>

      <fieldset class="field" id="bk-catering" data-label="Food and drink">
        <legend>Food and drink <span class="req" aria-hidden="true">*</span></legend>
        <ChoiceChips name="catering" options={CATERING} required idPrefix="bk-catering" />
        <p class="field-error" id="bk-catering-err" hidden></p>
      </fieldset>
      <div class="field" data-label="Caterer" data-show-when="catering=own_caterer">
        <label for="bk-caterer"
          >Who is the caterer? <span class="req" aria-hidden="true">*</span></label
        >
        <input id="bk-caterer" name="caterer_name" type="text" maxlength={LIMITS.short} required />
        <p class="field-error" id="bk-caterer-err" hidden></p>
      </div>

      <fieldset class="field" id="bk-alcohol" data-label="Alcohol">
        <legend>Alcohol <span class="req" aria-hidden="true">*</span></legend>
        <ChoiceChips name="alcohol" options={ALCOHOL} required idPrefix="bk-alcohol" />
        <p class="field-hint" data-show-when="alcohol=sold">
          Selling alcohol needs a licence from Lupa- ja valvontavirasto, applied for about a month
          ahead. We will talk you through it.
        </p>
        <p class="field-error" id="bk-alcohol-err" hidden></p>
      </fieldset>

      <fieldset class="field" id="bk-music" data-label="Music">
        <legend>Music <span class="req" aria-hidden="true">*</span></legend>
        <ChoiceChips name="music" options={MUSIC} required idPrefix="bk-music" />
        <p class="field-error" id="bk-music-err" hidden></p>
      </fieldset>
      <fieldset
        class="field"
        id="bk-late"
        data-label="Music after 22:00"
        data-show-when="music=background|live|dj"
      >
        <legend>
          Will the music carry on past 22:00? <span class="req" aria-hidden="true">*</span>
        </legend>
        <ChoiceChips name="music_past_2200" options={YES_NO_NOT_SURE} required idPrefix="bk-late" />
        <p class="field-hint">Loud music after 22:00 needs the building owner's approval.</p>
        <p class="field-error" id="bk-late-err" hidden></p>
      </fieldset>

      <fieldset class="field" id="bk-pyro" data-label="Smoke, haze or flame">
        <legend>
          Smoke, haze, candles or open flame? <span class="req" aria-hidden="true">*</span>
        </legend>
        <ChoiceChips name="pyro_flame" options={YES_NO_NOT_SURE} required idPrefix="bk-pyro" />
        <p class="field-hint" data-show-when="pyro_flame=yes|not_sure">
          Smoke, haze, steam and candles set off the building's fire alarm, so they are not allowed
          indoors at the moment. Tell us what you have in mind and we will tell you what can be
          arranged.
        </p>
        <p class="field-error" id="bk-pyro-err" hidden></p>
      </fieldset>
      <div
        class="field"
        data-label="Smoke, haze or flame details"
        data-show-when="pyro_flame=yes|not_sure"
      >
        <label for="bk-pyro-detail"
          >What do you have in mind?<span
            class="req"
            aria-hidden="true"
            data-show-when="pyro_flame=yes"
          >
            *</span
          ></label
        >
        <textarea
          id="bk-pyro-detail"
          name="pyro_flame_detail"
          rows="2"
          maxlength={LIMITS.long}
          data-required-when="pyro_flame=yes"></textarea>
        <p class="field-error" id="bk-pyro-detail-err" hidden></p>
      </div>

      <fieldset class="field" id="bk-media" data-label="Photography, filming or streaming">
        <legend>Photography, filming or streaming</legend>
        <ChoiceChips name="media" options={MEDIA} type="checkbox" idPrefix="bk-media" />
        <p class="field-hint">Anyone doing it at the event, including your own team.</p>
      </fieldset>

      <fieldset class="field" id="bk-cleaning" data-label="Cleaning">
        <legend>Cleaning afterwards <span class="req" aria-hidden="true">*</span></legend>
        <ChoiceChips name="cleaning" options={CLEANING} required idPrefix="bk-cleaning" />
        <p class="field-error" id="bk-cleaning-err" hidden></p>
      </fieldset>

      <fieldset class="field" id="bk-budget" data-label="Budget">
        <legend
          >Budget for the space and our help <span class="req" aria-hidden="true">*</span></legend
        >
        <ChoiceChips name="budget_band" options={BUDGET_BANDS} required idPrefix="bk-budget" />
        <p class="field-error" id="bk-budget-err" hidden></p>
      </fieldset>
    </div>

    <!-- 05 About you ------------------------------------------------------------ -->
    <div class="bk-step" role="group" aria-labelledby="bk-step-5">
      <h3 class="bk-step-head" id="bk-step-5">
        <span class="bk-step-num" aria-hidden="true">05</span>
        <span>About you</span>
      </h3>

      <div class="field-row">
        <div class="field" data-label="First name">
          <label for="bk-first">First name <span class="req" aria-hidden="true">*</span></label>
          <input
            id="bk-first"
            name="contact_first_name"
            type="text"
            required
            maxlength={LIMITS.short}
            autocomplete="given-name"
          />
          <p class="field-error" id="bk-first-err" hidden></p>
        </div>
        <div class="field" data-label="Last name">
          <label for="bk-last">Last name <span class="req" aria-hidden="true">*</span></label>
          <input
            id="bk-last"
            name="contact_last_name"
            type="text"
            required
            maxlength={LIMITS.short}
            autocomplete="family-name"
          />
          <p class="field-error" id="bk-last-err" hidden></p>
        </div>
      </div>
      <div class="field-row">
        <div class="field" data-label="Email">
          <label for="bk-email">Email <span class="req" aria-hidden="true">*</span></label>
          <input
            id="bk-email"
            name="contact_email"
            type="email"
            required
            maxlength={LIMITS.short}
            autocomplete="email"
            spellcheck="false"
          />
          <p class="field-error" id="bk-email-err" hidden></p>
        </div>
        <div class="field" data-label="Phone">
          <label for="bk-phone">Phone</label>
          <input id="bk-phone" name="contact_phone" type="tel" maxlength="30" autocomplete="tel" />
          <p class="field-error" id="bk-phone-err" hidden></p>
        </div>
      </div>

      <fieldset class="field" id="bk-orgtype" data-label="Booking as">
        <legend>You are booking as <span class="req" aria-hidden="true">*</span></legend>
        <ChoiceChips name="org_type" options={ORG_TYPES} required idPrefix="bk-orgtype" />
        <p class="field-error" id="bk-orgtype-err" hidden></p>
      </fieldset>
      <div class="field" data-label="Organisation">
        <label for="bk-org">Organisation</label>
        <input
          id="bk-org"
          name="org_name"
          type="text"
          maxlength={LIMITS.short}
          autocomplete="organization"
        />
      </div>

      <fieldset class="field" id="bk-member" data-label="ODDspace member">
        <legend>Are you an ODDspace member? <span class="req" aria-hidden="true">*</span></legend>
        <ChoiceChips name="is_member" options={YES_NO} required idPrefix="bk-member" />
        <p class="field-error" id="bk-member-err" hidden></p>
      </fieldset>
      <fieldset class="field" id="bk-tier" data-label="Membership" data-show-when="is_member=true">
        <legend>Which membership? <span class="req" aria-hidden="true">*</span></legend>
        <ChoiceChips
          name="membership_tier"
          options={MEMBERSHIP_TIERS}
          required
          idPrefix="bk-tier"
        />
        <p class="field-error" id="bk-tier-err" hidden></p>
      </fieldset>

      <div class="field" data-label="Accessibility needs">
        <label for="bk-access-notes">Accessibility needs</label>
        <textarea
          id="bk-access-notes"
          name="accessibility_notes"
          rows="2"
          maxlength={LIMITS.long}
          aria-describedby="bk-access-hint"></textarea>
        <p class="field-hint" id="bk-access-hint">
          Yours or your guests'. Step-free access, lifts and toilets are still being documented, so
          we tell you exactly what the space can do today.
        </p>
        <p class="field-error" id="bk-access-notes-err" hidden></p>
      </div>
      <div class="field" data-label="How you heard about us">
        <label for="bk-referral">How did you hear about us?</label>
        <input id="bk-referral" name="referral_source" type="text" maxlength={LIMITS.short} />
      </div>
      <div class="field" data-label="Anything else">
        <label for="bk-notes">Anything else?</label>
        <textarea id="bk-notes" name="notes" rows="3" maxlength={LIMITS.long}></textarea>
        <p class="field-error" id="bk-notes-err" hidden></p>
      </div>

      <div class="field" id="bk-consent" data-label="Privacy consent">
        <label class="check">
