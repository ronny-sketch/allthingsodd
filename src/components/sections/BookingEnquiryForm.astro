---
// The ODDspace booking enquiry, on /oddspace/venue. First built 2026-09-23;
// reworked 2026-09-24 for brand, order and error handling, then for what a
// quote needs (the lighter pass); and on 2026-09-24 (v2) turned into a
// guided enquiry in a full-screen dialog. See .design/booking-form in the
// Claude project for the brief and the information architecture.
//
// One ask, "Get a quote", opens a native <dialog> over the venue page: five
// short steps (When → People and room → The event → What you need → About
// you), a progress bar, and a "Check and send" summary where anything can be
// edited before it goes. Each step is checked when you press Next, and only
// that step. The page's own "Get a quote" buttons, the sticky bar and any
// link to `#booking-form` open it; the browser's back button, Esc and ×
// close it, and the answers stay until the page is reloaded (nothing is
// stored in the browser).
//
// It asks only for what a quote depends on, so nobody has to write back with
// twenty questions. Catering, cleaning, the final layout, music after 22:00
// and filming are settled after the booking is confirmed, and budget is not
// asked: none of them changes the quote.
//
// It posts JSON to POST /api/booking-enquiry on the Growth OS Worker
// (../odd-growth-os). The Worker writes the Notion Events Pipeline record and
// hands the submission to Make. This file holds no keys and imports no
// Growth OS code (CLAUDE.md, "Growth OS integration").
//
// A few questions are asked differently from the payload they fill, and the
// submit script converts them. The Worker contract is unchanged.
// - Date, from and until become `get_in` and `get_out`. An end time earlier
//   than the start means the next day.
// - "How many people?" is a number, and `headcount_band` is derived from it.
// - "Who can come?" fills both `event_visibility` and `event_access`.
// - In a space with fixed seating (the Auditorium) the layout is not asked
//   and is sent as `theatre`. Elsewhere it is optional.
// - The smoke, haze or flame tick box sends `pyro_flame` as yes or no.
// - Times come from quarter-hour lists and the date from the calendar only;
//   nothing in "When" can be typed.
//
// Every option list comes from booking-enquiry-schema.ts, the same module
// the submit script validates against. Labels are UI copy and stay in code,
// following WorkEnquiryForm.astro, and are not exposed in CloudCannon. The
// room photographs are the ones the venue page and the info pack already
// use.
//
// Conditional fields carry `data-show-when="<name>=<value>[|<value>]"`,
// `<name>!=<value>` or `<name>=*` (any answer). booking-enquiry-form.ts hides
// them until they apply and disables their inputs while hidden, so a hidden
// field is never sent or validated. Without JavaScript the "Get a quote"
// button is hidden and the <noscript> note gives the email route, because
// the enquiry cannot send without JavaScript.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Pill from '../primitives/Pill.astro';
import ChoiceChips from '../primitives/ChoiceChips.astro';
import {
  ORG_TYPES,
  MEMBERSHIP_TIERS,
  EVENT_TYPES,
  AUDIENCE,
  SPACES,
  SPACE_INFO,
  FIXED_SEATING_SPACES,
  LAYOUTS,
  SUPPORT_OFFERED,
  SUPPORT_DESCRIPTIONS,
  TECH_OFFERED,
  ALCOHOL,
  MUSIC,
  QUARTER_HOURS,
  LIMITS,
} from '../../scripts/booking-enquiry-schema';
import galleryPhoto from '../../assets/oddspace/gallery-floor.jpg';
import aulaPhoto from '../../assets/oddspace/lounge.jpg';
import auditoriumPhoto from '../../assets/oddspace/auditorium.jpg';
import secondFloorPhoto from '../../assets/oddspace/coworking-desks.jpg';

const FIXED = FIXED_SEATING_SPACES.join('|');
const YES_NO = [
  { value: 'true', label: 'Yes' },
  { value: 'false', label: 'No' },
];

// One photograph per room; a combination shows each of its rooms side by
// side. The alt text follows the info pack's, shortened.
interface Photo {
  src: ImageMetadata;
  alt: string;
}
const GALLERY: Photo = {
  src: galleryPhoto,
  alt: 'The Gallery: an open concrete-floored hall with white columns and tall windows.',
};
const AULA: Photo = {
  src: aulaPhoto,
  alt: 'The Aula: sofas and a round table, with artworks leaning against the wall.',
};
const AUDITORIUM: Photo = {
  src: auditoriumPhoto,
  alt: 'The Auditorium from the back: curved tiered seats facing a screen.',
};
const SECOND_FLOOR: Photo = {
  src: secondFloorPhoto,
  alt: 'The 2nd-floor co-creation space: desks and lounge chairs by tall windows.',
};
const SPACE_PHOTOS: Record<string, Photo[]> = {
  gallery: [GALLERY],
  aula: [AULA],
  auditorium: [AUDITORIUM],
  second_floor: [SECOND_FLOOR],
  gallery_aula: [GALLERY, AULA],
  auditorium_aula: [AUDITORIUM, AULA],
  full_triangle: [GALLERY, AULA, AUDITORIUM],
};

const STEPS = ['When', 'People and room', 'The event', 'What you need', 'About you'];
---

<div class="booking" id="booking-form">
  <noscript>
    <p class="booking-noscript">
      This form needs JavaScript to send. You can email the same details to{' '}
      <a href="mailto:hello@oddfest.co">hello@oddfest.co</a> instead.
    </p>
    <style is:inline>
      .bk-opener,
      .bk-sticky {
        display: none !important;
      }
    </style>
  </noscript>

  <!-- The section's heading and this one button are the ask. -->
  <div class="bk-opener">
    <Pill type="button" variant="solid" id="bk-open" class="bk-open">Get a quote</Pill>
    <p class="bk-opener-note">
      Five short steps. Nothing is booked until we confirm it in writing.
    </p>
  </div>
  <p class="bk-sent" id="bk-sent" role="status" tabindex="-1" hidden>
    Your enquiry is in, reference <strong data-sent-ref></strong>. We reply within one working day.
  </p>

  <!-- The enquiry. `data-suppress-newsletter-popup`: while it is open the
       timed newsletter popup stays away (newsletter-popup.ts). -->
  <dialog
    class="bk-dialog"
    id="bk-dialog"
    aria-labelledby="bk-dialog-title"
    data-suppress-newsletter-popup
  >
    <header class="bk-head">
      <div class="bk-head-row">
        <p class="bk-head-title" id="bk-dialog-title">Get a quote</p>
        <p class="bk-count" id="bk-count" aria-live="polite">Step 1 of {STEPS.length}</p>
        <button type="button" class="bk-close" data-bk-close aria-label="Close">
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <ol class="bk-progress" aria-hidden="true">
        {STEPS.map(() => <li />)}
      </ol>
    </header>

    <form class="booking-form" id="bookingEnquiryForm" novalidate>
      <div class="bk-body" id="bk-body">
        <!-- Honeypot. A person never sees it. A non-empty value means a bot. -->
        <div class="botcheck" aria-hidden="true">
          <label for="bk-hp">Leave this empty</label>
          <input id="bk-hp" name="hp_field" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <!-- 01 When ---------------------------------------------------------- -->
        <section class="bk-step" data-step="1" aria-labelledby="bk-step-1">
          <h2 class="bk-step-head" id="bk-step-1" tabindex="-1">
            <span class="bk-step-num" aria-hidden="true">01</span>
            <span>When</span>
          </h2>
          <p class="booking-key">
            Questions marked <span class="req" aria-hidden="true">*</span><span class="sr-only"
              >with an asterisk</span
            > need an answer. Everything else is optional.
          </p>

          <fieldset class="field" id="bk-when" data-label="Date and time">
            <legend>Date and time <span class="req" aria-hidden="true">*</span></legend>
            <div class="bk-when-grid">
              <div class="bk-sub bk-sub-date">
                <label for="bk-date">Date</label>
                <input
                  id="bk-date"
                  name="event_date"
                  type="date"
                  required
                  data-picker-only
                  aria-describedby="bk-when-hint"
                />
              </div>
              <div class="bk-sub">
                <label for="bk-from">From</label>
                <select id="bk-from" name="time_from" required aria-describedby="bk-when-hint">
                  <option value="" selected disabled>––:––</option>
                  {QUARTER_HOURS.map((t) => <option value={t}>{t}</option>)}
                </select>
              </div>
              <div class="bk-sub">
                <label for="bk-until">Until</label>
                <select id="bk-until" name="time_until" required aria-describedby="bk-when-hint">
                  <option value="" selected disabled>––:––</option>
                  {QUARTER_HOURS.map((t) => <option value={t}>{t}</option>)}
                </select>
              </div>
            </div>
            <p class="field-hint" id="bk-when-hint">
              Helsinki time. Start from when your first person arrives to set up, and end when the
              last person leaves after clearing up. The hire covers everything in between.
            </p>
            <p class="bk-derived" id="bk-when-summary" aria-live="polite" hidden></p>
            <label class="check">
              <input type="checkbox" name="multi_day" value="true" />
              <span>It runs over more than one day</span>
            </label>
            <div class="bk-sub bk-sub-date" data-show-when="multi_day=true">
              <label for="bk-enddate">Last day</label>
              <input id="bk-enddate" name="end_date" type="date" required data-picker-only />
            </div>
            <input type="hidden" name="get_in" />
            <input type="hidden" name="get_out" />
            <p class="field-error" id="bk-when-err" hidden></p>
          </fieldset>

          <p class="booking-warning" id="bk-notice" role="status" aria-live="polite" hidden></p>

          <div class="field">
            <label class="check">
              <input type="checkbox" name="has_alt_dates" value="true" />
              <span>Other dates would work too</span>
            </label>
          </div>
          <div class="field-row" data-show-when="has_alt_dates=true">
            <div class="field" data-label="Another date">
              <label for="bk-alt1">Another date</label>
              <input id="bk-alt1" name="alt_date_1" type="date" data-picker-only />
              <p class="field-error" id="bk-alt1-err" hidden></p>
            </div>
            <div class="field" data-label="A third date">
              <label for="bk-alt2">And another</label>
              <input id="bk-alt2" name="alt_date_2" type="date" data-picker-only />
              <p class="field-error" id="bk-alt2-err" hidden></p>
            </div>
          </div>

          <div class="field">
            <label class="check">
              <input type="checkbox" name="is_series" value="true" />
              <span>It is one of a series of events</span>
            </label>
          </div>
          <div
            class="field bk-narrow"
            data-label="Events in the series"
            data-show-when="is_series=true"
          >
            <label for="bk-series"
              >How many events? <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="bk-series"
              name="series_count"
              type="number"
              inputmode="numeric"
              min="2"
              max={LIMITS.maxSeries}
              step="1"
              required
            />
            <p class="field-error" id="bk-series-err" hidden></p>
          </div>
        </section>

        <!-- 02 People and room ---------------------------------------------- -->
        <section class="bk-step" data-step="2" aria-labelledby="bk-step-2" hidden>
          <h2 class="bk-step-head" id="bk-step-2" tabindex="-1">
            <span class="bk-step-num" aria-hidden="true">02</span>
            <span>People and room</span>
          </h2>

          <div class="field bk-narrow" data-label="Number of people">
            <label for="bk-estimate"
              >How many people? <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="bk-estimate"
              name="headcount_estimate"
              type="number"
              inputmode="numeric"
              min="1"
              max={LIMITS.maxHeadcount}
              step="1"
              required
              aria-describedby="bk-estimate-hint"
            />
            <p class="field-hint" id="bk-estimate-hint">
              The most people inside at once, counting guests, crew and performers. A rough number
              is fine.
            </p>
            <p class="field-hint" id="bk-steward" hidden>
              Over 100 people needs a licensed security steward on site, which is not part of the
              hire.
            </p>
            <input type="hidden" name="headcount_band" />
            <p class="field-error" id="bk-estimate-err" hidden></p>
          </div>

          <fieldset class="field" id="bk-space" data-label="Room">
            <legend>Which room? <span class="req" aria-hidden="true">*</span></legend>
            <div class="bk-cards bk-cards-rooms">
              {
                SPACES.map((o, i) => {
                  const info = SPACE_INFO[o.value];
                  const photos = SPACE_PHOTOS[o.value] ?? [];
                  const id = `bk-space-${o.value}`;
                  return (
                    <Fragment>
                      {o.value === 'gallery_aula' && <p class="bk-cards-label">Or combine rooms</p>}
                      <div
                        class:list={[
                          'bk-card',
                          photos.length === 0 && 'bk-card-plain',
                          info.more && 'has-more',
                        ]}
                      >
                        <label class="bk-card-main" for={id}>
                          <input
                            class="bk-card-input"
                            id={id}
                            type="radio"
                            name="space"
                            value={o.value}
                            required={i === 0}
                            aria-labelledby={`${id}-name ${id}-meta`}
                            aria-describedby={`${id}-blurb`}
                          />
                          {photos.length > 0 && (
                            <span class="bk-card-photo" data-count={photos.length}>
                              {photos.map((ph) => (
                                <Image
                                  src={ph.src}
                                  alt={ph.alt}
                                  widths={[160, 320, 640]}
                                  sizes="(min-width: 720px) 8rem, 6rem"
                                  loading="lazy"
                                />
                              ))}
                            </span>
                          )}
                          <span class="bk-card-text">
                            <span class="bk-card-name" id={`${id}-name`}>
                              {o.label}
                            </span>
                            <span class="bk-card-meta" id={`${id}-meta`}>
                              {info.meta}
                            </span>
                            <span class="bk-card-blurb" id={`${id}-blurb`}>
                              {info.blurb}
                            </span>
                          </span>
                        </label>
                        {info.more && (
                          <details class="bk-more">
                            <summary aria-label={`More about ${o.label}`}>
                              <span class="bk-more-icon" aria-hidden="true" />
                              <span class="bk-more-label">More about this room</span>
                            </summary>
                            <p class="bk-more-blurb">{info.blurb}</p>
                            {info.more.map((line) => (
                              <p>{line}</p>
                            ))}
                          </details>
                        )}
                      </div>
                    </Fragment>
                  );
                })
              }
            </div>
            <p class="field-hint">
              The <a href="/oddspace/event-info-pack/" target="_blank" rel="noopener"
                >event info pack</a
              > (opens in a new tab) has the floor plans and house rules.
            </p>
            <p class="booking-warning" id="bk-capacity" role="status" aria-live="polite" hidden></p>
            <p class="field-error" id="bk-space-err" hidden></p>
          </fieldset>

          <fieldset
            class="field"
            id="bk-layout"
            data-label="Layout"
            data-show-when={`space!=${FIXED}`}
          >
            <legend>How should the room be set up?</legend>
            <ChoiceChips name="layout" options={LAYOUTS} idPrefix="bk-layout" />
            <p class="field-hint">
              <span data-show-when="space=full_triangle"
                >This is for the Gallery and the Aula; the Auditorium's seats are fixed.{' '}</span
              >If you are not sure yet, leave it. We confirm the layout with you before the event.
            </p>
            <p class="field-error" id="bk-layout-err" hidden></p>
          </fieldset>
          <div class="field" data-show-when={`space=${FIXED}`}>
            <p class="bk-fixed">
              The Auditorium has fixed tiered seating, so there is no layout to choose.
            </p>
            <input type="hidden" name="layout" value="theatre" />
          </div>
          <div class="field" data-label="Layout details" data-show-when="layout=custom">
            <label for="bk-layout-detail"
              >Describe the layout <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="bk-layout-detail"
              name="layout_custom"
              type="text"
              maxlength={LIMITS.short}
              required
            />
            <p class="field-error" id="bk-layout-detail-err" hidden></p>
          </div>
        </section>

        <!-- 03 The event ------------------------------------------------------ -->
        <section class="bk-step" data-step="3" aria-labelledby="bk-step-3" hidden>
          <h2 class="bk-step-head" id="bk-step-3" tabindex="-1">
            <span class="bk-step-num" aria-hidden="true">03</span>
            <span>The event</span>
          </h2>

          <div class="field" data-label="Name of the event">
            <label for="bk-title"
              >Name of the event <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="bk-title"
              name="event_title"
              type="text"
              required
              maxlength={LIMITS.short}
              aria-describedby="bk-title-hint"
            />
            <p class="field-hint" id="bk-title-hint">A working title is fine.</p>
            <p class="field-error" id="bk-title-err" hidden></p>
          </div>

          <fieldset class="field" id="bk-type" data-label="Kind of event">
            <legend>What kind of event? <span class="req" aria-hidden="true">*</span></legend>
            <ChoiceChips name="event_type" options={EVENT_TYPES} required idPrefix="bk-type" />
            <p class="field-error" id="bk-type-err" hidden></p>
          </fieldset>

          <fieldset class="field" id="bk-audience" data-label="Who can come">
            <legend>Who can come? <span class="req" aria-hidden="true">*</span></legend>
            <ChoiceChips name="audience" options={AUDIENCE} required idPrefix="bk-audience" />
            <input type="hidden" name="event_visibility" />
            <input type="hidden" name="event_access" />
            <p class="field-error" id="bk-audience-err" hidden></p>
          </fieldset>

          <div class="field" data-label="About the event">
            <label for="bk-desc"
              >Tell us about it <span class="req" aria-hidden="true">*</span></label
            >
            <textarea
              id="bk-desc"
              name="event_description"
              rows="4"
              required
              maxlength={LIMITS.long}
              aria-describedby="bk-desc-hint"></textarea>
            <p class="field-hint" id="bk-desc-hint">
              Two or three lines is plenty: what happens, and who it is for.
            </p>
            <p class="field-error" id="bk-desc-err" hidden></p>
          </div>
        </section>

        <!-- 04 What you need -------------------------------------------------- -->
        <section class="bk-step" data-step="4" aria-labelledby="bk-step-4" hidden>
          <h2 class="bk-step-head" id="bk-step-4" tabindex="-1">
            <span class="bk-step-num" aria-hidden="true">04</span>
            <span>What you need</span>
          </h2>

          <fieldset class="field" id="bk-support" data-label="Help from us">
            <legend
              >How much help do you want from us? <span class="req" aria-hidden="true">*</span
              ></legend
            >
            <div class="bk-cards bk-cards-list">
              {
                SUPPORT_OFFERED.map((o, i) => {
                  const id = `bk-support-${o.value}`;
                  return (
                    <div class="bk-card bk-card-plain">
                      <label class="bk-card-main" for={id}>
                        <input
                          class="bk-card-input"
                          id={id}
                          type="radio"
                          name="support_level"
                          value={o.value}
                          required={i === 0}
                          aria-labelledby={`${id}-name`}
                          aria-describedby={`${id}-blurb`}
                        />
                        <span class="bk-card-text">
                          <span class="bk-card-name" id={`${id}-name`}>
                            {o.label}
                          </span>
                          <span class="bk-card-blurb" id={`${id}-blurb`}>
                            {SUPPORT_DESCRIPTIONS[o.value]}
                          </span>
                        </span>
                      </label>
                    </div>
                  );
                })
              }
            </div>
            <p class="field-hint">
              Your quote spells out exactly what the level you pick includes.
            </p>
            <p class="field-error" id="bk-support-err" hidden></p>
          </fieldset>

          <fieldset class="field" id="bk-tech" data-label="Kit from us">
            <legend>Kit you will use</legend>
            <ChoiceChips name="tech" options={TECH_OFFERED} type="checkbox" idPrefix="bk-tech" />
            <p class="field-hint">
              Pick any. The PA and one microphone come with every booking; tick them if you will use
              them, so they are set up for you.
            </p>
          </fieldset>
          <div class="field bk-narrow" data-label="Microphones" data-show-when="tech=mics">
            <label for="bk-mics"
              >How many microphones? <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="bk-mics"
              name="mic_count"
              type="number"
              inputmode="numeric"
              min="1"
              max={LIMITS.maxMics}
              step="1"
              required
            />
            <p class="field-error" id="bk-mics-err" hidden></p>
          </div>

          <div class="field">
            <label class="check">
              <input
                type="checkbox"
                name="own_equipment"
                value="true"
                aria-describedby="bk-equip-hint"
              />
              <span>We are bringing our own equipment</span>
            </label>
            <p class="field-hint" id="bk-equip-hint">
              Staging, rigging, lighting, or anything that needs more than a normal socket.
            </p>
          </div>
          <div class="field" data-label="Your equipment" data-show-when="own_equipment=true">
            <label for="bk-equip"
              >What are you bringing? <span class="req" aria-hidden="true">*</span></label
            >
            <textarea
              id="bk-equip"
              name="own_equipment_detail"
              rows="3"
              maxlength={LIMITS.long}
              required></textarea>
            <p class="field-error" id="bk-equip-err" hidden></p>
          </div>

          <fieldset class="field" id="bk-alcohol" data-label="Alcohol">
            <legend>Alcohol <span class="req" aria-hidden="true">*</span></legend>
            <ChoiceChips name="alcohol" options={ALCOHOL} required idPrefix="bk-alcohol" />
            <p class="field-hint" data-show-when="alcohol=sold">
              Selling alcohol needs a licence from Lupa- ja valvontavirasto, applied for about a
              month ahead. We will talk you through it.
            </p>
            <p class="field-error" id="bk-alcohol-err" hidden></p>
          </fieldset>

          <fieldset class="field" id="bk-music" data-label="Music">
            <legend>Music <span class="req" aria-hidden="true">*</span></legend>
            <ChoiceChips name="music" options={MUSIC} required idPrefix="bk-music" />
            <p class="field-error" id="bk-music-err" hidden></p>
          </fieldset>

          <div class="field">
            <label class="check">
              <input type="checkbox" name="has_pyro" value="true" />
              <span>It involves smoke, haze, candles or open flame</span>
            </label>
          </div>
          <div class="field" data-label="Smoke, haze or flame" data-show-when="has_pyro=true">
            <label for="bk-pyro-detail"
              >What do you have in mind? <span class="req" aria-hidden="true">*</span></label
            >
            <textarea
              id="bk-pyro-detail"
              name="pyro_flame_detail"
              rows="2"
              maxlength={LIMITS.long}
              required
              aria-describedby="bk-pyro-hint"></textarea>
            <p class="field-hint" id="bk-pyro-hint">
              Smoke, haze, steam and candles set off the building's fire alarm, so they are not
              allowed indoors at the moment. Tell us the idea and we will tell you what can be
              arranged.
            </p>
            <input type="hidden" name="pyro_flame" />
            <p class="field-error" id="bk-pyro-detail-err" hidden></p>
          </div>
        </section>

        <!-- 05 About you ------------------------------------------------------ -->
        <section class="bk-step" data-step="5" aria-labelledby="bk-step-5" hidden>
