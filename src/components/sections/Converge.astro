---
interface TrackItem {
  label: string;
  meta: string;
  href: string;
}
interface Props {
  intro: string;
  business: { lede: string; body: string; tracks: TrackItem[] };
  creative: { lede: string; body: string; tracks: TrackItem[] };
}
const { intro, business, creative } = Astro.props;
---

<section class="converge">
  <div class="wrap">
    <p class="converge-intro reveal">{intro}</p>
    <div class="converge-grid reveal">
      <div class="converge-col converge-col--business">
        <h2>For<br />business</h2>
        <p class="converge-lede">{business.lede}</p>
        <p class="converge-body">{business.body}</p>
        {
          business.tracks.map((t) => (
            <a class="track-item" href={t.href}>
              <>
                <span>{t.label}</span>
                <span>{t.meta}</span>
              </>
            </a>
          ))
        }
      </div>
      <div class="converge-col converge-col--creative">
        <h2>For<br />creatives</h2>
        <p class="converge-lede">{creative.lede}</p>
        <p class="converge-body">{creative.body}</p>
        {
          creative.tracks.map((t) => (
            <a class="track-item" href={t.href}>
              <>
                <span>{t.label}</span>
                <span>{t.meta}</span>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .converge {
    padding: 6rem 0 6.5rem;
  }
  .converge-intro {
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-paper-60);
    margin: 0 0 3.8rem;
  }
  .converge-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  .converge-col {
    padding: 0 3.5rem;
  }
  .converge-col--business {
    grid-column: 1;
    padding-left: 0;
    border-right: 1px solid var(--color-paper-12);
  }
  .converge-col--creative {
    grid-column: 2;
    padding-right: 0;
  }
  .converge-col h2 {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-paper);
    font-size: clamp(2.8rem, 6vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    margin: 0 0 0.9rem;
    text-wrap: balance;
  }
  .converge-lede {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    color: var(--color-paper);
    margin: 0 0 1.4rem;
  }
  .converge-body {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-paper-60);
    max-width: 38ch;
    margin: 0 0 2.2rem;
  }
  @media (max-width: 820px) {
    .converge-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .converge {
      padding: 3.25rem 0 3.75rem;
    }
    .converge-intro {
      margin-bottom: 2.4rem;
    }
    .converge-col {
      padding: 0;
    }
    /* .converge-col--creative's grid-column:2 (set unconditionally above,
       for the 2-column desktop layout) was never reset here — with only one
       explicit track at this width, Grid was placing it in a phantom
       implicit second column, pushing it off the right edge of the
       viewport and causing real horizontal page scroll on every mobile
       width. Found via an actual document.scrollWidth check, not visible
       just eyeballing a resized browser window. */
    .converge-col--creative {
      grid-column: 1;
    }
    .converge-col--business {
      border-right: none;
      border-bottom: 1px solid var(--color-paper-12);
      padding-bottom: 2.6rem;
    }
  }

  .track-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--color-paper-12);
    text-decoration: none;
    color: var(--color-paper-80);
    transition: color var(--duration-fast) ease;
  }
  .track-item:first-of-type {
    border-top: none;
  }
  .track-item span:first-child {
    font-weight: 500;
  }
  .track-item span:last-child {
    font-family: var(--font-body);
    font-size: 0.7rem;
    color: var(--color-paper-40);
  }
  .track-item:hover {
    color: var(--color-paper);
  }
  .converge-col--business .track-item:hover {
    color: var(--color-signal-bright);
  }
  .converge-col--creative .track-item:hover {
    color: var(--color-amber-bright);
  }

  @media (prefers-reduced-motion: no-preference) {
    .converge-grid .converge-col {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity var(--duration-slow) ease,
        transform var(--duration-slow) ease;
    }
    .converge-grid.in .converge-col {
      opacity: 1;
      transform: none;
    }
    .converge-grid.in .converge-col--creative {
      transition-delay: 0.12s;
    }
  }
</style>
