---
interface TrackItem {
  label: string;
  meta: string;
  href: string;
}
interface LinkCta {
  label: string;
  href: string;
  external?: boolean;
}
interface Props {
  intro: string;
  business: { lede: string; body: string; tracks?: TrackItem[]; cta?: LinkCta };
  creative: { lede: string; body: string; tracks?: TrackItem[]; cta?: LinkCta };
  // The section's own title ("Who ODD is for") — renders as a real
  // .section-head h2 (2026-08-31: was a tiny eyebrow-style label with no
  // heading at all above the intro paragraph, which read as under-titled
  // next to ProgramGrid's own "What we do" .section-head directly below it
  // in the same composition). Optional so Converge stays usable exactly as
  // before for any future caller that doesn't want a title. See
  // index.astro's merged "Who ODD is for / What we do" composition
  // (2026-08-30 homepage revision).
  audienceEyebrow?: string;
  // Reduces the section's own bottom padding — used only when a caller
  // stacks something (ProgramGrid, on Home) directly underneath as part of
  // one continuous composition, so the two don't get double-padded apart.
  // See docs/architecture.md.
  tightBottom?: boolean;
}
const { intro, business, creative, audienceEyebrow, tightBottom = false } = Astro.props;
---

<section class={`converge ${tightBottom ? 'is-tight-bottom' : ''}`}>
  <div class="wrap">
    {
      audienceEyebrow && (
        <div class="section-head converge-head reveal">
          <h2>{audienceEyebrow}</h2>
        </div>
      )
    }
    <p class="converge-intro reveal">{intro}</p>
    <div class="converge-grid reveal">
      <div class="converge-col converge-col--business">
        <span class="converge-label">For business</span>
        <h2 class="converge-title">{business.lede}</h2>
        <p class="converge-body">{business.body}</p>
        {
          business.tracks && (
            <div class="track-list">
              {business.tracks.map((t) => (
                <a class="track-item" href={t.href}>
                  <>
                    <span>{t.label}</span>
                    <span>{t.meta}</span>
                  </>
                </a>
              ))}
            </div>
          )
        }
        {
          business.cta && (
            <a class="converge-cta" href={business.cta.href}>
              {business.cta.label}
            </a>
          )
        }
      </div>
      <div class="converge-col converge-col--creative">
        <span class="converge-label">For creatives</span>
        <h2 class="converge-title">{creative.lede}</h2>
        <p class="converge-body">{creative.body}</p>
        {
          creative.tracks && (
            <div class="track-list">
              {creative.tracks.map((t) => (
                <a class="track-item" href={t.href}>
                  <>
                    <span>{t.label}</span>
                    <span>{t.meta}</span>
                  </>
                </a>
              ))}
            </div>
          )
        }
        {
          creative.cta && (
            <a class="converge-cta" href={creative.cta.href}>
              {creative.cta.label}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .converge {
    padding: 6rem 0 6.5rem;
  }
  .converge.is-tight-bottom {
    padding-bottom: var(--space-10);
  }
  /* Reuses the sitewide .section-head shape (bordered, centered — same
     pattern ProgramGrid's "What we do" uses directly below it in this same
     composition) so "Who ODD is for" reads as a real section title, not a
     tiny label the intro paragraph seemed to just be hanging off of. */
  .converge-head {
    margin-bottom: var(--space-8);
  }
  .converge-intro {
    text-align: center;
    max-width: 46rem;
    margin: 0 auto 3.8rem;
    font-family: var(--font-body);
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--color-paper-60);
  }
  .converge-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  .converge-col {
    padding: 0 3.5rem;
  }
  .converge-col--business {
    grid-column: 1;
    padding-left: 0;
    border-right: 1px solid var(--color-paper-12);
  }
  .converge-col--creative {
    grid-column: 2;
    padding-right: 0;
  }
  /* Small classification first, subtle but clearly visible — the column's
     actual headline is its lede copy (promoted below), not this label.
     Color-coded per side (signal/amber) to match the existing per-column
     hover accents on the track list further down. */
  .converge-label {
    display: block;
    font: var(--text-caption);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }
  .converge-col--business .converge-label {
    color: var(--color-signal-bright);
  }
  .converge-col--creative .converge-label {
    color: var(--color-amber-bright);
  }
  .converge-title {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-paper);
    font-size: clamp(1.9rem, 3.1vw, 2.6rem);
    line-height: 1.14;
    letter-spacing: -0.01em;
    margin: 0 0 1.2rem;
    max-width: 19ch;
    text-wrap: balance;
  }
  .converge-body {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-paper-60);
    max-width: 38ch;
    margin: 0 0 2.2rem;
  }
  /* Single routing CTA per side (2026-09-02 copywriting pass) — same visual
     treatment as SectionIntro's own text link, reused rather than inventing
     a new link style. */
  .converge-cta {
    display: inline-block;
    margin-top: -0.6rem;
    margin-bottom: 1.6rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.82rem;
    color: var(--color-paper-80);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-paper-20);
    transition: color var(--duration-fast) ease;
  }
  .converge-cta:hover {
    color: var(--color-amber-bright);
    text-decoration-color: var(--color-amber-bright);
  }
  @media (max-width: 820px) {
    .converge-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .converge {
      padding: 3.25rem 0 3.75rem;
    }
    .converge.is-tight-bottom {
      padding-bottom: var(--space-8);
    }
    .converge-intro {
      margin-bottom: 2.4rem;
    }
    .converge-col {
      padding: 0;
    }
    /* .converge-col--creative's grid-column:2 (set unconditionally above,
       for the 2-column desktop layout) was never reset here — with only one
       explicit track at this width, Grid was placing it in a phantom
       implicit second column, pushing it off the right edge of the
       viewport and causing real horizontal page scroll on every mobile
       width. Found via an actual document.scrollWidth check, not visible
       just eyeballing a resized browser window. */
    .converge-col--creative {
      grid-column: 1;
    }
    .converge-col--business {
      border-right: none;
      border-bottom: 1px solid var(--color-paper-12);
      padding-bottom: 2.6rem;
    }
  }

  .track-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--color-paper-12);
    text-decoration: none;
    color: var(--color-paper-80);
    transition: color var(--duration-fast) ease;
  }
  .track-item:first-of-type {
    border-top: none;
  }
  .track-item span:first-child {
    font-weight: 500;
  }
  .track-item span:last-child {
    font-family: var(--font-body);
    font-size: 0.7rem;
    color: var(--color-paper-40);
  }
  .track-item:hover {
    color: var(--color-paper);
  }
  .converge-col--business .track-item:hover {
    color: var(--color-signal-bright);
  }
  .converge-col--creative .track-item:hover {
    color: var(--color-amber-bright);
  }

  @media (prefers-reduced-motion: no-preference) {
    .converge-grid .converge-col {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity var(--duration-slow) ease,
        transform var(--duration-slow) ease;
    }
    .converge-grid.in .converge-col {
      opacity: 1;
      transform: none;
    }
    .converge-grid.in .converge-col--creative {
      transition-delay: 0.12s;
    }
  }
</style>
