---
interface Card {
  number: string;
  title: string;
  body: string;
}
interface Props {
  cards: Card[];
}
const { cards } = Astro.props;
// A wider cap for 4+ cards (was a flat 60rem, tuned for the original
// fixed-3-column grid) — otherwise a 4- or 5-card row gets squeezed
// narrower than it needs to be relative to the page's own .wrap container.
const maxWidth = cards.length <= 3 ? '60rem' : '72rem';
---

<div class="oddf-grid reveal" style={`max-width: ${maxWidth}`}>
  {
    cards.map((c) => (
      <div>
        <div class="band-meta">{c.number}</div>
        <h2>{c.title}</h2>
        <p>{c.body}</p>
      </div>
    ))
  }
</div>

<style>
  .oddf-grid {
    margin: 4rem auto 0;
    display: grid;
    /* auto-fit + minmax(240px, 1fr), not a fixed repeat(var(--cols), 1fr) —
       a fixed N-column count was tried first (matching --cols, set inline
       per instance) but a card's longest single word ("Organisational",
       "Entrepreneurs") needs ~250px to avoid overflowing its own cell, and
       no single fixed-column count is safe at every viewport: the
       container's real width varies a lot (SubpageFrame's rails add a
       constant 176px regardless of viewport; the font-size clamp below
       also hits its own max well before typical desktop widths), so a
       column count safe at one width overflowed at another (confirmed via
       screenshots at 834/1100/1440/1920px, not assumed — "Organisational"
       silently lost letters at both a "narrow desktop" and a "wide desktop"
       width with a fixed 5-column layout). auto-fit sidesteps the whole
       problem: it always uses as many ≥240px columns as actually fit,
       at any width, so a card is never forced narrower than its own
       longest word needs. A lone last card on its own row (5 cards, 4 fit
       per row) reads fine here — see docs/architecture.md's note on the
       original "stranded card" bug this replaces; that was about a
       hardcoded repeat(3, 1fr) never adapting to real card counts at all,
       not about an uneven final row, which this design already uses
       elsewhere (ProofGrid/CaseGrid's own auto-fit grids). */
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    background: var(--color-paper-12);
  }
  .oddf-grid > div {
    /* overflow: hidden — a safety net, not the primary fix (that's the
       240px auto-fit floor below): without it, a single long word that
       still doesn't fit its cell doesn't get clipped, it bleeds into the
       next cell and renders invisibly underneath that cell's own opaque
       background (DOM-order paint stacking) — confirmed via an actual
       tablet screenshot where "Organisational Leaders" silently lost its
       "L" this way, not assumed. */
    overflow: hidden;
    background: var(--color-backstage);
    padding: 2.2rem;
    text-align: center;
  }
  .band-meta {
    font: var(--text-caption);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-paper-40);
  }
  .oddf-grid h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    color: var(--color-paper);
    margin: 0.7rem 0 0;
  }
  .oddf-grid p {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-paper-60);
    margin: 0.7rem 0 0;
    line-height: 1.6;
  }
  @media (prefers-reduced-motion: no-preference) {
    .oddf-grid > div {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.55s ease,
        transform 0.55s ease;
    }
    .oddf-grid.in > div {
      opacity: 1;
      transform: none;
    }
    .oddf-grid.in > div:nth-child(1) {
      transition-delay: 0s;
    }
    .oddf-grid.in > div:nth-child(2) {
      transition-delay: 0.1s;
    }
    .oddf-grid.in > div:nth-child(3) {
      transition-delay: 0.2s;
    }
    .oddf-grid.in > div:nth-child(4) {
      transition-delay: 0.3s;
    }
    .oddf-grid.in > div:nth-child(5) {
      transition-delay: 0.4s;
    }
  }
</style>
