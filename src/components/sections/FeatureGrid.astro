---
interface Card {
  number: string;
  title: string;
  body: string;
}
interface Props {
  cards: Card[];
  // A FeatureGrid is a set of cards inside a section, not the section
  // heading itself — every real usage sits directly under its own h2
  // section head (see docs/design-system.md's FeatureGrid rule), so card
  // titles default to h3. Configurable, not hardcoded, only for the rare
  // future case a caller needs a different level rather than forcing every
  // page's heading hierarchy through one fixed tag.
  headingLevel?: 'h2' | 'h3' | 'h4';
  // Opt-in only (default 'auto', every existing caller unaffected). The
  // default track (`repeat(auto-fit, minmax(240px, 280px))`) sizes columns
  // to the *container's* real width, which at some in-between desktop/
  // laptop widths silently produced an accidental 3+1 or 2x2 split for
  // ODDfest's exactly-4-step "How it works" instead of one deliberate
  // 01|02|03|04 row — see docs/architecture.md and the .is-four-column rule
  // below. Every other FeatureGrid instance (3-, 5-step grids) keeps the
  // exact auto-fit behavior it already has.
  layout?: 'auto' | 'four-column';
}
const { cards, headingLevel = 'h3', layout = 'auto' } = Astro.props;
const Heading = headingLevel;
// A wider cap for 4+ cards (was a flat 60rem, tuned for the original
// fixed-3-column grid) — otherwise a 4- or 5-card row gets squeezed
// narrower than it needs to be relative to the page's own .wrap container.
const maxWidth = cards.length <= 3 ? '60rem' : '72rem';
const gridClass = `oddf-grid reveal${layout === 'four-column' ? ' is-four-column' : ''}`;
---

<div class={gridClass} style={`max-width: ${maxWidth}`}>
  {
    cards.map((c) => (
      <div>
        <div class="band-meta">{c.number}</div>
        <Heading>{c.title}</Heading>
        <p>{c.body}</p>
      </div>
    ))
  }
</div>

<style>
  .oddf-grid {
    margin: 4rem auto 0;
    display: grid;
    /* minmax(240px, 280px), not minmax(240px, 1fr) — a fixed N-column count
       was tried first (matching --cols, set inline per instance) but a
       card's longest single word ("Organisational", "Entrepreneurs") needs
       ~250px to avoid overflowing its own cell, and no single fixed-column
       count is safe at every viewport: the container's real width varies a
       lot (SubpageFrame's rails add a constant 176px regardless of
       viewport; the font-size clamp below also hits its own max well
       before typical desktop widths), so a column count safe at one width
       overflowed at another (confirmed via screenshots at
       834/1100/1440/1920px, not assumed — "Organisational" silently lost
       letters at both a "narrow desktop" and a "wide desktop" width with a
       fixed 5-column layout).
       Capping the track's max at 280px (not 1fr), corrected 2026-08-31
       (final implementation pass): 1fr let a lone last-row card (5 cards,
       4 fit per row) stretch to fill the entire row width, reading as one
       oversized card next to four normal ones — confirmed via a real
       screenshot (ODDagency's 5-step "How a project works"). `justify-
       content: center` centers a partial last row instead of leaving it
       flush left. No container background any more either (see the removed
       `background: var(--color-paper-12)` that used to live here) — CSS
       Grid's explicit column count applies to every row uniformly, so a
       background on this element was never scoped to "cells with a real
       card in them," it painted the *whole* track structure including an
       incomplete last row's genuinely empty cells, which showed as a bare
       solid-color box next to the one real card there (confirmed via a
       real screenshot: capping the track width alone fixed the oversized
       card but not this). Each card's own `background: var(--color-
       backstage)` below plus the `gap` is what actually reads as a hairline
       grid now — real cards only, nothing painted where there isn't one. */
    grid-template-columns: repeat(auto-fit, minmax(240px, 280px));
    justify-content: center;
    gap: 1px;
  }
  /* Forces exactly four columns, one deliberate row, once the container is
     wide enough for four ~240px cards without squeezing below the same
     240px floor the default auto-fit track already treats as a hard
     minimum. Below this width it falls back to the identical responsive
     stacking every other FeatureGrid instance uses (no separate mobile/
     tablet branch needed).

     1200px, not a rounder 1024/1080 — measured directly (not assumed):
     inside SubpageFrame's rails + .oddf-center's gutters, this section's
     real container width runs ~232px narrower than the raw viewport (792px
     container at a 1024px viewport, 808px at 1040px — confirmed via two
     live getBoundingClientRect() checks, linear across both). Four 240px
     columns plus 3px of gap need a ~963px container, i.e. a ~1195px
     viewport; 1200px leaves a small safety margin rather than sitting
     exactly on that edge. Below it, 1024/1040 measured out to a squeezed
     ~201px/column — under the established minimum, a real regression this
     breakpoint is specifically here to avoid. Verified via a real
     screenshot pass at 1024/1200/1280/1440/1920 — see
     tests/functional/interactions.spec.ts's geometry assertion. */
  @media (min-width: 1200px) {
    .oddf-grid.is-four-column {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .oddf-grid > div {
    /* overflow: hidden — a safety net, not the primary fix (that's the
       240px auto-fit floor below): without it, a single long word that
       still doesn't fit its cell doesn't get clipped, it bleeds into the
       next cell and renders invisibly underneath that cell's own opaque
       background (DOM-order paint stacking) — confirmed via an actual
       tablet screenshot where "Organisational Leaders" silently lost its
       "L" this way, not assumed. */
    overflow: hidden;
    background: var(--color-backstage);
    padding: 2.2rem;
    text-align: center;
  }
  .band-meta {
    font: var(--text-caption);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-paper-40);
  }
  .oddf-grid h2,
  .oddf-grid h3,
  .oddf-grid h4 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    color: var(--color-paper);
    margin: 0.7rem 0 0;
  }
  .oddf-grid p {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-paper-60);
    margin: 0.7rem 0 0;
    line-height: 1.6;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .oddf-grid > div {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.55s ease,
        transform 0.55s ease;
    }
    :global(html.reveal-js) .oddf-grid.in > div {
      opacity: 1;
      transform: none;
    }
    .oddf-grid.in > div:nth-child(1) {
      transition-delay: 0s;
    }
    .oddf-grid.in > div:nth-child(2) {
      transition-delay: 0.1s;
    }
    .oddf-grid.in > div:nth-child(3) {
      transition-delay: 0.2s;
    }
    .oddf-grid.in > div:nth-child(4) {
      transition-delay: 0.3s;
    }
    .oddf-grid.in > div:nth-child(5) {
      transition-delay: 0.4s;
    }
  }
</style>
