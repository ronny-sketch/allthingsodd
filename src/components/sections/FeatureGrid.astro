---
interface Card {
  number: string;
  title: string;
  body: string;
}
interface Props {
  cards: Card[];
  // A FeatureGrid is a set of cards inside a section, not the section
  // heading itself — every real usage sits directly under its own h2
  // section head (see docs/design-system.md's FeatureGrid rule), so card
  // titles default to h3. Configurable, not hardcoded, only for the rare
  // future case a caller needs a different level rather than forcing every
  // page's heading hierarchy through one fixed tag.
  headingLevel?: 'h2' | 'h3' | 'h4';
}
const { cards, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
// How many cards one full row may hold. Four cards go two-by-two rather than
// three-and-one; five go three-and-two. The card width itself lives in CSS.
const perRow = cards.length === 4 ? 2 : Math.min(cards.length, 3);
---

<div class="oddf-grid reveal" style={`--per-row: ${perRow}`}>
  {
    cards.map((c) => (
      <div>
        <div class="band-meta">{c.number}</div>
        <Heading>{c.title}</Heading>
        <p>{c.body}</p>
      </div>
    ))
  }
</div>

<style>
  /* A centred, wrapping row of equal cards (2026-09-13 typography pass; this
     was `repeat(auto-fit, minmax(240px, 280px))`).

     The card width is derived from the Heading role its title is set in:
     9em of title — room for the widest single words these cards carry,
     "collaboration" and "automatically" — plus the card's own padding. A
     fixed pixel track could not do that. Heading is fluid (1.5rem to 2rem),
     so a track wide enough for "availability" at 2rem was too wide to keep
     three cards on a row in the 60rem container, and one narrow enough to
     keep them clipped the word; tying the width to --font-size-heading keeps
     card and title in proportion at every viewport.

     Flex rather than grid for what a short last row does. A grid's explicit
     columns leave a lone final card in column one with an empty cell beside
     it (the 2026-08-31 pass hit this twice, once as a stretched 1fr card and
     once as a painted empty cell); a flex row centres it at the same width
     as every other card. There is still no background on the container —
     each card's own background plus the 1px gap is the hairline grid, so
     nothing is ever painted where there is no card. `max-width` caps a row
     at --per-row cards (set from the card count above); the extra 1px per
     card is rounding slack so the last card on a full row never wraps.

     No block margin: the caller places the grid with `.flow`. */
  .oddf-grid {
    --feature-card: calc(var(--font-size-heading) * 9 + 3.2rem);

    margin-inline: auto;
    max-width: calc((var(--feature-card) + 1px) * var(--per-row));
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1px;
  }
  /* There is no forced four-across variant any more. ODDfest's four steps
     used to be pinned to one row from 1200px, but with their titles on the
     Heading role a ~280px card set "Start with something you already want to
     make" in five or six lines — so four cards take the same 2x2 block as
     any other four-card grid. */
  .oddf-grid > div {
    /* Shrinks (never grows) — so a single card on a phone narrower than
       --feature-card still fits its column. */
    flex: 0 1 var(--feature-card);
    min-width: 0;
    /* overflow: hidden — a safety net, not the primary fix (that's the card
       width above): without it, a single long word that still doesn't fit
       doesn't get clipped, it bleeds into the next card and renders
       invisibly underneath that card's own opaque background (DOM-order paint
       stacking) — confirmed via an actual tablet screenshot where
       "Organisational Leaders" silently lost its "L" this way. */
    overflow: hidden;
    background: var(--color-backstage);
    padding: 1.6rem;
    text-align: center;
  }
  /* The narrowest phones: a 264px column can't also give 1.6rem each side to
     the longest title words at the Heading role's 1.5rem floor. */
  @media (max-width: 360px) {
    .oddf-grid > div {
      padding-inline: 1.2rem;
    }
  }
  .band-meta {
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-40);
  }
  .oddf-grid h2,
  .oddf-grid h3,
  .oddf-grid h4 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }
  .oddf-grid p {
    font: var(--text-body);
    color: var(--color-paper-60);
    margin: var(--space-3) 0 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .oddf-grid > div {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.55s ease,
        transform 0.55s ease;
    }
    :global(html.reveal-js) .oddf-grid.in > div {
      opacity: 1;
      transform: none;
    }
    .oddf-grid.in > div:nth-child(1) {
      transition-delay: 0s;
    }
    .oddf-grid.in > div:nth-child(2) {
      transition-delay: 0.1s;
    }
    .oddf-grid.in > div:nth-child(3) {
      transition-delay: 0.2s;
    }
    .oddf-grid.in > div:nth-child(4) {
      transition-delay: 0.3s;
    }
    .oddf-grid.in > div:nth-child(5) {
      transition-delay: 0.4s;
    }
  }
</style>
