---
// A logo row — two modes. Default (`scroll` unset/false) is static: a
// wrapped, centered row, real alt text per image, used for the plain
// partner-network mentions on About/Work with ODD/Membership. `scroll`
// brings back an infinite left-to-right auto-scroll (marquee-right — see
// motion.css), used for "Featured In" specifically (Home + Media): the
// track is duplicated once for a seamless loop, marked aria-hidden, with a
// real sr-only text list alongside it so the (genuinely meaningful, not
// decorative) list of outlets stays in the accessibility tree. Respects
// prefers-reduced-motion — under reduced motion the track simply sits at
// its default position, showing one clean, non-duplicated pass. For a
// *grouped* static display (tier labels + logos per tier), see
// PartnerTiers.astro instead, used for Home's dedicated Partners section.
import type { ImageMetadata } from 'astro';

interface LogoItem {
  name: string;
  logo: ImageMetadata;
}
interface Props {
  eyebrow: string;
  title: string;
  items: LogoItem[];
  size?: 'default' | 'large';
  scroll?: boolean;
  // Home's "Featured in" sits directly under "The ODD platform" now — proof
  // supporting that section, not a new chapter of its own. `compact` drops
  // the bordered section-head/h2 in favour of one small inline label, and
  // tightens the rhythm so it reads as a continuation, not a fresh section.
  // Media's own "Featured in" keeps the default (non-compact) full treatment.
  compact?: boolean;
}
const { eyebrow, title, items, size = 'default', scroll = false, compact = false } = Astro.props;
const track = scroll ? [...items, ...items] : items;
const sizeClass = size === 'large' ? 'is-large' : '';
---

<section class={`logo-strip-section ${compact ? 'is-compact' : ''}`}>
  <div class="wrap">
    {
      compact ? (
        <div class="logo-strip-label">
          <span class="eyebrow">{eyebrow}</span>
          <h2>{title}</h2>
        </div>
      ) : (
        <div class="section-head">
          <span class="eyebrow">{eyebrow}</span>
          <h2>{title}</h2>
        </div>
      )
    }
  </div>
  {
    scroll ? (
      <>
        <div class="logo-strip-scroll">
          <div class={`logo-strip-track ${sizeClass}`} aria-hidden="true">
            {track.map((item) => (
              <img src={item.logo.src} alt="" loading="lazy" />
            ))}
          </div>
        </div>
        <p class="sr-only">{items.map((item) => item.name).join(', ')}</p>
      </>
    ) : (
      <div class="wrap">
        <div class={`logo-strip-row ${sizeClass}`}>
          {items.map((item) => (
            <img src={item.logo.src} alt={item.name} loading="lazy" />
          ))}
        </div>
      </div>
    )
  }
</section>

<style>
  .logo-strip-section {
    border-top: 1px solid var(--color-paper-12);
    padding: var(--space-20) 0 var(--space-16);
  }
  .logo-strip-section .section-head {
    margin-bottom: var(--space-10);
  }
  /* Compact — no border-top (this isn't a new chapter, it's proof under the
     platform section above it), no bordered section-head, one quiet label
     line instead of an h2, generous but tighter top/bottom rhythm. */
  .logo-strip-section.is-compact {
    border-top: none;
    padding: var(--space-4) 0 var(--space-20);
  }
  /* Real heading typography (same --text-heading-md/--color-paper the
     non-compact .section-head h2 above uses — Media's own "Featured in" is
     the source of truth) without the bordered/padded "new chapter" scaffold
     .section-head carries — that's what keeps this reading as supportive
     proof under "What we do" rather than a competing section of its own. */
  .logo-strip-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-8);
  }
  .logo-strip-label .eyebrow {
    color: var(--color-paper-60);
  }
  .logo-strip-label h2 {
    font: var(--text-heading-md);
    margin: 0;
    color: var(--color-paper);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .logo-strip-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2.75rem 3.5rem;
  }
  .logo-strip-scroll {
    overflow: hidden;
    width: 100%;
    padding: 0.25rem 0;
  }
  .logo-strip-track {
    display: flex;
    align-items: center;
    gap: 3.5rem;
    width: max-content;
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo-strip-track {
      /* animation-direction: reverse (not just marquee-right's own from/to
         swapped) — verified empirically via screenshot, not assumed: plain
         marquee-right on this doubled track actually reads as right-to-left
         content motion, the opposite of what its name suggests elsewhere in
         this codebase. Reversing it here is what actually produces left-to-
         right, which is what was asked for. */
      animation: marquee-right 30s linear infinite reverse;
    }
  }
  .logo-strip-row img,
  .logo-strip-track img {
    height: 34px;
    width: auto;
    max-width: 150px;
    object-fit: contain;
    display: block;
    opacity: 0.65;
    flex-shrink: 0;
    /* Source logos arrive in whatever color/contrast their own brand uses —
       brightness(0) invert(1) normalizes any of them (dark wordmark, colored
       mark, whatever) into a single clean paper-colored silhouette, the only
       treatment that reads reliably against --color-ink for an arbitrary,
       uncurated logo set. */
    filter: brightness(0) invert(1);
    transition: opacity var(--duration-fast) ease;
  }
  .logo-strip-row.is-large img,
  .logo-strip-track.is-large img {
    height: 68px;
    max-width: 240px;
  }
  .logo-strip-row img:hover {
    opacity: 1;
  }
</style>
