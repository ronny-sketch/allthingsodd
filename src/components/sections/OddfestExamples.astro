---
// ODDfest's "Last year, this looked like…" grid — real, named 2026
// Creative Week examples across varied formats. Page-specific (not reused
// elsewhere) because none of the site's existing card grids fit this shape:
// CaseGrid has no image field, ProgramGrid's cards are full-height link-outs
// sized for exactly the four ODD platforms. This one is a compact photo/
// typographic card, image optional — see content.config.ts's
// `creativeWeekExample` and ProgramGrid's own "card can skip its photo"
// convention, reused here.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface ExampleItem {
  category: string;
  title: string;
  host?: string;
  body: string;
  image?: ImageMetadata;
  href?: string;
  external?: boolean;
}
interface Props {
  items: ExampleItem[];
}
const { items } = Astro.props;
---

<div class="examples">
  <div class="examples-grid reveal">
    {
      items.map((item) => {
        const Tag = item.href ? 'a' : 'div';
        // `external` (2026-09-14): the verified examples link out to their
        // partners' own event pages and write-ups — a new tab with
        // rel=noreferrer, the same treatment Pill gives any external link.
        const linkProps = item.href
          ? {
              href: item.href,
              ...(item.external ? { target: '_blank', rel: 'noreferrer' } : {}),
            }
          : {};
        return (
          <Tag class="example-card" {...linkProps}>
            <div class={`example-media ${item.image ? '' : 'example-media--empty'}`}>
              {item.image && (
                <Image class="example-media-img" src={item.image} alt="" width={960} />
              )}
            </div>
            <div class="example-body">
              <span class="example-category">{item.category}</span>
              <h3>{item.title}</h3>
              {item.host && <span class="example-host">{item.host}</span>}
              <p>{item.body}</p>
            </div>
          </Tag>
        );
      })
    }
  </div>
</div>

<style>
  /* No container background (2026-09-14) — the same fix CaseGrid got on
     2026-08-31, reached here the first time this grid carried a count that
     doesn't divide evenly per row (five). The container's background is what
     painted an incomplete last row's empty cell as a bare solid card; each
     card's own background plus the 1px gap is what reads as the hairline
     grid, and it still does.

     Column counts (2026-09-14, eight cards): the same 16.25rem-per-card
     steps the old `auto-fit` grid took — 1, 2, 3, 4 columns — but set
     against the grid's own width with a container query, so the three-column
     step can be written as six half-tracks. That lets a last row of two
     cards share the whole row (three half-tracks each) instead of leaving an
     empty cell beside them; their photos go 2:1 so the row keeps the same
     image height as the 4:3 cards above it. A single leftover card stays one
     column wide — stretched across the page it would be a banner, not a
     card. */
  .examples {
    container: examples / inline-size;
  }
  .examples-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
  }
  @container examples (min-width: 32.5rem) {
    .examples-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @container examples (min-width: 48.75rem) {
    .examples-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .example-card {
      grid-column: span 2;
    }
    .example-card:nth-child(3n + 1):nth-last-child(2),
    .example-card:nth-child(3n + 2):last-child {
      grid-column: span 3;
    }
    .example-card:nth-child(3n + 1):nth-last-child(2) .example-media,
    .example-card:nth-child(3n + 2):last-child .example-media {
      aspect-ratio: 2 / 1;
    }
  }
  @container examples (min-width: 65rem) {
    .examples-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .example-card,
    .example-card:nth-child(3n + 1):nth-last-child(2),
    .example-card:nth-child(3n + 2):last-child {
      grid-column: auto;
    }
    .example-card:nth-child(3n + 1):nth-last-child(2) .example-media,
    .example-card:nth-child(3n + 2):last-child .example-media {
      aspect-ratio: 4 / 3;
    }
  }
  .example-card {
    display: flex;
    flex-direction: column;
    background: var(--color-backstage);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--duration-fast) ease;
  }
  @media (hover: hover) {
    a.example-card:hover {
      background: color-mix(in srgb, var(--color-backstage) 85%, var(--color-paper) 15%);
    }
  }
  .example-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-backstage);
  }
  .example-media :global(.example-media-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.15) brightness(0.92);
    transition: transform 0.6s ease;
  }
  @media (hover: hover) {
    a.example-card:hover .example-media :global(.example-media-img) {
      transform: scale(1.05);
    }
  }
  /* Touch press state. `(hover: hover)` above keeps the pointer-only
     enhancements off touchscreens, where iOS leaves :hover stuck on the
     last-tapped element; this is what replaces them — an immediate, physical
     acknowledgement at the moment of the tap. The tap-highlight reset is
     paired with it deliberately: the platform's grey flash is only removed
     because there is a real state taking its place. */
  @media (hover: none) {
    a.example-card {
      -webkit-tap-highlight-color: transparent;
      transition:
        transform 0.12s ease,
        background 0.12s ease;
    }
    a.example-card:active {
      transform: scale(0.985);
      background: color-mix(in srgb, var(--color-backstage) 85%, var(--color-paper) 15%);
    }
  }

  .example-media--empty {
    background:
      radial-gradient(ellipse 70% 70% at 30% 20%, rgb(226 223 222 / 6%) 0%, transparent 60%),
      var(--color-backstage);
  }
  .example-body {
    padding: 1.6rem 1.8rem 2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .example-category {
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-40);
  }
  .example-body h3 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: 0.6rem 0 0;
  }
  .example-host {
    display: block;
    font: var(--text-small);
    color: var(--color-paper-60);
    margin-top: 0.3rem;
  }
  .example-body p {
    font: var(--text-body);
    color: var(--color-paper-60);
    margin: 0.8rem 0 0;
    flex: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .examples-grid .example-card {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.55s ease,
        transform 0.55s ease;
    }
    :global(html.reveal-js) .examples-grid.in .example-card {
      opacity: 1;
      transform: none;
    }
  }
</style>
