---
// About: real vertical scroll, pinned and read as horizontal movement (Horst-style).
// .about-pin-wrap is a tall block (panels × 100vh); .about-scroll pins to the
// viewport with position:sticky while that height scrolls past, and JS (see
// src/scripts/about-scroll.ts) maps scroll progress through it onto a translateX
// on .about-track. Real scrollY under the hood, not a wheel-event hijack —
// prefers-reduced-motion drops it to a plain stacked page (.about-static) instead.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Logo from '../primitives/Logo.astro';
import Pill from '../primitives/Pill.astro';

type Panel =
  | {
      _kind: 'media';
      image: ImageMetadata;
      alt: string;
      eyebrow: string;
      title: string;
      body: string;
    }
  | {
      _kind: 'model';
      eyebrow: string;
      title: string;
      items: { label: string; meta: string; href: string }[];
    }
  | {
      _kind: 'text';
      eyebrow: string;
      title: string;
      body: string;
      cta?: { label: string; href: string };
    };

interface Props {
  panels: Panel[];
  marqueeItems: string[];
  pageTitle: string;
}
const { panels, marqueeItems, pageTitle } = Astro.props;
const marqueeLoop = [...marqueeItems, ...marqueeItems];
---

{
  /* Every panel below is an h2 — the page as a whole still needs exactly one
   h1 for a correct heading hierarchy, even though the design has no visible
   "page title" moment (it opens straight into the first panel). */
}
<h1 class="sr-only">{pageTitle}</h1>

<div class="about-pin-wrap" id="aboutPinWrap" style={`--panels:${panels.length}`}>
  <div class="about-scroll">
    <div class="about-track" id="aboutTrack">
      {
        panels.map((panel) => {
          if (panel._kind === 'media') {
            return (
              <div class="about-panel about-panel--media">
                <div class="about-media">
                  <Image src={panel.image} alt={panel.alt} width={1200} />
                </div>
                <div class="about-copy">
                  <div class="eyebrow">{panel.eyebrow}</div>
                  <h2>{panel.title}</h2>
                  <p>{panel.body}</p>
                </div>
              </div>
            );
          }
          if (panel._kind === 'model') {
            return (
              <div class="about-panel about-panel--text">
                <div class="about-mark">
                  <Logo ariaHidden />
                </div>
                <div class="eyebrow">{panel.eyebrow}</div>
                <h2>{panel.title}</h2>
                <div class="about-model-list">
                  {panel.items.map((item) => (
                    <a class="about-model-row" href={item.href}>
                      <b>{item.label}</b>
                      <span>{item.meta}</span>
                    </a>
                  ))}
                </div>
              </div>
            );
          }
          return (
            <div class="about-panel about-panel--text">
              <div class="eyebrow">{panel.eyebrow}</div>
              <h2>
                {panel.title.split('\n').map((line, i) =>
                  i === 0 ? (
                    line
                  ) : (
                    <>
                      <br />
                      {line}
                    </>
                  ),
                )}
              </h2>
              <p>{panel.body}</p>
              {panel.cta && (
                <div style="margin-top:1.8rem;">
                  <Pill href={panel.cta.href} variant="solid" magnetic>
                    {panel.cta.label}
                  </Pill>
                </div>
              )}
            </div>
          );
        })
      }
    </div>

    <div class="about-hint" id="aboutHint" aria-hidden="true">
      Scroll to explore
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
      >
    </div>

    <div class="about-marquee" aria-hidden="true">
      <div class="about-marquee-track">
        {
          marqueeLoop.map((item, i) => (
            <span class="about-marquee-item">
              {i % 2 === 0 && <Logo ariaHidden />}
              {item}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script src="../../scripts/about-scroll.ts"></script>

<style>
  .about-pin-wrap {
    position: relative;
    height: calc(var(--panels, 5) * 100vh);
  }
  .about-scroll {
    position: sticky;
    top: var(--nav-h, 65px);
    height: calc(100vh - var(--nav-h, 65px));
    overflow: hidden;
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
  }
  .about-track {
    display: flex;
    flex: 1;
    min-height: 0;
    will-change: transform;
  }
  .about-panel {
    width: 100vw;
    height: 100%;
    flex-shrink: 0;
    display: grid;
    overflow: hidden;
  }
  .about-panel--media {
    grid-template-columns: 1fr 1fr;
  }
  .about-panel--text {
    grid-template-columns: 1fr;
    align-content: center;
    justify-items: center;
    text-align: center;
    padding: 0 8vw;
  }
  .about-media {
    position: relative;
    overflow: hidden;
    background: var(--color-backstage);
  }
  .about-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.1) brightness(0.88);
  }
  .about-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4vw 6vw;
    max-width: 34rem;
  }
  .about-copy .eyebrow {
    margin-bottom: 1.2rem;
  }
  .about-copy h2,
  .about-panel--text h2 {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-paper);
    font-size: clamp(2.2rem, 4.6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.01em;
    margin: 0 0 1.4rem;
    text-wrap: balance;
  }
  .about-panel--text h2 {
    max-width: 20ch;
  }
  .about-copy p,
  .about-panel--text p {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.75;
    color: var(--color-paper-60);
    max-width: 42ch;
  }
  .about-panel--text .eyebrow {
    margin-bottom: 1.2rem;
  }
  .about-mark {
    width: min(160px, 22vw);
    height: auto;
    color: var(--color-paper-40);
    margin: 0 auto 2rem;
  }
  .about-model-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 1.6rem;
    max-width: 30rem;
    width: 100%;
  }
  .about-model-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--color-paper-12);
    text-align: left;
    text-decoration: none;
    color: inherit;
    transition: color var(--duration-fast) ease;
  }
  .about-model-row:first-child {
    border-top: none;
  }
  .about-model-row b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.2rem;
    color: var(--color-paper);
  }
  .about-model-row span {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-paper-40);
    white-space: nowrap;
  }
  .about-model-row:hover b {
    color: var(--color-amber);
  }

  .about-hint {
    position: absolute;
    left: 50%;
    bottom: 78px;
    transform: translateX(-50%);
    z-index: 5;
    font: var(--text-caption);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-paper-60);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .about-hint svg {
    width: 15px;
    height: 15px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .about-hint svg {
      animation: about-hint-nudge 1.6s ease-in-out infinite;
    }
  }
  @keyframes about-hint-nudge {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(6px);
    }
  }

  .about-marquee {
    height: 60px;
    flex-shrink: 0;
    border-top: 1px solid var(--color-paper-12);
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .about-marquee-track {
    display: flex;
    align-items: center;
    gap: 2.75rem;
    width: max-content;
  }
  @media (prefers-reduced-motion: no-preference) {
    .about-marquee-track {
      animation: marquee-right 26s linear infinite;
    }
  }
  .about-marquee-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.15rem;
    text-transform: uppercase;
    color: var(--color-paper-60);
    white-space: nowrap;
  }
  .about-marquee-item :global(svg) {
    width: 20px;
    height: auto;
    color: var(--color-paper-40);
    flex-shrink: 0;
  }

  @media (max-width: 820px) {
    .about-panel--media {
      grid-template-columns: 1fr;
      grid-template-rows: 38% 62%;
    }
    .about-copy {
      padding: 6vw;
      max-width: none;
    }
    .about-hint {
      bottom: 74px;
    }
  }

  /* prefers-reduced-motion: drop the scroll-pin entirely, read as a normal stacked page */
  .about-pin-wrap.about-static {
    height: auto;
  }
  .about-pin-wrap.about-static .about-scroll {
    position: static;
    height: auto;
    overflow: visible;
  }
  .about-pin-wrap.about-static .about-track {
    flex-direction: column;
    height: auto;
    transform: none !important;
  }
  .about-pin-wrap.about-static .about-panel {
    width: 100%;
    height: auto;
    min-height: 70vh;
  }
  .about-pin-wrap.about-static .about-hint {
    display: none;
  }
</style>
