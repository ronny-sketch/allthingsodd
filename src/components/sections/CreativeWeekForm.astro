---
// The ODDfest 2027 Creative Week submission, on /oddfest/ (2026-10-04). It
// replaces sending would-be hosts to /contact/?topic=oddfest_2027_event, and
// asks the ODDfest team's Google Form questions ("ODDfest 2027 form") itself.
//
// It is the venue page's "Get a quote" journey (BookingEnquiryForm.astro)
// with different questions: a native <dialog>, one step at a time with a
// progress bar, each step checked when you press Next, and a "Check and
// send" summary where anything can be edited. Every link to
// `#creative-week-form` opens it (the hero, How to join, the "Want your
// event in the next one?" band, the sticky bar); the browser's back button,
// Esc and × close it; the answers stay until the page is reloaded and
// nothing is stored in the browser. No timed popup ever opens it.
//
// The shell, its markup and its styles mirror BookingEnquiryForm's on
// purpose (same sheet, steps, marks, summary and sticky bar), kept as a
// copy so this branch leaves the live quote form untouched. ponytail: two
// copies of the dialog shell; extract one shared shell when either changes.
// No venue questions, prices or response-time promises carry over.
//
// The steps regroup the Google Form's sections so the idea comes first and
// the contact details last, the quote form's order: Your idea (2) → Making
// it happen (3) → Where and when (5; the form has no section 4) → Audience
// and access (6) → What you need (7) → About you (1, 8 and 9's questions).
// The acknowledgements and the privacy tick box are on the summary.
//
// Every option list and rule comes from creative-week-schema.ts, which the
// submit script validates against. Labels are UI copy and stay in code,
// like the quote form's, out of CloudCannon. It posts JSON to POST
// /api/creative-week-submission on the Growth OS Worker (../odd-growth-os),
// which writes the Creative Week Notion database. This file holds no keys
// and imports no Growth OS code (AGENTS.md, "Growth OS integration").
//
// Conditional questions carry `data-show-when="<name>=<value>[|<value>]"`
// (the quote form's convention); the script hides them until they apply and
// disables their inputs while hidden, so a hidden answer is never sent.
// Without JavaScript the <noscript> note gives the email route.
import Pill from '../primitives/Pill.astro';
import ChoiceChips from '../primitives/ChoiceChips.astro';
import {
  APPLICANT_TYPES,
  EVENT_KINDS,
  FORMATS,
  FIELDS,
  READINESS,
  VENUE_STATUS,
  VENUE_NAMED,
  VENUE_OPEN,
  TIMING,
  AUDIENCES,
  ACCESS,
  HELP,
  FINANCING,
  REFERRAL,
  LIMITS,
} from '../../scripts/creative-week-schema';

const STEPS = [
  'Your idea',
  'Making it happen',
  'Where and when',
  'Audience and access',
  'What you need',
  'About you',
];
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<div class="cw" id="creative-week-form">
  <noscript>
    <p class="cw-noscript">
      This form needs JavaScript to send. You can email your idea to{' '}
      <a href="mailto:hello@oddfest.co">hello@oddfest.co</a> instead.
    </p>
    <style is:inline>
      .cw-sticky {
        display: none !important;
      }
    </style>
  </noscript>

  <p class="cw-sent" id="cw-sent" role="status" tabindex="-1" hidden>
    Your idea is in, reference <strong data-sent-ref></strong>. Thank you.
  </p>

  <!-- `data-suppress-newsletter-popup`: while it is open the timed
       newsletter popup stays away (newsletter-popup.ts). -->
  <dialog
    class="cw-dialog"
    id="cw-dialog"
    aria-labelledby="cw-dialog-title"
    data-suppress-newsletter-popup
  >
    <header class="cw-head">
      <div class="cw-head-row">
        <p class="cw-head-title" id="cw-dialog-title">Submit an event idea</p>
        <p class="cw-count" id="cw-count" aria-live="polite">Step 1 of {STEPS.length}</p>
        <button type="button" class="cw-close" aria-label="Close">
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <ol class="cw-progress" aria-hidden="true">
        {STEPS.map(() => <li />)}
      </ol>
    </header>

    <form class="cw-form" id="creativeWeekForm" novalidate>
      <div class="cw-body" id="cw-body">
        <!-- Honeypot. A person never sees it. A non-empty value means a bot. -->
        <div class="botcheck" aria-hidden="true">
          <label for="cw-hp">Leave this empty</label>
          <input id="cw-hp" name="hp_field" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <!-- 01 Your idea (the Google Form's section 2) ------------------------ -->
        <section class="cw-step" data-step="1" aria-labelledby="cw-step-1">
          <h2 class="cw-step-head" id="cw-step-1" tabindex="-1">
            <span class="cw-step-num" aria-hidden="true">{num(0)}</span>
            <span>{STEPS[0]}</span>
          </h2>
          <p class="cw-key">
            An exhibition, an industry gathering, a club night or a workshop: what would you bring
            to Helsinki’s creative week? You should have a clear concept, but your venue, team or
            funding can still be taking shape. It takes around 5–10 minutes, one submission per
            idea.
          </p>
          <p class="cw-key">
            Questions marked <span class="req" aria-hidden="true">*</span><span class="sr-only"
              >with an asterisk</span
            > need an answer. Everything else is optional.
          </p>

          <div class="field" data-label="Working title">
            <label for="cw-title">Working title <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="cw-title"
              name="title"
              type="text"
              required
              maxlength={LIMITS.short}
              aria-describedby="cw-title-hint"
            />
            <p class="field-hint" id="cw-title-hint">A rough title is fine.</p>
            <p class="field-error" id="cw-title-err" hidden></p>
          </div>

          <div class="field" data-label="Your idea">
            <label for="cw-desc"
              >Describe your idea in a few sentences <span class="req" aria-hidden="true">*</span
              ></label
            >
            <textarea
              id="cw-desc"
              name="description"
              rows="5"
              required
              maxlength={LIMITS.long}
              aria-describedby="cw-desc-hint"></textarea>
            <p class="field-hint" id="cw-desc-hint">
              What actually happens? What would someone experience? Focus on the event rather than
              your biography.
            </p>
            <p class="field-error" id="cw-desc-err" hidden></p>
          </div>

          <fieldset class="field" data-label="Type of event">
            <legend>What type of event is it? <span class="req" aria-hidden="true">*</span></legend>
            <p class="field-hint">Educating, entertaining, or both?</p>
            <div class="cw-options">
              {
                EVENT_KINDS.map((o, i) => (
                  <label class="check" for={`cw-kind-${o.value}`}>
                    <input
                      id={`cw-kind-${o.value}`}
                      type="radio"
                      name="event_kind"
                      value={o.value}
                      required={i === 0}
                    />
                    <span class="cw-option-text">{o.label}</span>
                  </label>
                ))
              }
            </div>
            <p class="field-error" id="cw-kind-err" hidden></p>
          </fieldset>

          <fieldset class="field" data-label="Formats">
            <legend
              >Which of these describes the event in more detail? <span
                class="req"
                aria-hidden="true">*</span
              ></legend
            >
            <p class="field-hint">Select all that apply. Hybrid formats are welcome.</p>
            <ChoiceChips name="formats" options={FORMATS} type="checkbox" idPrefix="cw-format" />
            <p class="field-error" id="cw-format-err" hidden></p>
          </fieldset>
          <div class="field" data-label="Other format" data-show-when="formats=other">
            <label for="cw-format-other-text"
              >Other format <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="cw-format-other-text"
              name="formats_other"
              type="text"
              required
              maxlength={LIMITS.line}
            />
            <p class="field-error" id="cw-format-other-err" hidden></p>
          </div>

          <fieldset class="field" data-label="Creative fields">
            <legend
              >Which creative fields does it connect to? <span class="req" aria-hidden="true"
                >*</span
              ></legend
            >
            <p class="field-hint">Select all that apply.</p>
            <ChoiceChips name="fields" options={FIELDS} type="checkbox" idPrefix="cw-field" />
            <p class="field-error" id="cw-field-err" hidden></p>
          </fieldset>
          <div class="field" data-label="Other creative field" data-show-when="fields=other">
            <label for="cw-field-other-text"
              >Other creative field <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="cw-field-other-text"
              name="fields_other"
              type="text"
              required
              maxlength={LIMITS.line}
            />
            <p class="field-error" id="cw-field-other-err" hidden></p>
          </div>

          <div class="field" data-label="Why ODDfest">
            <label for="cw-why">Why would you like to make this part of ODDfest?</label>
            <textarea
              id="cw-why"
              name="motivation"
              rows="3"
              maxlength={LIMITS.long}
              aria-describedby="cw-why-hint"></textarea>
            <p class="field-hint" id="cw-why-hint">
              Maybe you want to reach another audience, meet another scene, try something new, find
              collaborators, or simply bring something you care about into the shared week. One or
              two sentences is enough.
            </p>
            <p class="field-error" id="cw-why-err" hidden></p>
          </div>
        </section>

        <!-- 02 Making it happen (section 3) ------------------------------------ -->
        <section class="cw-step" data-step="2" aria-labelledby="cw-step-2" hidden>
          <h2 class="cw-step-head" id="cw-step-2" tabindex="-1">
            <span class="cw-step-num" aria-hidden="true">{num(1)}</span>
            <span>{STEPS[1]}</span>
          </h2>
          <p class="cw-key">
            What’s already in place, and what’s still open? A rough picture is enough. You don’t
            need every answer yet.
          </p>

          <fieldset class="field" data-label="Where the idea is">
            <legend
              >Where is the idea right now? <span class="req" aria-hidden="true">*</span></legend
            >
            <div class="cw-options">
              {
                READINESS.map((o, i) => (
                  <label class="check" for={`cw-ready-${o.value}`}>
                    <input
                      id={`cw-ready-${o.value}`}
                      type="radio"
                      name="readiness"
                      value={o.value}
                      required={i === 0}
                    />
                    <span class="cw-option-text">{o.label}</span>
                  </label>
                ))
              }
            </div>
            <p class="field-error" id="cw-ready-err" hidden></p>
          </fieldset>
          <div
            class="field"
            data-label="Where the idea is (other)"
            data-show-when="readiness=other"
          >
            <label for="cw-ready-other-text"
              >Tell us where it is <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="cw-ready-other-text"
              name="readiness_other"
              type="text"
              required
              maxlength={LIMITS.line}
            />
            <p class="field-error" id="cw-ready-other-err" hidden></p>
          </div>

          <div class="field" data-label="Who is involved">
            <label for="cw-involved">Who is already involved in the event?</label>
            <input id="cw-involved" name="involved" type="text" maxlength={LIMITS.line} />
            <p class="field-error" id="cw-involved-err" hidden></p>
          </div>

          <div class="field" data-label="What is still needed">
            <label for="cw-needed"
              >What’s still needed to make this event happen? <span class="req" aria-hidden="true"
                >*</span
              ></label
            >
            <input
              id="cw-needed"
              name="still_needed"
              type="text"
              required
              maxlength={LIMITS.line}
            />
            <p class="field-error" id="cw-needed-err" hidden></p>
          </div>
        </section>

        <!-- 03 Where and when (section 5; the Google Form has no section 4) ---- -->
        <section class="cw-step" data-step="3" aria-labelledby="cw-step-3" hidden>
          <h2 class="cw-step-head" id="cw-step-3" tabindex="-1">
            <span class="cw-step-num" aria-hidden="true">{num(2)}</span>
            <span>{STEPS[2]}</span>
          </h2>
          <p class="cw-key">
            Where could it happen, and what timing might work? Share what you know so far. A
            confirmed venue isn’t needed to submit.
          </p>

          <fieldset class="field" data-label="Venue or location">
            <legend
              >Do you have a venue or location? <span class="req" aria-hidden="true">*</span
              ></legend
            >
            <p class="field-hint">
              For an outdoor or mobile event, choose the first or second option if the location or
              route is already agreed or being discussed.
            </p>
            <div class="cw-options">
              {
                VENUE_STATUS.map((o, i) => (
                  <label class="check" for={`cw-venue-${o.value}`}>
                    <input
                      id={`cw-venue-${o.value}`}
                      type="radio"
                      name="venue_status"
                      value={o.value}
                      required={i === 0}
                    />
                    <span class="cw-option-text">{o.label}</span>
                  </label>
                ))
              }
            </div>
            <p class="field-error" id="cw-venue-err" hidden></p>
          </fieldset>
          <div
            class="field"
            data-label="Venue, location or route"
            data-show-when={`venue_status=${VENUE_NAMED.join('|')}`}
          >
            <label for="cw-venue-name"
              >Venue, location or route <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="cw-venue-name"
              name="venue"
              type="text"
              required
              maxlength={LIMITS.line}
              aria-describedby="cw-venue-name-hint"
            />
            <p class="field-hint" id="cw-venue-name-hint">
              Name the place and neighbourhood, or the route. A place you have in mind is fine: it
              does not count as confirmed.
            </p>
            <p class="field-error" id="cw-venue-name-err" hidden></p>
          </div>
          <div
            class="field"
            data-label="Space needed"
            data-show-when={`venue_status=${VENUE_OPEN.join('|')}`}
          >
            <label for="cw-space"
              >What kind of space do you need? <span class="req" aria-hidden="true">*</span></label
            >
            <textarea
              id="cw-space"
              name="space_needs"
              rows="3"
              required
              maxlength={LIMITS.long}
              aria-describedby="cw-space-hint"></textarea>
            <p class="field-hint" id="cw-space-hint">
              Approximate size, indoor or outdoor, audience capacity and any essential technical
              needs. Only the essentials; no technical rider needed.
            </p>
            <p class="field-error" id="cw-space-err" hidden></p>
          </div>

          <fieldset class="field" data-label="Timing">
            <legend
              >How flexible is your timing during ODDfest week? <span class="req" aria-hidden="true"
                >*</span
              ></legend
            >
            <p class="field-hint">
              Exact 2027 festival dates will be confirmed separately. Answer based on your current
              flexibility.
            </p>
            <ChoiceChips name="timing_flexibility" options={TIMING} required idPrefix="cw-timing" />
            <p class="field-error" id="cw-timing-err" hidden></p>
          </fieldset>

          <div class="field" data-label="Timing constraints">
            <label for="cw-timing-notes">Any timing constraints or rough duration?</label>
            <input
              id="cw-timing-notes"
              name="timing_notes"
              type="text"
              maxlength={LIMITS.line}
              aria-describedby="cw-timing-notes-hint"
            />
            <p class="field-hint" id="cw-timing-notes-hint">
              For example: one evening, a two-hour workshop, a weekend, an exhibition already
              running, or a date you cannot move. Leave blank if flexible.
            </p>
            <p class="field-error" id="cw-timing-notes-err" hidden></p>
          </div>
        </section>

        <!-- 04 Audience and access (section 6) --------------------------------- -->
        <section class="cw-step" data-step="4" aria-labelledby="cw-step-4" hidden>
          <h2 class="cw-step-head" id="cw-step-4" tabindex="-1">
            <span class="cw-step-num" aria-hidden="true">{num(3)}</span>
            <span>{STEPS[3]}</span>
          </h2>
          <p class="cw-key">
            Who do you want to bring together, and how could they take part? Rough estimates are
            fine for now.
          </p>

          <fieldset class="field" data-label="Audience">
            <legend>Who is the event for? <span class="req" aria-hidden="true">*</span></legend>
            <p class="field-hint">Select all that apply.</p>
            <ChoiceChips
              name="audiences"
              options={AUDIENCES}
              type="checkbox"
              idPrefix="cw-audience"
            />
            <p class="field-error" id="cw-audience-err" hidden></p>
          </fieldset>
          <div class="field" data-label="Other audience" data-show-when="audiences=other">
            <label for="cw-audience-other-text"
              >Other audience <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="cw-audience-other-text"
              name="audiences_other"
              type="text"
              required
              maxlength={LIMITS.line}
            />
            <p class="field-error" id="cw-audience-other-err" hidden></p>
          </div>

          <fieldset class="field" data-label="Access">
            <legend
              >How do you expect people to access it? <span class="req" aria-hidden="true">*</span
              ></legend
            >
            <ChoiceChips name="access" options={ACCESS} required idPrefix="cw-access" />
            <p class="field-error" id="cw-access-err" hidden></p>
          </fieldset>

          <div class="field" data-label="Number of people">
            <label for="cw-capacity"
              >Roughly how many people could take part? <span class="req" aria-hidden="true">*</span
              ></label
            >
            <input
              id="cw-capacity"
              name="capacity"
              type="text"
              required
              maxlength={LIMITS.line}
              aria-describedby="cw-capacity-hint"
            />
            <p class="field-hint" id="cw-capacity-hint">
              For a performance or workshop, think per session. For a drop-in exhibition or
              installation, think total visitors during ODDfest week. A rough estimate is enough.
            </p>
            <p class="field-error" id="cw-capacity-err" hidden></p>
          </div>
        </section>

        <!-- 05 What you need (section 7) --------------------------------------- -->
        <section class="cw-step" data-step="5" aria-labelledby="cw-step-5" hidden>
          <h2 class="cw-step-head" id="cw-step-5" tabindex="-1">
            <span class="cw-step-num" aria-hidden="true">{num(4)}</span>
            <span>{STEPS[4]}</span>
          </h2>
          <p class="cw-key">
            What connections could help your idea happen? Tell us what you’re looking for and what
            you already have. We’ll see where we may be able to help.
          </p>

          <fieldset class="field" data-label="Help from ODDfest">
            <legend
              >What help would be useful from ODDfest? <span class="req" aria-hidden="true">*</span
              ></legend
            >
            <p class="field-hint">Select all that apply.</p>
            <div class="cw-options">
              {
                HELP.map((o) => (
                  <label class="check" for={`cw-help-${o.value}`}>
                    <input id={`cw-help-${o.value}`} type="checkbox" name="help" value={o.value} />
                    <span class="cw-option-text">{o.label}</span>
                  </label>
                ))
              }
            </div>
            <p class="field-error" id="cw-help-err" hidden></p>
          </fieldset>
          <div class="field" data-label="Other help" data-show-when="help=other">
            <label for="cw-help-other-text"
              >Other help <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="cw-help-other-text"
              name="help_other"
              type="text"
              required
              maxlength={LIMITS.line}
            />
            <p class="field-error" id="cw-help-other-err" hidden></p>
          </div>

          <div class="field" data-label="What you need">
            <label for="cw-help-details"
              >Tell us more about what you need <span class="req" aria-hidden="true">*</span></label
            >
            <textarea
              id="cw-help-details"
              name="help_details"
              rows="3"
              required
              maxlength={LIMITS.long}
              aria-describedby="cw-help-details-hint"></textarea>
            <p class="field-hint" id="cw-help-details-hint">
              Only add anything we haven’t already covered. If something is essential for the event
              to happen, tell us.
            </p>
            <p class="field-error" id="cw-help-details-err" hidden></p>
          </div>

          <fieldset class="field" data-label="Resources">
            <legend
              >How will the event be resourced or financed? <span class="req" aria-hidden="true"
                >*</span
              ></legend
            >
            <p class="field-hint">
              No detailed budget needed at this stage. Organisers remain responsible for financing
              their events. ODDfest does not automatically provide production funding, artist fees
              or travel costs.
            </p>
            <div class="cw-options">
              {
                FINANCING.map((o, i) => (
                  <label class="check" for={`cw-money-${o.value}`}>
                    <input
                      id={`cw-money-${o.value}`}
                      type="radio"
                      name="financing"
                      value={o.value}
                      required={i === 0}
                    />
                    <span class="cw-option-text">{o.label}</span>
                  </label>
                ))
              }
            </div>
            <p class="field-error" id="cw-money-err" hidden></p>
          </fieldset>
        </section>

        <!-- 06 About you (sections 1, 8 and 9) ---------------------------------- -->
        <section class="cw-step" data-step="6" aria-labelledby="cw-step-6" hidden>
          <h2 class="cw-step-head" id="cw-step-6" tabindex="-1">
            <span class="cw-step-num" aria-hidden="true">{num(5)}</span>
            <span>{STEPS[5]}</span>
          </h2>
          <p class="cw-key">
            Who’s behind the idea? Tell us a little about yourself or your crew, and how we can
            reach you.
          </p>

          <div class="field" data-label="Full name">
            <label for="cw-name">Full name <span class="req" aria-hidden="true">*</span></label>
            <input
              id="cw-name"
              name="full_name"
              type="text"
              required
              maxlength={LIMITS.short}
              autocomplete="name"
            />
            <p class="field-error" id="cw-name-err" hidden></p>
          </div>
          <div class="field-row">
            <div class="field" data-label="Email">
              <label for="cw-email">Email <span class="req" aria-hidden="true">*</span></label>
              <input
                id="cw-email"
                name="email"
                type="email"
                required
                maxlength={LIMITS.short}
                autocomplete="email"
                spellcheck="false"
              />
              <p class="field-error" id="cw-email-err" hidden></p>
            </div>
            <div class="field" data-label="Phone">
              <label for="cw-phone"
                >Phone number <span class="req" aria-hidden="true">*</span></label
              >
              <input
                id="cw-phone"
                name="phone"
                type="tel"
                required
                maxlength={LIMITS.phone}
                autocomplete="tel"
              />
              <p class="field-error" id="cw-phone-err" hidden></p>
            </div>
          </div>
          <div class="field" data-label="Organisation, collective or project">
            <label for="cw-org"
              >Organisation, collective or project name <span class="req" aria-hidden="true">*</span
              ></label
            >
            <input
              id="cw-org"
              name="org_name"
              type="text"
              required
              maxlength={LIMITS.short}
              autocomplete="organization"
              aria-describedby="cw-org-hint"
            />
            <p class="field-hint" id="cw-org-hint">Applying as yourself is welcome too.</p>
            <p class="field-error" id="cw-org-err" hidden></p>
          </div>
          <div class="field" data-label="Website, Instagram or portfolio">
            <label for="cw-web"
              >Website, Instagram or portfolio <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="cw-web"
              name="website"
              type="text"
              required
              maxlength={LIMITS.line}
              autocomplete="url"
              spellcheck="false"
              aria-describedby="cw-web-hint"
            />
            <p class="field-hint" id="cw-web-hint">A link or handle is enough.</p>
            <p class="field-error" id="cw-web-err" hidden></p>
          </div>

          <fieldset class="field" data-label="Which describes you">
            <legend>Which describes you best? <span class="req" aria-hidden="true">*</span></legend>
            <ChoiceChips
              name="applicant_type"
              options={APPLICANT_TYPES}
              required
              idPrefix="cw-applicant"
            />
            <p class="field-error" id="cw-applicant-err" hidden></p>
          </fieldset>
          <div
            class="field"
            data-label="Which describes you (other)"
            data-show-when="applicant_type=other"
          >
            <label for="cw-applicant-other-text"
              >Tell us what describes you <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="cw-applicant-other-text"
              name="applicant_type_other"
              type="text"
              required
              maxlength={LIMITS.line}
            />
            <p class="field-error" id="cw-applicant-other-err" hidden></p>
          </div>

          <div class="field" data-label="Links">
            <label for="cw-links"
              >Links that help us understand the idea or the people behind it</label
            >
            <textarea
              id="cw-links"
              name="links"
              rows="3"
              maxlength={LIMITS.long}
              spellcheck="false"
              aria-describedby="cw-links-hint"></textarea>
            <p class="field-hint" id="cw-links-hint">
              Portfolio, previous events, Instagram, video, references. One or two links is enough;
              no polished materials needed. Skip anything you’ve already shared.
            </p>
            <p class="field-error" id="cw-links-err" hidden></p>
          </div>

          <div class="field" data-label="Anything else">
            <label for="cw-notes">Anything else you’d like us to know?</label>
            <textarea id="cw-notes" name="notes" rows="3" maxlength={LIMITS.long}></textarea>
            <p class="field-error" id="cw-notes-err" hidden></p>
          </div>

          <fieldset class="field" data-label="How you heard about ODDfest">
            <legend>How did you hear about ODDfest?</legend>
            <ChoiceChips name="referral" options={REFERRAL} idPrefix="cw-referral" />
            <p class="field-error" id="cw-referral-err" hidden></p>
          </fieldset>
          <div class="field" data-label="How you heard (other)" data-show-when="referral=other">
            <label for="cw-referral-other-text"
              >Where did you hear about it? <span class="req" aria-hidden="true">*</span></label
            >
            <input
              id="cw-referral-other-text"
              name="referral_other"
              type="text"
              required
              maxlength={LIMITS.line}
            />
            <p class="field-error" id="cw-referral-other-err" hidden></p>
          </div>
        </section>

        <!-- Check and send ---------------------------------------------------- -->
        <section class="cw-step" data-step="review" aria-labelledby="cw-step-review" hidden>
          <h2 class="cw-step-head" id="cw-step-review" tabindex="-1">
            <span>Check and send</span>
          </h2>
          <p class="cw-key">This is what we will read. Anything can still be changed.</p>
          <div class="cw-review" id="cw-review"></div>

          <div class="field" data-label="Programme selection">
            <label class="check">
              <input type="checkbox" name="ack_selection" value="true" required />
              <span>
                I understand that submitting an idea does not guarantee inclusion in the ODDfest
                programme. <span class="req" aria-hidden="true">*</span>
              </span>
            </label>
            <p class="field-error" id="cw-ack-selection-err" hidden></p>
          </div>
          <div class="field" data-label="Organiser responsibility">
            <label class="check">
              <input type="checkbox" name="ack_responsibility" value="true" required />
              <span>
                I understand that, if the event goes ahead, the organiser remains responsible for
                its production and financing, including any necessary permissions. ODDfest does not
                guarantee funding, artist fees, a venue or production support. <span
                  class="req"
                  aria-hidden="true">*</span
                >
              </span>
            </label>
            <p class="field-error" id="cw-ack-responsibility-err" hidden></p>
          </div>
          <div class="field" data-label="Privacy consent">
            <label class="check">
              <input
                type="checkbox"
                name="consent_privacy"
                value="true"
                required
                aria-describedby="cw-consent-hint"
              />
              <span>
                I agree that New Nordic Way rf stores these details to review my idea, contact me
                about it and coordinate a possible place in ODDfest 2027, as the{' '}
                <a href="/privacy/" target="_blank" rel="noopener">privacy notice</a> describes.{
                  ' '
                }
                <span class="req" aria-hidden="true">*</span>
              </span>
            </label>
            <p class="field-hint" id="cw-consent-hint">
              This form does not publish your idea as an event listing. Please avoid including other
              people’s private contact details.
            </p>
            <p class="field-error" id="cw-consent-err" hidden></p>
          </div>
        </section>
      </div>

      <footer class="cw-foot">
        <p class="form-status" role="status" aria-live="polite"></p>
        <div class="cw-foot-actions">
          <button type="button" class="cw-back" hidden>Back</button>
          <Pill type="submit" variant="solid" class="cw-next">Next</Pill>
        </div>
      </footer>
    </form>

    <!-- After sending: one message per answer the Worker can give
         (creative-week-schema.ts readOutcome). Only the one that applies is
         shown, so "queued" and "emailed" never borrow each other's words. -->
    <div class="cw-done" id="cw-done" tabindex="-1" hidden>
      <div data-done="delivered" hidden>
        <h2>Got it. Your idea is in.</h2>
        <p>
          It is with the ODDfest team now. If it looks like a fit, we will be in touch at{' '}
          <strong data-done-email></strong> to take it further.
        </p>
      </div>
      <div data-done="queued" hidden>
        <h2>Got it. Your idea is saved.</h2>
        <p>
          It is taking a little longer than usual to reach the ODDfest team, and it will get there
          on its own. There is nothing more you need to do. If it looks like a fit, we will be in
          touch at <strong data-done-email></strong>.
        </p>
      </div>
      <div data-done="emailed" hidden>
        <h2>Got it. Your idea reached us by email.</h2>
        <p>
          Our usual system was not available, so your answers went to the ODDfest team by email
          instead. There is nothing more you need to do. If it looks like a fit, we will be in touch
          at <strong data-done-email></strong>.
        </p>
      </div>
      <p class="cw-ref">Reference <span data-done-ref></span></p>
      <Pill type="button" variant="outline" class="cw-done-close">Close</Pill>
    </div>

    <p class="sr-only" id="cw-announce" role="alert"></p>
  </dialog>

  <!-- Keeps the ask in reach while no other way into the form is on screen.
       Hidden while the dialog is open, while the cookie banner is up, and
       once an idea has been sent. -->
  <div class="cw-sticky" id="cw-sticky">
    <p class="cw-sticky-text">We are collecting ideas for ODDfest 2027 now.</p>
    <Pill type="button" variant="solid" class="cw-sticky-cta">Submit an event idea</Pill>
  </div>
</div>

<script src="../../scripts/creative-week-form.ts"></script>

