---
// Shared logo-strip pattern — same marquee CSS as Aftermovie.astro's ODD
// sub-brand strip, generalized for any named logo list. Used for both
// "Partners" (Home) and "Featured in" (Home + Media) — see
// site/global.json's partners/featuredIn, the single shared source for both.
import type { ImageMetadata } from 'astro';

interface LogoItem {
  name: string;
  logo: ImageMetadata;
}
interface Props {
  eyebrow: string;
  title: string;
  items: LogoItem[];
}
const { eyebrow, title, items } = Astro.props;
const track = [...items, ...items];
---

<section class="logo-marquee-section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
    </div>
  </div>
  <div class="logo-marquee" aria-hidden="true">
    <div class="logo-marquee-track">
      {track.map((item) => <img src={item.logo.src} alt={item.name} loading="lazy" />)}
    </div>
  </div>
  <p class="sr-only">
    {items.map((item) => item.name).join(', ')}
  </p>
</section>

<style>
  .logo-marquee-section {
    border-top: 1px solid var(--color-paper-12);
    padding: var(--space-20) 0 var(--space-16);
  }
  .logo-marquee-section .section-head {
    margin-bottom: var(--space-10);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .logo-marquee {
    overflow: hidden;
    width: 100%;
    padding: 0.25rem 0;
  }
  .logo-marquee-track {
    display: flex;
    align-items: center;
    gap: 4.5rem;
    width: max-content;
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo-marquee-track {
      animation: marquee-left 22s linear infinite;
    }
  }
  .logo-marquee-track img {
    height: 34px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    display: block;
    opacity: 0.65;
    flex-shrink: 0;
    /* Source logos arrive in whatever color/contrast their own brand uses —
       brightness(0) invert(1) normalizes any of them (dark wordmark, colored
       mark, whatever) into a single clean paper-colored silhouette, the only
       treatment that reads reliably against --color-ink for an arbitrary,
       uncurated logo set. */
    filter: brightness(0) invert(1);
    transition: opacity var(--duration-fast) ease;
  }
  .logo-marquee-track img:hover {
    opacity: 1;
  }
</style>
