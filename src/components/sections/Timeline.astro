---
// About page's Story/Timeline — editable milestone rows. No invented dates:
// see about.json for the explicit placeholder years/titles.
interface Milestone {
  year: string;
  title: string;
  body: string;
}
interface Props {
  items: Milestone[];
}
const { items } = Astro.props;
---

<div class="timeline reveal">
  {
    items.map((m) => (
      <div class="timeline-row">
        <span class="timeline-year">{m.year}</span>
        <div class="timeline-body">
          <h3>{m.title}</h3>
          <p>{m.body}</p>
        </div>
      </div>
    ))
  }
</div>

<style>
  .timeline {
    max-width: 46rem;
    margin: 0 auto;
  }
  .timeline-row {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.5rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--color-paper-12);
  }
  .timeline:last-child .timeline-row:last-child,
  .timeline-row:last-child {
    border-bottom: 1px solid var(--color-paper-12);
  }
  .timeline-year {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.3rem;
    color: var(--color-paper);
    font-variant-numeric: tabular-nums;
  }
  .timeline-body h3 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-paper);
    margin: 0;
  }
  .timeline-body p {
    margin: 0.5rem 0 0;
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--color-paper-60);
  }
  @media (max-width: 600px) {
    .timeline-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .timeline .timeline-row {
      opacity: 0;
      transform: translateY(10px);
      transition:
        opacity 0.5s ease,
        transform 0.5s ease;
    }
    :global(html.reveal-js) .timeline.in .timeline-row {
      opacity: 1;
      transform: none;
    }
  }
</style>
