---
// The mobile expression of SubpageRail's identity framing.
//
// Added 2026-09-02 (mobile experience pass). The two fixed vertical rails
// (SubpageRail.astro) are one of the strongest things about a subpage on
// desktop — a slow ticker of the page's own name and metadata running down
// both edges — and they `display: none` below 821px, because 68px of fixed
// furniture on each side of a 360px screen is not a trade worth making. That
// left every product subpage on a phone with no framing at all: the hero
// ended and generic body content began.
//
// This is the same idea rotated into the axis a phone actually has to spare.
// One slim horizontal band directly under the hero, running the identical
// `railLeft`/`railRight` beats the vertical rails are built from (so there is
// no second content model and nothing new for an editor to fill in), sized to
// cost ~40px of vertical space once.
//
// Deliberately one band, not two: the desktop version has a left and a right
// rail because it has two edges to use. A phone has one place this belongs,
// and a second competing ticker would read as clutter rather than identity.
import { getImage } from 'astro:assets';
import { logoFor, LOGO_ASSET_WIDTH, type SubpageSlug } from './subpage-logo';

interface RailItem {
  kind: 'logo' | 'word' | 'meta';
  text?: string;
}
interface Props {
  items: RailItem[];
  slug: SubpageSlug;
}
const { items, slug } = Astro.props;

// Same geometry contract as SubpageRail: the inter-beat space lives on each
// item's `padding-inline-end` rather than the flex container's `gap`, so N
// items contribute exactly N spaces and the track is exactly `reps` identical
// periods long. The track then travels translateX(-100%/reps) — one period, to
// the pixel, at any content length and any viewport.
//
// The previous version rendered 6 copies but reused the shared `marquee-left`
// keyframe, which is hard-coded to travel -33.3333% (2 of those 6 copies).
// With the space on `gap` that undershoots a true period by gap/3 = 12.8px, so
// the band jumped 12.8px every cycle.
const BEAT_GAP = 38;
const LOGO_THICK = 16;
// Same masked-silhouette treatment as SubpageRail — see the long note in its
// styles. The short version: both wordmarks bake in a paper-coloured fill, and
// ODDspace/ODDstudio render under body.theme-light with that palette inverted,
// so a mask painted with --color-paper is the only treatment that is correct
// on both themes and on the RGBA PNG as well as the two SVGs.
const wordmark = logoFor(slug);
const logoLength = Math.round(LOGO_THICK * (wordmark.width / wordmark.height));
// Through astro:assets rather than referencing the import's raw .src, per
// CLAUDE.md — getImage() is the CSS-side equivalent of <Image>. It passes the
// two SVG wordmarks through untouched and emits a correctly-sized asset for
// ODDference's PNG, which is 1080px wide at source and renders at 130.
const logoAsset = await getImage({ src: wordmark, width: LOGO_ASSET_WIDTH });
// Measured px-per-character for the two type styles below (re-measured
// 2026-09-13 at 10.55 and 10.07 once both moved onto the typography ladder,
// then rounded up about 5% — the margin the original figures carried).
// Estimate only — it sizes `reps` and the duration, never the seam.
const PX_PER_WORD_CHAR = 11.2;
const PX_PER_META_CHAR = 10.6;
const beatLength = (item: RailItem) =>
  item.kind === 'logo'
    ? logoLength
    : (item.text?.length ?? 0) * (item.kind === 'word' ? PX_PER_WORD_CHAR : PX_PER_META_CHAR);
const period = items.reduce((sum, item) => sum + BEAT_GAP + beatLength(item), 0) || 1;

// Wide enough that (reps-1) periods still span the widest screen this band
// renders on (the 820px breakpoint). Same one-directional safety margin on the
// estimate as SubpageRail — it may only ever over-render, never under-render.
const OVERFILL_PX = 2000;
const SAFETY = 0.6;
const reps = Math.min(16, Math.max(4, Math.ceil(OVERFILL_PX / (period * SAFETY)) + 2));
const track = Array.from({ length: reps }, () => items).flat();

// px per second — slower than the rails, because a horizontal band at eye
// level reads faster than a vertical one at the edge of the screen.
const TICKER_SPEED = 15;
// Not rounded, for the same reason as SubpageRail's — see the note there.
const duration = (period / TICKER_SPEED).toFixed(2);
---

<div class="oddf-ticker" aria-hidden="true">
  <div
    class="oddf-ticker-track"
    style={`--reps:${reps};--ticker-duration:${duration}s;--beat-gap:${BEAT_GAP}px;--logo-thick:${LOGO_THICK}px;--logo-length:${logoLength}px;--logo-src:url('${logoAsset.src}')`}
  >
    {
      track.map((item) => (
        <span class="oddf-ticker-item">
          {item.kind === 'logo' && <span class="oddf-ticker-logo" />}
          {item.kind === 'word' && <span class="oddf-ticker-word">{item.text}</span>}
          {item.kind === 'meta' && <span class="oddf-ticker-meta">{item.text}</span>}
        </span>
      ))
    }
  </div>
</div>

<style>
  /* Above the tablet cutoff the real vertical rails are visible (SubpageRail
     hides itself at exactly this width), so this must not also be on screen —
     they are two renderings of one idea, never both at once. */
  .oddf-ticker {
    display: none;
  }
  @media (max-width: 820px) {
    .oddf-ticker {
      display: block;
      overflow: hidden;
      border-top: 1px solid var(--color-paper-12);
      border-bottom: 1px solid var(--color-paper-12);
      background: var(--color-bg);
      padding: 0.7rem 0;
      /* Full-bleed inside SubpageFrame's padded column, so the band meets
         both screen edges the way the vertical rails meet theirs. Uses the
         same `.bleed` geometry as layout.css rather than a new technique. */
      width: 100vw;
      margin-left: calc(50% - 50vw);
      /* Beats enter and leave through a fade rather than being cut off at the
         screen edge — the horizontal twin of the rails' end mask. */
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 32px,
        #000 calc(100% - 32px),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 32px,
        #000 calc(100% - 32px),
        transparent 100%
      );
    }
  }
  .oddf-ticker-track {
    display: flex;
    align-items: center;
    /* No `gap` — the space is on each item, so N items give exactly N spaces
       and the track is exactly `--reps` periods wide. See the frontmatter. */
    width: max-content;
  }
  @media (prefers-reduced-motion: no-preference) {
    .oddf-ticker-track {
      animation: ticker-left var(--ticker-duration, 38s) linear infinite;
    }
  }
  /* Exactly one period, whatever the beats are. */
  @keyframes ticker-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% / var(--reps)));
    }
  }
  /* Reduced motion keeps the band and its content, static — the beats are
     still legible, they just don't travel. Nothing here is information that
     exists only while it moves. */
  .oddf-ticker-item {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    /* Fed from the frontmatter's BEAT_GAP, so the period estimated there and
       the spacing rendered here can never drift apart. */
    padding-inline-end: var(--beat-gap, 38px);
  }
  .oddf-ticker-logo {
    display: block;
    width: var(--logo-length);
    height: var(--logo-thick, 20px);
    flex-shrink: 0;
    background: var(--color-paper);
    opacity: 0.88;
    -webkit-mask: var(--logo-src) center / contain no-repeat;
    mask: var(--logo-src) center / contain no-repeat;
  }
  /* Forta at the Body size, the same setting as SubpageRail's word beat —
     the two are one idea on two axes. */
  .oddf-ticker-word {
    font-family: var(--font-display);
    font-size: var(--font-size-body);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-paper);
    white-space: nowrap;
  }
  .oddf-ticker-meta {
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-40);
    white-space: nowrap;
  }
</style>
