---
// A full-bleed editorial photo interlude — real ODD archive photography
// used as pure breathing room between text-heavy sections on the now much
// longer V2 subpages. Deliberately no caption/text overlay: the site's
// design is minimal specifically so a real photo can be the whole moment,
// not a graphic with copy on it. See docs/architecture.md#v2.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  // Optional — About's closing section (2026 launch photo) uses this
  // component before a real, verified image has been chosen. Same "plain
  // surface, no placeholder image" convention as ProgramGrid's
  // `four-card-bg--empty`, never a guessed/random photo. `alt` is required
  // together with `image` (both present, or both absent).
  image?: ImageMetadata;
  alt?: string;
  tall?: boolean;
}
const { image, alt, tall = false } = Astro.props;
---

<div class={`photo-break bleed reveal ${tall ? 'is-tall' : ''}`}>
  {
    image ? (
      // width 2200, not the site's usual ~900-1600 — .bleed escapes the
      // normal ~1280px content width to span the full viewport, so on any
      // genuinely wide monitor this was being upscaled from a source
      // narrower than its own render width (visible softness, not a
      // hypothetical).
      //
      // `widths` + `sizes` added 2026-09-21, and 2200 deliberately KEPT as
      // the top step so nothing gets softer on a wide monitor. Until then
      // this was a single 2200px file with no srcset, on all ten pages that
      // use this component — so a phone downloaded a 2200px image to fill a
      // 390px band. /about's was the largest served asset on the site at
      // 441KB. `sizes="100vw"` is exact rather than approximate here,
      // because .bleed really is the full viewport width.
      <Image
        src={image}
        alt={alt ?? ''}
        width={2200}
        widths={[640, 1024, 1440, 1920, 2200]}
        sizes="100vw"
      />
    ) : (
      <div class="photo-break-empty" />
    )
  }
</div>

<style>
  .photo-break {
    position: relative;
    overflow: hidden;
    height: min(52vh, 480px);
    /* An edge, not a padded section: it contributes half of each
       neighbouring section gap as margin (layout.css, section rhythm). The
       token is fluid, so the phone breakpoint below only changes height. */
    margin-block: calc(var(--space-section) / 2);
  }
  .photo-break.is-tall {
    height: min(74vh, 640px);
  }
  .photo-break :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.15) brightness(0.9);
  }
  .photo-break-empty {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(ellipse 70% 70% at 30% 20%, rgb(226 223 222 / 6%) 0%, transparent 60%),
      var(--color-backstage);
  }
  @media (max-width: 700px) {
    .photo-break {
      height: min(40vh, 360px);
    }
  }
</style>
