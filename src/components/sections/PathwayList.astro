---
// Work with ODD's "Ways to work with us" — four entry points, scannable in
// a few seconds. Deliberately not ProgramGrid (which the homepage's "What
// we do" section also uses — redesigning it in place would regress that
// section too): compact rows, not four near-full-viewport cards. The
// number/stage pair reads as a rough light→deep progression (see
// content.config.ts's `pathwayCard` comment) without implying any card is
// gated behind the one before it — every row links out on its own.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Card {
  number: string;
  stage: string;
  meta: string;
  title: string;
  body: string;
  goLabel: string;
  href: string;
  image?: ImageMetadata;
}
interface Props {
  title: string;
  cards: Card[];
}
const { title, cards } = Astro.props;
---

<section class="pathway-list">
  <div class="wrap flow">
    <div class="section-head"><h2>{title}</h2></div>
    <div class="pathway-rows reveal">
      {
        cards.map((card) => (
          <a class="pathway-row" href={card.href}>
            <div class="pathway-row-number">
              <span class="pathway-number">{card.number}</span>
              <span class="pathway-stage">{card.stage}</span>
            </div>
            <div class="pathway-row-media">
              {card.image ? (
                <Image class="pathway-row-img" src={card.image} alt="" width={480} />
              ) : (
                <div class="pathway-row-img pathway-row-img--empty" />
              )}
            </div>
            <div class="pathway-row-body">
              <span class="pathway-meta">{card.meta}</span>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <span class="pathway-go">{card.goLabel}</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pathway-rows {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-paper-12);
  }
  .pathway-row {
    display: grid;
    grid-template-columns: 6rem 7rem 1fr;
    gap: 2rem;
    align-items: center;
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--color-paper-12);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--duration-fast) ease;
  }
  @media (hover: hover) {
    .pathway-row:hover {
      background: color-mix(in srgb, var(--color-backstage) 60%, transparent);
    }
  }
  .pathway-row-number {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .pathway-number {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper-40);
  }
  .pathway-stage {
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-paper-60);
  }
  .pathway-row-media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .pathway-row :global(.pathway-row-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.15);
    transition: transform var(--duration-base) ease;
  }
  @media (hover: hover) {
    .pathway-row:hover :global(.pathway-row-img) {
      transform: scale(1.05);
    }
  }
  .pathway-row-img--empty {
    background: var(--color-paper-12);
  }
  .pathway-meta {
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-paper-40);
  }
  .pathway-row-body h3 {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    margin: var(--space-3) 0 0;
  }
  .pathway-row-body p {
    font: var(--text-body);
    color: var(--color-paper-60);
    margin: var(--space-3) 0 0;
    max-width: 46ch;
  }
  .pathway-go {
    display: inline-block;
    width: fit-content;
    margin-top: var(--space-5);
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-paper);
    border-bottom: 1px solid var(--color-paper-40);
    padding-bottom: 0.15rem;
    transition: border-color var(--duration-fast) ease;
  }
  @media (hover: hover) {
    .pathway-row:hover .pathway-go {
      border-color: var(--color-paper);
    }
  }
  /* Touch press state. `(hover: hover)` above keeps the pointer-only
     enhancements off touchscreens, where iOS leaves :hover stuck on the
     last-tapped element; this is what replaces them — an immediate, physical
     acknowledgement at the moment of the tap. The tap-highlight reset is
     paired with it deliberately: the platform's grey flash is only removed
     because there is a real state taking its place. */
  @media (hover: none) {
    .pathway-row {
      -webkit-tap-highlight-color: transparent;
      transition: background 0.12s ease;
    }
    .pathway-row:active {
      background: color-mix(in srgb, var(--color-backstage) 75%, transparent);
    }
    .pathway-row:active .pathway-go {
      border-color: var(--color-paper);
    }
  }

  @media (max-width: 700px) {
    .pathway-row {
      /* 6rem, the desktop number column's width, not the old 4rem: the stage
         label under the number ("Stay involved") is Small-role capitals and
         needs ~90px for its longest word. Fixed rather than auto, so every
         row's thumbnail keeps the same 7rem size. */
      grid-template-columns: 6rem 1fr;
      grid-template-areas:
        'number media'
        'body body';
      row-gap: var(--space-4);
    }
    .pathway-row-number {
      grid-area: number;
    }
    .pathway-row-media {
      grid-area: media;
      max-width: 7rem;
      margin-left: auto;
    }
    .pathway-row-body {
      grid-area: body;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .pathway-rows .pathway-row {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.5s ease,
        transform 0.5s ease;
    }
    :global(html.reveal-js) .pathway-rows.in .pathway-row {
      opacity: 1;
      transform: none;
    }
    .pathway-rows.in .pathway-row:nth-child(1) {
      transition-delay: 0s;
    }
    .pathway-rows.in .pathway-row:nth-child(2) {
      transition-delay: 0.08s;
    }
    .pathway-rows.in .pathway-row:nth-child(3) {
      transition-delay: 0.16s;
    }
    .pathway-rows.in .pathway-row:nth-child(4) {
      transition-delay: 0.24s;
    }
  }
</style>
