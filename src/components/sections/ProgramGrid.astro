---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Card {
  meta: string;
  title: string;
  body: string;
  goLabel: string;
  href: string;
  // Optional — this grid isn't fixed to exactly four equal photo cards
  // anymore (see docs/architecture.md#v2); a card with no photo yet gets a
  // plain backstage-colored surface instead of forcing a placeholder image.
  image?: ImageMetadata;
}
interface Props {
  title: string;
  cards: Card[];
}
const { title, cards } = Astro.props;
---

<section id="four">
  <div class="wrap">
    <div class="section-head"><h2>{title}</h2></div>
  </div>
  <div class="four-grid bleed reveal" style={`--cols: ${cards.length}`}>
    {
      cards.map((card) => (
        <a
          class="four-card"
          href={card.href}
          target={card.href.startsWith('http') ? '_blank' : undefined}
          rel={card.href.startsWith('http') ? 'noreferrer' : undefined}
        >
          {card.image ? (
            // width 1300, not 900 — .four-grid is full-bleed and each card is
            // half that width on desktop (up to ~1280px on a wide monitor),
            // which was upscaling the 900px source.
            <Image class="four-card-bg" src={card.image} alt="" width={1300} />
          ) : (
            <div class="four-card-bg four-card-bg--empty" />
          )}
          <div class="four-card-scrim" />
          <div class="four-card-body">
            <div class="meta">{card.meta}</div>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            <span class="go">{card.goLabel}</span>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  /* Equal destinations in one row on desktop/wide tablet (2026-08-31
     homepage revision, narrowed to the three primary ODD programmes only —
     2026-08-31 final implementation pass) — was a 2x2 grid of near-square,
     viewport-height-driven cards; a fixed aspect-ratio per tier (instead of
     min-height: Nvh) is what keeps narrow columns from turning into
     awkwardly tall slivers on a short laptop screen or a tall external
     monitor, while still reading as "one deliberate row" rather than cropped
     photo strips. --cols (set inline from the real card count, same pattern
     as ParticipateBand/ProofGrid) rather than a hardcoded repeat(4, 1fr) —
     this grid no longer always renders exactly four cards.  */
  .four-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 2px;
    background: var(--color-paper-12);
  }
  .four-card {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    text-decoration: none;
    color: var(--color-paper);
  }
  /* One row survives down to 1024px (Nav.astro's own "tablet" cutoff,
     where the header already collapses to its mobile menu) — a real iPad
     landscape viewport, confirmed legible at exactly that width via a
     scrolled Playwright screenshot, not assumed. Only below that does a
     four-across row get too narrow to read comfortably. */
  @media (max-width: 1023px) {
    .four-grid {
      grid-template-columns: 1fr 1fr;
    }
    .four-card {
      aspect-ratio: 4 / 5;
    }
    .four-card-body {
      padding: 1.75rem;
    }
  }
  @media (max-width: 760px) {
    .four-grid {
      grid-template-columns: 1fr;
    }
    .four-card {
      aspect-ratio: 4 / 3;
    }
    .four-card-body {
      padding: 2.2rem;
    }
  }
  .four-card :global(.four-card-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.78) contrast(1.08) saturate(1.25);
    transition:
      transform 0.6s ease,
      filter var(--duration-base) ease;
  }
  .four-card:hover :global(.four-card-bg) {
    transform: scale(1.06);
    filter: brightness(0.92) contrast(1.08) saturate(1.35);
  }
  .four-card-bg--empty {
    background:
      radial-gradient(ellipse 70% 70% at 30% 20%, rgb(226 223 222 / 6%) 0%, transparent 60%),
      var(--color-backstage);
  }
  .four-card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 92%) 0%,
      rgb(0 0 0 / 32%) 52%,
      rgb(0 0 0 / 5%) 100%
    );
  }
  .four-card-body {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.2rem;
  }
  .four-card-body .meta {
    font: var(--text-caption);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-paper-60);
  }
  .four-card-body h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    line-height: 1.05;
    margin: 0.5rem 0 0;
    color: var(--color-paper);
  }
  .four-card-body p {
    font-family: var(--font-body);
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--color-paper-80);
    max-width: 32ch;
    margin: 0.8rem 0 0;
  }
  .four-card-body .go {
    display: inline-block;
    width: fit-content;
    margin-top: 1.1rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-paper);
    border-bottom: 1px solid var(--color-paper-40);
    padding-bottom: 0.15rem;
    transition: border-color var(--duration-fast) ease;
  }
  .four-card:hover .four-card-body .go {
    border-color: var(--color-paper);
  }

  @media (prefers-reduced-motion: no-preference) {
    .four-grid .four-card {
      opacity: 0;
      transform: translateY(18px);
      transition:
        opacity var(--duration-slow) ease,
        transform var(--duration-slow) ease;
    }
    .four-grid.in .four-card {
      opacity: 1;
      transform: none;
    }
    .four-grid.in .four-card:nth-child(1) {
      transition-delay: 0s;
    }
    .four-grid.in .four-card:nth-child(2) {
      transition-delay: 0.09s;
    }
    .four-grid.in .four-card:nth-child(3) {
      transition-delay: 0.18s;
    }
    .four-grid.in .four-card:nth-child(4) {
      transition-delay: 0.27s;
    }
  }
</style>
