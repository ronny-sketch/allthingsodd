---
// BuiltAround — Home's "Why ODD" (2026-09-14 redesign; replaces
// SectionIntro + FloatingCloud there).
//
// The section draws its own headline. The hero directly above is a full
// mosaic of ODD's archive; this repeats that grid — the same hairline gaps
// and sharp cells — with everything taken out of it except one photograph.
// The photo is the talent. The empty cells around it are labelled with what
// the body says has to be found again after every project: the money, the
// partners, the place to work, the reason to gather. "What's missing is what
// gets built around it" is something a visitor sees before they read it.
//
// What it replaced: eleven small rotated thumbnails in a crescent around a
// centred warping headline. The photos were too small to read as anything,
// the tilt was the only rotated imagery on the site, and the arc said nothing
// about the argument — decoration around the words rather than part of them.
// The warp went for the same reason: this headline has to be taken in at a
// glance. The living type stays on the headings that still carry it.
//
// The grid is aria-hidden. Every word in it is already in the body, and the
// photo is atmosphere (alt=""), so a screen reader gets the headline and the
// paragraphs in order with nothing said twice.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Pill from '../primitives/Pill.astro';

interface LinkCta {
  label: string;
  href: string;
}
interface Props {
  eyebrow: string;
  // Split at its first sentence end into the premise (set quieter) and the
  // point (full paper). A one-sentence headline renders whole, as the point.
  headline: string;
  // Blank lines become paragraphs — the same convention as SectionIntro.
  body: string;
  // Up to four labels for the cells around the photo, read left to right and
  // top to bottom. Fewer leaves the remaining cells empty, which is still the
  // picture.
  pieces?: string[];
  image: ImageMetadata;
  // The first renders solid, any others outline — the pair Home used here
  // before.
  ctas?: LinkCta[];
}
const { eyebrow, headline, body, pieces = [], image, ctas = [] } = Astro.props;

const split = headline.match(/^(.+?[.!?])\s+(\S.*)$/s);
const premise = split ? split[1] : null;
const point = split ? split[2] : headline;

const paragraphs = body
  .split(/\r?\n\s*\r?\n/)
  .map((part) => part.trim())
  .filter(Boolean);

// Reading order, not clockwise: 01 and 02 across the top, 03 and 04 below.
const PIECE_SLOTS = ['tl', 'tr', 'bl', 'br'] as const;
---

<section class="built-around">
  <div class="wrap ba-head reveal">
    <span class="eyebrow">{eyebrow}</span>
    <h2 class="ba-title">
      {
        premise && (
          <>
            <span class="ba-premise">{premise}</span>{' '}
          </>
        )
      }
      <span class="ba-point">{point}</span>
    </h2>
  </div>

  <div class="ba-grid reveal" aria-hidden="true">
    <div class="ba-cell ba-edge ba-edge-1"></div>
    <div class="ba-cell ba-edge ba-edge-2"></div>
    <div class="ba-cell ba-edge ba-edge-3"></div>
    <div class="ba-cell ba-edge ba-edge-4"></div>
    <div class="ba-cell ba-talent">
      <Image src={image} alt="" width={Math.min(image.width, 640)} />
    </div>
    {
      PIECE_SLOTS.map((slot, i) => (
        <div class={`ba-cell ba-piece ba-${slot}`} style={`--i:${i}`}>
          {pieces[i] && (
            <>
              <span class="ba-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="ba-label">{pieces[i]}</span>
            </>
          )}
        </div>
      ))
    }
  </div>

  <div class="wrap ba-body">
    <div class="ba-text reveal" style={`--cols:${Math.min(paragraphs.length, 2)}`}>
      {paragraphs.map((para) => <p>{para}</p>)}
    </div>
    {
      ctas.length > 0 && (
        <div class="ba-actions reveal">
          {ctas.map((cta, i) => (
            <Pill href={cta.href} variant={i === 0 ? 'solid' : 'outline'} magnetic>
              {cta.label}
            </Pill>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .ba-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  /* Brighter than the shared eyebrow default — kept from the version this
     replaced, which matched HeroCentered's eyebrow for the same reason: this
     is the page's second big statement, directly under the hero. */
  .ba-head .eyebrow {
    color: var(--color-paper-80);
  }
  /* Hero, not Display: the one place on Home where a sentence is the whole
     point of the section. Phones step to Display — see the media query at the
     end and docs/design-system.md's exceptions. */
  .ba-title {
    font: var(--text-hero);
    letter-spacing: var(--tracking-hero);
    color: var(--color-paper);
    margin: var(--space-5) 0 0;
  }
  .ba-premise,
  .ba-point {
    display: block;
  }
  /* The premise reads as given, the point as the claim. Large type, so
     --color-paper-40 (4.97:1 on ink) clears AA with room to spare. */
  .ba-premise {
    color: var(--color-paper-40);
  }

  /* The grid. Hairlines are the grid's own background showing through a 2px
     gap — the ProgramGrid treatment — and padding-block closes the top and
     bottom edges so the band reads as a cut of a larger grid. The mask fades
     the outer columns into the page, which is what says "this continues"
     rather than "this is a box". Capped so a very wide monitor doesn't turn
     each cell into a room. */
  .ba-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: 2px;
    padding-block: 2px;
    max-width: 100rem;
    margin: var(--space-16) auto 0;
    background: var(--color-paper-12);
    mask-image: linear-gradient(to right, transparent 0%, #000 16%, #000 84%, transparent 100%);
  }
  .ba-cell {
    position: relative;
    min-width: 0;
    aspect-ratio: 4 / 3;
    background: var(--color-bg);
  }
  .ba-edge-1 {
    grid-area: 1 / 1;
  }
  .ba-edge-2 {
    grid-area: 2 / 1;
  }
  .ba-edge-3 {
    grid-area: 1 / 5;
  }
  .ba-edge-4 {
    grid-area: 2 / 5;
  }
  .ba-tl {
    grid-area: 1 / 2;
  }
  .ba-tr {
    grid-area: 1 / 4;
  }
  .ba-bl {
    grid-area: 2 / 2;
  }
  .ba-br {
    grid-area: 2 / 4;
  }
  /* Spans both rows, so its height is the two cells beside it plus the gap —
     no aspect ratio of its own, or it would fight the rows for its size. */
  .ba-talent {
    grid-area: 1 / 3 / span 2 / 4;
    aspect-ratio: auto;
    overflow: hidden;
  }
  .ba-talent :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.15);
  }

  .ba-piece {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-5);
  }
  .ba-num {
    font: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    color: var(--color-paper-40);
  }
  .ba-label {
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper-80);
    text-wrap: balance;
  }

  .ba-body {
    margin-top: var(--space-16);
  }
  .ba-text {
    display: grid;
    grid-template-columns: repeat(var(--cols, 1), minmax(0, 1fr));
    gap: var(--space-8) var(--space-16);
    max-width: 62rem;
    margin: 0 auto;
  }
  .ba-text p {
    margin: 0;
    font: var(--text-body);
    color: var(--color-paper-80);
  }
  .ba-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: var(--space-12);
  }

  /* Below the laptop range the outer columns go and the three that carry the
     idea fill the width — at five columns a tablet's cells are too narrow for
     a label. Nothing left to fade, so no mask. */
  @media (max-width: 1023px) {
    .ba-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      mask-image: none;
    }
    .ba-edge {
      display: none;
    }
    .ba-tl {
      grid-area: 1 / 1;
    }
    .ba-tr {
      grid-area: 1 / 3;
    }
    .ba-bl {
      grid-area: 2 / 1;
    }
    .ba-br {
      grid-area: 2 / 3;
    }
    .ba-talent {
      grid-area: 1 / 2 / span 2 / 3;
    }
  }
  @media (max-width: 760px) {
    .ba-grid {
      margin-top: var(--space-10);
    }
    .ba-body {
      margin-top: var(--space-10);
    }
    .ba-text {
      grid-template-columns: minmax(0, 1fr);
    }
    .ba-actions {
      margin-top: var(--space-8);
    }
  }
  /* Phones: square cells give a three-line label the height it needs, and the
     label drops to Forta at the Body size — the documented reuse for compact,
     brand-voiced text. The headline steps from Hero to Display, as
     HeroCentered's does, because Hero's 3.25rem floor sets these two
     sentences as a column of one- and two-word lines. */
  @media (max-width: 560px) {
    /* .ba-piece, not .ba-cell: the photo's cell must keep `aspect-ratio:
       auto`, or it sizes itself square and leaves its second row empty. */
    .ba-piece {
      aspect-ratio: 1 / 1;
      padding: var(--space-3);
    }
    .ba-label {
      font-family: var(--font-display);
      font-size: var(--font-size-body);
      line-height: var(--line-height-heading);
    }
    .ba-title {
      font: var(--text-display);
      letter-spacing: var(--tracking-display);
    }
  }

  /* Entrance: the grid rises with the site's shared .reveal, then the photo
     settles and the labels arrive one by one around it — built around it.
     Hidden states are gated on html.reveal-js (see motion.css), so without
     the script everything is simply there. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .ba-talent :global(img) {
      transform: scale(1.12);
      transition: transform 1.6s var(--ease-out-expo);
    }
    :global(html.reveal-js) .ba-grid.in .ba-talent :global(img) {
      transform: none;
    }
    :global(html.reveal-js) .ba-piece > * {
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity var(--duration-slow) ease,
        transform var(--duration-slow) var(--ease-out-expo);
      transition-delay: calc(0.35s + var(--i) * 0.14s);
    }
    :global(html.reveal-js) .ba-grid.in .ba-piece > * {
      opacity: 1;
      transform: none;
    }
  }
</style>
