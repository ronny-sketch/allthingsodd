---
// Interactive live photo mosaic: 20 cells fly in and Ken-Burns pan, then quietly
// self-swap on a randomized loop from a curated ODD-archive photo pool, with a
// cursor-driven 3D tilt + spotlight. All timing/randomization lives in
// src/scripts/mosaic.ts and src/scripts/hero-tilt.ts — this component only lays
// out the optimized images and hands the pool URLs to the client script.
//
// Pool (2026-09-24): exactly the 73 photos Ronny picked from the 2025 and
// 2026 Flickr archives, and nothing else — src/assets/mosaic/NN-<flickr id>.jpg.
// This replaced the earlier 46 (src/assets/hero + src/assets/news), which
// other pages still use directly, so those folders are untouched.
//
// The NN prefix is a one-off shuffle, so the glob's alphabetical order is
// already a random mix of years and events; the first 20 are the cells a
// visitor sees first (the two near-black stage shots were kept out of them).
// Each visit then rotates the rest in its own random order — see mosaic.ts.
// Where each photo is cropped is in mosaic-focus.ts.
import { mosaicImage, MOSAIC_SIZES } from './mosaic-images';
import { MOSAIC_FOCUS } from './mosaic-focus';
import Logo from '../primitives/Logo.astro';

const mosaicModules = import.meta.glob<{ default: ImageMetadata }>('../../assets/mosaic/*.jpg', {
  eager: true,
});
const archive = Object.entries(mosaicModules).map(([path, m]) => ({
  src: m.default,
  position: MOSAIC_FOCUS[path.match(/(\d+)\.jpg$/)?.[1] ?? ''] ?? '50% 50%',
}));

// The pool carries the SAME responsive set as the rendered cells, not a
// single 500px file (2026-09-21). It used to be
// `getImage({ src, width: 500 })`, and mosaic.ts set only `src` on the image
// it swaps in — so every ambient swap downloaded a 500px file into a cell
// that is ~273px wide on this viewport, forty-six of them, one every ~1.8s
// for as long as the page stays open.
//
// It also broke LCP, which is how it was found. LCP moves to any larger
// contentful paint until the first interaction, and a 500px file has a
// larger intrinsic size than the srcset candidate the initial cells actually
// render — so roughly four seconds in, the first swap became a new, larger
// LCP candidate. Measured: homepage LCP 4184ms, naming a different swapped
// photo on every run, which is the signature of the swap rather than of the
// first paint. Giving the swap the same srcset means it can never be larger
// than what was already painted, so LCP stays where the first paint put it.
const pool = await Promise.all(
  archive.map(async ({ src, position }) => ({ ...(await mosaicImage(src)), position })),
);
const cellImages = pool.slice(0, 20);

interface Props {
  mosaicAlt: string;
  // The page's real proposition line — rendered as the actual <h1>, directly
  // under the logo mark. Used to sit in its own light band below the hero
  // (OpeningLine.astro, since removed); moved back onto the hero itself at
  // Ronny's direct request, so it's optional here rather than assumed —
  // Hero is still usable text-free if a future caller wants that.
  headline?: string;
}
const { mosaicAlt, headline } = Astro.props;
---

<header class="hero">
  <div
    class="mosaic"
    id="heroMosaic"
    aria-hidden="true"
    data-pool={JSON.stringify(pool)}
    data-sizes={MOSAIC_SIZES}
  >
    {
      // All 20 cells are inside the viewport at load — this is the hero,
      // not below-the-fold content. `loading="lazy"` here was inherited
      // from the original single-file site, where these were inline base64
      // data URIs (part of the HTML itself, no separate request, so `lazy`
      // was inert either way). Now that they're real optimized files, lazy
      // was actually deferring the page's own LCP candidate — confirmed via
      // a real PerformanceObserver check, not assumed: the reported LCP
      // element was exactly one of these images, 4-7s in under throttled
      // mobile conditions. `eager` + `fetchpriority="high"` on the very
      // first cell (the one nearest top-left, first to matter for LCP).
      cellImages.map((img, i) => (
        <div class="mosaic-cell">
          <img
            src={img.src}
            srcset={img.srcset}
            sizes={MOSAIC_SIZES}
            width={img.width}
            height={img.height}
            style={`object-position: ${img.position}`}
            alt=""
            loading="eager"
            decoding="async"
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </div>
      ))
    }
  </div>
  <p class="sr-only">{mosaicAlt}</p>

  <div class="hero-spotlight" id="heroSpotlight" aria-hidden="true"></div>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-logo" id="heroLogo">
    <Logo ariaHidden />
    {headline && <h1 class="hero-headline">{headline}</h1>}
  </div>
</header>

<script src="../../scripts/mosaic.ts"></script>
<script src="../../scripts/hero-tilt.ts"></script>

<style>
  .hero {
    position: relative;
    /* Full-viewport again (was shrunk to 46dvh with the proposition line
       moved into its own light band below — that band's gone now, the line
       lives on the hero itself instead, so the hero is back to its
       original full-screen size). dvh accounts for mobile Safari's dynamic
       toolbar; 100vh is a fallback for browsers without dvh support (same
       value there anyway). */
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    background: var(--color-bg);
    perspective: 1400px;
    /* An edge, not a padded section: the hero contributes its half of the
       gap to the first section as margin (layout.css, section rhythm). */
    margin-block-end: calc(var(--space-section) / 2);
  }
  .mosaic {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 3px;
    transition: transform 0.4s ease;
  }
  /* The cells fly in. They do NOT fade in, and that is load-bearing.

     Chrome excludes an element painted at `opacity: 0` from being a Largest
     Contentful Paint candidate. With `opacity: 0` here, all twenty mosaic
     images were disqualified at first paint, so LCP fell through to the first
     photo mosaic.ts swaps in on its ambient timer — four seconds later. That
     swapped image paints at full opacity, so it is a candidate, and it is the
     one the metric ends up naming.

     This is HALF the cause, and fixing only this half changes nothing. All
     four combinations were measured on this machine, at 1366x900, against the
     built site:

       fade + 500px swap (as shipped) ..... 4184ms, a swapped photo
       no fade + 500px swap .............. 4280ms, a swapped photo
       fade + srcset swap ................ 4220ms, a swapped photo
       no fade + srcset swap ............. 152ms, cell 0's own image

     The other half is in Hero.astro's `pool` and mosaic.ts: the swapped-in
     image used to carry a single 500px `src` with no srcset, giving it a
     larger intrinsic size than the srcset candidate the initial cells render
     — and LCP moves to any LARGER contentful paint until the first
     interaction. So with the fade removed but the swap still oversized, LCP
     was still the swap. Both had to go.

     Everything this component already does to make the first paint fast —
     `loading="eager"` on all twenty, `fetchpriority="high"` on cell 0, and a
     real <link rel="preload" as="image"> with a full imagesrcset — was being
     spent and thrown away. The comment on the `loading` attribute below
     records an earlier round of this same diagnosis, where the reasoning was
     right and only one layer got fixed; this is the same trap.

     Dropping the fade keeps the motion (translate, rotate, scale) and costs
     the cross-fade only. It is also the exact end state reduced motion has
     always rendered, so the appearance is already part of the design system.
     Do not reintroduce an opacity ramp here; if the fade must come back, it
     has to come back on a wrapper that is not the image's own painted box —
     and `node scripts/measure-cwv.mjs` is how you find out whether it did. */
  .mosaic-cell {
    position: relative;
    overflow: hidden;
    background: var(--color-paper-06);
    transform: translate(var(--ex, 0), var(--ey, 0)) rotate(var(--er, 0deg)) scale(0.82);
    transition: filter 0.25s ease;
    filter: saturate(1.15) contrast(1.04);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mosaic-cell {
      animation: cell-fly 0.95s var(--ease-out-expo) both;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mosaic-cell {
      transform: none;
    }
  }
  @keyframes cell-fly {
    to {
      transform: none;
    }
  }
  .mosaic-cell::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: rgb(14 9 11 / 0%);
    transition: background 0.35s ease;
  }
  .mosaic:hover .mosaic-cell:not(:hover)::before {
    background: rgb(14 9 11 / 42%);
  }
  .mosaic-cell:hover::before {
    background: rgb(14 9 11 / 0%) !important;
  }
  .mosaic-cell:hover {
    filter: brightness(1.22) saturate(1.3);
  }
  /* :global(img), not a scoped `img`, and that is load-bearing (2026-09-24).
     Astro scopes these rules to img[data-astro-cid-…], which only the twenty
     server-rendered images carry. Every photo mosaic.ts swaps in is created
     in the browser without that attribute, so none of this applied to them:
     no cover fit, no crop point, no pan. Each one rendered at its intrinsic
     500x333 from the cell's top-left corner, so desktop showed a zoomed-in
     top-left corner of the photo and a portrait tablet a strip short of the
     cell. The `.mosaic-cell` half stays scoped, so this reaches no other
     image on the page. */
  .mosaic-cell :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: var(--kox, 50%) var(--koy, 50%);
    will-change: transform;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mosaic-cell :global(img) {
      animation: ken-burns var(--kd, 16s) ease-in-out infinite alternate;
    }
  }
  /* Set by mosaic.ts whenever the hero is scrolled out of view or the tab is
     hidden — see its own comment. Parks the twenty pan animations and drops
     the compositor-layer hint with them, so nothing is being painted for a
     hero nobody can see. */
  .mosaic.mosaic-is-idle :global(img) {
    animation-play-state: paused;
    will-change: auto;
  }
  /* Pausing was not enough on its own. A paused animation keeps its element
     alive as a composited layer, so twenty offscreen mosaic cells were still
     being composited every frame for the whole time someone reads the rest
     of the homepage — the unattributed steady-state CPU cost PR #19 measured
     and could not place. `content-visibility: hidden` skips rendering the
     subtree outright, which is exactly what "nobody can see this" should
     mean. Measured at 390x844 / 4x CPU, hero scrolled offscreen, task time
     over a 6s window, median of 3: 639ms -> 309ms (-52%).
     The mosaic is `position: absolute; inset: 0`, so its box comes from the
     hero and cannot collapse without content; it is already aria-hidden, so
     nothing is being hidden from assistive tech that was not already; and an
     engine without support simply keeps the previous paused-only behaviour.
     Only ever applied while the hero is offscreen — see mosaic.ts's sync(). */
  .mosaic.mosaic-is-idle {
    content-visibility: hidden;
  }
  @keyframes ken-burns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.16) translate(var(--kx, 2%), var(--ky, 1%));
    }
  }
  @media (max-width: 820px) {
    .mosaic {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(7, 1fr);
    }
  }
  /* Landscape phone. The 3x7 portrait grid divides a ~375px-tall viewport
     into 7 rows of ~50px — bands too shallow to read as photographs at all,
     let alone as the archive mosaic this is. A short, wide viewport wants the
     short, wide grid: 5 columns of 4, the same shape desktop uses, which is
     what the cell count was laid out for in the first place. */
  @media (max-width: 820px) and (max-height: 520px) {
    .mosaic {
      grid-template-columns: repeat(5, 1fr);
      grid-template-rows: repeat(4, 1fr);
    }
  }

  .hero-spotlight {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 70% at 50% 50%, rgb(28 43 102 / 14%) 0%, rgb(14 9 11 / 66%) 100%),
      linear-gradient(
        to bottom,
        rgb(14 9 11 / 50%) 0%,
        rgb(14 9 11 / 8%) 30%,
        rgb(14 9 11 / 8%) 70%,
        rgb(14 9 11 / 64%) 100%
      );
  }
  .hero-logo {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    padding: 0 1.5rem;
    pointer-events: none;
  }
  .hero-logo :global(svg) {
    width: min(25rem, 46vw);
    height: auto;
    color: var(--color-paper);
    opacity: 1;
    filter: url(#steam-hero) drop-shadow(0 0 70px rgb(226 223 222 / 18%));
  }
  .hero-headline {
    margin: 0;
    max-width: 48ch;
    text-align: center;
    /* Heading, not Hero or Display — the logo mark directly above is already
       the dominant object in this frame, so the sentence under it reads as a
       companion line to the mark rather than competing with it for the same
       visual weight. */
    font: var(--text-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-paper);
    /* Two layers: a tight near-black pass for edge contrast against bright
       mosaic cells directly behind the glyphs, plus a soft wide falloff so
       the line still reads as sitting in the scene, not pasted on top of
       it — the hero-scrim gradient alone is quite light at dead-center
       (see .hero-scrim's radial-gradient), so this text can't lean on it. */
    text-shadow:
      0 1px 3px rgb(14 9 11 / 75%),
      0 8px 32px rgb(14 9 11 / 50%);
  }
  @media (prefers-reduced-motion: no-preference) {
    /* No entrance delay, and that is a performance decision, not a taste one.
       This <h1> is by far the largest contentful element on the homepage
       (~102,500px^2 against ~15,000px^2 for a mosaic cell), so it is the
       page's natural LCP element. Chrome evaluates a text element for LCP at
       the paint where its content first appears, and an element painted at
       opacity 0 is not a candidate — it is not reconsidered later. With the
       0.55s delay this used to carry, the headline was therefore disqualified
       outright, and LCP fell through to a 130px mosaic thumbnail, which the
       ambient self-swap in mosaic.ts then kept replacing with a marginally
       larger one for as long as the page stayed open. Measured result:
       LCP 4376ms -> 484ms at 390x844 / 4x CPU, median of 3, with the element
       moving from a swapped-in archive photo to this heading. That is also
       the honest number: the headline really is readable within half a
       second. Keep the delay at 0 — reintroducing one puts the metric back
       on a thumbnail with no visible change to the page.

       And no opacity ramp at all (2026-09-25). A 0s delay was not enough:
       with `opacity: 0` as the first keyframe the headline's first paint is
       still invisible, so Chrome never made it a candidate and LCP was a
       mosaic cell again — then the first ambient swap, 2.7s in, because the
       initial cells first paint mid-fly-in at scale(0.82) and a swapped-in
       photo paints at full size. It rises into place instead of fading.
       tests/functional/hero-performance.spec.ts pins LCP to this heading. */
    .hero-headline {
      animation: hero-headline-in 1.2s 0s var(--ease-out-expo) both;
    }
  }
  @keyframes hero-headline-in {
    from {
      transform: translateY(10px);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The mark used to lead the headline by 0.25s. With the headline moved
       to a 0s delay above, keeping the mark at 0.3s would have inverted that
       order on screen. Both now rise together from the first frame, which
       keeps the pair reading as one gesture. */
    .hero-logo :global(svg) {
      opacity: 0;
      animation:
        hero-logo-in 1.2s 0s var(--ease-out-expo) both,
        hero-float 10s ease-in-out infinite;
    }
  }
  @keyframes hero-logo-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-2%);
    }
  }
</style>
