---
// Interactive live photo mosaic: 20 cells fly in and Ken-Burns pan, then quietly
// self-swap on a randomized loop from a 40-photo Flickr-archive pool, with a
// cursor-driven 3D tilt + spotlight. All timing/randomization lives in
// src/scripts/mosaic.ts and src/scripts/hero-tilt.ts — this component only lays
// out the optimized images and hands the pool URLs to the client script.
import { getImage } from 'astro:assets';
import Logo from '../primitives/Logo.astro';

const archiveModules = import.meta.glob<{ default: ImageMetadata }>('../../assets/hero/*.jpg', {
  eager: true,
});
const archive = Object.values(archiveModules).map((m) => m.default);

const cellImages = await Promise.all(
  archive.slice(0, 20).map((src) => getImage({ src, width: 500, format: 'webp' })),
);
const poolImages = await Promise.all(
  archive.map((src) => getImage({ src, width: 500, format: 'webp' })),
);
const pool = poolImages.map((i) => i.src);

interface Props {
  mosaicAlt: string;
}
const { mosaicAlt } = Astro.props;
---

<header class="hero">
  <div class="mosaic" id="heroMosaic" aria-hidden="true" data-pool={JSON.stringify(pool)}>
    {
      cellImages.map((img) => (
        <div class="mosaic-cell">
          <img
            src={img.src}
            width={img.attributes.width}
            height={img.attributes.height}
            alt=""
            loading="lazy"
          />
        </div>
      ))
    }
  </div>
  <p class="sr-only">{mosaicAlt}</p>

  <div class="hero-spotlight" id="heroSpotlight" aria-hidden="true"></div>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-logo" id="heroLogo">
    <Logo ariaHidden />
  </div>
</header>

<script src="../../scripts/mosaic.ts"></script>
<script src="../../scripts/hero-tilt.ts"></script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: var(--color-bg);
    perspective: 1400px;
  }
  .mosaic {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 3px;
    transition: transform 0.4s ease;
  }
  .mosaic-cell {
    position: relative;
    overflow: hidden;
    background: var(--color-paper-06);
    cursor: none;
    opacity: 0;
    transform: translate(var(--ex, 0), var(--ey, 0)) rotate(var(--er, 0deg)) scale(0.82);
    transition: filter 0.25s ease;
    filter: saturate(1.15) contrast(1.04);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mosaic-cell {
      animation: cell-fly 0.95s var(--ease-out-expo) both;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mosaic-cell {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes cell-fly {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .mosaic-cell::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: rgb(0 0 0 / 0%);
    transition: background 0.35s ease;
  }
  .mosaic:hover .mosaic-cell:not(:hover)::before {
    background: rgb(0 0 0 / 42%);
  }
  .mosaic-cell:hover::before {
    background: rgb(0 0 0 / 0%) !important;
  }
  .mosaic-cell:hover {
    filter: brightness(1.22) saturate(1.3);
  }
  .mosaic-cell img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: var(--kox, 50%) var(--koy, 50%);
    will-change: transform;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mosaic-cell img {
      animation: ken-burns var(--kd, 16s) ease-in-out infinite alternate;
    }
  }
  @keyframes ken-burns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.16) translate(var(--kx, 2%), var(--ky, 1%));
    }
  }
  @media (max-width: 820px) {
    .mosaic {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(7, 1fr);
    }
  }

  .hero-spotlight {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 70% at 50% 50%, rgb(28 43 102 / 14%) 0%, rgb(14 9 11 / 66%) 100%),
      linear-gradient(
        to bottom,
        rgb(14 9 11 / 50%) 0%,
        rgb(14 9 11 / 8%) 30%,
        rgb(14 9 11 / 8%) 70%,
        rgb(14 9 11 / 64%) 100%
      );
  }
  .hero-logo {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .hero-logo :global(svg) {
    width: min(400px, 46vw);
    height: auto;
    color: var(--color-paper);
    opacity: 1;
    filter: url(#steam-hero) drop-shadow(0 0 70px rgb(226 223 222 / 18%));
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-logo :global(svg) {
      opacity: 0;
      animation:
        hero-logo-in 1.2s 0.3s var(--ease-out-expo) both,
        hero-float 10s ease-in-out infinite;
    }
  }
  @keyframes hero-logo-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-2%);
    }
  }
</style>
