---
// Brand book chapters 15-20: sub-brands, applications, decks, downloads,
// do/don't, tokens. The download links and the deck previews are resolved
// from brand/ at build time, so this page ships whatever the brand folder
// actually contains.
import { Image } from 'astro:assets';
import Chapter from './Chapter.astro';
import Pill from '../primitives/Pill.astro';
import tokens from '../../../brand/tokens/brand-tokens.json';

import oddfestMark from '../../../brand/logos/svg/oddfest-paper.svg';
import oddferenceMark from '../../../brand/logos/svg/oddference-paper.svg';
import oddspaceInk from '../../../brand/logos/svg/oddspace-ink.svg';
import markPaper from '../../../brand/logos/svg/odd-mark-paper.svg';
import markInk from '../../../brand/logos/svg/odd-mark-ink.svg';

import poster from '../../assets/oddfest-2026/blue-light-performer.jpg';
import social from '../../assets/oddspace/opening-audience-close.jpg';

// Files, straight out of brand/. `?url` keeps them as downloadable assets.
const logoFiles = import.meta.glob('../../../brand/logos/svg/*.svg', {
  query: '?url&no-inline',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const logoPngs = import.meta.glob('../../../brand/logos/png/*.png', {
  query: '?url&no-inline',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const fontFiles = import.meta.glob('../../../brand/fonts/*.ttf', {
  query: '?url&no-inline',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const deckFiles = import.meta.glob('../../../brand/deck/*.pptx', {
  query: '?url&no-inline',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const cssBundle = import.meta.glob('../../../brand/tokens/odd.css', {
  query: '?url&no-inline',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const tokenFile = import.meta.glob('../../../brand/tokens/brand-tokens.json', {
  query: '?url&no-inline',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const deckSheets = import.meta.glob<{ default: ImageMetadata }>(
  '../../../brand/deck/previews/*.jpg',
  {
    eager: true,
  },
);

const base = (path: string) => path.split('/').pop() ?? path;
const fileGroups = [
  {
    title: 'Logos',
    note: 'The mark, every product lockup, and the app icon. Paper artwork for Ink grounds, Ink artwork for Paper. Generated by brand/logos/build.py.',
    files: { ...logoFiles, ...logoPngs },
  },
  {
    title: 'Typefaces',
    note: 'Forta and Gabarito, SIL Open Font Licence 1.1. Install these before opening a deck.',
    files: fontFiles,
  },
  {
    title: 'Decks',
    note: 'The 16:9 master template and the example deck, both editable PowerPoint.',
    files: deckFiles,
  },
  {
    title: 'Tokens',
    note: 'Every colour, type role, space, radius and duration as machine-readable JSON, and the same system as one stylesheet for anything built outside this repository — tokens, the type ladder, .wrap/.flow/.section-head/.eyebrow, the base rules and the Pill.',
    files: { ...tokenFile, ...cssBundle },
  },
];

const products = [
  {
    name: 'ODDfest',
    ground: 'Ink',
    accent: 'Ember, plus the Ultraviolet wash',
    hero: 'Film, with the lockup over it',
    rails: 'ODDFEST · HELSINKI · 2027',
    subject: 'Nights, stages, crowds, the week itself',
  },
  {
    name: 'ODDference',
    ground: 'Ink',
    accent: 'Signal',
    hero: 'Film of the room, with the lockup over it',
    rails: 'ODDFERENCE · HELSINKI · 2027',
    subject: 'Speakers, audiences, the stage in daylight',
  },
  {
    name: 'ODDspace',
    ground: 'Paper — the page inverts',
    accent: 'None; the inversion is the accent',
    hero: 'A mosaic of the rooms',
    rails: 'ODDSPACE · VALLILA · YEAR-ROUND',
    subject: 'Desks, lunches, talks, the building',
  },
  {
    name: 'ODDstudio',
    ground: 'Paper',
    accent: 'None',
    hero: 'A photograph of the room',
    rails: 'ODDSTUDIO · VALLILA',
    subject: 'Instruments, monitors, the desk',
  },
  {
    name: 'Work with ODD / ODDagency',
    ground: 'Ink',
    accent: 'Signal, sparingly',
    hero: 'One photograph, centred title',
    rails: '—',
    subject: 'Projects, partners, work in progress',
  },
];

const doDont = [
  [
    'Set a headline as one sentence in Forta, ending in a full stop.',
    'Stack fragments into a slogan, or type it in capitals.',
  ],
  [
    'Put an accent where it is light: a label, a keyline, a wash, a hover.',
    'Fill a section, a card or a button with Ember or Signal.',
  ],
  [
    'Show a real photograph from the archive, credited.',
    'Reach for stock, a render, or a generated crowd.',
  ],
  ['Separate things with a 1px hairline.', 'Draw a box, a shadow or a rounded card around them.'],
  ['Use the pill shape for buttons, tags and badges.', 'Round a photograph, a card or a section.'],
  [
    'Let the parent own the space between blocks.',
    'Add a margin to a component, then claw it back with a negative one.',
  ],
  ['Number a structure: 01, 02, 03.', 'Add icons to make a list look designed.'],
  [
    'Put the creative side first when both are shown.',
    'Open with the business case on a creative page.',
  ],
  [
    'Generate a new lockup with the script.',
    'Draw a new logo, or set a product name in another face.',
  ],
  [
    'Write what is actually true, including what is undecided.',
    'Publish a figure the site cannot stand behind.',
  ],
];
---

<Chapter
  id="sub-brands"
  num="15"
  title="Sub-brands"
  premise="Same system."
  statement="Different light, different room."
>
  <div class="bb-prose">
    <p>
      A product page changes four things and nothing else: its ground, its one accent, its hero, and
      the words in its rails. Everything below the hero — type, spacing, cards, buttons, photography
      — is identical across the family, which is what lets a visitor land on any of them and know
      they are in the same organisation.
    </p>
  </div>

  <div class="bb-table-wrap">
    <table class="bb-table">
      <thead
        ><tr
          ><th>Product</th><th>Ground</th><th>Accent</th><th>Hero</th><th>Rails</th><th
            >Photographs</th
          ></tr
        ></thead
      >
      <tbody>
        {
          products.map((p) => (
            <tr>
              <td>{p.name}</td>
              <td>{p.ground}</td>
              <td>{p.accent}</td>
              <td>{p.hero}</td>
              <td>{p.rails}</td>
              <td>{p.subject}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="bb-row">
    <figure class="bb-figure">
      <div class="bb-stage bb-stage--ink bb-stage--center" style="gap: var(--space-4);">
        <Image
          src={oddfestMark}
          alt=""
          width={300}
          style="width: min(100%, 15rem); height: auto;"
        />
        <p class="t-heading" style="margin: 0;">
          Helsinki’s creative week, bringing cultural and creative scenes together.
        </p>
        <p class="t-eyebrow">Helsinki · 2027</p>
      </div>
      <figcaption>ODDfest — Ink, Ember, film.</figcaption>
    </figure>
    <figure class="bb-figure">
      <div class="bb-stage bb-stage--ink bb-stage--center" style="gap: var(--space-4);">
        <Image
          src={oddferenceMark}
          alt=""
          width={300}
          style="width: min(100%, 16rem); height: auto;"
        />
        <p class="t-heading" style="margin: 0;">
          Where creative expertise meets business and society.
        </p>
        <p class="t-eyebrow" style="color: var(--color-signal-bright);">For business</p>
      </div>
      <figcaption>ODDference — Ink, Signal, the same frame.</figcaption>
    </figure>
    <figure class="bb-figure">
      <div class="bb-stage bb-stage--paper bb-stage--center" style="gap: var(--space-4);">
        <Image
          src={oddspaceInk}
          alt=""
          width={300}
          style="width: min(100%, 15rem); height: auto;"
        />
        <p class="t-heading" style="margin: 0;">A year-round home for creative work.</p>
        <p class="t-eyebrow" style="color: rgb(14 9 11 / 62%);">Vallila · Helsinki</p>
      </div>
      <figcaption>ODDspace — the whole page inverts to Paper. Nothing else changes.</figcaption>
    </figure>
  </div>
</Chapter>

<Chapter
  id="applications"
  num="16"
  title="Applications"
  premise="The system leaves the screen."
  statement="A poster, a post, an invitation, a wall."
>
  <div class="bb-prose">
    <p>
      In print and in physical space the ladder scales as a whole — set the smallest step first,
      then keep every ratio. Nothing else changes: Ink or Paper, one hairline, one statement, the
      archive, and the mark with its clear space.
    </p>
  </div>

  <div class="bb-apps">
    <figure class="bb-figure span-4">
      <div class="bb-poster">
        <div class="bb-poster-photo">
          <Image
            src={poster}
            alt=""
            width={800}
            widths={[400, 800]}
            sizes="(max-width: 820px) 100vw, 30vw"
          />
        </div>
        <Image src={oddfestMark} alt="" width={400} class="bb-poster-lockup" />
        <p class="bb-poster-title">One week. Many hosts.</p>
        <div class="bb-poster-foot">
          <span>Helsinki · June 2027</span><span>allthingsodd.co</span>
        </div>
      </div>
      <figcaption>
        Poster, A-series. Photograph above, statement below, the lockup signing the top.
      </figcaption>
    </figure>

    <figure class="bb-figure span-4">
      <div class="bb-social">
        <div class="bb-social-photo">
          <Image
            src={social}
            alt=""
            width={800}
            widths={[400, 800]}
            sizes="(max-width: 820px) 100vw, 25vw"
          />
        </div>
        <div class="bb-social-body">
          <p>Creative work needs more than moments.</p>
          <span>ODDspace · Vallila</span>
        </div>
      </div>
      <figcaption>
        Instagram, 4:5. The inversion carries the caption; the photograph never has type on it.
      </figcaption>
    </figure>

    <figure class="bb-figure span-4">
      <div class="bb-invite">
        <Image src={markInk} alt="" width={200} />
        <p><span>You are invited.</span> ODDference 2027.</p>
        <dl>
          <dt>Date</dt><dt>Place</dt><dt>Doors</dt>
          <dd>To be announced</dd><dd>Helsinki</dd><dd>09:00</dd>
        </dl>
      </div>
      <figcaption>
        Invitation, 7:5. Premise quiet, point full; facts in a three-column list.
      </figcaption>
    </figure>

    <figure class="bb-figure span-12">
      <div class="bb-sign">
        <div class="bb-sign-head">
          <Image src={markPaper} alt="" width={200} />
          <span>Teollisuuskatu 9D</span>
        </div>
        <div>Auditorio<span>Floor 2</span></div>
        <div>Galleria<span>Floor 1</span></div>
        <div>ODDstudio<span>Floor 1</span></div>
      </div>
      <figcaption>
        Wayfinding. Forta names the room, Gabarito says where it is, a hairline between each. The
        same rules as a list on a page.
      </figcaption>
    </figure>
  </div>

  <h3 class="bb-h3">When the thing is not announced yet</h3>
  <dl class="bb-spec">
    <dt>The ask</dt>
    <dd>
      No form and no route yet? The ask is <code>hello@oddfest.co</code>, with a label that says
      what happens: “Ask us about ODDcity.” Never a button that goes nowhere, never “Coming soon”.
    </dd>
    <dt>The photograph</dt>
    <dd>
      If it has not happened, there is no photograph of it. Borrow a real archive photograph of
      something adjacent and credit it honestly, or leave the cells empty with their hairlines
      showing and say in the caption that they are empty on purpose.
    </dd>
    <dt>The copy</dt>
    <dd>Say what is undecided, plainly, in the same voice as everything else.</dd>
  </dl>

  <h3 class="bb-h3">Rules that travel</h3>
  <dl class="bb-spec">
    <dt>Print type</dt>
    <dd>
      Set Small first (9–11pt on A3–A2), then scale the whole ladder by the same ratios. Never
      enlarge one step alone.
    </dd>
    <dt>Margins</dt>
    <dd>
      A poster’s margin is the mark’s clear space, at poster scale: half the mark’s height, on every
      side.
    </dd>
    <dt>Print colour</dt>
    <dd>Ink and Paper are the only grounds. No grain in print — it is a screen texture.</dd>
    <dt>Social</dt>
    <dd>
      4:5 for feed, 9:16 for stories. Type never sits on the photograph unless a scrim is under it;
      the caption block carries it instead.
    </dd>
    <dt>Physical</dt>
    <dd>
      Signage is Forta at whatever size the room needs, with Gabarito for the practical half. One
      hairline per division.
    </dd>
    <dt>Email and documents</dt>
    <dd>
      Arial stands in for Gabarito where the font cannot be installed. Forta has no substitute: set
      the statement as an image or leave it out.
    </dd>
  </dl>
</Chapter>

<Chapter
  id="decks"
  num="17"
  title="Pitch decks"
  premise="The proof that this is a system."
  statement="Not a website that happens to look nice."
>
  <div class="bb-prose">
    <p>
      The deck system is the same identity at 13.333 × 7.5 inches: Ink ground, Paper for daylight
      moments, five type sizes in points, a 12-column grid with a 0.625in margin, hairline cells,
      archive photography, and pills only where something is a call to action. It is generated from
      the same tokens as this page, so a slide cannot drift from the site.
    </p>
  </div>

  {
    Object.entries(deckSheets).map(([path, mod]) => (
      <figure class="bb-deck">
        <Image
          src={mod.default}
          alt={`Contact sheet of ${base(path).replace('.jpg', '')}`}
          width={1600}
          widths={[800, 1600]}
          sizes="(max-width: 820px) 100vw, 70vw"
        />
        <figcaption class="t-small t-muted">{base(path).replace('.jpg', '')}</figcaption>
      </figure>
    ))
  }

  <dl class="bb-spec">
    <dt>Template</dt>
    <dd>
      21 archetypes — covers, statements, dividers, text and image, quotes, columns, figures,
      timeline, ecosystem, partners, people, programme, case study, two sides, closing, contact, and
      a blank frame. Speaker notes say when to use each.
    </dd>
    <dt>Example</dt>
    <dd>
      A 12-slide All Things ODD deck built only from real site content, to show the archetypes
      working together.
    </dd>
    <dt>Rebuild</dt>
    <dd>
      <code>cd brand/deck/src &amp;&amp; npm install &amp;&amp; npm run build</code>, then <code
        >npm run preview</code
      > for JPEG previews of every slide.
    </dd>
    <dt>Fonts</dt>
    <dd>
      Install <code>brand/fonts/*.ttf</code> before opening a deck, or PowerPoint will substitute Arial
      for Forta.
    </dd>
    <dt>Making a new deck</dt>
    <dd>
      Start from the template, delete what you do not need, and keep the archetypes intact. One
      statement a slide; a slide with two competing headlines is two slides.
    </dd>
  </dl>
</Chapter>

<Chapter id="downloads" num="18" title="Downloads" statement="One canonical file per thing.">
  <div class="bb-prose">
    <p>
      Everything here is generated from this repository, so there is never a second version of a
      logo floating around a shared drive. Need a lockup that does not exist yet? Add the name to
      <code>brand/logos/build.py</code> and run it.
    </p>
  </div>

  {
    fileGroups.map((group) => (
      <div>
        <h3 class="bb-h3">{group.title}</h3>
        <p class="bb-prose t-small">{group.note}</p>
        <ul class="bb-downloads">
          {Object.entries(group.files)
            .sort(([a], [b]) => a.localeCompare(b))
            .map(([path, url]) => (
              <li>
                <div>
                  <strong>{base(path)}</strong>
                </div>
                <div class="bb-links">
                  <a class="bb-link" href={url} download>
                    Download
                  </a>
                </div>
              </li>
            ))}
        </ul>
      </div>
    ))
  }

  <h3 class="bb-h3">In the repository</h3>
  <dl class="bb-spec">
    <dt>brand/BRAND-GUIDE.md</dt>
    <dd>
      The instruction manual: how to build a new page, campaign, sub-brand or deck so it comes out
      ODD. Written for a person or an AI agent.
    </dd>
    <dt>brand/AUDIT.md</dt>
    <dd>What the audit found, what was standardised, and what was deliberately left alone.</dd>
    <dt>brand/CHANGELOG.md</dt>
    <dd>Every change this system made to the site, and why.</dd>
    <dt>brand/logos/build.py</dt>
    <dd>The lockup generator. The only correct way to make a new one.</dd>
  </dl>
</Chapter>

<Chapter id="do-dont" num="19" title="Do / Don’t" statement="Ten decisions that keep it ODD.">
  <div class="bb-table-wrap">
    <table class="bb-table">
      <thead>
        <tr>
          <th><span class="bb-verdict">Do</span></th>
          <th><span class="bb-verdict bb-verdict--dont">Don’t</span></th>
        </tr>
      </thead>
      <tbody>
        {
          doDont.map(([yes, no]) => (
            <tr>
              <td style="white-space: normal;">{yes}</td>
              <td>{no}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="bb-prose">
    When a rule here and a live page disagree, the page wins and this line is a bug — but check the
    page against chapters 02 and 03 first. The system is allowed to change; it is not allowed to
    drift.
  </p>
</Chapter>

<Chapter
  id="tokens"
  num="20"
  title="Design tokens"
  premise="The book is documentation."
  statement="The tokens are the system."
>
  <div class="bb-prose">
    <p>
      <code>src/styles/tokens.css</code> and <code>typography.css</code> are canonical for anything on
      the web. <code>brand/tokens/brand-tokens.json</code> mirrors them for everything that is not — decks,
      print, Figma, an agent writing a new page — and <code>npm run check:brand</code> fails the build
      if the two ever disagree. Every table in this chapter is rendered from that JSON.
    </p>
  </div>

  <h3 class="bb-h3">Using them</h3>
  <div class="bb-stage">
    <pre
      class="bb-code"><code>{`.card {
  background: var(--color-backstage);   /* raised surface  */
  border: 1px solid var(--color-paper-12); /* hairline     */
  padding: var(--space-6);
}
.card h3 {
  font: var(--text-heading);            /* one of five     */
  letter-spacing: var(--tracking-heading);
}
.card p {
  margin-block-start: var(--space-3);   /* title -> body   */
  color: var(--color-paper-60);
}
.card a:hover {
  color: var(--color-heat);             /* warms on touch  */
}`}</code></pre>
  </div>

  <h3 class="bb-h3">Every token</h3>
  <div class="bb-table-wrap">
    <table class="bb-table">
      <thead><tr><th>Group</th><th>Token</th><th>Value</th></tr></thead>
      <tbody>
        {
          Object.entries(tokens.color.primitive).map(([, t]) => (
            <tr>
              <>
                <td>Colour</td>
                <td>
                  <code>{t.css}</code>
                </td>
                <td>{t.value}</td>
              </>
            </tr>
          ))
        }
        {
          Object.entries(tokens.color.opacityRamp.dark).map(([step, value]) => (
            <tr>
              <>
                <td>Ramp (Ink)</td>
                <td>
                  <code>--color-paper-{step}</code>
                </td>
                <td>{value}</td>
              </>
            </tr>
          ))
        }
        {
          Object.entries(tokens.color.opacityRamp.light).map(([step, value]) => (
            <tr>
              <>
                <td>Ramp (Paper)</td>
                <td>
                  <code>--color-ink-{step}</code>
                </td>
                <td>{value}</td>
              </>
            </tr>
          ))
        }
        {
          Object.entries(tokens.typography.roles).map(([, r]) => (
            <tr>
              <>
                <td>Type</td>
                <td>
                  <code>{r.css}</code>
                </td>
                <td>
                  {r.size} / {r.lineHeight} / {r.tracking}
                </td>
              </>
            </tr>
          ))
        }
        {
          Object.entries(tokens.spacing.scale).map(([step, value]) => (
            <tr>
              <>
                <td>Space</td>
                <td>
                  <code>--space-{step}</code>
                </td>
                <td>{value}</td>
              </>
            </tr>
          ))
        }
        {
          Object.entries(tokens.spacing.rhythm).map(([, r]) => (
            <tr>
              <>
                <td>Rhythm</td>
                <td>
                  <code>{r.css}</code>
                </td>
                <td>{r.value}</td>
              </>
            </tr>
          ))
        }
        {
          Object.entries(tokens.shape.radius).map(([, r]) => (
            <tr>
              <>
                <td>Radius</td>
                <td>
                  <code>{'css' in r ? r.css : '—'}</code>
                </td>
                <td>{r.value}</td>
              </>
            </tr>
          ))
        }
        {
          Object.entries(tokens.motion.duration).map(([, d]) => (
            <tr>
              <>
                <td>Motion</td>
                <td>
                  <code>{d.css}</code>
                </td>
                <td>{d.value}</td>
              </>
            </tr>
          ))
        }
        {
          Object.entries(tokens.motion.easing).map(([easing, e]) => (
            <tr>
              <>
                <td>Easing</td>
                <td>
                  <code>{'css' in e ? e.css : easing}</code>
                </td>
                <td>{e.value}</td>
              </>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="bb-row" style="margin-top: var(--space-group);">
    <Pill href="#index" variant="outline">Back to the index</Pill>
    <Pill
      href="https://github.com/ronny-sketch/allthingsodd/tree/main/brand"
      variant="outline"
      target="_blank"
    >
      The brand folder on GitHub
    </Pill>
  </div>
</Chapter>

<style>
  .bb-code {
    margin: 0;
    /* A grid item's min-width is auto, so without this the code block's
       min-content width pushes the page wider than the viewport instead of
       scrolling inside itself. */
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: var(--font-size-small);
    line-height: 1.6;
    color: var(--color-paper-80);
  }
</style>
