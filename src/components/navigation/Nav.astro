---
// Header hierarchy (2026-08-30 revision): the primary left-side nav is only
// ODD's real products (ODDfest/ODDference/ODDspace/Work with ODD) — "Info"
// (About/Media/Contact) moved to the right side, where a "Newsletter" pill
// used to sit, and renders as its own pill-styled dropdown trigger instead
// of a plain inline link. Newsletter no longer has any persistent nav UI —
// see Footer.astro (the only persistent newsletter UI left) and
// NewsletterPopup.astro (the timed exception). Any nav item with `children`
// is treated as the "Info"-style item, not a hardcoded label match, so this
// still works if `site/global.json`'s nav array ever reorders things.
import { getEntry } from 'astro:content';
import Logo from '../primitives/Logo.astro';
import Pill from '../primitives/Pill.astro';

const site = await getEntry('site', 'global');
if (!site) throw new Error('Missing site/global.json content entry');
const { nav } = site.data;
const path = Astro.url.pathname;
const primaryItems = nav.filter((item) => !item.children);
const infoItem = nav.find((item) => item.children);
---

<nav>
  <div class="nav-wrap nav-row">
    <div class="nav-left">
      <a href="/" class="mark" aria-label="ODD">
        <Logo />
      </a>
      <div class="nav-links">
        {
          primaryItems.map((item) => {
            const isActive = !item.external && path === item.href;
            return (
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noreferrer' : undefined}
                class={isActive ? 'is-active' : undefined}
              >
                {item.label}
              </a>
            );
          })
        }
      </div>
    </div>
    <div class="nav-buttons">
      {
        infoItem && (
          <div class="nav-dropdown nav-info" data-nav-info>
            <button
              type="button"
              class={`nav-info-trigger${
                path === infoItem.href || infoItem.children?.some((c) => path === c.href)
                  ? ' is-active'
                  : ''
              }`}
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="nav-info-menu"
              data-nav-info-trigger
            >
              {infoItem.label}
              <svg
                class="nav-info-chevron"
                viewBox="0 0 10 6"
                width="10"
                height="6"
                aria-hidden="true"
              >
                <path
                  d="M1 1l4 3.4L9 1"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                />
              </svg>
            </button>
            <div class="nav-dropdown-menu" id="nav-info-menu" data-nav-info-menu>
              <span class="nav-dropdown-label">{infoItem.label}</span>
              {infoItem.children?.map((child) => (
                <a
                  href={child.href}
                  target={child.external ? '_blank' : undefined}
                  rel={child.external ? 'noreferrer' : undefined}
                  class={path === child.href ? 'is-active' : undefined}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        )
      }
      <Pill type="button" variant="solid" ariaLabel="Menu" class="js-menu-toggle" id="menuToggle">
        <span id="menuToggleLabel">Menu</span>
      </Pill>
    </div>
  </div>
</nav>

<script src="../../scripts/nav-info-dropdown.ts"></script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-paper-12);
  }
  .nav-wrap {
    max-width: var(--width-wide);
    margin: 0 auto;
    padding: 0 var(--gutter-wide);
  }
  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.25rem;
    /* padding-top/bottom only, not the shorthand `padding: 0.9rem 0` this
       used to be — .nav-wrap and .nav-row are both classes on the SAME
       element, and the shorthand's implicit `padding-left/right: 0`
       silently overrode .nav-wrap's own `padding: 0 var(--gutter-wide)`
       (same specificity, later in source order wins), zeroing out the
       header's horizontal gutter on every page, at every width — confirmed
       via getBoundingClientRect showing the logo mark flush against x:0.
       Longhand here can't clobber a property .nav-wrap doesn't also set. */
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }
  .nav-left {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    min-width: 0;
  }
  .mark {
    color: var(--color-paper);
    display: flex;
    align-items: center;
    flex-shrink: 0;
    /* The mark renders at 1.35rem tall, which makes its clickable box ~22px
       — two pixels under WCAG 2.2 SC 2.5.8's 24x24 minimum, on the one
       control that appears on every page. The hit-slop pattern the mobile
       rule below already uses works just as well here: padding grows the
       invisible target, the matching negative margin keeps the mark itself
       rendering at exactly the same size and position. No visual change.
       (Mobile keeps its larger 11px version — see below.) */
    padding: 3px 4px;
    margin: -3px -4px;
  }
  .mark :global(svg) {
    height: 1.35rem;
    width: auto;
    display: block;
  }
  .nav-links {
    display: flex;
    gap: 1.9rem;
    align-items: center;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    color: var(--color-paper);
  }
  .nav-links a {
    position: relative;
    text-decoration: none;
    color: var(--color-paper-80);
    transition: color var(--duration-fast) ease;
  }
  .nav-links a::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -7px;
    right: -7px;
    height: 0;
    border-top: 2.5px solid var(--color-paper);
    pointer-events: none;
    transform: translateY(-50%) scaleX(0);
    transform-origin: center;
    transition: transform var(--duration-fast) ease;
  }
  .nav-links a:hover {
    color: var(--color-paper);
  }
  .nav-links a:hover::before,
  .nav-links a.is-active::before {
    transform: translateY(-50%) scaleX(1);
  }
  .nav-links a.is-active {
    color: var(--color-paper-60);
  }
  /* Dropdown for a nav item with children (currently just "Info" ->
     About/Media/Contact) — hover/focus-within still open it with no JS for
     a pointer/keyboard-tab user, same as before; nav-info-dropdown.ts adds
     an explicit click/Enter/Space toggle (.is-open), Escape-to-close, and
     click-outside-to-close on top, since the trigger is a real <button>
     now (see the markup above) rather than a link that happened to also
     have a hover menu. */
  .nav-dropdown {
    position: relative;
  }
  .nav-dropdown-menu {
    position: absolute;
    /* top:100% plus a padding-top spacer (below), not a margin-top gap — a
       real gap between trigger and menu is a dead zone: the instant the
       pointer crosses it, it leaves every element matching
       .nav-dropdown:hover, so the menu can flicker shut before the pointer
       ever reaches it. Padding keeps the menu's own box (and so its hover
       area) contiguous with the trigger while landing the visible card in
       the same spot. */
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 196px;
    padding: 0.9rem 0.6rem 0.6rem;
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-panel);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform-origin: top center;
    transition:
      opacity var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }
  /* White/paper surface (same independent light-panel treatment as
     MobileMenu.astro's fullscreen overlay — see its own comment) rather
     than the dark --color-backstage this used to sit on. Pinned to the true
     light/dark swatches, not the inherited --color-paper/--color-ink, so
     this stays correct even opened from ODDspace's .theme-light page,
     where those tokens are already inverted. */
  .nav-dropdown-menu {
    background: var(--swatch-paper);
    color: var(--swatch-ink);
    border: 1px solid var(--color-ink-12);
  }
  /* A small header inside the panel itself — same eyebrow language used
     sitewide — is what makes this read as a mini nav panel with its own
     hierarchy rather than a bare browser-default link list. */
  .nav-dropdown-label {
    display: block;
    font: var(--text-caption);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-ink-40);
    padding: 0.4rem 0.8rem 0.7rem;
    margin-bottom: 0.2rem;
    border-bottom: 1px solid var(--color-ink-12);
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav-dropdown-menu {
      transform: translateX(-50%) translateY(-4px) scale(0.98);
    }
  }
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu,
  .nav-dropdown.is-open .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) scale(1);
  }
  .nav-dropdown-menu a {
    display: block;
    padding: 0.65rem 0.8rem;
    border-radius: 6px;
    font-size: 0.92rem;
    text-decoration: none;
    white-space: nowrap;
    color: var(--swatch-ink);
    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }
  .nav-dropdown-menu a::before {
    display: none;
  }
  /* Menu item default: paper surface, ink text (inherited from the panel
     above). Hover/keyboard focus: ink fill, paper text — the same inversion
     MobileMenu.astro's .menu-links a:hover uses. */
  .nav-dropdown-menu a:hover,
  .nav-dropdown-menu a.is-active,
  .nav-dropdown-menu a:focus-visible {
    color: var(--swatch-paper);
    background: var(--swatch-ink);
  }
  /* "Info" trigger reads as a pill button (same visual language as
     Pill.astro's `outline` variant) now that it sits where the old
     Newsletter pill did, on the header's right side — a plain text link
     there would look like a stray nav item, not an intentional control. Not
     reusing <Pill> itself: this trigger needs to stay a plain <button> so
     :focus-within on the shared .nav-dropdown parent keeps working for the
     hover/focus path, alongside the explicit click/keyboard toggle in
     nav-info-dropdown.ts. */
  .nav-info-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 999px;
    padding: 0.55rem 1.1rem 0.55rem 1.25rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.72rem;
    /* A <button>'s UA stylesheet declares its own line-height (usually
       "normal") directly on the element, which wins over inheritance
       regardless of specificity — so swapping this trigger from <a> to
       <button> silently shrank it a few px versus the old anchor (which
       inherited body's unitless 1.5 here, same as .nav-links a still does),
       shaving the same few px off nav's own offsetHeight and, through
       nav-height.ts's --nav-h, every page's total height sitewide (caught
       via a real Playwright visual-regression diff, not assumed). Restoring
       the same 1.5 ratio keeps this pixel-identical to the anchor it
       replaced. */
    line-height: 1.5;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-paper);
    background: transparent;
    border: 1px solid rgb(226 223 222 / 35%);
    cursor: pointer;
    appearance: none;
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  /* The chevron is what makes the trigger legible as "opens a panel" rather
     than a plain link to /about that happens to also have a hover menu —
     the flip on open/hover is the same small, fast motion language as the
     panel's own entrance below, not a separate animation to track. */
  .nav-info-chevron {
    flex-shrink: 0;
    color: var(--color-paper-60);
    transition:
      transform var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  .nav-info-trigger:hover .nav-info-chevron,
  .nav-info-trigger.is-active .nav-info-chevron {
    color: var(--color-paper);
  }
  .nav-dropdown:hover .nav-info-chevron,
  .nav-dropdown:focus-within .nav-info-chevron,
  .nav-dropdown.is-open .nav-info-chevron {
    transform: rotate(180deg);
  }
  /* Same dark-ground assumption as Pill.astro's .pill-outline (this trigger
     intentionally matches that variant's look) — under .theme-light
     (ODDspace) the ground is light, so this needs the ink-tinted mirror at
     the same opacity, not the inherited (now-dark) --color-paper value
     reused as a border tint. See Pill.astro's identical comment. */
  :global(.theme-light) .nav-info-trigger {
    border-color: rgb(14 9 11 / 35%);
  }
  .nav-info-trigger::before {
    display: none;
  }
  .nav-info-trigger:hover,
  .nav-info-trigger.is-active {
    border-color: var(--color-paper);
    color: var(--color-paper);
  }
  .nav-info-trigger:focus-visible {
    outline-offset: 2px;
  }
  /* Right-aligned under the trigger, not centered — .nav-dropdown-menu's
     default centering (built for a mid-row trigger like the old inline
     "Info" link) would push the menu card partly past the viewport's own
     right edge now that the trigger sits flush against it. */
  .nav-info .nav-dropdown-menu {
    left: auto;
    right: 0;
    transform: none;
    transform-origin: top right;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav-info .nav-dropdown-menu {
      transform: translateY(-4px) scale(0.98);
    }
  }
  .nav-info:hover .nav-dropdown-menu,
  .nav-info:focus-within .nav-dropdown-menu,
  .nav-info.is-open .nav-dropdown-menu {
    transform: none;
  }
  .nav-buttons {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  /* 1024px (not 760px) — V2's nav grew a genuinely long label ("Work with
     ODD"), and at anything narrower the 5-item nav collided with the
     Pre-register button (caught via an actual tablet-width screenshot, not
     assumed — it was silently baked into the visual-regression baseline
     itself). This range covers every common tablet portrait width
     (iPad Mini/Air/Pro all 768-1024px), not just phones. MobileMenu.astro
     renders About/Media/Contact as direct items below this width, so the
     header's own Info dropdown hides alongside the primary links rather
     than offering a second, redundant way to reach the same three pages. */
  @media (max-width: 1024px) {
    .nav-links,
    .nav-info {
      display: none;
    }
    /* Below the tablet cutoff the mark is the only left-side control (the
       primary links are gone), so it's worth a real tap target: padding
       grows the invisible hit area, the matching negative margin keeps the
       mark itself rendering at the exact same size/position as before —
       purely a hit-slop increase, not a visual change. */
    .mark {
      padding: 11px 8px;
      margin: -11px -8px;
    }
  }
</style>
