---
import { getEntry } from 'astro:content';
import Logo from '../primitives/Logo.astro';
import Pill from '../primitives/Pill.astro';

const site = await getEntry('site', 'global');
if (!site) throw new Error('Missing site/global.json content entry');
const { nav, preRegister } = site.data;
const path = Astro.url.pathname;
---

<nav>
  <div class="nav-wrap nav-row">
    <div class="nav-left">
      <a href="/" class="mark" aria-label="ODD">
        <Logo />
      </a>
      <div class="nav-links">
        {
          nav.map((item) => (
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noreferrer' : undefined}
              class={!item.external && path === item.href ? 'is-active' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
    <div class="nav-buttons">
      <Pill href={preRegister.href} variant="outline" magnetic>{preRegister.label}</Pill>
      <Pill type="button" variant="solid" ariaLabel="Menu" class="js-menu-toggle" id="menuToggle">
        <span id="menuToggleLabel">Menu</span>
      </Pill>
    </div>
  </div>
</nav>

<div class="brand-corner" aria-hidden="true">
  <Logo ariaHidden />
</div>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-paper-12);
  }
  .nav-wrap {
    max-width: var(--width-wide);
    margin: 0 auto;
    padding: 0 var(--gutter-wide);
  }
  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.25rem;
    padding: 0.9rem 0;
  }
  .nav-left {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    min-width: 0;
  }
  .mark {
    color: var(--color-paper);
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .mark :global(svg) {
    height: 1.35rem;
    width: auto;
    display: block;
    filter: url(#steam-nav);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mark :global(svg) {
      animation: hero-float 10s ease-in-out infinite;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .mark {
      transition: transform 0.4s var(--ease-spring);
    }
    .mark:hover {
      transform: rotate(-4deg) scale(1.06);
    }
  }
  .nav-links {
    display: flex;
    gap: 1.9rem;
    align-items: center;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    color: var(--color-paper);
  }
  .nav-links a {
    position: relative;
    text-decoration: none;
    color: var(--color-paper-80);
    transition: color var(--duration-fast) ease;
  }
  .nav-links a::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -7px;
    right: -7px;
    height: 0;
    border-top: 2.5px solid var(--color-paper);
    pointer-events: none;
    transform: translateY(-50%) scaleX(0);
    transform-origin: center;
    transition: transform var(--duration-fast) ease;
  }
  .nav-links a:hover {
    color: var(--color-paper);
  }
  .nav-links a:hover::before,
  .nav-links a.is-active::before {
    transform: translateY(-50%) scaleX(1);
  }
  .nav-links a.is-active {
    color: var(--color-paper-60);
  }
  .nav-buttons {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  .brand-corner {
    position: fixed;
    left: 1.5rem;
    bottom: 1.5rem;
    z-index: 60;
    color: var(--color-paper-60);
    width: 30px;
    height: auto;
    pointer-events: none;
    opacity: 0.85;
  }
  .brand-corner :global(svg) {
    width: 100%;
    height: auto;
    display: block;
    filter: url(#steam-nav);
  }
  @media (prefers-reduced-motion: no-preference) {
    .brand-corner :global(svg) {
      animation: hero-float 11s ease-in-out infinite;
    }
  }
  @media (max-width: 820px) {
    .brand-corner {
      display: none;
    }
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-2%);
    }
  }
  @media (max-width: 760px) {
    .nav-links {
      display: none;
    }
  }
</style>
