---
import { getEntry } from 'astro:content';
import Logo from '../primitives/Logo.astro';
import SocialIcon from '../primitives/SocialIcon.astro';
import NewsletterForm from '../primitives/NewsletterForm.astro';

const site = await getEntry('site', 'global');
if (!site) throw new Error('Missing site/global.json content entry');
const { nav, social, contact, footerAddress, newsletterLabel, newsletterHref, supportedBy } =
  site.data;
// A footer link list doesn't need a dropdown — an item with children (e.g.
// "Info") flattens straight into its real children instead of showing a
// grouping label that isn't itself a page. See Nav.astro for the dropdown
// version of the same data.
const footerLinks = nav.flatMap((item) => item.children ?? [item]);
---

<footer>
  <div class="wrap foot-top">
    <a href="/" class="mark foot-mark" aria-label="ODD"><Logo /></a>
    <nav class="foot-nav">
      {
        footerLinks.map((item) => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noreferrer' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="foot-nl" id="newsletter">
      <span class="foot-nl-label">{newsletterLabel}</span>
      <NewsletterForm
        id="newsletterForm"
        source="footer_newsletter"
        newsletterHref={newsletterHref}
      />
    </div>
  </div>
  <div class="wrap foot-mid">
    <ul class="foot-contact">
      {
        contact.map((c) => (
          <li>
            {c.label} <a href={`mailto:${c.email}`}>{c.email}</a>
          </li>
        ))
      }
    </ul>
    <div class="footer-social">
      {
        social.map((s) => (
          <a
            class="social-badge"
            href={s.href}
            target="_blank"
            rel="noreferrer"
            aria-label={s.platform}
          >
            <SocialIcon platform={s.platform} />
          </a>
        ))
      }
    </div>
  </div>
  {
    supportedBy && supportedBy.length > 0 && (
      <div class="wrap foot-supported">
        <span class="foot-supported-label">Supported by</span>
        <div class="foot-supported-logos">
          {supportedBy.map((item) => (
            <img src={item.logo.src} alt={item.name} loading="lazy" />
          ))}
        </div>
      </div>
    )
  }
  <div class="wrap foot-bottom">
    <p>{footerAddress}</p>
    <a href="https://oddfest.co">oddfest.co</a>
  </div>
</footer>

<style>
  footer {
    border-top: 4px solid var(--color-paper);
    padding-top: 0;
  }
  .foot-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    padding: 3rem 0 2.4rem;
  }
  .foot-mark {
    color: var(--color-paper);
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .foot-mark :global(svg) {
    height: 1.7rem;
    width: auto;
    display: block;
  }
  .foot-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.7rem;
    font-family: var(--font-display);
    font-size: 1rem;
  }
  .foot-nav a {
    position: relative;
    color: var(--color-paper-60);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }
  .foot-nav a::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -7px;
    right: -7px;
    height: 0;
    border-top: 2.5px solid var(--color-paper);
    pointer-events: none;
    transform: translateY(-50%) scaleX(0);
    transform-origin: center;
    transition: transform var(--duration-fast) ease;
  }
  .foot-nav a:hover {
    color: var(--color-paper);
  }
  .foot-nav a:hover::before {
    transform: translateY(-50%) scaleX(1);
  }

  .foot-nl {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
    flex-shrink: 0;
    scroll-margin-top: var(--nav-h);
  }
  .foot-nl-label {
    font: var(--text-caption);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-paper-40);
  }
  .foot-mid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2.5rem;
    padding: 1.8rem 0;
    border-top: 1px solid var(--color-paper-12);
  }
  .foot-contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
  }
  .foot-contact a {
    color: var(--color-paper-60);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }
  .foot-contact a:hover {
    color: var(--color-paper);
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.1rem;
  }
  .social-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Icon itself stays 22px (below); this is the tap target — WCAG 2.2's
       24px AA minimum, rounded up to Apple's 44px HIG recommendation since
       it costs nothing visually (invisible box, icon still centered at its
       original size). */
    min-width: 44px;
    min-height: 44px;
    margin: -11px;
    color: var(--color-paper-40);
    text-decoration: none;
    transition:
      color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }
  /* The last badge's own -11px right margin has nothing after it to
     encroach into, so it instead pushed the page's real scrollWidth 11px
     past the viewport whenever this row lands flush against it — confirmed
     live at 768–1024px (every page, Footer is global). Zeroing only that
     one side, on only the last badge, keeps the tap-target expansion (and
     its symmetric hover) everywhere else while removing the actual
     overflow — confirmed via a direct before/after scrollWidth check. */
  .social-badge:last-child {
    margin-right: 0;
  }
  .social-badge:hover {
    color: var(--color-paper);
    transform: translateY(-2px);
  }
  .social-badge :global(svg) {
    width: 22px;
    height: 22px;
    display: block;
  }

  /* Quiet, secondary treatment on purpose — visually much smaller than the
     future full grouped logo wall (see site/global.json's `logoWall`), and
     only renders at all once `supportedBy` actually has confirmed entries
     (see content.config.ts). */
  .foot-supported {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--color-paper-12);
  }
  .foot-supported-label {
    font: var(--text-caption);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-paper-40);
    flex-shrink: 0;
  }
  .foot-supported-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }
  .foot-supported-logos img {
    height: 22px;
    width: auto;
    max-width: 110px;
    object-fit: contain;
    opacity: 0.6;
    filter: brightness(0) invert(1);
    transition: opacity var(--duration-fast) ease;
  }
  .foot-supported-logos img:hover {
    opacity: 1;
  }

  .foot-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 2rem;
    padding: 1.5rem 0 2.2rem;
    border-top: 1px solid var(--color-paper-12);
    /* Clay itself measures 4.3:1 here — just under WCAG AA for text this small, so this
       spot uses a lightened reading of it (5.2:1) rather than the literal archive value. */
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: #967e79;
  }
  /* The lightened clay above is tuned for a dark ground; under .theme-light
     (ODDspace) the footer sits on the light ground instead, so it needs the
     darkened reading of the same clay hue for equivalent contrast. */
  :global(.theme-light) .foot-bottom {
    color: #6b5551;
  }
  .foot-bottom p {
    margin: 0;
  }
  .foot-bottom a {
    color: #967e79;
    text-decoration: none;
  }
  :global(.theme-light) .foot-bottom a {
    color: #6b5551;
  }
  .foot-bottom a:hover {
    color: var(--color-paper);
  }

  @media (max-width: 700px) {
    .foot-top,
    .foot-mid,
    .foot-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
