---
import { getEntry } from 'astro:content';
import Logo from '../primitives/Logo.astro';
import SocialIcon from '../primitives/SocialIcon.astro';

const site = await getEntry('site', 'global');
if (!site) throw new Error('Missing site/global.json content entry');
const { nav, social, contact, footerAddress, newsletterLabel } = site.data;
---

<footer>
  <div class="wrap foot-top">
    <a href="/" class="mark foot-mark" aria-label="ODD"><Logo /></a>
    <nav class="foot-nav">
      {
        nav.map((item) => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noreferrer' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="foot-nl">
      <span class="foot-nl-label">{newsletterLabel}</span>
      <form class="nl-form" onsubmit="return false;">
        <input type="email" placeholder="you@example.com" aria-label="Email address" />
        <button type="submit">Sign up</button>
      </form>
    </div>
  </div>
  <div class="wrap foot-mid">
    <ul class="foot-contact">
      {
        contact.map((c) => (
          <li>
            <a href={`mailto:${c.email}`}>
              {c.label} — {c.email}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="footer-social">
      {
        social.map((s) => (
          <a
            class="social-badge"
            href={s.href}
            target="_blank"
            rel="noreferrer"
            aria-label={s.platform}
          >
            <SocialIcon platform={s.platform} />
          </a>
        ))
      }
    </div>
  </div>
  <div class="wrap foot-bottom">
    <p>{footerAddress}</p>
    <a href="https://oddfest.co">oddfest.co</a>
  </div>
</footer>

<style>
  footer {
    border-top: 4px solid var(--color-paper);
    padding-top: 0;
  }
  .foot-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    padding: 3rem 0 2.4rem;
  }
  .foot-mark {
    color: var(--color-paper);
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .foot-mark :global(svg) {
    height: 1.7rem;
    width: auto;
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .foot-mark {
      transition: transform 0.4s var(--ease-spring);
    }
    .foot-mark:hover {
      transform: rotate(-4deg) scale(1.06);
    }
  }
  .foot-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.7rem;
    font-family: var(--font-display);
    font-size: 1rem;
  }
  .foot-nav a {
    position: relative;
    color: var(--color-paper-60);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }
  .foot-nav a::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -7px;
    right: -7px;
    height: 0;
    border-top: 2.5px solid var(--color-paper);
    pointer-events: none;
    transform: translateY(-50%) scaleX(0);
    transform-origin: center;
    transition: transform var(--duration-fast) ease;
  }
  .foot-nav a:hover {
    color: var(--color-paper);
  }
  .foot-nav a:hover::before {
    transform: translateY(-50%) scaleX(1);
  }

  .foot-nl {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
    flex-shrink: 0;
  }
  .foot-nl-label {
    font: var(--text-caption);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-paper-40);
  }
  .nl-form {
    display: flex;
    border: 1px solid var(--color-paper-20);
    border-radius: 999px;
    max-width: 320px;
    flex-shrink: 0;
    overflow: hidden;
  }
  .nl-form input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    padding: 0.7rem 0 0.7rem 1.1rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--color-paper);
    outline: none;
  }
  .nl-form button {
    border: none;
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 0 1.2rem;
    margin: 3px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity var(--duration-fast) ease;
  }
  .nl-form button:hover {
    opacity: 0.85;
  }

  .foot-mid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2.5rem;
    padding: 1.8rem 0;
    border-top: 1px solid var(--color-paper-12);
  }
  .foot-contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
  }
  .foot-contact a {
    color: var(--color-paper-60);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }
  .foot-contact a:hover {
    color: var(--color-paper);
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.1rem;
  }
  .social-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-paper-40);
    text-decoration: none;
    transition:
      color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }
  .social-badge:hover {
    color: var(--color-paper);
    transform: translateY(-2px);
  }
  .social-badge :global(svg) {
    width: 22px;
    height: 22px;
    display: block;
  }

  .foot-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 2rem;
    padding: 1.5rem 0 2.2rem;
    border-top: 1px solid var(--color-paper-12);
    /* Clay itself measures 4.3:1 here — just under WCAG AA for text this small, so this
       spot uses a lightened reading of it (5.2:1) rather than the literal archive value. */
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: #967e79;
  }
  .foot-bottom p {
    margin: 0;
  }
  .foot-bottom a {
    color: #967e79;
    text-decoration: none;
  }
  .foot-bottom a:hover {
    color: var(--color-paper);
  }

  @media (max-width: 700px) {
    .foot-top,
    .foot-mid,
    .foot-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
