---
// The fullscreen menu overlay. The original built this via innerHTML JS purely
// because it was one hand-authored file; as real markup it's just another
// component, which also means its links are indexable/accessible without JS.
//
// 2026-08-30 revision: items with `children` (currently just "Info") flatten
// straight into their real children here instead of showing a grouped
// "Info" heading that hides About/Media/Contact behind an extra tap — same
// flattening Footer.astro already does for the identical reason, see its own
// comment. Newsletter no longer has a form here either — see Footer.astro
// (the one persistent newsletter UI) and NewsletterPopup.astro (the timed
// exception) for where it lives instead.
import { getEntry } from 'astro:content';
import Logo from '../primitives/Logo.astro';
import SocialIcon from '../primitives/SocialIcon.astro';

const site = await getEntry('site', 'global');
if (!site) throw new Error('Missing site/global.json content entry');
const { nav, social, footerTag } = site.data;
const menuLinks = nav.flatMap((item) => item.children ?? [item]);
---

<div class="menu-overlay" id="menuOverlay" role="dialog" aria-modal="true" aria-label="Site menu">
  <div class="menu-topbar">
    <a href="/" class="mark-ink" aria-label="ODD"><Logo /></a>
    <button type="button" class="menu-close" id="menuClose">Close</button>
  </div>
  <nav class="menu-links">
    {
      menuLinks.map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noreferrer' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="menu-bottom">
    <div class="menu-social">
      {
        social.map((s) => (
          <a href={s.href} target="_blank" rel="noreferrer" aria-label={s.platform}>
            <SocialIcon platform={s.platform} />
          </a>
        ))
      }
    </div>
    <span class="menu-tag">{footerTag}</span>
  </div>
</div>

<script>
  const toggle = document.getElementById('menuToggle');
  const overlay = document.getElementById('menuOverlay');
  const closeBtn = document.getElementById('menuClose');
  const toggleLabel = document.getElementById('menuToggleLabel');
  if (toggle && overlay && closeBtn && toggleLabel) {
    let open = false;

    // Set once at load, not just inside setOpen() — without this, a
    // screen reader gets no aria-expanded/aria-controls at all until the
    // trigger is clicked for the first time, rather than the correct
    // "closed" state from the start.
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-controls', 'menuOverlay');

    function getFocusable(): HTMLElement[] {
      if (!overlay) return [];
      return Array.from(
        overlay.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      );
    }

    // "Background does not remain interactable" — every other direct child
    // of <body> (Nav, <main>, Footer, the newsletter popup, the consent
    // banner, the custom cursor) gets `inert` while the overlay is open, so
    // Tab can't leave it and a screen reader can't reach page content
    // behind it. The overlay element itself is always excluded.
    function setBackgroundInert(v: boolean) {
      Array.from(document.body.children).forEach((el) => {
        if (el === overlay) return;
        if (v) el.setAttribute('inert', '');
        else el.removeAttribute('inert');
      });
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        setOpen(false);
        return;
      }
      // Minimal focus trap — Tab/Shift+Tab wrap within the overlay's own
      // focusable elements instead of escaping into (now-inert) page
      // content behind it, same pattern as newsletter-popup.ts.
      if (e.key === 'Tab') {
        const focusable = getFocusable();
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    const setOpen = (v: boolean) => {
      open = v;
      overlay.classList.toggle('is-open', open);
      document.body.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggleLabel.textContent = open ? 'Close' : 'Menu';
      setBackgroundInert(open);
      if (open) {
        closeBtn?.focus();
        document.addEventListener('keydown', onKeydown);
      } else {
        document.removeEventListener('keydown', onKeydown);
        // Always the toggle itself, not "whatever was focused before
        // opening" — the spec calls for focus returning to the Menu
        // trigger specifically (this is the only way to open the menu, so
        // that's also the only sensible return target). requestAnimationFrame,
        // not a synchronous call — verified via a real cross-browser
        // failure, not assumed: WebKit doesn't finish making a
        // just-un-inerted element focusable within the same task
        // removeAttribute('inert') runs in, so calling .focus() immediately
        // after silently no-ops there (Chromium/Firefox both handle it
        // synchronously and don't need this, but the deferral is harmless
        // for them too — one paint's delay is imperceptible).
        requestAnimationFrame(() => toggle.focus());
      }
    };
    toggle.addEventListener('click', () => setOpen(!open));
    closeBtn.addEventListener('click', () => setOpen(false));
    overlay
      .querySelectorAll('.menu-links a')
      .forEach((a) => a.addEventListener('click', () => setOpen(false)));
  }
</script>

<style>
  .menu-overlay {
    /* Pinned to the true light/dark swatches, not the inherited
       --color-paper/--color-ink — this overlay is always a light panel
       regardless of the underlying page's theme (see tokens.css's
       .theme-light), so on ODDspace it must NOT inherit the inverted
       tokens the rest of that page uses. */
    --color-paper: var(--swatch-paper);
    --color-ink: var(--swatch-ink);
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--color-paper);
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      visibility 0s linear 0.3s;
  }
  .menu-overlay.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  :global(body.menu-open) {
    overflow: hidden;
  }
  .menu-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* Height-aware — see .menu-links's own comment below on why 100dvh
       fitting needs every section's vertical rhythm to respond to viewport
       height, not just the links themselves. Unchanged on genuinely tall
       viewports (2svh only undercuts 0.85rem below ~680px tall), tightens
       on short ones. */
    padding: clamp(0.6rem, 2svh, 0.85rem) 2rem;
    /* This fullscreen overlay sits flush against inset:0, so on a notched
       phone the close button/logo need their own safe-area clearance —
       nothing else on the site needs this (every other fixed/sticky
       surface leaves the very top of the viewport alone). */
    padding-top: max(clamp(0.6rem, 2svh, 0.85rem), env(safe-area-inset-top));
    border-bottom: 1px solid rgb(36 34 32 / 15%);
    flex-shrink: 0;
  }
  .menu-topbar .mark-ink {
    color: var(--color-ink);
    display: flex;
    align-items: center;
    /* Same hit-slop as Nav.astro's `.mark`, for the same reason: the mark is
       ~22px tall, two pixels under WCAG 2.2 SC 2.5.8, and this one is inside
       an overlay where it is one of only two controls. Padding grows the
       target, the negative margin keeps the rendering identical. */
    padding: 3px 4px;
    margin: -3px -4px;
  }
  .menu-topbar .mark-ink :global(svg) {
    height: 1.35rem;
    width: auto;
    display: block;
  }
  .menu-close {
    border: 1px solid rgb(36 34 32 / 35%);
    background: transparent;
    color: var(--color-ink);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--duration-fast) ease;
  }
  .menu-close:hover {
    border-color: var(--color-ink);
  }
  /* Requirement 30: the whole overlay (topbar + links + bottom bar) needs to
     fit 100dvh with no scrolling at normal phone/tablet/laptop heights — it
     didn't (a real bug, not hypothetical: 7 links at the old flat
     2.1-4.6rem/6.5vw sizing ran 600-630px tall on their own, before topbar/
     bottom chrome, which already overflows a ~700px-tall browser window).
     Fixed by making every section's vertical rhythm height-aware — font
     size and padding both respond to svh, not just vw — so short viewports
     shrink automatically instead of only ever growing with width.
     overflow-y:auto stays on .menu-overlay itself as the safety fallback
     for genuinely extreme heights/zoom levels this can't fully solve (see
     the file-level comment above), not the primary fit strategy. */
  .menu-links {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1rem, 3.5svh, 2rem) 2.5rem;
  }
  .menu-links a {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    /* min(vw, svh) — whichever dimension is actually tight wins. A tall
       narrow phone stays vw-limited (unchanged from before: plenty of
       height there already). A short wide viewport (laptop window, tablet
       landscape) becomes svh-limited instead of overflowing. */
    font-size: clamp(1.7rem, min(6.5vw, 8.2svh), 4.6rem);
    line-height: 1.14;
    color: var(--color-ink);
    text-decoration: none;
    padding: clamp(0.05rem, 0.6svh, 0.15rem) 0.6rem;
    margin: 0 -0.6rem;
    transition:
      background var(--duration-fast) ease,
      color var(--duration-fast) ease,
      padding-left 0.25s ease;
  }
  .menu-links a:hover {
    background: var(--color-ink);
    color: var(--color-paper);
    padding-left: 1.4rem;
  }
  .menu-bottom {
    border-top: 1px solid rgb(36 34 32 / 15%);
    padding: clamp(1rem, 3svh, 1.8rem) 2.5rem;
    flex-shrink: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem 2.5rem;
    align-items: center;
    justify-content: space-between;
  }
  /* Extreme short heights (landscape phone, a badly cramped browser zoom
     level) — tighten line-height further on top of the svh-based sizing
     above rather than relying on overflow-y:auto alone. */
  @media (max-height: 480px) {
    .menu-links a {
      line-height: 1.05;
    }
  }
  .menu-social {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .menu-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    opacity: 0.55;
    text-decoration: none;
    transition:
      opacity var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }
  .menu-social a :global(svg) {
    width: 22px;
    height: 22px;
  }
  .menu-social a:hover {
    opacity: 1;
    transform: translateY(-2px);
  }
  .menu-tag {
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: rgb(36 34 32 / 55%);
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .menu-links {
      padding: 1.5rem;
    }
    .menu-bottom {
      padding: 1.5rem;
      padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    }
  }
</style>
