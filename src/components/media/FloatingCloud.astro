---
// A loose scatter of small archive photos around a text section — purely
// atmospheric (aria-hidden, alt=""), so it never competes with or duplicates
// real content. Positions/rotations are fixed per slot (not randomized at
// runtime), so the layout is stable across reloads and doesn't shift under
// hydration. Cursor-reactive drift lives in floating-cloud.ts, gated by
// prefers-reduced-motion and (hover: none) — see hero-tilt.ts for the same
// pattern used on the homepage hero.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
}
const { images } = Astro.props;

// top/left as % of the wrapping container, rotate in deg, size in px, depth
// as the parallax multiplier (smaller = drifts less, reads as "further back").
// Positions sit along a half-moon arc (an ellipse swept from ~202° to ~-22°,
// so it wraps slightly past horizontal on both ends rather than stopping
// dead at the equator — reads as a full crescent, not a thin one) with a
// small fixed per-point offset layered on top so it doesn't look like a
// mechanically perfect curve. Still hand-set, not runtime-random — see the
// file comment above on why.
const slots = [
  { top: 55, left: 6.4, rotate: -8, size: 92, depth: 0.5 },
  { top: 42.2, left: 1.5, rotate: 6, size: 68, depth: 0.8 },
  { top: 23, left: 8.7, rotate: 5, size: 84, depth: 1.1 },
  { top: 14.6, left: 16.9, rotate: -6, size: 60, depth: 0.6 },
  { top: 4, left: 29.6, rotate: 7, size: 96, depth: 0.9 },
  { top: 2, left: 51.5, rotate: -5, size: 72, depth: 1.2 },
  { top: 5, left: 67.9, rotate: 8, size: 88, depth: 0.7 },
  { top: 10.6, left: 85.1, rotate: -7, size: 64, depth: 1.0 },
  { top: 26, left: 92.3, rotate: 4, size: 100, depth: 0.5 },
  { top: 37.2, left: 97, rotate: -9, size: 76, depth: 0.85 },
  { top: 56, left: 91.6, rotate: 6, size: 82, depth: 0.65 },
];
---

<div class="floating-cloud" data-floating-cloud aria-hidden="true">
  {
    images.slice(0, slots.length).map((image, i) => {
      const slot = slots[i];
      return (
        <div
          class="floating-cloud-item reveal"
          style={`top:${slot.top}%; left:${slot.left}%; --size:${slot.size}px; transition-delay:${i * 70}ms;`}
          data-depth={slot.depth}
        >
          {/* Split from the outer item: the outer handles the one-time
               reveal-in (opacity/scale, transitioned) and top/left
               positioning; this inner element handles the continuous
               per-frame cursor-drift transform with no transition of its
               own, so floating-cloud.ts's rAF updates apply instantly
               instead of each tiny step re-animating over the reveal's
               0.6s easing (which would read as laggy, chasing motion). */}
          <div class="floating-cloud-item-inner" style={`--rotate:${slot.rotate}deg;`}>
            <Image src={image} alt="" width={220} />
          </div>
        </div>
      );
    })
  }
</div>

<script src="../../scripts/floating-cloud.ts"></script>

<style>
  .floating-cloud {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .floating-cloud-item {
    position: absolute;
    width: var(--size);
    height: var(--size);
    transform: translate(-50%, -50%);
  }
  .floating-cloud-item-inner {
    width: 100%;
    height: 100%;
    /* No transition here on purpose — floating-cloud.ts writes --driftX/
       --driftY every rAF frame, already smoothed by its own lerp; a CSS
       transition on top would re-animate each tiny step over its own
       duration instead of tracking the cursor, reading as laggy chase
       rather than a live-following drift. */
    transform: rotate(var(--rotate)) translate(var(--driftX, 0px), var(--driftY, 0px));
    /* Square, not circular — matches the sharp-cornered photo treatment used
       everywhere else on the site (PhotoBreak, ProgramGrid); circles were
       this component's own one-off. */
    overflow: hidden;
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 55%);
    border: 1px solid var(--color-paper-12);
  }
  .floating-cloud-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) saturate(1.1) brightness(0.85);
  }
  @media (prefers-reduced-motion: no-preference) {
    .floating-cloud-item {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.7);
      transition:
        opacity 0.6s ease,
        transform 0.6s ease;
    }
    .floating-cloud-item.in {
      opacity: 0.9;
      transform: translate(-50%, -50%) scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-cloud-item {
      opacity: 0.9;
    }
  }
  /* Small screens: the cloud has no room to scatter around a full-width
     stacked heading without overlapping the text itself — hide rather than
     crowd it, same call as decorative-only elements elsewhere on the site. */
  @media (max-width: 820px) {
    .floating-cloud {
      display: none;
    }
  }
</style>
