---
// A loose scatter of small archive photos around a text section — purely
// atmospheric (aria-hidden, alt=""), so it never competes with or duplicates
// real content. Positions/rotations are fixed per slot (not randomized at
// runtime), so the layout is stable across reloads and doesn't shift under
// hydration. Cursor-reactive drift lives in floating-cloud.ts, gated by
// prefers-reduced-motion and (hover: none) — see hero-tilt.ts for the same
// pattern used on the homepage hero.
//
// Restored 2026-08-30 (removed 2026-08-27, see git history around commit
// 4860613/f73243a) for Home's "What ODD is" section, which went back to this
// centered-text + scattered-photography treatment from the asymmetric
// two-image layout that replaced it. Re-checked against the clipping bug
// that motivated the original removal before reintroducing it — see the
// `slots` comment below.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
}
const { images } = Astro.props;

// top/left as % of the wrapping container, rotate in deg, size in px, depth
// as the parallax multiplier (smaller = drifts less, reads as "further back").
// Positions sit along a half-moon arc, so the section's centred headline
// reads as sitting inside a crescent of photography.
//
// Recomposed 2026-09-11. The previous arc's sizes (60-100px) and depths
// (0.5-1.2) were assigned independently of each other and of position, so a
// small photo could be the nearest thing on screen and a large one the
// furthest — there was no front-to-back logic to read, just scatter, and the
// two sides of the crescent didn't balance. Now:
//
//   * The arc is a real ellipse about the section's own centre (50%, 50%),
//     rx 44 / ry 45, swept 200° → -20° in 22° steps. Both ends land at the
//     same height, so the crescent is symmetrical around the headline rather
//     than lopsided.
//   * Size and depth move together, and alternate along the arc: each
//     near/large photo sits between two far/small ones. That alternation is
//     what stops a mirrored arc from reading as a mechanical stamp — the
//     rhythm carries the eye along the curve instead of the curve itself
//     being the only thing to see.
//   * `depth` now also drives opacity and brightness in CSS below, so
//     "further back" is one consistent idea (smaller, dimmer, drifts less)
//     instead of three unrelated numbers.
//
// The clipping constraint the previous version documents still holds and was
// re-checked against these values: at the 821px width where this component
// stops rendering, every slot's worst-case edge (left% × W ± size/2) keeps a
// positive margin inside .floating-cloud's own overflow:hidden box — the
// tightest are the four slots at left 6/9.8/90.2/94, which clear it by 18px
// and 34px respectively. Top edges are checked the same way, against the
// shortest this section gets rather than the tallest: the apex (top 5%) is
// the smallest photo of the eleven for exactly that reason.
const slots = [
  { top: 65.4, left: 8.6, rotate: -8, size: 86, depth: 0.9 },
  { top: 48.4, left: 6.0, rotate: 5, size: 62, depth: 0.55 },
  { top: 31.7, left: 9.8, rotate: -4, size: 92, depth: 1.05 },
  { top: 17.6, left: 19.4, rotate: 7, size: 66, depth: 0.6 },
  { top: 8.3, left: 33.5, rotate: -6, size: 80, depth: 0.85 },
  { top: 5.0, left: 50.0, rotate: 4, size: 54, depth: 0.5 },
  { top: 8.3, left: 66.5, rotate: -7, size: 80, depth: 0.85 },
  { top: 17.6, left: 80.6, rotate: 6, size: 66, depth: 0.6 },
  { top: 31.7, left: 90.2, rotate: -5, size: 92, depth: 1.05 },
  { top: 48.4, left: 94.0, rotate: 8, size: 62, depth: 0.55 },
  { top: 65.4, left: 91.3, rotate: -6, size: 86, depth: 0.9 },
];
---

<div class="floating-cloud" data-floating-cloud aria-hidden="true">
  {
    images.slice(0, slots.length).map((image, i) => {
      const slot = slots[i];
      return (
        <div
          class="floating-cloud-item reveal"
          style={`top:${slot.top}%; left:${slot.left}%; --size:${slot.size}px; --depth:${slot.depth}; transition-delay:${i * 70}ms;`}
          data-depth={slot.depth}
        >
          {/* Split from the outer item: the outer handles the one-time
               reveal-in (opacity/scale, transitioned) and top/left
               positioning; this inner element handles the continuous
               per-frame cursor-drift transform with no transition of its
               own, so floating-cloud.ts's rAF updates apply instantly
               instead of each tiny step re-animating over the reveal's
               0.6s easing (which would read as laggy, chasing motion). */}
          <div class="floating-cloud-item-inner" style={`--rotate:${slot.rotate}deg;`}>
            <Image src={image} alt="" width={220} />
          </div>
        </div>
      );
    })
  }
</div>

<script src="../../scripts/floating-cloud.ts"></script>

<style>
  .floating-cloud {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .floating-cloud-item {
    position: absolute;
    width: var(--size);
    height: var(--size);
    transform: translate(-50%, -50%);
  }
  .floating-cloud-item-inner {
    width: 100%;
    height: 100%;
    /* No transition here on purpose — floating-cloud.ts writes --driftX/
       --driftY every rAF frame, already smoothed by its own lerp; a CSS
       transition on top would re-animate each tiny step over its own
       duration instead of tracking the cursor, reading as laggy chase
       rather than a live-following drift. */
    transform: rotate(var(--rotate)) translate(var(--driftX, 0px), var(--driftY, 0px));
    /* Square, not circular — matches the sharp-cornered photo treatment used
       everywhere else on the site (PhotoBreak, ProgramGrid); circles were
       this component's own one-off. */
    overflow: hidden;
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 55%);
    border: 1px solid var(--color-paper-12);
  }
  /* Brightness follows --depth (see the slots table): the photos meant to
     read as nearest are the brightest, the ones furthest back sit down into
     the section's ground. Range is deliberately narrow — 0.83 to 0.95 — since
     this is atmosphere behind a headline, and a photo that gets bright enough
     to be legible starts competing with the text for attention. The old flat
     0.85 for every item is what made the whole cloud read as one dim smudge
     rather than as depth. */
  .floating-cloud-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.06) saturate(1.12) brightness(calc(0.72 + var(--depth, 0.8) * 0.22));
  }
  /* Same idea in opacity: 0.72 at the back, 0.89 at the front. */
  .floating-cloud-item {
    opacity: calc(0.55 + var(--depth, 0.8) * 0.32);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.reveal-js) .floating-cloud-item {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.7);
      transition:
        opacity 0.6s ease,
        transform 0.6s ease;
    }
    :global(html.reveal-js) .floating-cloud-item.in {
      opacity: calc(0.55 + var(--depth, 0.8) * 0.32);
      transform: translate(-50%, -50%) scale(1);
    }
  }
  /* Small screens: the cloud has no room to scatter around a full-width
     stacked heading without overlapping the text itself — hide rather than
     crowd it, same call as decorative-only elements elsewhere on the site. */
  @media (max-width: 820px) {
    .floating-cloud {
      display: none;
    }
  }
</style>
