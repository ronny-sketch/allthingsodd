---
// Timed newsletter popup — the one deliberate exception to "newsletter UI
// lives only in the footer" (see Footer.astro, Nav.astro, MobileMenu.astro's
// own comments). Appears ~15s after page load, once per browser session
// (sessionStorage, not a cookie — see newsletter-popup.ts), reuses the exact
// same submission logic/endpoint as the footer via NewsletterForm.astro
// (different `source` tag only), and is mounted sitewide from Layout.astro
// since the brief asks for "the visitor enters the site", not a homepage-
// only prompt. See docs/architecture.md and the 2026-08-30 homepage
// revision brief, section 13.
import { getEntry } from 'astro:content';
import NewsletterForm from '../primitives/NewsletterForm.astro';
import Logo from '../primitives/Logo.astro';

const site = await getEntry('site', 'global');
if (!site) throw new Error('Missing site/global.json content entry');
const { newsletterHref } = site.data;
---

<div class="nl-popup-backdrop" id="newsletterPopupBackdrop" hidden></div>
<div
  class="nl-popup"
  id="newsletterPopup"
  role="dialog"
  aria-modal="true"
  aria-labelledby="newsletterPopupTitle"
  hidden
>
  <button type="button" class="nl-popup-close" id="newsletterPopupClose" aria-label="Close">
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
      <path
        d="M4 4l12 12M16 4L4 16"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        fill="none"></path>
    </svg>
  </button>
  <Logo class="nl-popup-mark" ariaHidden />
  <p class="eyebrow">Stay in touch</p>
  <h2 id="newsletterPopupTitle">Keep up with ODD</h2>
  <p class="nl-popup-body">
    Events, open calls and what's happening across ODDfest, ODDference and ODDspace — straight to
    your inbox, no spam.
  </p>
  <NewsletterForm
    id="newsletterPopupForm"
    source="popup_newsletter"
    newsletterHref={newsletterHref}
  />
</div>

<script src="../../scripts/newsletter-popup.ts"></script>

<style>
  .nl-popup-backdrop {
    position: fixed;
    inset: 0;
    z-index: 220;
    background: rgb(14 9 11 / 55%);
    opacity: 0;
    transition: opacity var(--duration-base) ease;
  }
  .nl-popup-backdrop.is-open {
    opacity: 1;
  }
  /* Centered editorial invite, not a peripheral notification — sized and
     bordered like the rest of the ODD panel language (Nav.astro's Info
     dropdown shares --radius-panel/--shadow-panel, see tokens.css), just
     roomier: this is the one deliberate full-attention interruption on the
     site, not a quiet corner toast.

     White/paper surface (same independent light-panel treatment as
     MobileMenu.astro's fullscreen overlay and Nav.astro's Info dropdown —
     see their own comments) rather than the dark --color-backstage this
     used to sit on. Pinned to the true light/dark swatches, not the
     inherited --color-paper/--color-ink, so this renders correctly on
     ODDspace's .theme-light page too, where those tokens are inverted. */
  .nl-popup {
    --color-paper: var(--swatch-paper);
    --color-ink: var(--swatch-ink);
    position: fixed;
    z-index: 221;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(30rem, calc(100vw - 2 * var(--space-6)));
    max-height: calc(100vh - 2 * var(--space-6));
    overflow-y: auto;
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1px solid var(--color-ink-12);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-panel);
    padding: var(--space-12) var(--space-10) var(--space-10);
    text-align: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nl-popup {
      transform: translate(-50%, -50%) scale(0.96);
      transition:
        opacity var(--duration-base) ease,
        transform var(--duration-base) ease,
        visibility 0s linear var(--duration-base);
    }
    .nl-popup.is-open {
      transform: translate(-50%, -50%);
      transition:
        opacity var(--duration-base) ease,
        transform var(--duration-base) ease;
    }
  }
  .nl-popup.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .nl-popup-mark {
    display: block;
    height: 20px;
    width: auto;
    margin: 0 auto var(--space-6);
    color: var(--color-ink-40);
  }
  /* .eyebrow's sitewide default (--color-paper-40) is tuned for dark
     grounds and doesn't track this panel's local paper/ink flip above (it's
     a fixed literal, not a role token) — needs its own ink-based override
     here, same as every other text color in this component below. */
  .nl-popup .eyebrow {
    display: block;
    margin: 0 0 0.6rem;
    color: var(--color-ink-60);
  }
  .nl-popup h2 {
    margin: 0;
    font: var(--text-heading-lg);
    color: var(--color-ink);
  }
  .nl-popup-body {
    margin: 0.9rem auto 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--color-ink-60);
    max-width: 36ch;
  }
  .nl-popup :global(.nl-form) {
    max-width: none;
    width: 100%;
    margin: var(--space-8) auto 0;
    border-color: var(--color-ink-20);
  }
  .nl-popup :global(.nl-form:focus-within) {
    border-color: var(--color-ink);
  }
  .nl-popup :global(.nl-form input) {
    padding: 0.95rem 0 0.95rem 1.4rem;
    font-size: 0.9rem;
    color: var(--color-ink);
  }
  /* NewsletterForm's button is paper-fill/ink-text by default (built for
     the site's usual dark ambient page, where that pairing pops) — on this
     always-light panel it would render paper-on-paper. Inverted here for
     real contrast against the panel. */
  .nl-popup :global(.nl-form button) {
    padding: 0 1.6rem;
    font-size: 0.72rem;
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .nl-popup :global(.nl-status) {
    text-align: center;
    color: var(--color-ink-40);
  }
  .nl-popup-close {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-60);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  .nl-popup-close:hover {
    background: var(--color-ink-12);
    color: var(--color-ink);
  }

  @media (max-width: 640px) {
    .nl-popup {
      width: calc(100vw - 2 * var(--space-5));
      padding: var(--space-10) var(--space-6) var(--space-6);
    }
    /* This popup's own desktop override (0.9rem = 14.4px, above) wins over
       NewsletterForm.astro's scoped 16px mobile rule by specificity — Safari
       then auto-zooms the whole page on focus, since iOS treats any input
       under 16px as "the user must be zooming in to read this." Re-asserting
       16px here at the same specificity this popup already writes at is what
       actually restores the behaviour that rule was meant to guarantee. */
    .nl-popup :global(.nl-form input) {
      font-size: 16px;
    }
  }
</style>
