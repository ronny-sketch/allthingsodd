---
// JSON-LD structured data — Organization + WebSite only. Deliberately no
// Event schema: the homepage's activity list ("What's happening") was
// removed on 2026-09-04 and nothing else on this site publishes confirmed
// dates, so there is no real event data to mark up. Shipping Event markup
// with unconfirmed dates is the kind of fake structured data that hurts
// more than it helps; add it if and when a page carries dates a human has
// actually confirmed.
import { getEntry } from 'astro:content';

const site = await getEntry('site', 'global');
if (!site) throw new Error('Missing site/global.json content entry');
const { social, contact } = site.data;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const email = contact[0]?.email;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'New Nordic Way rf',
  alternateName: 'ODD',
  url: siteUrl,
  logo: `${siteUrl}/logo.png`,
  ...(email && { email }),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Sturenportti 3',
    addressLocality: 'Helsinki',
    addressCountry: 'FI',
  },
  sameAs: social.map((s) => s.href),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  // The website, not the brand (2026-09-04). "All Things ODD" is the name of
  // this site/project — the canonical digital home for ODD's things; `ODD`
  // stays on as the brand's alternate name, and the Organization entity
  // above keeps the legal publisher (New Nordic Way rf) factual.
  name: 'All Things ODD',
  alternateName: 'ODD',
  // Same underlying factual framing as Media's boilerplate (media.json) —
  // masterbrand connecting creative/cultural fields with business and wider
  // society, not the old "co-creation platform" phrasing, which predates
  // the current ODDfest/ODDference/ODDspace architecture. Keep both in sync
  // if either changes; see docs on the Media rebuild (2026-08-30/31).
  description:
    "ODD is a Helsinki-based initiative connecting Finland's creative and cultural fields with business and wider society, through ODDfest, ODDference and ODDspace.",
  url: siteUrl,
  publisher: { '@type': 'Organization', name: 'New Nordic Way rf' },
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(organization)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(website)} />
