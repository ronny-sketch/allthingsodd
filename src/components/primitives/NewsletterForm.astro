---
// The site's one newsletter subscribe form — used by Footer.astro (the only
// persistent newsletter UI on the site) and NewsletterPopup.astro (the
// timed, session-once popup). One component, one submission script
// (newsletter-form.ts), so the two never drift into duplicate/conflicting
// implementations — see docs/architecture.md and CLAUDE.md's CMS rules.
//
// `id` must be unique per instance (an id collision would break both forms'
// `document.getElementById` lookups and is invalid HTML) — callers pass a
// distinct id per placement. `source` tags which surface a signup came from
// in the same POST payload newsletter-form.ts already sends (see
// src/scripts/newsletter-form.ts and src/scripts/utm.ts).
interface Props {
  id: string;
  source: string;
  newsletterHref: string;
  placeholder?: string;
  buttonLabel?: string;
}
const {
  id,
  source,
  newsletterHref,
  placeholder = 'you@example.com',
  buttonLabel = 'Sign up',
} = Astro.props;
---

<form
  class="nl-form"
  id={id}
  data-newsletter-form
  data-source={source}
  action={newsletterHref}
  method="get"
  target="_blank"
>
  <input
    type="text"
    name="botcheck"
    class="nl-botcheck"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />
  <input
    type="email"
    name="email"
    placeholder={placeholder}
    aria-label="Email address"
    autocomplete="email"
    required
  />
  <button type="submit">{buttonLabel}</button>
</form>
<p class="nl-status" role="status" aria-live="polite"></p>

<script src="../../scripts/newsletter-form.ts"></script>

<style>
  .nl-form {
    display: flex;
    border: 1px solid var(--color-paper-20);
    border-radius: 999px;
    /* Capped by its container too: the email field's intrinsic width, and so
       this pill's natural width, depends on the platform's font metrics — on
       Linux it reaches the 20rem cap, which in a 320px footer row with its
       gutters pushed the page 28px wide. The field has min-width: 0, so it
       gives up the space instead. */
    max-width: min(20rem, 100%);
    flex-shrink: 0;
    overflow: hidden;
  }
  /* The input's own outline is suppressed below (it'd be clipped by this
     pill's overflow:hidden/rounded corners anyway) — :focus-within on the
     container itself is the visible replacement, since there was none at
     all before. */
  .nl-form:focus-within {
    border-color: var(--color-paper);
  }
  .nl-form input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    padding: 0.7rem 0 0.7rem 1.1rem;
    /* Body at every width. Its 1rem floor is also the iOS guarantee — Safari
       zooms the page on focus for any field under 16px — so no mobile-only
       override is needed, and none should be layered on top. */
    font: var(--text-body);
    color: var(--color-paper);
    outline: none;
  }
  .nl-form button {
    border: none;
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 0 1.2rem;
    margin: 3px;
    border-radius: 999px;
    font: var(--text-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    cursor: pointer;
    white-space: nowrap;
    transition: opacity var(--duration-fast) ease;
  }
  .nl-form button:hover {
    opacity: 0.85;
  }
  .nl-botcheck {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .nl-status {
    margin: 0.5rem 0 0;
    font: var(--text-small);
    color: var(--color-paper-40);
  }
  /* Empty until the form answers: no margin, so an unused status line leaves
     no blank under the field. Not display:none — it is an aria-live region. */
  .nl-status:empty {
    margin: 0;
  }
</style>
