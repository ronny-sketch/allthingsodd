---
// Pill: the site's one button shape. `variant` and `tone` are the only knobs a
// content editor gets — see docs/design-system.md#buttons for why raw CSS values
// aren't exposed here.
interface Props {
  href?: string;
  variant?: 'outline' | 'solid' | 'ticket';
  magnetic?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  ariaLabel?: string;
  id?: string;
  target?: '_blank';
}
const {
  href,
  variant = 'solid',
  magnetic = false,
  type,
  class: className,
  ariaLabel,
  id,
  target,
} = Astro.props;
const classes = ['pill', `pill-${variant}`, magnetic && 'magnetic', className]
  .filter(Boolean)
  .join(' ');
const Tag = href ? 'a' : 'button';
---

<Tag
  id={id}
  class={classes}
  href={href}
  type={!href ? (type ?? 'button') : undefined}
  aria-label={ariaLabel}
  target={target}
  rel={target === '_blank' ? 'noreferrer' : undefined}
>
  <slot />
</Tag>

<style>
  .pill {
    display: inline-block;
    border-radius: 999px;
    padding: 0.55rem 1.25rem;
    white-space: nowrap;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    transition:
      opacity var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }
  .pill-outline {
    background: transparent;
    color: var(--color-paper);
    border-color: rgb(226 223 222 / 35%);
  }
  /* Literal above assumes a dark ground (paper-tinted border at 35%) — under
     .theme-light (ODDspace) the ground is light, so the border needs the
     ink-tinted mirror at the same opacity, not the inherited (now-dark)
     --color-paper value reused as a border tint. */
  :global(.theme-light) .pill-outline {
    border-color: rgb(14 9 11 / 35%);
  }
  @media (hover: hover) {
    .pill-outline:hover {
      border-color: var(--color-paper);
    }
  }
  .pill-solid {
    background: var(--color-paper);
    color: var(--color-ink);
    border-color: var(--color-paper);
  }
  @media (hover: hover) {
    .pill-solid:hover {
      opacity: 0.85;
    }
  }
  .pill-ticket {
    background: var(--color-paper);
    color: var(--color-ink);
    border-color: var(--color-paper);
    box-shadow: 0 6px 18px rgb(0 0 0 / 35%);
  }
  @media (hover: hover) {
    .pill-ticket:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 22px rgb(0 0 0 / 45%);
    }
  }
  .pill:focus-visible {
    outline-offset: 2px;
  }
  /* Touch (2026-09-02 mobile experience pass). Two separate problems, one
     media query:

     1. The shipped padding puts this button at roughly 35px tall — under the
        44px minimum every touch-target guideline agrees on, and this is the
        site's only button shape, so it applied to every CTA on every page.
        Growing the vertical padding here (rather than sitewide) fixes the
        tap target without touching the approved desktop button proportions
        at all.
     2. None of the hover states above can ever fire meaningfully on a
        touchscreen — they either never trigger or stick after the tap — so
        the button had no press feedback whatsoever. `:active` supplies it. */
  @media (hover: none) {
    .pill {
      /* Vertical padding only — the horizontal value deliberately stays at
         the desktop 1.25rem. Pill sets `white-space: nowrap`, so a long
         label's min-content width is a hard floor on whatever grid column
         holds it, and widening this button widens that floor everywhere.
         ODDference's "Talk to us about partnering →" CTA is already the
         binding constraint on `.oddc-convert`'s single-column track (see
         that page's own comment); an earlier version of this rule used
         1.4rem and pushed `/oddference` 3px past a 320px viewport on Linux
         CI, where the string measures slightly wider than on macOS. The
         44px target is a height requirement, so height is all this needs. */
      padding: 0.85rem 1.25rem;
      /* A <button>'s UA stylesheet sets its own `line-height: normal`
         directly on the element, which beats inheritance regardless of
         specificity — so a Pill rendered as a button (the Menu trigger) came
         out several px shorter than the identical Pill rendered as a link,
         and landed at 42px where the anchors reached 44. Same UA quirk
         Nav.astro documents for its Info trigger. Asserting body's 1.5 here
         makes both tags measure the same. Scoped to this touch block so the
         approved desktop button proportions are untouched. */
      line-height: 1.5;
      -webkit-tap-highlight-color: transparent;
    }
    .pill:active {
      transform: scale(0.96);
    }
    .pill-outline:active {
      border-color: var(--color-paper);
    }
    .pill-solid:active,
    .pill-ticket:active {
      opacity: 0.82;
    }
  }
</style>
